# uname [-a]: name the system

use io: machos.user.io;
use rt: machos.user.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc > 1 && io.streq(argv[1], "-a\0") != 0) {
        io.out("MachOS 0.1.0 x86_64 (kernel and userland written in mach)\n\0");
    } or {
        io.out("MachOS\n\0");
    }
    ret 0;
}
