# small helpers every program uses: strings, numbers, printing

use abi: machos.abi.sys;
use sys: machos.user.sys;

pub fun len(s: *u8) u64 {
    var n: u64 = 0;
    for (s[n] != 0) { n = n + 1; }
    ret n;
}

pub fun eq(a: *u8, an: u64, b: *u8, bn: u64) u8 {
    if (an != bn) { ret 0; }
    var i: u64 = 0;
    for (i < an) {
        if (a[i] != b[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

# NUL-terminated `a` equals NUL-terminated `b`
pub fun streq(a: *u8, b: *u8) u8 { ret eq(a, len(a), b, len(b)); }

pub fun copy(dst: *u8, src: *u8, n: u64) {
    var i: u64 = 0;
    for (i < n) {
        dst[i] = src[i];
        i = i + 1;
    }
}

# write everything, retrying short writes; returns 0 on failure
pub fun write_all(h: u64, buf: *u8, n: u64) u8 {
    var done: u64 = 0;
    for (done < n) {
        val r: u64 = sys.write(h, ?buf[done], n - done);
        if (abi.is_err(r) != 0 || r == 0) { ret 0; }
        done = done + r;
    }
    ret 1;
}

pub fun out(s: *u8) { write_all(abi.STDOUT, s, len(s)); }
pub fun outn(s: *u8, n: u64) { write_all(abi.STDOUT, s, n); }
pub fun err(s: *u8) { write_all(abi.STDERR, s, len(s)); }
pub fun errn(s: *u8, n: u64) { write_all(abi.STDERR, s, n); }

pub fun putc(c: u8) {
    var b: u8 = c;
    write_all(abi.STDOUT, ?b, 1);
}

# decimal digits of v into buf (20 bytes); returns the count
pub fun fmt_dec(v: u64, buf: *u8) u64 {
    var tmp: [20]u8;
    var n: u64 = 0;
    var x: u64 = v;
    for {
        tmp[n] = 48 + (x % 10)::u8;
        n = n + 1;
        x = x / 10;
        if (x == 0) { brk; }
    }
    var i: u64 = 0;
    for (i < n) {
        buf[i] = tmp[n - 1 - i];
        i = i + 1;
    }
    ret n;
}

pub fun dec(v: u64) {
    var buf: [20]u8;
    outn(?buf[0], fmt_dec(v, ?buf[0]));
}

# right-aligned in `width` columns
pub fun dec_pad(v: u64, width: u64) {
    var buf: [20]u8;
    val n: u64 = fmt_dec(v, ?buf[0]);
    var i: u64 = n;
    for (i < width) {
        putc(32);
        i = i + 1;
    }
    outn(?buf[0], n);
}

# parse a decimal number; `ok` is set to 0 if `s` is not one
pub fun parse_dec(s: *u8, n: u64, ok: *u8) u64 {
    @ok = 0;
    if (n == 0) { ret 0; }
    var v: u64 = 0;
    var i: u64 = 0;
    for (i < n) {
        if (s[i] < 48 || s[i] > 57) { ret 0; }
        v = v * 10 + (s[i] - 48)::u64;
        i = i + 1;
    }
    @ok = 1;
    ret v;
}

# "prog: what: reason\n" on stderr
pub fun fail(prog: *u8, what: *u8, e: u64) {
    err(prog);
    err(": \0");
    if (what != nil) {
        err(what);
        err(": \0");
    }
    err(abi.err_name(e));
    err("\n\0");
}

# argv[i] of a program's arguments
pub fun arg(argv: **u8, i: u64) *u8 { ret argv[i]; }
