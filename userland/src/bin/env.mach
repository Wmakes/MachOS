# Print or replace the environment and run commands with the selected PATH.

use sys: sdk.sys;
use os:  std.system.os;
use io:  userland.lib.cli;
use path: userland.lib.path;
use opt: userland.lib.options;
use std.runtime;


fun is_assignment(w: *u8) u64 {
    var i: u64 = 0;
    for (w[i] != 0) {
        if (w[i] == 61) { ret i; }
        i = i + 1;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

# the environment being built: "NAME=value" strings
var list: [512]*u8;
var count: u64 = 0;

# NAME=value, replacing an entry with the same NAME
fun set(entry: *u8, eq: u64) {
    var k: u64 = 0;
    for (k < count) {
        val e: *u8 = list[k];
        if (io.len(e) > eq && io.eq(e, eq, entry, eq) != 0 && e[eq] == 61) {
            list[k] = entry;
            ret;
        }
        k = k + 1;
    }
    if (count + 1 < 512) {
        list[count] = entry;
        count = count + 1;
    }
}

fun run(argc: u64, argv: **u8) u64 {
    if (opt.standard(argc, argv, "env", "usage: env [-i0] [-u NAME] [-C DIR] [NAME=VALUE...] [COMMAND [ARG...]]\n  -i, --ignore-environment  start empty\n  -u, --unset               remove variable\n  -C, --chdir               change directory before running\n  -0, --null                NUL-delimit printed entries") != 0) { ret 0; }
    val now: **u8 = os.environ(); var k: u64 = 0;
    for (now != nil && now[k] != nil) {
        if (count + 1 == 512) { io.emsg("env: too many variables\n"); ret 1; }
        list[count] = now[k]; count = count + 1; k = k + 1;
    }
    var p: opt.Parser; opt.init(?p, argc, argv); var end: u8 = 10; var dir: *u8 = nil;
    for {
        val c: u8 = opt.next(?p, "ignore-environment=i,unset=u,chdir=C,null=0"); if (c == 0) { brk; }
        if (c == 105) { count = 0; }
        or (c == 48) { end = 0; }
        or (c == 67) { dir = opt.argument(?p); }
        or (c == 117) {
            val name: *u8 = opt.argument(?p);
            if (name != nil) {
                val n: u64 = io.len(name); k = 0;
                if (n == 0 || is_assignment(name) != 0) { p.bad = 1; }
                for (k < count) {
                    if (io.len(list[k]) > n && io.eq(list[k], n, name, n) != 0 && list[k][n] == 61) {
                        count = count - 1; var j: u64 = k;
                        for (j < count) { list[j] = list[j + 1]; j = j + 1; }
                    } or { k = k + 1; }
                }
            }
        } or { p.bad = 1; }
    }
    if (p.bad != 0) { ret opt.error("env"); }
    if (dir != nil) {
        val r: i64 = sys.chdir(dir, io.len(dir))::i64; if (r < 0) { io.fail("env", dir, r); ret 1; }
    }
    var i: u64 = p.at;
    for (i < argc) {
        val eq: u64 = is_assignment(argv[i]);
        if (eq == 0) { brk; }
        if (count + 1 == 512) { io.emsg("env: too many variables\n"); ret 1; }
        set(argv[i], eq);
        i = i + 1;
    }
    list[count] = nil;
    if (i == argc) {
        var k: u64 = 0;
        for (k < count) {
            io.out(list[k]);
            io.putc(end);
            k = k + 1;
        }
        ret 0;
    }
    # COMMAND: through $PATH like the shell
    var full: [256]u8;
    val name: *u8 = argv[i];
    var search: *u8 = "/bin"; k = 0;
    for (k < count) {
        if (io.len(list[k]) >= 5 && io.eq(list[k], 5, "PATH=", 5) != 0) { search = ?list[k][5]; }
        k = k + 1;
    }
    if (end == 0) { io.emsg("env: --null requires no command\n"); ret 2; }
    val fl: u64 = path.lookup_in(name, ?full[0], search);
    if (fl == 0) {
        io.emsg("env: \0");
        io.err(name);
        io.emsg(": command not found\n\0");
        ret 127;
    }
    val st: i64 = io.run_program(?full[0], ?argv[i], ?list[0]);
    if (st < 0) {
        io.fail("env\0", name, st);
        ret 126;
    }
    ret st::u64;
}
