# mount DEV DIR: mount the filesystem on DEV (e.g. /dev/sdb1) on DIR. ext2,
# FAT16/32 and exFAT are recognised by what is on the device.
# mount alone lists what is mounted

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc == 1) {
        var i: u64 = 0;
        for {
            var m: abi.MountInfo;
            val r: u64 = sys.mounts(i, ?m);
            if (abi.is_err(r) != 0 || r == 0) { brk; }
            io.out(?m.dev[0]);
            io.msg(" on \0");
            io.out(?m.dir[0]);
            io.msg(" type \0");
            io.out(?m.fstype[0]);
            io.putc(10);
            i = i + 1;
        }
        ret 0;
    }
    if (argc != 3) {
        io.emsg("usage: mount [DEV DIR]\n\0");
        ret 2;
    }
    val r: u64 = sys.mount(argv[1], io.len(argv[1]), argv[2], io.len(argv[2]));
    if (abi.is_err(r) != 0) {
        io.fail("mount\0", argv[1], r);
        ret 1;
    }
    ret 0;
}
