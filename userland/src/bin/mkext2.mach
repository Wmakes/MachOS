# mkext2 PART: make an empty ext2 filesystem on the partition PART (e.g. /dev/sdb2):
# 4 KiB blocks, 128-byte inodes, one inode per 64 KiB, the `filetype`
# feature only. every group carries a copy of the superblock and group
# descriptors (no sparse_super). the root directory and lost+found are made

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use bd:  sdk.blkdev;
use rt:  sdk.rt;

val BS: u64 = 4096;
val BPG: u64 = 32768;      # blocks per group: one bitmap block's worth
val INODE_SIZE: u64 = 128;
val BYTES_PER_INODE: u64 = 65536;

var disk: u64 = 0;
var base: u64 = 0;
var blocks: u64 = 0;
var groups: u64 = 0;
var ipg: u64 = 0;
var itb: u64 = 0;          # inode table blocks per group
var gdt_blocks: u64 = 0;
var now: u64 = 0;
var uuid: [16]u8;

var blk: [4096]u8;
var gdt: [131072]u8;       # 4096 groups' descriptors: 512 GiB, past our 32 GiB

fun group_start(g: u64) u64 { ret g * BPG; }

fun group_blocks(g: u64) u64 {
    val left: u64 = blocks - group_start(g);
    if (left < BPG) { ret left; }
    ret BPG;
}

fun overhead() u64 { ret 1 + gdt_blocks + 2 + itb; }

fun write_block(b: u64, src: *u8) u8 { ret bd.pwrite(disk, base + b * BS, src, BS); }

fun set_bit(b: *u8, i: u64) { b[i / 8] = b[i / 8] | (1::u8 << (i % 8)::u8); }

# the superblock, as group `g` stores it
fun superblock(s: *u8, g: u64, free_blocks: u64, free_inodes: u64) {
    bd.clear(s, 1024);
    bd.put32(s, 0, ipg * groups);
    bd.put32(s, 4, blocks);
    bd.put32(s, 12, free_blocks);
    bd.put32(s, 16, free_inodes);
    bd.put32(s, 20, 0);          # first data block
    bd.put32(s, 24, 2);          # 1024 << 2 = 4 KiB
    bd.put32(s, 28, 2);
    bd.put32(s, 32, BPG);
    bd.put32(s, 36, BPG);
    bd.put32(s, 40, ipg);
    bd.put32(s, 44, 0);          # mount time
    bd.put32(s, 48, now);        # write time
    bd.put16(s, 52, 0);
    bd.put16(s, 54, 0xFFFF);     # no forced checks
    bd.put16(s, 56, 0xEF53);
    bd.put16(s, 58, 1);          # clean
    bd.put16(s, 60, 1);          # on errors: continue
    bd.put32(s, 64, now);        # last check
    bd.put32(s, 76, 1);          # dynamic revision
    bd.put32(s, 84, 11);         # first ordinary inode
    bd.put16(s, 88, INODE_SIZE);
    bd.put16(s, 90, g);
    bd.put32(s, 96, 2);          # incompat: filetype
    io.copy(?s[104], ?uuid[0], 16);
    io.copy(?s[120], "machos\0", 6);
}

fun inode(ino: u64, mode: u64, links: u64, block: u64) u8 {
    var i: [128]u8;
    bd.clear(?i[0], 128);
    bd.put16(?i[0], 0, mode);
    bd.put32(?i[0], 4, BS);
    bd.put32(?i[0], 8, now);
    bd.put32(?i[0], 12, now);
    bd.put32(?i[0], 16, now);
    bd.put16(?i[0], 26, links);
    bd.put32(?i[0], 28, 8);
    bd.put32(?i[0], 40, block);
    val table: u64 = group_start(0) + 1 + gdt_blocks + 2;
    ret bd.pwrite(disk, base + table * BS + (ino - 1) * INODE_SIZE, ?i[0], 128);
}

fun dirent(b: *u8, off: u64, ino: u64, rec: u64, name: *u8) {
    val n: u64 = io.len(name);
    bd.put32(b, off, ino);
    bd.put16(b, off + 4, rec);
    b[off + 6] = n::u8;
    b[off + 7] = 2; # directory
    io.copy(?b[off + 8], name, n);
}

fun dir_block(at: u64, self: u64, parent: u64, child: u64, child_name: *u8) u8 {
    bd.clear(?blk[0], BS);
    dirent(?blk[0], 0, self, 12, ".\0");
    if (child == 0) {
        dirent(?blk[0], 12, parent, BS - 12, "..\0");
    } or {
        dirent(?blk[0], 12, parent, 12, "..\0");
        dirent(?blk[0], 24, child, BS - 24, child_name);
    }
    ret write_block(at, ?blk[0]);
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc != 2) {
        io.err("usage: mkext2 PART\n\0");
        ret 2;
    }
    disk = bd.open_disk("mkext2\0", argv[1], 1);
    if (abi.is_err(disk) != 0) { ret 1; }
    val count: u64 = bd.disk_size(argv[1]) / bd.SECTOR;
    base = 0;
    now = sys.time();
    bd.guid(?uuid[0]);

    blocks = count * bd.SECTOR / BS;
    groups = (blocks + BPG - 1) / BPG;
    var inodes: u64 = blocks * BS / BYTES_PER_INODE;
    ipg = (inodes + groups - 1) / groups;
    ipg = (ipg + 31) / 32 * 32; # whole inode-table blocks
    if (ipg < 64) { ipg = 64; }
    itb = ipg * INODE_SIZE / BS;
    gdt_blocks = (groups * 32 + BS - 1) / BS;
    # a last group too small for its own metadata is dropped
    if (groups > 1 && group_blocks(groups - 1) < overhead() + 16) {
        groups = groups - 1;
        blocks = groups * BPG;
        gdt_blocks = (groups * 32 + BS - 1) / BS;
    }
    if (groups * 32 > 131072 || blocks < overhead() + 64) {
        io.err("mkext2: the partition is too large or too small\n\0");
        ret 1;
    }

    # group descriptors and free counts; group 0 also holds two directory blocks
    val root_block: u64 = overhead();
    val lf_block: u64 = overhead() + 1;
    var free_blocks: u64 = 0;
    var free_inodes: u64 = 0;
    bd.clear(?gdt[0], groups * 32);
    var g: u64 = 0;
    for (g < groups) {
        val s: u64 = group_start(g);
        val d: *u8 = ?gdt[g * 32];
        bd.put32(d, 0, s + 1 + gdt_blocks);
        bd.put32(d, 4, s + 2 + gdt_blocks);
        bd.put32(d, 8, s + 3 + gdt_blocks);
        var fb: u64 = group_blocks(g) - overhead();
        var fi: u64 = ipg;
        if (g == 0) {
            fb = fb - 2;
            fi = fi - 11;
            bd.put16(d, 16, 2); # directories: / and lost+found
        }
        bd.put16(d, 12, fb);
        bd.put16(d, 14, fi);
        free_blocks = free_blocks + fb;
        free_inodes = free_inodes + fi;
        g = g + 1;
    }

    var ok: u8 = 1;
    g = 0;
    for (g < groups && ok != 0) {
        val s: u64 = group_start(g);
        # superblock (group 0: at byte 1024 of block 0) and descriptors
        bd.clear(?blk[0], BS);
        var sbo: u64 = 0;
        if (g == 0) { sbo = 1024; }
        superblock(?blk[sbo], g, free_blocks, free_inodes);
        ok = write_block(s, ?blk[0]);
        var k: u64 = 0;
        for (k < gdt_blocks && ok != 0) {
            bd.clear(?blk[0], BS);
            var n: u64 = groups * 32 - k * BS;
            if (n > BS) { n = BS; }
            io.copy(?blk[0], ?gdt[k * BS], n);
            ok = write_block(s + 1 + k, ?blk[0]);
            k = k + 1;
        }
        # block bitmap: metadata (and group 0's two directory blocks) in use,
        # bits past the end of a short last group set
        bd.clear(?blk[0], BS);
        var used: u64 = overhead();
        if (g == 0) { used = used + 2; }
        var b: u64 = 0;
        for (b < used) { set_bit(?blk[0], b); b = b + 1; }
        b = group_blocks(g);
        for (b < BPG) { set_bit(?blk[0], b); b = b + 1; }
        if (ok != 0) { ok = write_block(s + 1 + gdt_blocks, ?blk[0]); }
        # inode bitmap: reserved inodes 1-11 in group 0, padding past ipg
        bd.clear(?blk[0], BS);
        if (g == 0) {
            b = 0;
            for (b < 11) { set_bit(?blk[0], b); b = b + 1; }
        }
        b = ipg;
        for (b < BS * 8) { set_bit(?blk[0], b); b = b + 1; }
        if (ok != 0) { ok = write_block(s + 2 + gdt_blocks, ?blk[0]); }
        # an empty inode table
        if (ok != 0) { ok = bd.zero(disk, base + (s + 3 + gdt_blocks) * BS, itb * BS); }
        g = g + 1;
    }

    # / is inode 2, lost+found inode 11
    if (ok != 0) { ok = inode(2, 0x41ED, 3, root_block); }
    if (ok != 0) { ok = inode(11, 0x41C0, 2, lf_block); }
    if (ok != 0) { ok = dir_block(root_block, 2, 2, 11, "lost+found\0"); }
    if (ok != 0) { ok = dir_block(lf_block, 11, 2, 0, "\0"); }
    sys.close(disk);
    if (ok == 0) {
        io.err("mkext2: writing the disk failed\n\0");
        ret 1;
    }
    io.out("mkext2: \0");
    io.dec(blocks / 256);
    io.out(" MiB in \0");
    io.dec(groups);
    io.out(" groups, \0");
    io.dec(ipg * groups);
    io.out(" inodes\n\0");
    ret 0;
}
