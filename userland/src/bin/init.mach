# pid 1: apply /etc/machos.conf, then keep a login prompt on each terminal,
# tty1..tty6 (alt+F1..F6 switch between them; tty1 is also the serial
# port). in rescue mode: one root shell on the console, no password asked,
# for repairing the system
#
# from /etc/machos.conf: hostname, ttys (how many terminals get a login
# prompt), autologin (a user logged in on tty1 without a password), and
# rtc (utc, or local when the hardware clock keeps local time, as Windows
# does: the time zone's offset is handed to the kernel) and network (dhcp,
# off, or a fixed "IP/PREFIX GATEWAY DNS")

use sdk.auth;
use std.runtime;
use std.system.os;
use std.system.os.machos; # a shell leading its own process group
use std.types.size.usize;
use io: userland.lib.cli;
use userland.lib.conf;
use userland.lib.time;

val TTYS: u64 = 6;

var fds:       [6]i64; # each terminal, open (tty1 is the console init was given)
var pids:      [6]i64; # the session running on it, 0 = none
var ttys:      u64 = 6;
var autologin: [32]u8;

# start login on terminal `t`
fun start(t: u64) {
    var argv: [4]*u8;
    argv[0] = "login";
    argv[1] = nil;
    if (t == 0 && autologin[0] != 0) {
        argv[1] = "-f";
        argv[2] = ?autologin[0];
        argv[3] = nil;
    }
    val h:   i32 = fds[t]::i32;
    val pid: i64 = os.spawn_redirected("/bin/login", ?argv[0], os.environ(), h::usize, h::usize, h::usize);
    if (pid < 0) {
        pids[t] = 0;
        if (t == 0) { io.fail("init", "cannot start a session", pid); }
        ret;
    }
    pids[t] = pid;
}

# wait for any child; its pid, or a negative native code
fun reap() i64 {
    var st: os.ProcessStatus;
    val w:  os.WaitResult = os.wait_pid(-1, ?st, 0);
    if (w.pid > 0) { ret w.pid; }
    ret w.error.code;
}

fun rescue_shell() {
    for {
        io.out("init: rescue mode, root shell (fsck -y /dev/sda2 checks the disk)\n");
        var argv: [2]*u8;
        argv[0] = "-sh";
        argv[1] = nil;
        val pid: i64 = machos.spawn_grouped("/bin/sh", ?argv[0], os.environ());
        if (pid < 0) {
            io.fail("init", "cannot start a shell", pid);
            io.sleep_ms(1000);
            cnt;
        }
        for {
            val r: i64 = reap();
            if (r == pid || r < 0) { brk; }
        }
    }
}

# write `text` to /proc file `path`
fun tell(path: *u8, text: *u8) {
    val h: i64 = io.open_mode(path, os.O_WRONLY, 0);
    if (h < 0) {
        io.fail("init", path, h);
        ret;
    }
    val r: i64 = io.write(h, text, io.len(text));
    if (r < 0) { io.fail("init", path, r); }
    io.close(h);
}

fun clamp(v: u64, lo: u64, hi: u64) u64 {
    if (v < lo) { ret lo; }
    if (v > hi) { ret hi; }
    ret v;
}

# the settings that are the system's
fun configure() {
    var v: [64]u8;
    if (conf.get("hostname", ?v[0], 64) > 0) { tell("/proc/sys/kernel/hostname", ?v[0]); }
    ttys = clamp(conf.number("ttys", 6), 1, TTYS);
    conf.get("autologin", ?autologin[0], 32);
    if (conf.get("rtc", ?v[0], 64) > 0 && io.streq(?v[0], "local") != 0) { rtc_local(); }
    # the network: dhcp (the kernel already asks), off, or "IP/PREFIX GATEWAY DNS"
    if (conf.get("network", ?v[0], 64) > 0 && io.streq(?v[0], "dhcp") == 0) { tell("/proc/net/config", ?v[0]); }
}

# v as decimal text, with a minus when it is negative, into out (24 bytes)
fun signed(v: i64, out: *u8) {
    var n: u64 = 0;
    var x: u64 = v::u64;
    if (v < 0) {
        out[0] = 45;
        n      = 1;
        x      = (0 - v)::u64;
    }
    n      = n + io.fmt_dec(x, ?out[n]);
    out[n] = 0;
}

# a hardware clock on local time: the zone's offset then (the clock as the
# kernel read it is that much ahead)
fun rtc_local() {
    var z: time.Zone;
    time.system_zone(?z);
    var ts: os.Timespec;
    os.realtime(?ts);
    var zname: *u8 = nil;
    val off:   i64 = time.offset(?z, ts.sec - z.std_off, ?zname);
    var b:     [24]u8;
    signed(off, ?b[0]);
    tell("/proc/sys/kernel/rtc_offset", ?b[0]);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc > 1 && io.streq(argv[1], "rescue") != 0) {
        rescue_shell();
        ret 0;
    }
    if (io.exists("/bin/mpm-bootstrap.tar")) {
        var args: [3]*u8 = [3]*u8{"mpm", "--bootstrap", nil};
        if (io.run_program("/bin/mpm", ?args[0], nil) != 0) {
            io.err("init: legacy migration failed; boot rescue to repair the system\n");
            for { io.sleep_ms(1000); }
        }
    }
    auth.boot();
    configure();
    fds[0] = io.STDIN;
    var name: [10]u8;
    io.copy(?name[0], "/dev/tty", 8);
    name[9] = 0;
    var t: u64 = 1;
    for (t < TTYS) {
        name[8] = 49 + t::u8;
        fds[t]  = -1;
        if (t < ttys) { fds[t] = io.open_mode(?name[0], os.O_RDWR, 0); }
        t = t + 1;
    }
    t = 0;
    for (t < TTYS) {
        if (fds[t] >= 0) { start(t); }
        t = t + 1;
    }
    # restart whichever session ends, collecting orphans meanwhile
    for {
        val r: i64 = reap();
        if (r < 0) {
            io.sleep_ms(1000);
            cnt;
        }
        t = 0;
        for (t < TTYS) {
            if (pids[t] == r) {
                if (t == 0) { io.sleep_ms(100); }
                start(t);
            }
            t = t + 1;
        }
    }
    ret 0;
}
