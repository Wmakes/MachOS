# These tests use ordinary memory for MMIO and descriptors, never a live NIC.
test rtl8125__descriptor_layout_and_revision_gate {
    var tx: Tx;
    var rx: Rx;
    if ($size_of(Tx) != 32 || $size_of(Rx) != 32) { ret 1; }
    if ((?tx.addr)::u64 - (?tx)::u64 != 8 || (?rx.addr)::u64 - (?rx)::u64 != 16 ||
        (?rx.status)::u64 - (?rx)::u64 != 28) { ret 2; }
    if (supported_revision(0x64100700) == 0 || supported_revision(0x60900000) != 0 ||
        supported_revision(0x68800000) != 0 || supported_revision(0xffffffff) != 0) { ret 3; }
    var d: pci.Device;
    d.class    = 2;
    d.subclass = 0;
    d.vendor   = 0x10ec;
    d.device   = 0x8125;
    if (supports(?d) == 0) { ret 4; }
    d.device = 0x8168;
    if (supports(?d) != 0 || supports(nil) != 0) { ret 5; }
    var out: ethernet.Device;
    out.context = 91;
    if (probe(?d, ?out) != 0 || out.context != 91 || probe(nil, ?out) != 0) { ret 6; }
    ret 0;
}

test rtl8125__transmit_wrap_full_ring_and_padding {
    var n:     Nic;
    var regs:  [64]u32;
    var ring:  [32]Tx;
    var data:  [2048]u8;
    var frame: [1515]u8;
    n.regs    = (?regs[0])::u64;
    n.tx      = (?ring[0])::u64;
    n.running = 1;
    frame[0]  = 73;
    frame[13] = 91;
    var i: u64 = 0;
    for (i < RING) {
        n.tx_buf[i]  = (?data[0])::u64;
        ring[i].addr = 0x12345000;
        i            = i + 1;
    }
    if (send_frame((?n)::u64, nil, 64) != 0 || send_frame(0, ?frame[0], 64) != 0 ||
        send_frame((?n)::u64, ?frame[0], 13) != 0 || send_frame((?n)::u64, ?frame[0], 1515) != 0) { ret 1; }
    i = 0;
    for (i < RING) {
        if (send_frame((?n)::u64, ?frame[0], 14) == 0) { ret 2; }
        i = i + 1;
    }
    if (n.tx_next != 0 || send_frame((?n)::u64, ?frame[0], 64) != 0) { ret 3; }
    if (ring[31].status != (OWN | EOR | TX_WHOLE | 60) || ring[0].addr != 0x12345000 ||
        data[0] != 73 || data[13] != 91 || data[14] != 0 || data[59] != 0 || regs[36] != 1) { ret 4; }
    ring[0].status = 0;
    if (send_frame((?n)::u64, ?frame[0], 1514) == 0 || n.tx_next != 1 ||
        ring[0].status != (OWN | TX_WHOLE | 1514)) { ret 5; }
    frame[0] = 0;
    if (data[0] != 73 || ring[0].extra != 0 || ring[0].reserved[0] != 0) { ret 6; }
    ret 0;
}

test rtl8125__receive_recycles_errors_strips_crc_and_preserves_bounds {
    var n:    Nic;
    var ring: [32]Rx;
    var data: [2048]u8;
    var out:  [65]u8;
    n.rx      = (?ring[0])::u64;
    n.running = 1;
    var i: u64 = 0;
    for (i < RING) {
        n.rx_buf[i]    = (?data[0])::u64;
        n.rx_pa[i]     = 0x12345000 + i * 4096;
        ring[i].status = OWN;
        i              = i + 1;
    }
    data[0]        = 73;
    data[63]       = 91;
    data[64]       = 13;
    out[64]        = 99;
    ring[0].status = RX_WHOLE | RX_ERROR | 68;
    ring[1].status = 0x02000000 | 68; # A fragment cannot be delivered as a frame.
    ring[2].status = RX_WHOLE | 1519;
    ring[3].status = RX_WHOLE | 17;
    ring[4].status = RX_WHOLE | 69; # Larger than the caller's buffer after CRC removal.
    ring[5].status = RX_WHOLE | 68;
    if (receive_frame((?n)::u64, ?out[0], 64) != 64 || n.rx_next != 6 ||
        out[0] != 73 || out[63] != 91 || out[64] != 99) { ret 1; }
    if (ring[0].status != (OWN | 2048) || ring[5].status != (OWN | 2048) ||
        ring[5].addr != n.rx_pa[5] || receive_frame((?n)::u64, ?out[0], 64) != 0) { ret 2; }
    n.rx_next       = 31;
    ring[31].status = RX_WHOLE | 18;
    if (receive_frame((?n)::u64, ?out[0], 64) != 14 || n.rx_next != 0 ||
        ring[31].status != (OWN | EOR | 2048)) { ret 3; }
    i = 0;
    for (i < RING) {
        ring[i].status = RX_ERROR;
        i              = i + 1;
    }
    if (receive_frame((?n)::u64, ?out[0], 64) != 0 || n.rx_next != 0)                 { ret 4; }
    if (receive_frame(0, ?out[0], 64) != 0 || receive_frame((?n)::u64, nil, 64) != 0) { ret 5; }
    ret 0;
}

test rtl8125__link_status_and_access_timeout {
    var n:    Nic;
    var regs: [64]u32;
    n.regs    = (?regs[0])::u64;
    n.running = 1;
    if (device_link((?n)::u64) != 0 || device_speed((?n)::u64) != 0) { ret 1; }
    regs[27] = 0x0402;
    if (device_link((?n)::u64) == 0 || device_speed((?n)::u64) != 2500) { ret 2; }
    regs[27] = 0x12;
    if (device_speed((?n)::u64) != 1000) { ret 3; }
    regs[27] = 0x0a;
    if (device_speed((?n)::u64) != 100) { ret 4; }
    regs[27] = 0x06;
    if (device_speed((?n)::u64) != 10 || device_link(0) != 0) { ret 5; }
    # A stuck PHY transaction latches failure and suppresses further commands.
    if (phy_read(?n, 0xa420) != 0 || n.failed == 0) { ret 6; }
    val before: u32 = regs[46];
    phy_write(?n, 0xa400, 0x9200);
    if (regs[46] != before) { ret 7; }
    ret 0;
}
