# dmesg [-t] [-x] [-r] [-l LEVEL] [-w] [-c|-C]: the kernel's log
#   -t        no timestamps
#   -x        show each line's level (err, warn, info, ...)
#   -r        raw: the records as the kernel gives them
#   -l LEVEL  only LEVEL and more urgent (emerg alert crit err warn notice
#             info debug, or 0-7)
#   -w        keep printing new lines as they come (^C stops)
#   -c        clear the log after printing it (root);  -C  clear only
# on a terminal, errors are red and warnings yellow

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;
use system: userland.lib.system;

var buf: [524288]u8;
var no_time: u8 = 0;
var levels: u8 = 0;
var raw: u8 = 0;
var max_level: u64 = 7;
var color: u8 = 0;
var next: u64 = 0;     # the sequence number after the last line shown

val NAMES: [8]*u8 = [8]*u8{"emerg\0", "alert\0", "crit\0", "err\0", "warn\0", "notice\0", "info\0", "debug\0"};

fun level_of(s: *u8) u64 {
    if (s[0] >= 48 && s[0] <= 55 && s[1] == 0) { ret (s[0] - 48)::u64; }
    var i: u64 = 0;
    for (i < 8) {
        if (io.streq(s, NAMES[i]) != 0) { ret i; }
        i = i + 1;
    }
    if (io.streq(s, "error\0") != 0) { ret 3; }
    if (io.streq(s, "warning\0") != 0) { ret 4; }
    ret 99;
}

fun digits(p: *u8, at: *u64, end: u64) u64 {
    var v: u64 = 0;
    for (@at < end && p[@at] >= 48 && p[@at] <= 57) {
        v = v * 10 + (p[@at] - 48)::u64;
        @at = @at + 1;
    }
    ret v;
}

# show buf[0..n): lines "<L>seq,us;text"
fun show(n: u64) {
    var i: u64 = 0;
    for (i < n) {
        var e: u64 = i;
        for (e < n && buf[e] != 10) { e = e + 1; }
        if (raw != 0) {
            io.outn(?buf[i], e - i + 1);
        } or (e - i > 3 && buf[i] == 60) {
            var at: u64 = i + 1;
            val lv: u64 = digits(?buf[0], ?at, e);
            at = at + 1; # >
            val seq: u64 = digits(?buf[0], ?at, e);
            at = at + 1; # ,
            val us: u64 = digits(?buf[0], ?at, e);
            at = at + 1; # ;
            if (seq >= next && lv <= max_level) {
                var paint: u8 = 0;
                if (color != 0 && lv <= 3) { io.out("\x1b[91m\0"); paint = 1; }
                or (color != 0 && lv == 4) { io.out("\x1b[93m\0"); paint = 1; }
                if (no_time == 0) {
                    if (color != 0 && paint == 0) { io.out("\x1b[90m\0"); }
                    io.putc(91);
                    io.dec_pad(us / 1000000, 5);
                    io.putc(46);
                    var frac: [6]u8;
                    var x: u64 = us % 1000000;
                    var k: u64 = 6;
                    for (k > 0) {
                        k = k - 1;
                        frac[k] = 48 + (x % 10)::u8;
                        x = x / 10;
                    }
                    io.outn(?frac[0], 6);
                    io.out("] \0");
                    if (color != 0 && paint == 0) { io.out("\x1b[0m\0"); }
                }
                if (levels != 0) {
                    io.out(NAMES[lv]);
                    var p: u64 = io.len(NAMES[lv]);
                    for (p < 7) {
                        io.putc(32);
                        p = p + 1;
                    }
                    io.out(": \0");
                }
                io.outn(?buf[at], e - at);
                if (paint != 0) { io.out("\x1b[0m\0"); }
                io.putc(10);
            }
            if (seq >= next) { next = seq + 1; }
        }
        i = e + 1;
    }
}

# writing to /proc/kmsg empties the log (root only); whether it worked
fun clear_log() u8 {
    val h: i64 = io.open_mode("/proc/kmsg", os.O_WRONLY, 0);
    if (h < 0) { ret 0; }
    val r: i64 = io.write(h, "c", 1);
    io.close(h);
    ret (r > 0)::u8;
}

fun usage() u64 {
    io.err("usage: dmesg [-t] [-x] [-r] [-l LEVEL] [-w] [-c|-C]\n\0");
    ret 2;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    var follow: u8 = 0;
    var clear: u8 = 0;
    var clear_only: u8 = 0;
    var i: u64 = 1;
    for (i < argc) {
        val a: *u8 = argv[i];
        if (a[0] != 45) { ret usage(); }
        var k: u64 = 1;
        for (a[k] != 0) {
            val c: u8 = a[k];
            if (c == 116) { no_time = 1; }
            or (c == 120) { levels = 1; }
            or (c == 114) { raw = 1; }
            or (c == 119 || c == 102) { follow = 1; }
            or (c == 99) { clear = 1; }
            or (c == 67) { clear_only = 1; }
            or (c == 108) {
                if (i + 1 >= argc) { ret usage(); }
                i = i + 1;
                max_level = level_of(argv[i]);
                if (max_level == 99) {
                    io.err("dmesg: unknown level \0");
                    io.err(argv[i]);
                    io.err("\n\0");
                    ret 2;
                }
                brk;
            } or { ret usage(); }
            k = k + 1;
        }
        i = i + 1;
    }
    if (clear_only != 0) {
        if (clear_log() == 0) {
            io.err("dmesg: only root may clear the log\n\0");
            ret 1;
        }
        ret 0;
    }
    color = io.isatty(io.STDOUT);
    show(system.read_file("/proc/kmsg", ?buf[0], 524288));
    if (clear != 0 && clear_log() == 0) {
        io.err("dmesg: only root may clear the log\n\0");
        ret 1;
    }
    for (follow != 0) {
        io.sleep_ms(200);
        show(system.read_file("/proc/kmsg", ?buf[0], 524288));
    }
    ret 0;
}
