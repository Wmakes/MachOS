# disks through the firmware's Block I/O protocol, and their GPT partitions

use efi: machboot.efi;

pub val MAX_DISKS: u64 = 16;
pub val MAX_PARTS: u64 = 64;

pub rec Disk {
    bio:   *efi.BlockIo;
    bsize: u64;   # bytes per block (512 or 4096)
    last:  u64;   # the last block
}

pub rec Part {
    disk:   *Disk;
    first:  u64;      # in the disk's blocks
    count:  u64;
    kind:   [16]u8;   # the type GUID, as stored
    unique: [16]u8;   # this partition's own GUID
    index:  u64;      # 1-based position in the table
}

var disks: [16]Disk;
var ndisks: u64 = 0;
pub var parts: [64]Part;
pub var nparts: u64 = 0;

var bounce: u64 = 0;        # 64 KiB of pages for reads
val BOUNCE: u64 = 65536;

# n bytes at byte offset `off` of the disk into dst
pub fun read(d: *Disk, off: u64, n: u64, dst: u64) u8 {
    if (bounce == 0) {
        bounce = efi.alloc_pages(BOUNCE / 4096, 0);
        if (bounce == 0) { ret 0; }
    }
    var done: u64 = 0;
    for (done < n) {
        val at: u64 = off + done;
        val lba: u64 = at / d.bsize;
        val skip: u64 = at % d.bsize;
        var want: u64 = n - done + skip;
        if (want > BOUNCE) { want = BOUNCE; }
        val blocks: u64 = (want + d.bsize - 1) / d.bsize;
        if (lba + blocks - 1 > d.last) { ret 0; }
        if (efi.failed(d.bio.read(d.bio, d.bio.media.media_id, lba, blocks * d.bsize, bounce)) != 0) { ret 0; }
        var k: u64 = blocks * d.bsize - skip;
        if (k > n - done) { k = n - done; }
        var i: u64 = 0;
        for (i < k) {
            @((dst + done + i)::*u8) = @((bounce + skip + i)::*u8);
            i = i + 1;
        }
        done = done + k;
    }
    ret 1;
}

fun zero_guid(g: *u8) u8 {
    var i: u64 = 0;
    for (i < 16) {
        if (g[i] != 0) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

# the GPT of disk d into parts[]
fun scan_gpt(d: *Disk) {
    var hdr: [512]u8;
    if (read(d, d.bsize, 512, (?hdr[0])::u64) == 0) { ret; }
    if (hdr[0] != 69 || hdr[1] != 70 || hdr[2] != 73 || hdr[3] != 32) { ret; } # "EFI "
    val entries: u64 = @((?hdr[72])::*u64);
    val count: u64 = (@((?hdr[80])::*u32))::u64;
    val size: u64 = (@((?hdr[84])::*u32))::u64;
    if (size < 128 || size > 512 || count > 1024) { ret; }
    var e: [512]u8;
    var i: u64 = 0;
    for (i < count && nparts < MAX_PARTS) {
        if (read(d, entries * d.bsize + i * size, 128, (?e[0])::u64) == 0) { ret; }
        if (zero_guid(?e[0]) == 0) {
            val p: *Part = ?parts[nparts];
            p.disk = d;
            p.first = @((?e[32])::*u64);
            val last: u64 = @((?e[40])::*u64);
            if (last >= p.first && last <= d.last) {
                p.count = last - p.first + 1;
                var k: u64 = 0;
                for (k < 16) {
                    p.kind[k] = e[k];
                    p.unique[k] = e[16 + k];
                    k = k + 1;
                }
                p.index = i + 1;
                nparts = nparts + 1;
            }
        }
        i = i + 1;
    }
}

# every whole disk the firmware knows, and their partitions
pub fun scan() {
    var g: efi.Guid;
    efi.block_io_guid(?g);
    var n: u64 = 0;
    var handles: u64 = 0;
    if (efi.failed(efi.bs.locate_handle_buffer(2, ?g, 0, ?n, ?handles)) != 0) { ret; }
    var i: u64 = 0;
    for (i < n && ndisks < MAX_DISKS) {
        var bio: u64 = 0;
        val h: u64 = @((handles + i * 8)::*u64);
        if (efi.failed(efi.bs.handle_protocol(h, ?g, ?bio)) == 0 && bio != 0) {
            val b: *efi.BlockIo = bio::*efi.BlockIo;
            val m: *efi.Media = b.media;
            if (m.logical == 0 && m.present != 0 && m.block_size >= 512 && m.block_size <= 4096) {
                val d: *Disk = ?disks[ndisks];
                d.bio = b;
                d.bsize = m.block_size::u64;
                d.last = m.last_block;
                ndisks = ndisks + 1;
                scan_gpt(d);
            }
        }
        i = i + 1;
    }
}

pub fun same(a: *u8, b: *u8, n: u64) u8 {
    var i: u64 = 0;
    for (i < n) {
        if (a[i] != b[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

# the partition machboot was loaded from (its device path's hard-drive
# node gives the start block and, on GPT, the partition GUID), or nil
pub fun boot_partition() *Part {
    var lg: efi.Guid;
    efi.loaded_image_guid(?lg);
    var li: u64 = 0;
    if (efi.failed(efi.bs.handle_protocol(efi.image, ?lg, ?li)) != 0) { ret nil; }
    val img: *efi.LoadedImage = li::*efi.LoadedImage;
    var dg: efi.Guid;
    efi.device_path_guid(?dg);
    var dp: u64 = 0;
    if (efi.failed(efi.bs.handle_protocol(img.device, ?dg, ?dp)) != 0) { ret nil; }
    var node: u64 = dp;
    var guard: u64 = 0;
    for (guard < 64) {
        val t: u8 = @(node::*u8);
        val st: u8 = @((node + 1)::*u8);
        val len: u64 = (@((node + 2)::*u16))::u64;
        if (t == 0x7F || len < 4) { brk; }
        if (t == 4 && st == 1 && len >= 42) { # media: hard drive
            val start: u64 = @((node + 8)::*u64);
            val sig_type: u8 = @((node + 41)::*u8);
            var i: u64 = 0;
            for (i < nparts) {
                val p: *Part = ?parts[i];
                if (sig_type == 2 && same(?p.unique[0], (node + 24)::*u8, 16) != 0) { ret p; }
                if (sig_type != 2 && p.first == start) { ret p; }
                i = i + 1;
            }
        }
        node = node + len;
        guard = guard + 1;
    }
    ret nil;
}
