# umount DIR|DEV: unmount what is mounted on DIR, or the filesystem on DEV
# (e.g. /dev/sdb2), after writing it all back

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc != 2) {
        io.err("usage: umount DIR|DEV\n\0");
        ret 2;
    }
    val r: u64 = sys.umount(argv[1], io.len(argv[1]));
    if (abi.is_err(r) != 0) {
        io.fail("umount\0", argv[1], r);
        ret 1;
    }
    ret 0;
}
