# grep [-v] [-c] TEXT [FILE...]: lines containing TEXT (-v: not containing,
# -c: just count them)

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

var invert: u8 = 0;
var count_only: u8 = 0;
var pat: *u8 = nil;
var plen: u64 = 0;
var matches: u64 = 0;

var buf: [4096]u8;
var line: [4096]u8;

fun contains(s: *u8, n: u64) u8 {
    if (plen == 0) { ret 1; }
    if (plen > n) { ret 0; }
    var i: u64 = 0;
    for (i + plen <= n) {
        if (io.eq(?s[i], plen, pat, plen) != 0) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

fun check(n: u64, name: *u8) {
    var hit: u8 = contains(?line[0], n);
    if (invert != 0) { hit = hit ^ 1; }
    if (hit == 0) { ret; }
    matches = matches + 1;
    if (count_only != 0) { ret; }
    if (name != nil) {
        io.out("\x1b[35m\0");
        io.out(name);
        io.out("\x1b[0m:\0");
    }
    io.outn(?line[0], n);
    io.putc(10);
}

fun scan(h: u64, name: *u8) u8 {
    var n: u64 = 0;
    for {
        val r: u64 = sys.read(h, ?buf[0], 4096);
        if (abi.is_err(r) != 0) {
            io.fail("grep\0", name, r);
            ret 0;
        }
        if (r == 0) { brk; }
        var i: u64 = 0;
        for (i < r) {
            if (buf[i] == 10) {
                check(n, name);
                n = 0;
            } or (n < 4096) {
                line[n] = buf[i];
                n = n + 1;
            }
            i = i + 1;
        }
    }
    if (n > 0) { check(n, name); }
    ret 1;
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var i: u64 = 1;
    for (i < argc && argv[i][0] == 45 && argv[i][1] != 0) {
        if (io.streq(argv[i], "-v\0") != 0) { invert = 1; }
        or (io.streq(argv[i], "-c\0") != 0) { count_only = 1; }
        or {
            io.err("usage: grep [-v] [-c] TEXT [FILE...]\n\0");
            ret 2;
        }
        i = i + 1;
    }
    if (i == argc) {
        io.err("usage: grep [-v] [-c] TEXT [FILE...]\n\0");
        ret 2;
    }
    pat = argv[i];
    plen = io.len(pat);
    i = i + 1;
    var status: u64 = 0;
    if (i == argc) {
        if (scan(abi.STDIN, nil) == 0) { status = 2; }
    } or {
        val many: u8 = (argc - i > 1)::u8;
        for (i < argc) {
            val h: u64 = sys.open(argv[i], io.len(argv[i]), abi.O_READ);
            if (abi.is_err(h) != 0) {
                io.fail("grep\0", argv[i], h);
                status = 2;
            } or {
                var label: *u8 = nil;
                if (many != 0) { label = argv[i]; }
                scan(h, label);
                sys.close(h);
            }
            i = i + 1;
        }
    }
    if (count_only != 0) {
        io.dec(matches);
        io.putc(10);
    }
    if (status != 0) { ret status; }
    if (matches == 0) { ret 1; }
    ret 0;
}
