# posixtest: exercise the POSIX-style system calls; every check prints
# "ok NAME" or "FAIL NAME", and the exit code is the number of failures

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;
use env: sdk.env;

var failures: u64 = 0;

fun check(name: *u8, good: u8) {
    if (good != 0) { io.out("ok \0"); }
    or {
        io.out("FAIL \0");
        failures = failures + 1;
    }
    io.out(name);
    io.putc(10);
}

fun fds() {
    val path: *u8 = "/tmp/posixtest\0";
    val h: u64 = sys.open(path, 14, abi.O_READ | abi.O_WRITE | abi.O_CREATE | abi.O_TRUNC);
    check("open\0", (abi.is_err(h) == 0)::u8);
    io.write_all(h, "0123456789\0", 10);

    check("lseek end\0", (sys.lseek(h, 0, abi.SEEK_END) == 10)::u8);
    check("lseek set\0", (sys.lseek(h, 3, abi.SEEK_SET) == 3)::u8);
    check("lseek cur back\0", (sys.lseek(h, 0 - 1, abi.SEEK_CUR) == 2)::u8);
    var c: [4]u8;
    sys.read(h, ?c[0], 2);
    check("read after lseek\0", (c[0] == 50 && c[1] == 51)::u8);

    var st: abi.Stat;
    check("fstat\0", (sys.fstat(h, ?st) == 0 && st.size == 10 && st.kind == abi.KIND_FILE)::u8);

    val d: u64 = sys.dup(h);
    check("dup gives a new fd\0", (abi.is_err(d) == 0 && d != h)::u8);
    check("dup shares the offset\0", (sys.lseek(d, 0, abi.SEEK_CUR) == 4)::u8);

    check("dup2\0", (sys.dup2(h, 9) == 9)::u8);
    check("dup2 onto itself\0", (sys.dup2(9, 9) == 9)::u8);
    check("F_GETFD starts 0\0", (sys.fcntl(9, abi.F_GETFD, 0) == 0)::u8);
    sys.fcntl(9, abi.F_SETFD, abi.FD_CLOEXEC);
    check("F_SETFD cloexec\0", (sys.fcntl(9, abi.F_GETFD, 0) == abi.FD_CLOEXEC)::u8);
    check("F_GETFL\0", ((sys.fcntl(9, abi.F_GETFL, 0) & abi.O_WRITE) != 0)::u8);
    check("F_DUPFD\0", (sys.fcntl(h, abi.F_DUPFD, 20) == 20)::u8);

    var ends: [2]u64;
    sys.pipe(?ends);
    check("lseek on a pipe fails\0", abi.is_err(sys.lseek(ends[0], 0, abi.SEEK_SET)));
    check("fstat on a pipe\0", (sys.fstat(ends[0], ?st) == 0 && st.kind == abi.KIND_PIPE)::u8);
    check("close a bad fd fails\0", abi.is_err(sys.close(31)));
    sys.remove(path, 14);
}

fun envs() {
    check("HOME came from the parent\0", (env.get("HOME\0") != nil)::u8);
    env.set("POSIXTEST_X\0", "forty two\0");
    val v: *u8 = env.get("POSIXTEST_X\0");
    check("setenv then getenv\0", (v != nil && io.streq(v, "forty two\0") != 0)::u8);
    env.set("POSIXTEST_X\0", "changed\0");
    check("setenv replaces\0", io.streq(env.get("POSIXTEST_X\0"), "changed\0"));
    env.unset("POSIXTEST_X\0");
    check("unsetenv\0", (env.get("POSIXTEST_X\0") == nil)::u8);
}

var shared_x: u64 = 1;

fun processes() {
    val me: u64 = sys.getpid();
    # fork: the child sees 0, the parent the child's pid
    val pid: u64 = sys.fork();
    if (pid == 0) {
        shared_x = 2; # copy-on-write: the parent must not see this
        var code: u64 = 7;
        if (sys.getppid() != me) { code = 99; }
        sys.exit(code);
    }
    check("fork returns a pid\0", (abi.is_err(pid) == 0 && pid != me)::u8);
    var st: u64 = 0;
    check("waitpid returns the pid\0", (sys.waitpid(pid, ?st, 0) == pid)::u8);
    check("exit status 7 (and getppid)\0", (abi.wifexited(st) != 0 && abi.wexitstatus(st) == 7)::u8);
    check("memory is copied on write\0", (shared_x == 1)::u8);
    check("no children left\0", (abi.err_code(sys.waitpid(abi.ANY_CHILD, ?st, 0)) == abi.E_CHILD)::u8);

    # a child killed by a fault reports the signal
    val bad: u64 = sys.fork();
    if (bad == 0) {
        val nowhere: *u64 = 16::*u64;
        @nowhere = 1;
        sys.exit(0);
    }
    sys.waitpid(bad, ?st, 0);
    check("a segfault is SIGSEGV\0", (abi.wifsignaled(st) != 0 && abi.wtermsig(st) == abi.SIGSEGV)::u8);

    # WNOHANG while the child still runs, then ANY_CHILD
    val slow: u64 = sys.fork();
    if (slow == 0) {
        sys.sleep(300);
        sys.exit(3);
    }
    check("WNOHANG returns 0\0", (sys.waitpid(slow, ?st, abi.WNOHANG) == 0)::u8);
    check("ANY_CHILD waits\0", (sys.waitpid(abi.ANY_CHILD, ?st, 0) == slow && abi.wexitstatus(st) == 3)::u8);

    # fds are inherited: a pipe across fork
    var ends: [2]u64;
    sys.pipe(?ends);
    val w: u64 = sys.fork();
    if (w == 0) {
        sys.close(ends[0]);
        io.write_all(ends[1], "through the pipe\0", 16);
        sys.exit(0);
    }
    sys.close(ends[1]);
    var buf: [32]u8;
    var got: u64 = 0;
    for {
        val r: u64 = sys.read(ends[0], ?buf[got], 32 - got);
        if (abi.is_err(r) != 0 || r == 0) { brk; }
        got = got + r;
    }
    sys.close(ends[0]);
    sys.waitpid(w, ?st, 0);
    check("a pipe across fork\0", io.eq(?buf[0], got, "through the pipe\0", 16));

    # fork + execve: the child becomes echo
    val ex: u64 = sys.fork();
    if (ex == 0) {
        # args built piece by piece: mach cuts string literals at an embedded NUL
        var args: [16]u8;
        io.copy(?args[0], "echo\0", 5);
        io.copy(?args[5], "exec-works\0", 11);
        val r: u64 = sys.execve("/bin/echo\0", 9, ?args[0], 16);
        sys.exit(100 + abi.err_code(r));
    }
    sys.waitpid(ex, ?st, 0);
    check("execve ran echo\0", (abi.wifexited(st) != 0 && abi.wexitstatus(st) == 0)::u8);
    check("execve of nothing fails\0", (abi.err_code(sys.execve("/nope\0", 5, nil, 0)) == abi.E_NOENT)::u8);
}

var caught: u64 = 0;
var caught_sig: u64 = 0;

fun on_signal(sig: u64) {
    caught = caught + 1;
    caught_sig = sig;
}

fun on_segv(sig: u64) {
    sys.exit(42); # cannot go back to the faulting instruction
}

fun signals() {
    val me: u64 = sys.getpid();
    sys.signal(abi.SIGUSR1, on_signal::u64);
    var keep: u64 = 12345;
    sys.kill(me, abi.SIGUSR1);
    check("a handler runs\0", (caught == 1 && caught_sig == abi.SIGUSR1)::u8);
    check("registers survive it\0", (keep == 12345)::u8);

    sys.sigprocmask(abi.SIG_BLOCK, abi.sigbit(abi.SIGUSR1));
    sys.kill(me, abi.SIGUSR1);
    check("a blocked signal waits\0", (caught == 1)::u8);
    sys.sigprocmask(abi.SIG_UNBLOCK, abi.sigbit(abi.SIGUSR1));
    check("and arrives when unblocked\0", (caught == 2)::u8);

    sys.signal(abi.SIGUSR2, abi.SIG_IGN);
    sys.kill(me, abi.SIGUSR2);
    check("an ignored signal is ignored\0", 1);

    sys.signal(abi.SIGALRM, on_signal::u64);
    sys.alarm(1);
    val r: u64 = sys.sleep(5000);
    check("alarm interrupts sleep (EINTR)\0", (abi.err_code(r) == abi.E_INTR && caught_sig == abi.SIGALRM)::u8);

    var st: u64 = 0;
    val t: u64 = sys.fork();
    if (t == 0) {
        sys.sleep(5000);
        sys.exit(0);
    }
    sys.kill(t, abi.SIGTERM);
    sys.waitpid(t, ?st, 0);
    check("SIGTERM's default kills\0", (abi.wifsignaled(st) != 0 && abi.wtermsig(st) == abi.SIGTERM)::u8);

    val sv: u64 = sys.fork();
    if (sv == 0) {
        sys.signal(abi.SIGSEGV, on_segv::u64);
        val nowhere: *u64 = 8::*u64;
        @nowhere = 1;
        sys.exit(0);
    }
    sys.waitpid(sv, ?st, 0);
    check("a SIGSEGV handler runs\0", (abi.wifexited(st) != 0 && abi.wexitstatus(st) == 42)::u8);

    var ends: [2]u64;
    sys.pipe(?ends);
    val pw: u64 = sys.fork();
    if (pw == 0) {
        sys.close(ends[0]);
        sys.sleep(100);
        io.write_all(ends[1], "x\0", 1);
        sys.exit(0);
    }
    sys.close(ends[0]);
    sys.close(ends[1]);
    sys.waitpid(pw, ?st, 0);
    check("writing to a dead pipe is SIGPIPE\0", (abi.wifsignaled(st) != 0 && abi.wtermsig(st) == abi.SIGPIPE)::u8);

    val sp: u64 = sys.fork();
    if (sp == 0) {
        sys.setpgid(0, 0);
        for { sys.sleep(1000); }
    }
    sys.sleep(50);
    check("setpgid made a group\0", (sys.getpgid(sp) == sp)::u8);
    sys.kill(sp, abi.SIGSTOP);
    check("WUNTRACED sees the stop\0", (sys.waitpid(sp, ?st, abi.WUNTRACED) == sp && abi.wifstopped(st) != 0 && abi.wstopsig(st) == abi.SIGSTOP)::u8);
    sys.kill(sp, abi.SIGCONT);
    sys.killpg(sp, abi.SIGKILL);
    sys.waitpid(sp, ?st, 0);
    check("killpg reaches the group\0", (abi.wifsignaled(st) != 0 && abi.wtermsig(st) == abi.SIGKILL)::u8);
    sys.signal(abi.SIGUSR1, abi.SIG_DFL);
}

fun permissions() {
    if (sys.getuid() != 0) {
        io.out("(permission checks need root: skipped)\n\0");
        ret;
    }
    # a file of root's in /tmp, which is sticky
    val rf: u64 = sys.open("/tmp/pt_root\0", 12, abi.O_WRITE | abi.O_CREATE);
    sys.close(rf);
    val pid: u64 = sys.fork();
    if (pid == 0) {
        failures = 0;
        check("setgid then setuid to 1000\0", (sys.setgid(1000) == 0 && sys.setuid(1000) == 0 && sys.getuid() == 1000 && sys.geteuid() == 1000)::u8);
        check("setuid back to root fails\0", (abi.err_code(sys.setuid(0)) == abi.E_PERM)::u8);
        check("shadow is not readable\0", (abi.err_code(sys.open("/etc/shadow\0", 11, abi.O_READ)) == abi.E_ACCES)::u8);
        check("access() agrees\0", (sys.access("/etc/passwd\0", 11, abi.R_OK) == 0 && abi.err_code(sys.access("/etc/shadow\0", 11, abi.R_OK)) == abi.E_ACCES)::u8);
        check("cannot create in /\0", (abi.err_code(sys.open("/pt_x\0", 5, abi.O_WRITE | abi.O_CREATE)) == abi.E_ACCES)::u8);
        check("cannot search /root\0", (abi.err_code(sys.chdir("/root\0", 5)) == abi.E_ACCES)::u8);
        sys.umask(0x3F); # 077
        val h: u64 = sys.open("/tmp/pt_user\0", 12, abi.O_WRITE | abi.O_CREATE);
        var st: abi.Stat;
        check("can create in /tmp, umask applies\0", (abi.is_err(h) == 0 && sys.fstat(h, ?st) == 0 && st.mode == 0x180 && st.uid == 1000)::u8);
        sys.close(h);
        check("chmod my own file\0", (sys.chmod("/tmp/pt_user\0", 12, 0x1A4) == 0)::u8);
        check("not root's file\0", (abi.err_code(sys.chmod("/tmp/pt_root\0", 12, 0x1FF)) == abi.E_PERM)::u8);
        check("sticky /tmp keeps root's file\0", (abi.err_code(sys.remove("/tmp/pt_root\0", 12)) == abi.E_PERM)::u8);
        check("but mine can go\0", (sys.remove("/tmp/pt_user\0", 12) == 0)::u8);
        check("chown needs root\0", (abi.err_code(sys.chown("/tmp/pt_root\0", 12, 1000, 1000)) == abi.E_PERM)::u8);
        check("cannot signal init\0", (abi.err_code(sys.kill(1, abi.SIGTERM)) == abi.E_PERM)::u8);
        check("cannot write a raw disk\0", (abi.err_code(sys.open("/dev/sda\0", 8, abi.O_READ)) == abi.E_ACCES)::u8);
        sys.exit(failures);
    }
    var st: u64 = 0;
    sys.waitpid(pid, ?st, 0);
    failures = failures + abi.wexitstatus(st);
    sys.remove("/tmp/pt_root\0", 12);
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    fds();
    envs();
    processes();
    signals();
    permissions();
    io.out("posixtest: \0");
    io.dec(failures);
    io.out(" failures\n\0");
    ret failures;
}
