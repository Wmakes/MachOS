# env [-i] [NAME=value...] [COMMAND [ARG...]]: print the environment, or run
# COMMAND with it changed (-i: starting from nothing)

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use env: sdk.env;
use path: sdk.path;
use rt:  sdk.rt;

var args: [16384]u8;
var envbuf: [16384]u8;

fun is_assignment(w: *u8) u64 {
    var i: u64 = 0;
    for (w[i] != 0) {
        if (w[i] == 61) { ret i; }
        i = i + 1;
    }
    ret 0;
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var i: u64 = 1;
    if (i < argc && io.streq(argv[i], "-i\0") != 0) {
        for (env.size() > 0) {
            val e: *u8 = env.nth(0);
            var k: u64 = 0;
            for (e[k] != 61) { k = k + 1; }
            env.unsetn(e, k);
        }
        i = i + 1;
    }
    for (i < argc) {
        val eq: u64 = is_assignment(argv[i]);
        if (eq == 0) { brk; }
        env.setn(argv[i], eq, ?argv[i][eq + 1], io.len(argv[i]) - eq - 1);
        i = i + 1;
    }
    if (i == argc) {
        var k: u64 = 0;
        for (k < env.size()) {
            io.out(env.nth(k));
            io.putc(10);
            k = k + 1;
        }
        ret 0;
    }
    # COMMAND: through $PATH like the shell
    var full: [256]u8;
    val name: *u8 = argv[i];
    val fl: u64 = path.lookup(name, ?full[0]);
    if (fl == 0) {
        io.err("env: \0");
        io.err(name);
        io.err(": command not found\n\0");
        ret 127;
    }
    var n: u64 = 0;
    for (i < argc) {
        val l: u64 = io.len(argv[i]);
        if (n + l + 1 > 16384) { ret 2; }
        io.copy(?args[n], argv[i], l + 1);
        n = n + l + 1;
        i = i + 1;
    }
    val pid: u64 = sys.spawn(?full[0], fl, ?args[0], n, nil);
    if (abi.is_err(pid) != 0) {
        io.fail("env\0", name, pid);
        ret 126;
    }
    val st: u64 = sys.wait(pid);
    if (abi.is_err(st) != 0) { ret 1; }
    ret st;
}
