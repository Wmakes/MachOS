# system calls (numbers and records in abi/sys.mach). every user pointer is
# checked against the caller's page tables before the kernel touches it

use queue:  machos.kern.queue;
use tcp:    machos.net.tcp;
use socket: machos.net.socket;
use netio:  machos.net.io;
use net:    machos.net.net;
use events: machos.kern.events;
use abi:    sdk.abi;
use idt:    machos.arch.x86_64.idt;
use apic:   machos.arch.x86_64.apic;
use vmm:    machos.mm.vmm;
use pmm:    machos.mm.pmm;
use heap:   machos.mm.heap;
use mem:    machos.kern.mem;
use kprint: machos.kern.kprint;
use proc:   machos.kern.proc;
use pipe:   machos.kern.pipe;
use tty:    machos.kern.tty;
use exec:   machos.kern.exec;
use path:   machos.fs.path;
use vfs:    machos.fs.vfs;
use file:   machos.fs.file;
use blk:    machos.fs.blk;
use clock:  machos.kern.clock;
use mount:  machos.fs.mount;
use parts:  machos.fs.parts;
use dsk:    machos.dev.disk;
use ext2:   machos.fs.ext2;
use power:  machos.kern.power;
use exit:   machos.kern.exit;
use signal: machos.kern.signal;
use version: machos.abi.version;
use cpu:    machos.arch.x86_64.cpu;
use fbcon:  machos.dev.fbcon;
use mmap:   machos.kern.mmap;
use smp:    machos.arch.x86_64.smp;

val ARGS_MAX: u64 = 65536;
val ENV_MAX: u64 = 65536;
val SYNC_EVERY: u64 = 5; # seconds: dirty blocks never wait longer than this

var last_sync: u64 = 0; # tick of the last periodic sync

fun cur() *proc.Proc { ret proc.current(); }

fun ok(va: u64, n: u64, write: u8) u8 {
    if (write != 0 && mmap.denies_write(cur(), va, n) != 0) { ret 0; }
    mmap.touch(cur(), va, n, write); # reserved pages not touched yet get theirs
    ret vmm.user_ok(cur().pml4, va, n, write);
}

fun e(code: u64) u64 { ret abi.err(code); }

# normalize a user path against the cwd into `out` (path.MAX bytes);
# returns its length or an error
fun user_path(va: u64, n: u64, out: *u8) u64 {
    if (n == 0) { ret e(abi.E_NOENT); }
    if (n >= path.MAX) { ret e(abi.E_NAMETOOLONG); }
    if (ok(va, n, 0) == 0) { ret e(abi.E_FAULT); }
    val text: *u8 = va::*u8;
    var component: u64 = 0;
    var i: u64 = 0;
    for (i < n) {
        if (text[i] == 47) { component = 0; }
        or {
            component = component + 1;
            if (component > abi.NAME_MAX) { ret e(abi.E_NAMETOOLONG); }
        }
        i = i + 1;
    }
    val p: *proc.Proc = cur();
    val len: u64 = path.resolve(?p.cwd[0], p.cwd_len, va::*u8, n, out);
    if (len == 0) { ret e(abi.E_NAMETOOLONG); }
    ret len;
}

# the node at a resolved path, or the error why not (E_ACCES when a
# directory on the way may not be searched)
fun find_node(p: *u8, n: u64, out: **vfs.Node) u64 {
    val nd: *vfs.Node = vfs.lookup(p, n);
    if (nd == nil) {
        if (vfs.was_looped() != 0) { ret e(abi.E_LOOP); }
        if (vfs.was_denied() != 0) { ret e(abi.E_ACCES); }
        ret e(abi.E_NOENT);
    }
    @out = nd;
    ret 0;
}

fun is_root() u8 { ret (cur().euid == 0)::u8; }

# may the caller add or remove entries in `dir` (and, for removing `nd`
# from a sticky directory, is it theirs)?
fun may_change(dir: *vfs.Node, nd: *vfs.Node) u64 {
    if (vfs.allowed(dir, abi.W_OK | abi.X_OK) == 0) { ret e(abi.E_ACCES); }
    if (nd != nil && (dir.mode & abi.S_ISVTX) != 0) {
        val me: u64 = cur().euid;
        if (me != 0 && me != nd.uid && me != dir.uid) { ret e(abi.E_PERM); }
    }
    ret 0;
}

fun handle(h: u64) *file.Handle {
    if (h >= abi.MAX_HANDLES) { ret nil; }
    ret cur().handles[h]::*file.Handle;
}

# put `h` in the lowest free fd at or above `from`
fun install_from(h: *file.Handle, from: u64) u64 {
    val p: *proc.Proc = cur();
    var i: u64 = from;
    for (i < abi.MAX_HANDLES) {
        if (p.handles[i] == 0) {
            p.handles[i] = h::u64;
            p.fdflags[i] = 0;
            ret i;
        }
        i = i + 1;
    }
    ret e(abi.E_MFILE);
}

fun install(h: *file.Handle) u64 { ret install_from(h, 0); }

fun set_name(p: *proc.Proc, full: *u8, n: u64) {
    val b: u64 = path.base_index(full, n);
    var k: u64 = n - b;
    if (k > 31) { k = 31; }
    mem.copy((?p.name[0])::u64, (?full[b])::u64, k);
    p.name_len = k;
    events.begin("start \0");
    events.dec(p.pid);
    events.char(32);
    events.textn(?p.name[0], k);
    events.end();
}

pub fun exit_with(code: u64) { exit.exit_with(code); }
pub fun killed_by(sig: u64) { exit.killed_by(sig); }

# create a process running `nd`. hs[i] (a Handle, or 0 for closed) becomes
# its fd i. returns the pid or an error
fun spawn(parent: *proc.Proc, nd: *vfs.Node, full: *u8, full_len: u64,
          args: u64, args_len: u64, env: u64, env_len: u64, hs: *[256]u64, group: u64) u64 {
    if (nd.kind != abi.KIND_FILE || vfs.allowed(nd, abi.X_OK) == 0) { ret e(abi.E_ACCES); }
    val c: *proc.Proc = proc.alloc();
    if (c == nil) { ret e(abi.E_AGAIN); }
    c.umask = 0x12; # 022
    if (parent != nil) {
        c.affinity = proc.current_thread().affinity;
        c.uid = parent.uid;
        c.gid = parent.gid;
        c.euid = parent.euid;
        c.egid = parent.egid;
        c.umask = parent.umask;
        c.ppid = parent.pid;
        mem.copy((?c.cwd[0])::u64, (?parent.cwd[0])::u64, parent.cwd_len);
        c.cwd_len = parent.cwd_len;
    } or {
        c.cwd[0] = 47;
        c.cwd_len = 1;
    }
    if (parent != nil) {
        c.session = parent.session;
        c.sig_mask = parent.sig_mask;
        # ignored signals stay ignored in the new program (like fork + exec)
        var sg: u64 = 0;
        for (sg < abi.NSIG) {
            if (parent.sig_handler[sg] == abi.SIG_IGN) { c.sig_handler[sg] = abi.SIG_IGN; }
            sg = sg + 1;
        }
    } or {
        c.session = c.pid;
    }
    if (group == abi.NEW_GROUP) { c.group = c.pid; }
    or (group == 0 && parent != nil) { c.group = parent.group; }
    or (group == 0) { c.group = c.pid; }
    or { c.group = group; }
    set_name(c, full, full_len);

    var st: exec.Start;
    val r: u64 = exec.load(c, nd, full, full_len, args, args_len, env, env_len, ?st);
    if (abi.is_err(r) != 0) {
        vmm.free_space(c.pml4);
        proc.reap(c);
        ret r;
    }
    setid(c, nd);
    proc.start(c, st.entry, st.rsp, st.argc, st.argv, st.envp);
    var i: u64 = 0;
    for (i < abi.MAX_HANDLES) {
        val h: *file.Handle = (@hs)[i]::*file.Handle;
        if (h != nil) { c.handles[i] = file.dup(h)::u64; }
        i = i + 1;
    }
    ret c.pid;
}

fun env_add(buf: *u8, at: u64, s: *u8) u64 {
    val n: u64 = mem.cstrlen(s);
    mem.copy((?buf[at])::u64, s::u64, n + 1);
    ret at + n + 1;
}

# start pid 1 from `p` with the console as its handles 0-2; in rescue mode
# it gets "rescue" as its argument
pub fun spawn_init(p: *u8, rescue: u8) u64 {
    val n: u64 = mem.cstrlen(p);
    val nd: *vfs.Node = vfs.lookup(p, n);
    if (nd == nil) { ret e(abi.E_NOENT); }
    val con: *vfs.Node = vfs.lookup("/dev/console\0", 12);
    if (con == nil) { ret e(abi.E_NOENT); }
    val h: *file.Handle = file.open_node(con, abi.O_READ | abi.O_WRITE);
    if (h == nil) { ret e(abi.E_NOMEM); }
    var hs: [256]u64;
    mem.fill((?hs[0])::u64, 0, $size_of([256]u64)::u64);
    hs[0] = h::u64;
    hs[1] = h::u64;
    hs[2] = h::u64;
    # the first environment. built piece by piece: mach does not keep a
    # string literal's bytes after an embedded NUL
    var env: [64]u8;
    var el: u64 = 0;
    el = env_add(?env[0], el, "PATH=/bin\0");
    el = env_add(?env[0], el, "HOME=/\0");
    el = env_add(?env[0], el, "TERM=machos\0");
    var args: [32]u8;
    var al: u64 = env_add(?args[0], 0, p);
    if (rescue != 0) { al = env_add(?args[0], al, "rescue\0"); }
    val pid: u64 = spawn(nil, nd, p, n, (?args[0])::u64, al, (?env[0])::u64, el, ?hs, 0);
    file.close(h); # the child holds its own references now
    ret pid;
}

fun sys_spawn(pva: u64, plen: u64, ava: u64, alen: u64, sva: u64) u64 {
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    var nd: *vfs.Node = nil;
    val fr: u64 = find_node(?full[0], n, ?nd);
    if (abi.is_err(fr) != 0) { ret fr; }
    if (nd.kind == abi.KIND_DIR) { ret e(abi.E_ISDIR); }
    if (alen > ARGS_MAX) { ret e(abi.E_INVAL); }
    if (ok(ava, alen, 0) == 0) { ret e(abi.E_FAULT); }

    val p: *proc.Proc = cur();
    if (ok(sva, $size_of(abi.Spawn)::u64, 0) == 0) { ret e(abi.E_FAULT); }
    val sp: *abi.Spawn = sva::*abi.Spawn;
    val env_len: u64 = sp.env_len;
    if (env_len > ENV_MAX) { ret e(abi.E_INVAL); }
    if (env_len > 0 && ok(sp.env::u64, env_len, 0) == 0) { ret e(abi.E_FAULT); }
    var hs: [256]u64;
    val group: u64 = sp.group;
    var i: u64 = 0;
    for (i < abi.MAX_HANDLES) {
        hs[i] = 0;
        if (sp.map_fds == 0 && (p.fdflags[i] & abi.FD_CLOEXEC::u8) == 0) { hs[i] = p.handles[i]; }
        i = i + 1;
    }
    if (sp.map_fds != 0) {
        i = 0;
        for (i < abi.SPAWN_FDS) {
            val idx: u64 = sp.handles[i];
            if (idx < abi.MAX_HANDLES) { hs[i] = p.handles[idx]; }
            i = i + 1;
        }
    }

    # the args, NUL-terminated even if the caller forgot; none -> the path
    var k: u64 = 0;
    var kn: u64 = 0;
    if (alen == 0) {
        kn = n + 1;
        k = heap.alloc(kn);
        if (k == 0) { ret e(abi.E_NOMEM); }
        mem.copy(k, (?full[0])::u64, n);
    } or {
        kn = alen + 1;
        k = heap.alloc(kn);
        if (k == 0) { ret e(abi.E_NOMEM); }
        mem.copy(k, ava, alen);
        if (@((ava + alen - 1)::*u8) == 0) { kn = alen; }
    }
    @((k + kn - 1)::*u8) = 0;
    # the environment, copied in; the last string must end in NUL
    var ek: u64 = 0;
    if (env_len > 0) {
        ek = heap.alloc(env_len + 1);
        if (ek == 0) {
            heap.free(k);
            ret e(abi.E_NOMEM);
        }
        mem.copy(ek, sp.env::u64, env_len);
        @((ek + env_len)::*u8) = 0;
    }
    var el: u64 = env_len;
    if (el > 0 && @((ek + el - 1)::*u8) != 0) { el = el + 1; }
    val r: u64 = spawn(p, nd, ?full[0], n, k, kn, ek, el, ?hs, group);
    heap.free(k);
    heap.free(ek);
    ret r;
}

# waitpid: pid > 0 that child, ANY_CHILD any. returns the pid (and the
# status), 0 under WNOHANG while they all still run, or E_CHILD
fun sys_wait(pid: u64, status: u64, flags: u64) u64 {
    if (status != 0 && ok(status, 8, 1) == 0) { ret e(abi.E_FAULT); }
    val p: *proc.Proc = cur();
    for {
        var any: u8 = 0;
        var i: u64 = 0;
        for (i < proc.MAX) {
            val c: *proc.Proc = proc.slot(i);
            if (c.state != proc.FREE && c.ppid == p.pid && (pid == abi.ANY_CHILD || c.pid == pid)) {
                any = 1;
                if (c.state == proc.STOPPED && c.report_stop != 0 && (flags & abi.WUNTRACED) != 0) {
                    c.report_stop = 0;
                    if (status != 0) { @(status::*u64) = (c.stop_sig << 8) | 0x7F; }
                    ret c.pid;
                }
                if (c.state == proc.ZOMBIE) {
                    val got: u64 = c.pid;
                    if (status != 0) { @(status::*u64) = c.exit_code; }
                    proc.reap(c);
                    ret got;
                }
            }
            i = i + 1;
        }
        if (any == 0) { ret e(abi.E_CHILD); }
        if ((flags & abi.WNOHANG) != 0) { ret 0; }
        if (proc.interrupted(p) != 0) { ret e(abi.E_INTR); }
        proc.sleep_on(p::u64);
    }
    ret 0;
}

# the frame of the system call being served (fork and execve rewrite it)
var frame: *idt.Frame = nil;

fun sys_fork() u64 {
    val p: *proc.Proc = cur();
    val c: *proc.Proc = proc.alloc();
    if (c == nil) { ret e(abi.E_AGAIN); }
    vmm.free_space(c.pml4); # alloc's empty space is replaced by the copy
    c.pml4 = vmm.fork_space(p.pml4);
    cpu.set_cr3(p.pml4); # the parent's pages just turned read-only
    if (c.pml4 == 0) {
        proc.reap(c);
        ret e(abi.E_NOMEM);
    }
    c.ppid = p.pid;
    c.affinity = proc.current_thread().affinity;
    c.group = p.group;
    c.session = p.session;
    c.uid = p.uid;
    c.gid = p.gid;
    c.euid = p.euid;
    c.egid = p.egid;
    c.umask = p.umask;
    c.sig_mask = p.sig_mask;
    c.restorer = p.restorer;
    var sg: u64 = 0;
    for (sg < abi.NSIG) {
        c.sig_handler[sg] = p.sig_handler[sg];
        c.sig_hmask[sg] = p.sig_hmask[sg];
        sg = sg + 1;
    }
    c.brk = p.brk;
    c.brk_base = p.brk_base;
    c.mmap_next = p.mmap_next;
    if (mmap.copy_regions(c, p) == 0) {
        vmm.free_space(c.pml4);
        proc.reap(c);
        ret e(abi.E_NOMEM);
    }
    c.pages = p.pages;
    mem.copy((?c.cwd[0])::u64, (?p.cwd[0])::u64, p.cwd_len);
    c.cwd_len = p.cwd_len;
    mem.copy((?c.name[0])::u64, (?p.name[0])::u64, p.name_len);
    c.name_len = p.name_len;
    var i: u64 = 0;
    for (i < abi.MAX_HANDLES) {
        if (p.handles[i] != 0) { c.handles[i] = file.dup(p.handles[i]::*file.Handle)::u64; }
        c.fdflags[i] = p.fdflags[i];
        i = i + 1;
    }
    c.fsbase = proc.current_thread().fsbase;
    proc.start_copy(c, frame);
    ret c.pid;
}

# copy user bytes in, NUL-terminating (one more byte when the last is not NUL)
fun copy_in(va: u64, n: u64, out: *u64, out_len: *u64) u64 {
    @out = 0;
    @out_len = 0;
    if (n == 0) { ret 0; }
    if (ok(va, n, 0) == 0) { ret e(abi.E_FAULT); }
    val k: u64 = heap.alloc(n + 1);
    if (k == 0) { ret e(abi.E_NOMEM); }
    mem.copy(k, va, n);
    var kn: u64 = n;
    if (@((k + n - 1)::*u8) != 0) {
        @((k + n)::*u8) = 0;
        kn = n + 1;
    }
    @out = k;
    @out_len = kn;
    ret 0;
}

# a set-user-id / set-group-id program runs as its file's owner / group
# (not a #! script: its interpreter would carry the power)
fun setid(p: *proc.Proc, nd: *vfs.Node) {
    if ((nd.mode & (abi.S_ISUID | abi.S_ISGID)) == 0) { ret; }
    var head: [2]u8;
    if (vfs.read(nd, 0, (?head[0])::u64, 2) == 2 && head[0] == 35 && head[1] == 33) { ret; }
    if ((nd.mode & abi.S_ISUID) != 0) { p.euid = nd.uid; }
    if ((nd.mode & abi.S_ISGID) != 0) { p.egid = nd.gid; }
}

fun sys_execve(pva: u64, plen: u64, ava: u64, alen: u64, eva: u64) u64 {
    # only the first thread may: the program replaced is the process's
    if (proc.current_thread() != cur()) { ret e(abi.E_BUSY); }
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    var nd: *vfs.Node = nil;
    val fr: u64 = find_node(?full[0], n, ?nd);
    if (abi.is_err(fr) != 0) { ret fr; }
    if (nd.kind == abi.KIND_DIR) { ret e(abi.E_ISDIR); }
    if (nd.kind != abi.KIND_FILE || vfs.allowed(nd, abi.X_OK) == 0) { ret e(abi.E_ACCES); }
    if (alen > ARGS_MAX) { ret e(abi.E_INVAL); }
    # the environment is NUL-separated strings ending in an empty one
    var elen: u64 = 0;
    if (eva != 0) {
        for (elen < ENV_MAX) {
            if (ok(eva + elen, 1, 0) == 0) { ret e(abi.E_FAULT); }
            if (@((eva + elen)::*u8) == 0 && (elen == 0 || @((eva + elen - 1)::*u8) == 0)) { brk; }
            elen = elen + 1;
        }
    }
    var args: u64 = 0;
    var args_len: u64 = 0;
    var r: u64 = copy_in(ava, alen, ?args, ?args_len);
    if (abi.is_err(r) != 0) { ret r; }
    if (args_len == 0) { # no arguments: the path is argv[0]
        args = heap.alloc(n + 1);
        if (args == 0) { ret e(abi.E_NOMEM); }
        mem.copy(args, (?full[0])::u64, n);
        @((args + n)::*u8) = 0;
        args_len = n + 1;
    }
    var env: u64 = 0;
    var env_len: u64 = 0;
    r = copy_in(eva, elen, ?env, ?env_len);
    if (abi.is_err(r) != 0) {
        heap.free(args);
        ret r;
    }

    # load into a fresh address space; the old one stays until that worked
    val p: *proc.Proc = cur();
    val old: u64 = p.pml4;
    val old_pages: u64 = p.pages;
    val fresh: u64 = vmm.new_space();
    if (fresh == 0) {
        heap.free(args);
        heap.free(env);
        ret e(abi.E_NOMEM);
    }
    p.pml4 = fresh;
    p.pages = 0;
    var st: exec.Start;
    r = exec.load(p, nd, ?full[0], n, args, args_len, env, env_len, ?st);
    heap.free(args);
    heap.free(env);
    if (abi.is_err(r) != 0) {
        p.pml4 = old;
        p.pages = old_pages;
        vmm.free_space(fresh);
        ret r;
    }
    # the other threads ran in the old program: they end with it
    proc.end_other_threads();
    proc.current_thread().fsbase = 0;
    cpu.wrmsr(0xC0000100, 0);
    cpu.set_cr3(fresh);
    vmm.free_space(old);
    set_name(p, ?full[0], n);
    setid(p, nd);
    var i: u64 = 0;
    for (i < abi.MAX_HANDLES) {
        if (p.handles[i] != 0 && (p.fdflags[i] & abi.FD_CLOEXEC::u8) != 0) {
            file.close(p.handles[i]::*file.Handle);
            p.handles[i] = 0;
            p.fdflags[i] = 0;
        }
        i = i + 1;
    }
    # caught signals go back to their defaults (the handlers are gone);
    # ignored ones stay ignored
    var sg: u64 = 0;
    for (sg < abi.NSIG) {
        if (p.sig_handler[sg] > 1) { p.sig_handler[sg] = abi.SIG_DFL; }
        sg = sg + 1;
    }
    p.alarm_at = 0;
    # start over: the frame now returns into the new program
    val f: *idt.Frame = frame;
    mem.fill(f::u64, 0, 15 * 8); # r15 ... rax
    f.rip = st.entry;
    f.rsp = st.rsp;
    f.rdi = st.argc;
    f.rsi = st.argv;
    f.rdx = st.envp;
    f.rflags = 0x202;
    val fpu: u64 = f::u64 - idt.FPU_AREA;
    mem.fill(fpu, 0, idt.FPU_AREA);
    @(fpu::*u16) = 0x037F;
    @((fpu + 24)::*u32) = 0x1F80;
    ret 0;
}

fun sys_open(pva: u64, plen: u64, flags: u64, mode: u64) u64 {
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    var f: u64 = flags;
    if ((f & abi.O_METADATA) == 0 && (f & (abi.O_READ | abi.O_WRITE)) == 0) { f = f | abi.O_READ; }
    if ((f & abi.O_METADATA) != 0) {
        if ((f & (abi.O_CREATE | abi.O_TRUNC | abi.O_WRITE)) != 0) { ret e(abi.E_INVAL); }
        f = f & ~abi.O_READ;
    }
    var nd: *vfs.Node = vfs.lookup_mode(?full[0], n, ((flags & abi.O_NOFOLLOW) == 0)::u8);
    if (nd != nil && nd.kind == abi.KIND_LINK && (f & abi.O_METADATA) == 0) { ret e(abi.E_LOOP); }
    if (nd != nil && (flags & (abi.O_CREATE | abi.O_EXCL)) == (abi.O_CREATE | abi.O_EXCL)) { ret e(abi.E_EXIST); }
    if (nd != nil && (flags & abi.O_DIRECTORY) != 0 && nd.kind != abi.KIND_DIR) { ret e(abi.E_NOTDIR); }
    if (nd == nil) {
        if (vfs.was_looped() != 0) { ret e(abi.E_LOOP); }
        if (vfs.was_denied() != 0) { ret e(abi.E_ACCES); }
        if ((flags & abi.O_CREATE) == 0 || (flags & abi.O_DIRECTORY) != 0) { ret e(abi.E_NOENT); }
        val dir: *vfs.Node = vfs.parent_dir(?full[0], n);
        if (dir == nil) { ret e(abi.E_NOENT); }
        val ch: u64 = may_change(dir, nil);
        if (abi.is_err(ch) != 0) { ret ch; }
        val b: u64 = path.base_index(?full[0], n);
        val cr: u64 = vfs.create(dir, ?full[b], n - b, abi.KIND_FILE, mode & ~cur().umask & 0xFFF, ?nd);
        if (abi.is_err(cr) != 0) { ret cr; }
    } or {
        var want: u64 = 0;
        if ((f & abi.O_METADATA_READ) != 0) { want = abi.R_OK; }
        if ((f & abi.O_READ) != 0) { want = want | abi.R_OK; }
        if ((f & abi.O_WRITE) != 0) { want = want | abi.W_OK; }
        if (vfs.allowed(nd, want) == 0) { ret e(abi.E_ACCES); }
    }
    if (nd.kind == abi.KIND_DIR && (f & abi.O_WRITE) != 0) { ret e(abi.E_ISDIR); }
    if (nd.kind == abi.KIND_FILE && (f & abi.O_TRUNC) != 0 && (f & abi.O_WRITE) != 0) {
        vfs.truncate(nd);
    }
    val h: *file.Handle = file.open_node(nd, f);
    if (h == nil) { ret e(abi.E_NOMEM); }
    val idx: u64 = install(h);
    if (abi.is_err(idx) != 0) { file.close(h); }
    or ((flags & abi.O_CLOEXEC) != 0) { cur().fdflags[idx] = abi.FD_CLOEXEC::u8; }
    ret idx;
}

fun sys_close(h: u64) u64 {
    val f: *file.Handle = handle(h);
    if (f == nil) { ret e(abi.E_BADF); }
    cur().handles[h] = 0;
    cur().fdflags[h] = 0;
    file.close(f);
    ret 0;
}

fun sys_readdir(h: u64, idx: u64, out: u64) u64 {
    val f: *file.Handle = handle(h);
    if (f == nil || f.kind != file.NODE) { ret e(abi.E_BADF); }
    if (f.node.kind != abi.KIND_DIR) { ret e(abi.E_NOTDIR); }
    if (ok(out, $size_of(abi.Entry)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    val c: *vfs.Node = vfs.nth_child(f.node, idx);
    if (c == nil) { ret 0; }
    val en: *abi.Entry = out::*abi.Entry;
    en.kind = c.kind;
    en.size = c.size;
    en.mtime = vfs.mtime_of(c);
    en.mode = c.mode;
    en.uid = c.uid;
    en.gid = c.gid;
    en.name_len = c.name_len;
    if (en.name_len > 59) { en.name_len = 59; }
    mem.copy((?en.name[0])::u64, (?c.name[0])::u64, en.name_len);
    ret 1;
}

fun sys_stat(pva: u64, plen: u64, out: u64, flags: u64) u64 {
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    if (ok(out, $size_of(abi.Stat)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    var nd: *vfs.Node = nil;
    nd = vfs.lookup_mode(?full[0], n, ((flags & abi.O_NOFOLLOW) == 0)::u8);
    var fr: u64 = 0;
    if (nd == nil) { fr = e(abi.E_NOENT); if (vfs.was_looped() != 0) { fr = e(abi.E_LOOP); } if (vfs.was_denied() != 0) { fr = e(abi.E_ACCES); } }
    if (abi.is_err(fr) != 0) { ret fr; }
    fill_stat(nd, out::*abi.Stat);
    ret 0;
}

fun fill_stat(nd: *vfs.Node, st: *abi.Stat) {
    st.sector = 0;
    st.rdev = 0;
    if (nd.kind == abi.KIND_DEV) {
        st.rdev = nd.dev;
        val bd: *parts.Bdev = parts.get(nd.dev);
        if (bd != nil) { st.sector = dsk.disk(bd.disk).native; }
    }
    st.kind = nd.kind;
    st.size = nd.size;
    st.mtime = vfs.mtime_of(nd);
    st.mode = nd.mode;
    st.uid = nd.uid;
    st.gid = nd.gid;
    # which file: ext2 has inode numbers; elsewhere the node itself names it
    # for as long as it is in the tree
    st.dev = nd.fs + 1;
    st.ino = nd::u64;
    if (nd.fs == vfs.FS_EXT2) {
        st.dev = nd.fsi::u64;
        st.ino = nd.ino;
    }
    st.nlink = 1;
    if (nd.unlinked != 0) { st.nlink = 0; }
}

fun sys_mkdir(pva: u64, plen: u64, mode: u64) u64 {
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    if (vfs.lookup(?full[0], n) != nil) { ret e(abi.E_EXIST); }
    if (vfs.was_denied() != 0) { ret e(abi.E_ACCES); }
    val dir: *vfs.Node = vfs.parent_dir(?full[0], n);
    if (dir == nil) { ret e(abi.E_NOENT); }
    val ch: u64 = may_change(dir, nil);
    if (abi.is_err(ch) != 0) { ret ch; }
    val b: u64 = path.base_index(?full[0], n);
    var made: *vfs.Node = nil;
    ret vfs.create(dir, ?full[b], n - b, abi.KIND_DIR, mode & ~cur().umask & 0xFFF, ?made);
}

fun sys_remove(pva: u64, plen: u64) u64 {
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    var nd: *vfs.Node = nil;
    nd = vfs.lookup_mode(?full[0], n, 0);
    var fr: u64 = 0;
    if (nd == nil) { fr = e(abi.E_NOENT); }
    if (abi.is_err(fr) != 0) { ret fr; }
    if (nd.parent != nil) {
        val ch: u64 = may_change(nd.parent, nd);
        if (abi.is_err(ch) != 0) { ret ch; }
    }
    ret vfs.unlink(nd);
}

fun sys_chmod(pva: u64, plen: u64, mode: u64, nofollow: u64) u64 {
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    var nd: *vfs.Node = nil;
    nd = vfs.lookup_mode(?full[0], n, (nofollow == 0)::u8);
    var fr: u64 = 0;
    if (nd == nil) { fr = e(abi.E_NOENT); }
    if (nd != nil && nd.kind == abi.KIND_LINK) { ret e(abi.E_NOTSUP); }
    if (abi.is_err(fr) != 0) { ret fr; }
    if (is_root() == 0 && cur().euid != nd.uid) { ret e(abi.E_PERM); }
    vfs.set_attr(nd, mode & 0xFFF, nd.uid, nd.gid);
    ret 0;
}

fun sys_chown(pva: u64, plen: u64, uid: u64, gid: u64) u64 {
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    var nd: *vfs.Node = nil;
    val fr: u64 = find_node(?full[0], n, ?nd);
    if (abi.is_err(fr) != 0) { ret fr; }
    if (is_root() == 0) { ret e(abi.E_PERM); }
    var u: u64 = uid;
    var g: u64 = gid;
    if (u == abi.NO_ID) { u = nd.uid; }
    if (g == abi.NO_ID) { g = nd.gid; }
    # a new owner loses the set-id bits, as on every Unix
    vfs.set_attr(nd, nd.mode & ~(abi.S_ISUID | abi.S_ISGID), u, g);
    ret 0;
}

fun sys_access(pva: u64, plen: u64, want: u64) u64 {
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    var nd: *vfs.Node = nil;
    val fr: u64 = find_node(?full[0], n, ?nd);
    if (abi.is_err(fr) != 0) { ret fr; }
    val p: *proc.Proc = cur();
    if (vfs.allowed_as(nd, want & 7, p.uid, p.gid) == 0) { ret e(abi.E_ACCES); }
    ret 0;
}

fun sys_setuid(uid: u64) u64 {
    val p: *proc.Proc = cur();
    if (p.euid == 0) {
        p.uid = uid;
        p.euid = uid;
        ret 0;
    }
    if (uid == p.uid) {
        p.euid = uid;
        ret 0;
    }
    ret e(abi.E_PERM);
}

fun sys_setgid(gid: u64) u64 {
    val p: *proc.Proc = cur();
    if (p.euid == 0) {
        p.gid = gid;
        p.egid = gid;
        ret 0;
    }
    if (gid == p.gid) {
        p.egid = gid;
        ret 0;
    }
    ret e(abi.E_PERM);
}

fun sys_rename(fva: u64, flen: u64, tva: u64, tlen: u64) u64 {
    var from: [512]u8;
    var to: [512]u8;
    val fnl: u64 = user_path(fva, flen, ?from[0]);
    if (abi.is_err(fnl) != 0) { ret fnl; }
    val tnl: u64 = user_path(tva, tlen, ?to[0]);
    if (abi.is_err(tnl) != 0) { ret tnl; }
    var src: *vfs.Node = nil;
    src = vfs.lookup_mode(?from[0], fnl, 0);
    var fr: u64 = 0;
    if (src == nil) { fr = e(abi.E_NOENT); }
    if (abi.is_err(fr) != 0) { ret fr; }
    val displaced: *vfs.Node = vfs.lookup_mode(?to[0], tnl, 0);
    val dir: *vfs.Node = vfs.parent_dir(?to[0], tnl);
    if (dir == nil) { ret e(abi.E_NOENT); }
    if (src.parent != nil) {
        val c1: u64 = may_change(src.parent, src);
        if (abi.is_err(c1) != 0) { ret c1; }
    }
    val c2: u64 = may_change(dir, nil);
    if (abi.is_err(c2) != 0) { ret c2; }
    if (displaced != nil) {
        val allowed: u64 = may_change(dir, displaced);
        if (abi.is_err(allowed) != 0) { ret allowed; }
        ret vfs.replace(src, displaced);
    }
    val b: u64 = path.base_index(?to[0], tnl);
    ret vfs.rename(src, dir, ?to[b], tnl - b);
}

fun sys_chdir(pva: u64, plen: u64) u64 {
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    var nd: *vfs.Node = nil;
    val fr: u64 = find_node(?full[0], n, ?nd);
    if (abi.is_err(fr) != 0) { ret fr; }
    if (nd.kind != abi.KIND_DIR) { ret e(abi.E_NOTDIR); }
    if (vfs.allowed(nd, abi.X_OK) == 0) { ret e(abi.E_ACCES); }
    val p: *proc.Proc = cur();
    mem.copy((?p.cwd[0])::u64, (?full[0])::u64, n);
    p.cwd_len = n;
    ret 0;
}

fun sys_getcwd(buf: u64, len: u64) u64 {
    val p: *proc.Proc = cur();
    var n: u64 = p.cwd_len;
    if (n > len) { n = len; }
    if (ok(buf, n, 1) == 0) { ret e(abi.E_FAULT); }
    mem.copy(buf, (?p.cwd[0])::u64, n);
    ret p.cwd_len;
}

fun sys_pipe(out: u64) u64 {
    if (ok(out, 16, 1) == 0) { ret e(abi.E_FAULT); }
    val pp: *pipe.Pipe = pipe.new();
    if (pp == nil) { ret e(abi.E_NOMEM); }
    var r: *file.Handle = nil;
    var w: *file.Handle = nil;
    if (file.pipe_ends(pp, ?r, ?w) == 0) {
        pipe.close_reader(pp);
        pipe.close_writer(pp);
        ret e(abi.E_NOMEM);
    }
    val ri: u64 = install(r);
    if (abi.is_err(ri) != 0) {
        file.close(r);
        file.close(w);
        ret ri;
    }
    val wi: u64 = install(w);
    if (abi.is_err(wi) != 0) {
        cur().handles[ri] = 0;
        file.close(r);
        file.close(w);
        ret wi;
    }
    val o: *u64 = out::*u64;
    o[0] = ri;
    o[1] = wi;
    ret 0;
}

fun sys_info(out: u64) u64 {
    if (ok(out, $size_of(abi.Info)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    val i: *abi.Info = out::*abi.Info;
    i.mem_total = pmm.total_pages() * 4096;
    i.mem_free = pmm.free_pages() * 4096;
    i.heap_used = heap.used();
    i.uptime_ms = proc.uptime_ticks() * 1000 / apic.HZ;
    i.procs = proc.count();
    i.cpus = smp.online();
    i.screen_w = fbcon.width_of();
    i.screen_h = fbcon.height_of();
    cpu.brand(?i.cpu_name[0]);
    var c: u64 = 0;
    for (c < 16) {
        i.cpu_busy[c] = proc.busy_ticks(c);
        i.cpu_ticks[c] = proc.all_ticks(c);
        c = c + 1;
    }
    ret 0;
}

fun sys_procs(idx: u64, out: u64) u64 {
    if (ok(out, $size_of(abi.ProcInfo)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    var seen: u64 = 0;
    var i: u64 = 0;
    for (i < proc.MAX) {
        val p: *proc.Proc = proc.slot(i);
        if (p.state != proc.FREE && p.leader == nil) {
            if (seen == idx) {
                val pi: *abi.ProcInfo = out::*abi.ProcInfo;
                pi.pid = p.pid;
                pi.uid = p.uid;
                pi.ppid = p.ppid;
                pi.group = p.group;
                pi.state = p.state;
                pi.pages = p.pages;
                pi.cpu_ticks = p.cpu_ticks;
                pi.name_len = p.name_len;
                mem.copy((?pi.name[0])::u64, (?p.name[0])::u64, p.name_len);
                ret 1;
            }
            seen = seen + 1;
        }
        i = i + 1;
    }
    ret 0;
}

# root may signal anyone; others, processes of their own (real) user
fun may_signal(me: *proc.Proc, p: *proc.Proc) u8 {
    if (me.euid == 0 || me.uid == p.uid || me.euid == p.uid) { ret 1; }
    ret 0;
}

# pid > 0: that process, 0: my group, -1: everyone but init and me,
# -g: group g. signal 0 only checks that the target exists
fun sys_kill(pid: u64, sig: u64) u64 {
    if (sig >= abi.NSIG) { ret e(abi.E_INVAL); }
    val me: *proc.Proc = cur();
    var group: u64 = 0;
    if (pid == 0) { group = me.group; }
    or (pid >= 0x8000000000000000) { group = 0 - pid; } # negative: a group (or -1)
    if (pid != 0 && pid < 0x8000000000000000) {
        val p: *proc.Proc = proc.find(pid);
        if (p == nil || p.state == proc.ZOMBIE) { ret e(abi.E_SRCH); }
        if (p.pid == 1 && sig != 0) { ret e(abi.E_PERM); }
        if (may_signal(me, p) == 0) { ret e(abi.E_PERM); }
        if (sig != 0) { proc.send(p, sig); }
        ret 0;
    }
    var found: u64 = 0;
    var i: u64 = 0;
    for (i < proc.MAX) {
        val p: *proc.Proc = proc.slot(i);
        if (p.state != proc.FREE && p.state != proc.ZOMBIE && p.pid != 1 && p.leader == nil) {
            if (((group == 1 && p != me) || (group != 1 && p.group == group)) && may_signal(me, p) != 0) {
                found = found + 1;
                if (sig != 0) { proc.send(p, sig); }
            }
        }
        i = i + 1;
    }
    if (found == 0) { ret e(abi.E_SRCH); }
    ret 0;
}

fun sys_sigaction(sig: u64, handler: u64, restorer: u64, mask: u64) u64 {
    if (sig == 0 || sig >= abi.NSIG || sig == abi.SIGKILL || sig == abi.SIGSTOP) { ret e(abi.E_INVAL); }
    if (handler > 1 && handler >= vmm.USER_END) { ret e(abi.E_FAULT); }
    val p: *proc.Proc = cur();
    val old: u64 = p.sig_handler[sig];
    p.sig_handler[sig] = handler;
    p.sig_hmask[sig] = mask;
    if (restorer != 0) { p.restorer = restorer; }
    # ignoring a signal drops it if it waits
    if (handler == abi.SIG_IGN) { p.sig_pending = p.sig_pending & ~abi.sigbit(sig); }
    ret old;
}

fun sys_sigprocmask(how: u64, set: u64) u64 {
    val p: *proc.Proc = cur();
    val old: u64 = p.sig_mask;
    if (how == abi.SIG_BLOCK) { p.sig_mask = old | set; }
    or (how == abi.SIG_UNBLOCK) { p.sig_mask = old & ~set; }
    or (how == abi.SIG_SETMASK) { p.sig_mask = set; }
    or { ret e(abi.E_INVAL); }
    p.sig_mask = p.sig_mask & ~(abi.sigbit(abi.SIGKILL) | abi.sigbit(abi.SIGSTOP));
    ret old;
}

fun sys_alarm(seconds: u64) u64 {
    val p: *proc.Proc = cur();
    var left: u64 = 0;
    val now: u64 = proc.uptime_ticks();
    if (p.alarm_at > now) { left = (p.alarm_at - now + apic.HZ - 1) / apic.HZ; }
    p.alarm_at = 0;
    if (seconds > 0) { p.alarm_at = now + seconds * apic.HZ; }
    ret left;
}

fun sys_setpgid(pid: u64, pgid: u64) u64 {
    val me: *proc.Proc = cur();
    var p: *proc.Proc = me;
    if (pid != 0) {
        p = proc.find(pid);
        if (p == nil) { ret e(abi.E_SRCH); }
        if (p != me && p.ppid != me.pid) { ret e(abi.E_PERM); }
    }
    var g: u64 = pgid;
    if (g == 0) { g = p.pid; }
    p.group = g;
    ret 0;
}

fun sys_getpgid(pid: u64) u64 {
    if (pid == 0) { ret cur().group; }
    val p: *proc.Proc = proc.find(pid);
    if (p == nil) { ret e(abi.E_SRCH); }
    ret p.group;
}

fun sys_setsid() u64 {
    val p: *proc.Proc = cur();
    if (p.group == p.pid) { ret e(abi.E_PERM); } # a group leader cannot
    p.session = p.pid;
    p.group = p.pid;
    ret p.pid;
}

fun sys_sbrk(n: u64) u64 {
    val p: *proc.Proc = cur();
    val old: u64 = p.brk;
    if (n == 0) { ret old; }
    val limit: u64 = mmap.lowest(p) - mmap.GAP; # below the mappings
    if (n > limit || old + n > limit) { ret e(abi.E_NOMEM); }
    var va: u64 = (old + 4095) & ~4095::u64;
    val end: u64 = old + n;
    for (va < end) {
        if (exec.map_user_page(p, va, vmm.W | vmm.NX) == 0) { ret e(abi.E_NOMEM); }
        va = va + 4096;
    }
    p.brk = end;
    ret old;
}

fun sys_mount(dva: u64, dlen: u64, pva: u64, plen: u64) u64 {
    if (is_root() == 0) { ret e(abi.E_PERM); }
    var dp: [512]u8;
    val dn: u64 = user_path(dva, dlen, ?dp[0]);
    if (abi.is_err(dn) != 0) { ret dn; }
    val dev: *vfs.Node = vfs.lookup(?dp[0], dn);
    if (dev == nil) { ret e(abi.E_NOENT); }
    if (dev.kind != abi.KIND_DEV) { ret e(abi.E_INVAL); }
    val b: *parts.Bdev = parts.get(dev.dev);
    if (b == nil) { ret e(abi.E_INVAL); }
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    val at: *vfs.Node = vfs.lookup(?full[0], n);
    if (at == nil) { ret e(abi.E_NOENT); }
    val mr: u64 = mount.mount_at(b, at);
    kprint.level(kprint.INFO);
    kprint.puts("mount: \0");
    var di: u64 = 0;
    for (di < dn) {
        kprint.putc(dp[di]);
        di = di + 1;
    }
    kprint.puts(" on \0");
    var fi: u64 = 0;
    for (fi < n) {
        kprint.putc(full[fi]);
        fi = fi + 1;
    }
    if (abi.is_err(mr) != 0) {
        kprint.puts(" failed: \0");
        kprint.puts(abi.err_name(mr));
    } or {
        events.begin("mount \0");
        events.textn(?dp[0], dn);
        events.char(32);
        events.textn(?full[0], n);
        events.end();
    }
    kprint.putc(10);
    ret mr;
}

fun sys_mounts(idx: u64, out: u64) u64 {
    if (ok(out, $size_of(abi.MountInfo)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    val m: *mount.Mount = mount.nth(idx);
    if (m == nil) { ret 0; }
    val mi: *abi.MountInfo = out::*abi.MountInfo;
    mem.fill(out, 0, $size_of(abi.MountInfo)::u64);
    val b: *parts.Bdev = parts.find(m.disk, m.start);
    if (b != nil) { parts.dev_name(b, ?mi.dev[0]); }
    if (m.root == nil) {
        mi.dir[0] = 47;
    } or {
        var full: [512]u8;
        var length: u64 = vfs.path_of(m.root, ?full[0]);
        if (length > 255) { length = 255; }
        mem.copy((?mi.dir[0])::u64, (?full[0])::u64, length);
    }
    mount.space(m, ?mi.total, ?mi.free);
    val kn: *u8 = mount.kind_name(m);
    mem.copy((?mi.fstype[0])::u64, kn::u64, mem.cstrlen(kn));
    ret 1;
}

fun sys_umount(pva: u64, plen: u64) u64 {
    if (is_root() == 0) { ret e(abi.E_PERM); }
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    val r: *vfs.Node = vfs.lookup(?full[0], n);
    if (r == nil) { ret e(abi.E_NOENT); }
    var res: u64 = 0;
    if (r.kind == abi.KIND_DEV) {
        val b: *parts.Bdev = parts.get(r.dev);
        if (b == nil) { ret e(abi.E_INVAL); }
        res = mount.unmount_dev(b);
    } or {
        res = mount.unmount(r);
    }
    kprint.level(kprint.INFO);
    kprint.puts("umount: \0");
    var i: u64 = 0;
    for (i < n) {
        kprint.putc(full[i]);
        i = i + 1;
    }
    if (abi.is_err(res) != 0) {
        kprint.puts(" failed: \0");
        kprint.puts(abi.err_name(res));
    } or {
        events.begin("umount \0");
        events.textn(?full[0], n);
        events.end();
    }
    kprint.putc(10);
    ret res;
}

fun put_str(dst: *u8, s: *u8) {
    val n: u64 = mem.cstrlen(s);
    mem.copy(dst::u64, s::u64, n);
    dst[n] = 0;
}

fun sys_uname(out: u64) u64 {
    if (ok(out, $size_of(abi.Uname)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    val u: *abi.Uname = out::*abi.Uname;
    put_str(?u.sysname[0], "MachOS\0");
    put_str(?u.release[0], version.VERSION);
    put_str(?u.machine[0], "x86_64\0");
    ret 0;
}

# the terminal behind handle `h` (0 = tty1), or an error (E_NOTTY)
fun tty_handle(h: u64) u64 {
    val f: *file.Handle = handle(h);
    if (f == nil) { ret e(abi.E_BADF); }
    if (f.kind != file.NODE || f.node.kind != abi.KIND_DEV || vfs.tty_of(f.node.dev) == 0xFF) { ret e(abi.E_NOTTY); }
    ret vfs.tty_of(f.node.dev);
}

fun sys_tcgetattr(h: u64, out: u64) u64 {
    val r: u64 = tty_handle(h);
    if (abi.is_err(r) != 0) { ret r; }
    if (ok(out, $size_of(abi.Termios)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    val t: *abi.Termios = out::*abi.Termios;
    t.lflag = tty.get_lflag(r);
    t.rows = fbcon.rows_of();
    t.cols = fbcon.cols_of();
    if (t.rows == 0 || t.cols == 0) { # serial only: assume the classic size
        t.rows = 24;
        t.cols = 80;
    }
    ret 0;
}

fun sys_tcsetattr(h: u64, in: u64) u64 {
    val r: u64 = tty_handle(h);
    if (abi.is_err(r) != 0) { ret r; }
    if (ok(in, $size_of(abi.Termios)::u64, 0) == 0) { ret e(abi.E_FAULT); }
    tty.set_lflag(r, (@(in::*abi.Termios)).lflag);
    ret 0;
}

fun sys_seek(h: u64, off: u64, whence: u64) u64 {
    val f: *file.Handle = handle(h);
    if (f == nil) { ret e(abi.E_BADF); }
    if (f.kind != file.NODE) { ret e(abi.E_INVAL); } # pipes cannot seek (ESPIPE)
    var base: u64 = 0;
    if (whence == abi.SEEK_CUR) { base = f.offset; }
    or (whence == abi.SEEK_END) { base = f.node.size; }
    or (whence != abi.SEEK_SET) { ret e(abi.E_INVAL); }
    val to: u64 = base + off; # wraps for negative offsets
    if (to >= abi.ERR_MIN) { ret e(abi.E_INVAL); }
    f.offset = to;
    ret to;
}

# PREAD / PWRITE: at `off`, leaving the handle's own offset where it was
fun sys_pread(h: u64, buf: u64, n: u64, off: u64, writing: u8) u64 {
    val f: *file.Handle = handle(h);
    if (f == nil) { ret e(abi.E_BADF); }
    if (f.kind != file.NODE) { ret e(abi.E_SPIPE); }
    if (off >= abi.ERR_MIN) { ret e(abi.E_INVAL); }
    if (n == 0) { ret 0; }
    if (ok(buf, n, (writing == 0)::u8) == 0) { ret e(abi.E_FAULT); }
    val saved: u64 = f.offset;
    val flags: u64 = f.flags;
    f.offset = off;
    f.flags = f.flags & ~abi.O_APPEND;
    var r: u64 = 0;
    if (writing != 0) { r = file.write(f, buf, n); } or { r = file.read(f, buf, n); }
    f.offset = saved;
    f.flags = flags;
    ret r;
}

# FDPATH: the absolute path of the file or directory a handle is open on
fun sys_fdpath(h: u64, buf: u64, len: u64) u64 {
    val f: *file.Handle = handle(h);
    if (f == nil) { ret e(abi.E_BADF); }
    if (f.kind != file.NODE) { ret e(abi.E_INVAL); }
    if (f.node.unlinked != 0) { ret e(abi.E_NOENT); }
    var p: [512]u8;
    val n: u64 = vfs.path_of(f.node, ?p[0]);
    var k: u64 = n;
    if (k > len) { k = len; }
    if (ok(buf, k, 1) == 0) { ret e(abi.E_FAULT); }
    mem.copy(buf, (?p[0])::u64, k);
    ret n;
}

# CLOCK: CLOCK_REALTIME or CLOCK_MONOTONIC, in seconds and nanoseconds
fun sys_clock(id: u64, out: u64) u64 {
    if (ok(out, $size_of(abi.Timespec)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    var ns: u64 = 0;
    if (id == abi.CLOCK_REALTIME) { ns = clock.real_ns(); }
    or (id == abi.CLOCK_MONOTONIC) { ns = clock.mono_ns(); }
    or { ret e(abi.E_INVAL); }
    val ts: *abi.Timespec = out::*abi.Timespec;
    ts.sec = ns / 1000000000;
    ts.nsec = ns % 1000000000;
    ret 0;
}

# GETRANDOM uses the CPU entropy source directly. timer/RTC/TSC values do
# not have a measured entropy budget, so machines without RDSEED/RDRAND
# fail explicitly instead of silently serving a predictable PRNG to TLS.
fun sys_getrandom(buf: u64, n: u64) u64 {
    if (n > 0x100000) { ret e(abi.E_INVAL); }
    if (ok(buf, n, 1) == 0) { ret e(abi.E_FAULT); }
    if (n == 0) { ret 0; }
    if (cpu.has_random_source() == 0) { ret e(abi.E_NOTSUP); }
    var i: u64 = 0;
    for (i < n) {
        var good: u8 = 0;
        var v: u64 = cpu.rdseed(?good);
        if (good == 0) { v = cpu.rdrand(?good); }
        if (good == 0) {
            if (i > 0) { ret i; }
            ret e(abi.E_AGAIN);
        }
        var k: u64 = 0;
        for (k < 8 && i < n) {
            @((buf + i)::*u8) = (v & 0xFF)::u8;
            v = v >> 8;
            k = k + 1;
            i = i + 1;
        }
    }
    ret n;
}

# --- sockets ------------------------------------------------------------------

fun sock_of(h: u64) *socket.Sock {
    val f: *file.Handle = handle(h);
    if (f == nil || f.kind != file.SOCK) { ret nil; }
    ret f.sock;
}

fun sys_socket(domain: u64, kind_flags: u64, proto: u64) u64 {
    if (domain != abi.AF_INET) { ret e(abi.E_NOTSUP); }
    val kind: u64 = kind_flags & 0xF;
    var k: u64 = socket.UDP;
    if (kind == abi.SOCK_STREAM) {
        if (proto != 0 && proto != abi.IPPROTO_TCP) { ret e(abi.E_NOTSUP); }
        k = socket.TCP;
    } or (kind == abi.SOCK_DGRAM) {
        if (proto == abi.IPPROTO_ICMP) { k = socket.ICMP; }
        or (proto != 0 && proto != abi.IPPROTO_UDP) { ret e(abi.E_NOTSUP); }
    } or {
        ret e(abi.E_NOTSUP);
    }
    val s: *socket.Sock = socket.alloc(k);
    if (s == nil) { ret e(abi.E_NFILE); }
    s.nonblock = ((kind_flags & abi.SOCK_NONBLOCK) != 0)::u8;
    val h: *file.Handle = file.open_socket(s);
    if (h != nil && s.nonblock != 0) { h.flags = h.flags | abi.O_NONBLOCK; }
    if (h == nil) {
        socket.release(s);
        ret e(abi.E_NOMEM);
    }
    val idx: u64 = install(h);
    if (abi.is_err(idx) != 0) { file.close(h); }
    if (abi.is_err(idx) == 0 && (kind_flags & abi.SOCK_CLOEXEC) != 0) { cur().fdflags[idx] = abi.FD_CLOEXEC::u8; }
    ret idx;
}

# a user sockaddr_in at va (len bytes): its ip and port
fun user_addr(va: u64, len: u64, ip: *u32, port: *u16) u64 {
    if (len < 16 || ok(va, 16, 0) == 0) { ret e(abi.E_FAULT); }
    if (socket.get_addr(va::*u8, ip, port) == 0) { ret e(abi.E_INVAL); }
    ret 0;
}

fun sys_bind(h: u64, va: u64, len: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    var ip: u32 = 0;
    var port: u16 = 0;
    val r: u64 = user_addr(va, len, ?ip, ?port);
    if (abi.is_err(r) != 0) { ret r; }
    if (port == 0) {
        if (s.kind == socket.TCP) {
            s.port = netio.tcp_port();
            if (s.port == 0) { ret e(abi.E_AGAIN); }
            s.local_ip = ip;
            ret 0;
        }
        val bound: u64 = netio.autobind(s);
        if (abi.is_err(bound) == 0) { s.local_ip = ip; }
        ret bound;
    }
    if (s.kind != socket.ICMP && port < 1024 && is_root() == 0) { ret e(abi.E_ACCES); }
    val other: *socket.Sock = socket.find(s.kind, port);
    if (other != nil && other != s) { ret e(abi.E_ADDRINUSE); }
    if (s.kind == socket.TCP && tcp.port_busy(port, s.reuse) != 0) { ret e(abi.E_ADDRINUSE); }
    s.port = port;
    s.local_ip = ip;
    ret 0;
}

fun sys_connect(h: u64, va: u64, len: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    var ip: u32 = 0;
    var port: u16 = 0;
    val r: u64 = user_addr(va, len, ?ip, ?port);
    if (abi.is_err(r) != 0) { ret r; }
    if (s.kind == socket.TCP) { ret netio.tcp_connect(s, ip, port); }
    val b: u64 = netio.autobind(s);
    if (abi.is_err(b) != 0) { ret b; }
    s.peer_ip = ip;
    s.peer_port = port;
    s.connected = (ip != 0)::u8;
    ret 0;
}

fun sys_sendto(h: u64, buf: u64, len: u64, va: u64, alen: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    if (len > 0 && ok(buf, len, 0) == 0) { ret e(abi.E_FAULT); }
    var ip: u32 = 0;
    var port: u16 = 0;
    if (va != 0) {
        val r: u64 = user_addr(va, alen, ?ip, ?port);
        if (abi.is_err(r) != 0) { ret r; }
    }
    ret netio.send(s, buf::*u8, len, ip, port);
}

fun sys_recvfrom(h: u64, buf: u64, len: u64, va: u64, alen: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    if (len > 0 && ok(buf, len, 1) == 0) { ret e(abi.E_FAULT); }
    if (va != 0 && ok(va, 16, 1) == 0) { ret e(abi.E_FAULT); }
    if (alen != 0 && ok(alen, 4, 1) == 0) { ret e(abi.E_FAULT); }
    var ip: u32 = 0;
    var port: u16 = 0;
    val n: u64 = netio.recv(s, buf::*u8, len, ?ip, ?port);
    if (abi.is_err(n) != 0) { ret n; }
    if (va != 0) { socket.put_addr(va::*u8, ip, port); }
    if (alen != 0) { @(alen::*u32) = 16; }
    ret n;
}

# datagram receive metadata stays separate from the original RECVFROM ABI.
fun sys_recvmsg(h: u64, buf: u64, len: u64, metadata: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    if (s.kind != socket.UDP) { ret e(abi.E_NOTSUP); }
    if (ok(buf, len, 1) == 0 || ok(metadata, $size_of(abi.RecvMeta)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    var ip: u32;
    var port: u16;
    ret netio.recv_message(s, buf::*u8, len, ?ip, ?port, metadata::*abi.RecvMeta);
}

fun sys_setsockopt(h: u64, opt: u64, v: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    if (opt == abi.SO_RCVTIMEO) { s.timeout = v; }
    or (opt == abi.SO_BROADCAST) { s.broadcast = (v != 0)::u8; }
    or (opt == abi.SO_REUSEADDR) { s.reuse = (v != 0)::u8; }
    or (opt == abi.SO_KEEPALIVE) { s.keepalive = (v != 0)::u8; }
    or (opt == abi.TCP_NODELAY) { s.nodelay = (v != 0)::u8; }
    or (opt == abi.SO_SNDBUF || opt == abi.SO_RCVBUF) { } # fixed at 64 KiB
    or (opt == abi.SO_LINGER) { s.linger = v; }
    or { ret e(abi.E_INVAL); }
    ret 0;
}

fun sys_getsockopt(h: u64, opt: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    if (opt == abi.SO_RCVTIMEO) { ret s.timeout; }
    if (opt == abi.SO_BROADCAST) { ret s.broadcast::u64; }
    if (opt == abi.SO_REUSEADDR) { ret s.reuse::u64; }
    if (opt == abi.SO_KEEPALIVE) { ret s.keepalive::u64; }
    if (opt == abi.TCP_NODELAY) { ret s.nodelay::u64; }
    if (opt == abi.SO_SNDBUF || opt == abi.SO_RCVBUF) { ret 65536; }
    if (opt == abi.SO_LINGER) { ret s.linger; }
    if (opt == abi.SO_ERROR) {
        if (s.kind != socket.TCP || s.conn == 0 || s.error_reported != 0) { ret 0; }
        val status: u64 = netio.status(s);
        if (status == e(abi.E_INPROGRESS)) { ret 0; }
        if (abi.is_err(status) != 0) {
            s.error_reported = 1;
            ret abi.err_code(status);
        }
        ret 0;
    }
    ret e(abi.E_INVAL);
}

fun sys_listen(h: u64, backlog: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    if (s.kind != socket.TCP) { ret e(abi.E_NOTSUP); }
    ret netio.tcp_listen(s, backlog);
}

fun sys_accept(h: u64, va: u64, flags: u64) u64 {
    if ((flags & ~(abi.SOCK_NONBLOCK | abi.SOCK_CLOEXEC)) != 0) { ret e(abi.E_INVAL); }
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    if (s.kind != socket.TCP) { ret e(abi.E_NOTSUP); }
    if (va != 0 && ok(va, 16, 1) == 0) { ret e(abi.E_FAULT); }
    var err: u64 = 0;
    val ns: *socket.Sock = netio.tcp_accept(s, ?err);
    if (ns == nil) { ret err; }
    ns.nonblock = ((flags & abi.SOCK_NONBLOCK) != 0)::u8;
    val nh: *file.Handle = file.open_socket(ns);
    if (nh == nil) {
        netio.close(ns);
        socket.release(ns);
        ret e(abi.E_NOMEM);
    }
    if (ns.nonblock != 0) { nh.flags = nh.flags | abi.O_NONBLOCK; }
    val idx: u64 = install(nh);
    if (abi.is_err(idx) != 0) {
        file.close(nh);
        ret idx;
    }
    if ((flags & abi.SOCK_CLOEXEC) != 0) { cur().fdflags[idx] = abi.FD_CLOEXEC::u8; }
    if (va != 0) { socket.put_addr(va::*u8, ns.peer_ip, ns.peer_port); }
    ret idx;
}

fun sys_shutdown(h: u64, how: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    if (s.kind != socket.TCP) { ret e(abi.E_NOTSUP); }
    ret netio.tcp_shutdown(s, how);
}

fun sys_getpeername(h: u64, va: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    if (s.connected == 0) { ret e(abi.E_NOTCONN); }
    if (ok(va, 16, 1) == 0) { ret e(abi.E_FAULT); }
    socket.put_addr(va::*u8, s.peer_ip, s.peer_port);
    ret 0;
}

fun sys_getsockname(h: u64, va: u64) u64 {
    val s: *socket.Sock = sock_of(h);
    if (s == nil) { ret e(abi.E_BADF); }
    if (ok(va, 16, 1) == 0) { ret e(abi.E_FAULT); }
    var ip: u32 = s.local_ip;
    if (s.kind == socket.TCP && s.conn != 0) {
        val c: *tcp.Conn = s.conn::*tcp.Conn;
        if (c.state != tcp.LISTEN) { ip = c.lip; }
    } or (ip == 0 && s.connected != 0) { ip = net.source_for(s.peer_ip); }
    socket.put_addr(va::*u8, ip, s.port);
    ret 0;
}

# --- readiness queues ------------------------------------------------------------

fun queue_of(h: u64) *queue.Queue {
    val f: *file.Handle = handle(h);
    if (f == nil || f.kind != file.QUEUE) { ret nil; }
    ret f.queue::*queue.Queue;
}

fun sys_queue_create() u64 {
    val q: *queue.Queue = queue.create();
    if (q == nil) { ret e(abi.E_NOMEM); }
    val h: *file.Handle = file.open_queue(q::u64);
    if (h == nil) {
        heap.free(q::u64);
        ret e(abi.E_NOMEM);
    }
    val idx: u64 = install(h);
    if (abi.is_err(idx) != 0) { file.close(h); }
    ret idx;
}

fun sys_queue_ctl(qh: u64, op: u64, fd: u64, want: u64, context: u64) u64 {
    val q: *queue.Queue = queue_of(qh);
    if (q == nil) { ret e(abi.E_BADF); }
    val f: *file.Handle = handle(fd);
    if (f == nil && op != abi.QUEUE_DEL) { ret e(abi.E_BADF); }
    ret queue.control(q, op, fd, f, want, context);
}

fun sys_queue_wait(qh: u64, out: u64, max: u64, ms: u64) u64 {
    val q: *queue.Queue = queue_of(qh);
    if (q == nil) { ret e(abi.E_BADF); }
    if (max == 0 || max > 1024) { ret e(abi.E_INVAL); }
    if (ok(out, max * $size_of(abi.QueueEvent)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    ret queue.wait(q, out::*abi.QueueEvent, max, ms, ?cur().handles);
}

# --- threads ------------------------------------------------------------------

fun sys_thread_spawn(rip: u64, rsp: u64, arg: u64, fsbase: u64, tid_word: u64) u64 {
    if (rip >= 0x800000000000 || rsp >= 0x800000000000 || fsbase >= 0x800000000000) { ret e(abi.E_INVAL); }
    if (tid_word != 0 && ok(tid_word, 8, 1) == 0) { ret e(abi.E_FAULT); }
    val p: *proc.Proc = cur();
    val t: *proc.Proc = proc.alloc_thread(p);
    if (t == nil) { ret e(abi.E_AGAIN); }
    t.fsbase = fsbase;
    t.clear_tid = tid_word;
    proc.start(t, rip, rsp, arg, 0, 0);
    ret t.pid;
}

fun sys_thread_exit() u64 {
    val t: *proc.Proc = proc.current_thread();
    if (t.clear_tid != 0 && ok(t.clear_tid, 8, 1) != 0) {
        @(t.clear_tid::*u64) = 0;
        proc.futex_wake(cur(), t.clear_tid, 0xFFFFFFFF);
    }
    proc.thread_exit();
    ret 0;
}

fun sys_futex_wait(addr: u64, expected: u64, ms: u64) u64 {
    if ((addr & 7) != 0 || ok(addr, 8, 0) == 0) { ret e(abi.E_FAULT); }
    if (@(addr::*u64) != expected) { ret e(abi.E_AGAIN); }
    var t: u64 = 0;
    if (ms != 0) {
        # the next tick may be imminent; only whole subsequent ticks count.
        t = (ms * apic.HZ + 999) / 1000 + 1;
    }
    if (proc.futex_wait(addr, t) != 0) { ret e(abi.E_TIMEDOUT); }
    if (proc.interrupted(cur()) != 0) { ret e(abi.E_INTR); }
    ret 0;
}

fun sys_dup2(h: u64, to: u64) u64 {
    val f: *file.Handle = handle(h);
    if (f == nil || to >= abi.MAX_HANDLES) { ret e(abi.E_BADF); }
    if (h == to) { ret to; }
    val p: *proc.Proc = cur();
    if (p.handles[to] != 0) { file.close(p.handles[to]::*file.Handle); }
    p.handles[to] = file.dup(f)::u64;
    p.fdflags[to] = 0;
    ret to;
}

fun sys_fcntl(h: u64, cmd: u64, arg: u64) u64 {
    val f: *file.Handle = handle(h);
    if (f == nil) { ret e(abi.E_BADF); }
    val p: *proc.Proc = cur();
    if (cmd == abi.F_DUPFD) {
        if (arg >= abi.MAX_HANDLES) { ret e(abi.E_INVAL); }
        val r: u64 = install_from(file.dup(f), arg);
        if (abi.is_err(r) != 0) { file.close(f); }
        ret r;
    }
    if (cmd == abi.F_GETFD) { ret p.fdflags[h]::u64; }
    if (cmd == abi.F_SETFD) {
        p.fdflags[h] = (arg & abi.FD_CLOEXEC)::u8;
        ret 0;
    }
    if (cmd == abi.F_GETFL) { ret f.flags; }
    if (cmd == abi.F_SETFL) {
        f.flags = (f.flags & ~(abi.O_APPEND | abi.O_NONBLOCK)) | (arg & (abi.O_APPEND | abi.O_NONBLOCK));
        if (f.kind == file.SOCK) { f.sock.nonblock = ((arg & abi.O_NONBLOCK) != 0)::u8; }
        ret 0;
    }
    ret e(abi.E_INVAL);
}

fun sys_fstat(h: u64, out: u64) u64 {
    val f: *file.Handle = handle(h);
    if (f == nil) { ret e(abi.E_BADF); }
    if (ok(out, $size_of(abi.Stat)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    val st: *abi.Stat = out::*abi.Stat;
    if (f.kind == file.NODE) {
        fill_stat(f.node, st);
    } or {
        st.kind = abi.KIND_PIPE;
        if (f.kind == file.SOCK) { st.kind = abi.KIND_SOCKET; }
        st.size = 0;
        st.mtime = 0;
        st.sector = 0;
        st.rdev = 0;
        st.dev = 0;
        st.ino = f.pipe::u64;
        st.nlink = 1;
    }
    ret 0;
}

fun sys_sleep(ms: u64) u64 {
    val t: u64 = (ms * apic.HZ + 999) / 1000;
    if (t == 0) {
        proc.yield();
        ret 0;
    }
    val until: u64 = proc.uptime_ticks() + t;
    for (proc.uptime_ticks() < until) {
        if (proc.interrupted(cur()) != 0) { ret e(abi.E_INTR); }
        proc.sleep_ticks(until - proc.uptime_ticks());
    }
    ret 0;
}

# symlinks store their target without following the final directory entry
fun sys_symlink(target: u64, length: u64, pva: u64, plen: u64) u64 {
    if (length == 0 || length >= path.MAX) { ret e(abi.E_INVAL); }
    if (ok(target, length, 0) == 0) { ret e(abi.E_FAULT); }
    var full: [512]u8;
    val n: u64 = user_path(pva, plen, ?full[0]);
    if (abi.is_err(n) != 0) { ret n; }
    if (vfs.lookup_mode(?full[0], n, 0) != nil) { ret e(abi.E_EXIST); }
    if (vfs.was_denied() != 0) { ret e(abi.E_ACCES); }
    val dir: *vfs.Node = vfs.parent_dir(?full[0], n);
    if (dir == nil) { ret e(abi.E_NOENT); }
    val permission: u64 = may_change(dir, nil);
    if (abi.is_err(permission) != 0) { ret permission; }
    val b: u64 = path.base_index(?full[0], n);
    var nd: *vfs.Node = nil;
    val made: u64 = vfs.create(dir, ?full[b], n - b, abi.KIND_LINK, 0x1FF, ?nd);
    if (abi.is_err(made) != 0) { ret made; }
    val wrote: u64 = vfs.write(nd, 0, target, length);
    if (wrote != length) {
        vfs.unlink(nd);
        if (abi.is_err(wrote) != 0) { ret wrote; }
        ret e(abi.E_IO);
    }
    ret 0;
}

fun sys_fchmod(fd: u64, mode: u64) u64 {
    val f: *file.Handle = handle(fd);
    if (f == nil || f.kind != file.NODE) { ret e(abi.E_BADF); }
    val nd: *vfs.Node = f.node;
    if (nd.kind == abi.KIND_LINK) { ret e(abi.E_NOTSUP); }
    if (is_root() == 0 && cur().euid != nd.uid) { ret e(abi.E_PERM); }
    vfs.set_attr(nd, mode & 0xFFF, nd.uid, nd.gid);
    ret 0;
}

fun sys_thread_name(set: u64, buffer: u64, capacity: u64, tid: u64) u64 {
    var t: *proc.Proc = proc.current_thread();
    if (tid != 0) {
        t = nil;
        var i: u64 = 0;
        for (i < proc.MAX) {
            val candidate: *proc.Proc = proc.slot(i);
            if (candidate.state != proc.FREE && candidate.pid == tid && proc.process_of(candidate) == cur()) { t = candidate; brk; }
            i = i + 1;
        }
        if (t == nil) { ret e(abi.E_SRCH); }
    }
    if (set != 0) {
        if (capacity > 15) { ret e(abi.E_RANGE); }
        if (ok(buffer, capacity, 0) == 0) { ret e(abi.E_FAULT); }
        mem.copy((?t.name[0])::u64, buffer, capacity);
        t.name_len = capacity;
        ret 0;
    }
    if (capacity <= t.name_len) { ret e(abi.E_RANGE); }
    if (ok(buffer, t.name_len + 1, 1) == 0) { ret e(abi.E_FAULT); }
    mem.copy(buffer, (?t.name[0])::u64, t.name_len);
    @((buffer + t.name_len)::*u8) = 0;
    ret t.name_len;
}

# CPU ids use one mask word: this kernel supports at most sixteen CPUs
fun sys_affinity(set: u64, words: u64, capacity: u64, required: u64) u64 {
    var allowed: u64 = 1;
    var cpu_index: u64 = 1;
    for (cpu_index < smp.MAX) {
        if (smp.is_up(cpu_index) != 0) { allowed = allowed | (1u64 << cpu_index); }
        cpu_index = cpu_index + 1;
    }
    val t: *proc.Proc = proc.current_thread();
    if (set != 0) {
        if (capacity == 0 || capacity > 256) { ret e(abi.E_INVAL); }
        if (ok(words, capacity * 8, 0) == 0) { ret e(abi.E_FAULT); }
        val mask: u64 = @(words::*u64);
        if (mask == 0 || (mask & ~allowed) != 0) { ret e(abi.E_INVAL); }
        var i: u64 = 1;
        for (i < capacity) {
            if (@((words + i * 8)::*u64) != 0) { ret e(abi.E_INVAL); }
            i = i + 1;
        }
        t.affinity = mask;
        ret 0;
    }
    if (ok(required, 8, 1) == 0) { ret e(abi.E_FAULT); }
    @(required::*u64) = 1;
    if (capacity == 0) { ret e(abi.E_RANGE); }
    if (ok(words, 8, 1) == 0) { ret e(abi.E_FAULT); }
    var mask: u64 = t.affinity;
    if (mask == 0) { mask = allowed; }
    @(words::*u64) = mask;
    ret 0;
}

fun sys_stack_bounds(low: u64, high: u64) u64 {
    if (ok(low, 8, 1) == 0 || ok(high, 8, 1) == 0) { ret e(abi.E_FAULT); }
    @(low::*u64) = exec.STACK_TOP - exec.STACK_RESERVE;
    @(high::*u64) = exec.STACK_TOP;
    ret 0;
}

fun sys_readdir_long(fd: u64, index: u64, out: u64) u64 {
    val f: *file.Handle = handle(fd);
    if (f == nil || f.kind != file.NODE) { ret e(abi.E_BADF); }
    if (f.node.kind != abi.KIND_DIR) { ret e(abi.E_NOTDIR); }
    if (ok(out, $size_of(abi.LongEntry)::u64, 1) == 0) { ret e(abi.E_FAULT); }
    val c: *vfs.Node = vfs.nth_child(f.node, index);
    if (c == nil) { ret 0; }
    val en: *abi.LongEntry = out::*abi.LongEntry;
    en.kind = c.kind;
    en.size = c.size;
    en.mtime = vfs.mtime_of(c);
    en.mode = c.mode;
    en.uid = c.uid;
    en.gid = c.gid;
    en.name_len = c.name_len;
    mem.copy((?en.name[0])::u64, (?c.name[0])::u64, c.name_len);
    ret 1;
}

fun call(n: u64, a: u64, b: u64, c: u64, d: u64, f5: u64) u64 {
    if (n == abi.EXIT) {
        exit_with(a);
        ret 0;
    }
    if (n == abi.READ) {
        val h: *file.Handle = handle(a);
        if (h == nil) { ret e(abi.E_BADF); }
        if (c == 0) { ret 0; }
        if (ok(b, c, 1) == 0) { ret e(abi.E_FAULT); }
        ret file.read(h, b, c);
    }
    if (n == abi.WRITE) {
        val h: *file.Handle = handle(a);
        if (h == nil) { ret e(abi.E_BADF); }
        if (c == 0) { ret 0; }
        if (ok(b, c, 0) == 0) { ret e(abi.E_FAULT); }
        ret file.write(h, b, c);
    }
    if (n == abi.PUBLICATION_CAPABILITIES) {
        val f: *file.Handle = handle(a);
        if (f == nil) { ret e(abi.E_BADF); }
        if (f.kind != file.NODE) { ret 0; }
        if ((f.node.kind == abi.KIND_FILE || f.node.kind == abi.KIND_DIR || f.node.kind == abi.KIND_LINK) &&
            (f.node.fs == vfs.FS_RAM || f.node.fs == vfs.FS_EXT2)) { ret 4; }
        ret 0;
    }
    if (n == abi.SYMLINK) { ret sys_symlink(a, b, c, d); }
    if (n == abi.FCHMOD) { ret sys_fchmod(a, b); }
    if (n == abi.THREAD_NAME) { ret sys_thread_name(a, b, c, d); }
    if (n == abi.AFFINITY) { ret sys_affinity(a, b, c, d); }
    if (n == abi.STACK_BOUNDS) { ret sys_stack_bounds(a, b); }
    if (n == abi.READDIR_LONG) { ret sys_readdir_long(a, b, c); }
    if (n == abi.OPEN)    { ret sys_open(a, b, c, d); }
    if (n == abi.CLOSE)   { ret sys_close(a); }
    if (n == abi.SPAWN)   { ret sys_spawn(a, b, c, d, f5); }
    if (n == abi.WAIT)    { ret sys_wait(a, b, c); }
    if (n == abi.FORK)    { ret sys_fork(); }
    if (n == abi.EXECVE)  { ret sys_execve(a, b, c, d, f5); }
    if (n == abi.GETPPID) { ret cur().ppid; }
    if (n == abi.READDIR) { ret sys_readdir(a, b, c); }
    if (n == abi.STAT)    { ret sys_stat(a, b, c, d); }
    if (n == abi.MKDIR)   { ret sys_mkdir(a, b, c); }
    if (n == abi.CHMOD)   { ret sys_chmod(a, b, c, d); }
    if (n == abi.CHOWN)   { ret sys_chown(a, b, c, d); }
    if (n == abi.ACCESS)  { ret sys_access(a, b, c); }
    if (n == abi.SETUID)  { ret sys_setuid(a); }
    if (n == abi.SETGID)  { ret sys_setgid(a); }
    if (n == abi.GETUID)  { ret cur().uid; }
    if (n == abi.GETEUID) { ret cur().euid; }
    if (n == abi.GETGID)  { ret cur().gid; }
    if (n == abi.GETEGID) { ret cur().egid; }
    if (n == abi.UMASK) {
        val old: u64 = cur().umask;
        cur().umask = a & 0x1FF;
        ret old;
    }
    if (n == abi.REMOVE)  { ret sys_remove(a, b); }
    if (n == abi.CHDIR)   { ret sys_chdir(a, b); }
    if (n == abi.GETCWD)  { ret sys_getcwd(a, b); }
    if (n == abi.PIPE)    { ret sys_pipe(a); }
    if (n == abi.SLEEP)   { ret sys_sleep(a); }
    if (n == abi.INFO)    { ret sys_info(a); }
    if (n == abi.GETPID)  { ret cur().pid; }
    if (n == abi.PROCS)   { ret sys_procs(a, b); }
    if (n == abi.KILL)    { ret sys_kill(a, b); }
    if (n == abi.SIGACTION) { ret sys_sigaction(a, b, c, d); }
    if (n == abi.SIGPROCMASK) { ret sys_sigprocmask(a, b); }
    if (n == abi.SIGRETURN) { ret signal.sigreturn(frame); }
    if (n == abi.ALARM)   { ret sys_alarm(a); }
    if (n == abi.SETPGID) { ret sys_setpgid(a, b); }
    if (n == abi.GETPGID) { ret sys_getpgid(a); }
    if (n == abi.SETSID)  { ret sys_setsid(); }
    if (n == abi.GETSID) {
        if (a == 0) { ret cur().session; }
        val p: *proc.Proc = proc.find(a);
        if (p == nil) { ret e(abi.E_SRCH); }
        ret p.session;
    }
    if (n == abi.TCSETPGRP) {
        val r: u64 = tty_handle(a);
        if (abi.is_err(r) != 0) { ret r; }
        tty.set_foreground(r, b);
        ret 0;
    }
    if (n == abi.TCGETPGRP) {
        val r: u64 = tty_handle(a);
        if (abi.is_err(r) != 0) { ret r; }
        ret tty.foreground(r);
    }
    if (n == abi.SBRK)    { ret sys_sbrk(a); }
    if (n == abi.MMAP) {
        var fh: *file.Handle = nil;
        if (((c >> 8) & abi.MAP_ANONYMOUS) == 0) { fh = handle(d); }
        ret mmap.mmap(cur(), a, b, c & 0xFF, c >> 8, fh, f5);
    }
    if (n == abi.MUNMAP)  { ret mmap.munmap(cur(), a, b); }
    if (n == abi.KLOG) {
        if ((d & 1) != 0) { # clear
            if (is_root() == 0) { ret e(abi.E_PERM); }
            kprint.clear_log();
            ret 0;
        }
        if (ok(a, b, 1) == 0) { ret e(abi.E_FAULT); }
        ret kprint.read_log(a::*u8, b, c);
    }
    if (n == abi.MPROTECT) { ret mmap.mprotect(cur(), a, b, c); }
    if (n == abi.SETFG) {
        tty.set_foreground(0, a);
        ret 0;
    }
    if (n == abi.RENAME)  { ret sys_rename(a, b, c, d); }
    if (n == abi.SEEK)    { ret sys_seek(a, b, c); }
    if (n == abi.DUP) {
        val f: *file.Handle = handle(a);
        if (f == nil) { ret e(abi.E_BADF); }
        val r: u64 = install(file.dup(f));
        if (abi.is_err(r) != 0) { file.close(f); }
        ret r;
    }
    if (n == abi.DUP2)    { ret sys_dup2(a, b); }
    if (n == abi.FCNTL)   { ret sys_fcntl(a, b, c); }
    if (n == abi.FSTAT)   { ret sys_fstat(a, b); }
    if (n == abi.TIME)    { ret clock.now(); }
    if (n == abi.CLOCK)   { ret sys_clock(a, b); }
    if (n == abi.GETRANDOM) { ret sys_getrandom(a, b); }
    if (n == abi.PREAD)   { ret sys_pread(a, b, c, d, 0); }
    if (n == abi.PWRITE)  { ret sys_pread(a, b, c, d, 1); }
    if (n == abi.FDPATH)  { ret sys_fdpath(a, b, c); }
    if (n == abi.SOCKET)  { ret sys_socket(a, b, c); }
    if (n == abi.BIND)    { ret sys_bind(a, b, c); }
    if (n == abi.CONNECT) { ret sys_connect(a, b, c); }
    if (n == abi.SENDTO)  { ret sys_sendto(a, b, c, d, f5); }
    if (n == abi.RECVFROM) { ret sys_recvfrom(a, b, c, d, f5); }
    if (n == abi.SETSOCKOPT) { ret sys_setsockopt(a, b, c); }
    if (n == abi.GETSOCKNAME) { ret sys_getsockname(a, b); }
    if (n == abi.LISTEN)  { ret sys_listen(a, b); }
    if (n == abi.ACCEPT)  { ret sys_accept(a, b, 0); }
    if (n == abi.RECVMSG) { ret sys_recvmsg(a, b, c, d); }
    if (n == abi.ACCEPT4) { ret sys_accept(a, b, c); }
    if (n == abi.SHUTDOWN) { ret sys_shutdown(a, b); }
    if (n == abi.GETPEERNAME) { ret sys_getpeername(a, b); }
    if (n == abi.THREAD_SPAWN) { ret sys_thread_spawn(a, b, c, d, f5); }
    if (n == abi.THREAD_EXIT) { ret sys_thread_exit(); }
    if (n == abi.FUTEX_WAIT) { ret sys_futex_wait(a, b, c); }
    if (n == abi.FUTEX_WAKE) {
        if ((a & 7) != 0) { ret e(abi.E_FAULT); }
        ret proc.futex_wake(cur(), a, b);
    }
    if (n == abi.SET_FSBASE) {
        if (a >= 0x800000000000) { ret e(abi.E_INVAL); }
        proc.current_thread().fsbase = a;
        cpu.wrmsr(0xC0000100, a);
        ret 0;
    }
    if (n == abi.GETTID)  { ret proc.current_thread().pid; }
    if (n == abi.QUEUE_CREATE) { ret sys_queue_create(); }
    if (n == abi.QUEUE_CTL) { ret sys_queue_ctl(a, b, c, d, f5); }
    if (n == abi.QUEUE_WAIT) { ret sys_queue_wait(a, b, c, d); }
    if (n == abi.QUEUE_WAKE) {
        val q: *queue.Queue = queue_of(a);
        if (q == nil) { ret e(abi.E_BADF); }
        queue.wake(q);
        ret 0;
    }
    if (n == abi.GETSOCKOPT) { ret sys_getsockopt(a, b); }
    if (n == abi.SOCK_STATUS) {
        val s: *socket.Sock = sock_of(a);
        if (s == nil) { ret e(abi.E_BADF); }
        if (b == 1) { ret netio.peek(s); }
        ret netio.status(s);
    }
    if (n == abi.MOUNT)   { ret sys_mount(a, b, c, d); }
    if (n == abi.UMOUNT)  { ret sys_umount(a, b); }
    if (n == abi.UNAME)   { ret sys_uname(a); }
    if (n == abi.TCGETATTR) { ret sys_tcgetattr(a, b); }
    if (n == abi.TCSETATTR) { ret sys_tcsetattr(a, b); }
    if (n == abi.MOUNTS)  { ret sys_mounts(a, b); }
    if (n == abi.REBOOT) {
        if (is_root() == 0) { ret e(abi.E_PERM); }
        if (a == abi.REBOOT_RESTART) { power.reboot(); }
        or (a == abi.REBOOT_POWEROFF) { power.poweroff(); }
        ret e(abi.E_INVAL);
    }
    if (n == abi.SYNC) {
        if (blk.sync() == 0) { ret e(abi.E_IO); }
        ret 0;
    }
    ret e(abi.E_NOSYS);
}

#[symbol("syscall_dispatch")]
fun syscall_dispatch(f: *idt.Frame) {
    smp.lock();
    proc.entered();
    syscall_body(f);
    smp.unlock();
}

fun syscall_body(f: *idt.Frame) {
    frame = f;
    vfs.set_cred(cur().euid, cur().egid);
    # user memory is reachable (SMAP) only while the call runs; every user
    # pointer it uses has been checked with ok() first
    val smap: u8 = cpu.has_smap();
    if (smap != 0) { cpu.stac(); }
    f.rax = call(f.rax, f.rdi, f.rsi, f.rdx, f.r10, f.r8);
    if (smap != 0) { cpu.clac(); }
    vfs.set_cred(0, 0); # the kernel itself looks things up as root
    # the scheduler syncs whenever the cpu idles; a busy system syncs here
    val now: u64 = proc.uptime_ticks();
    if (now - last_sync >= SYNC_EVERY * apic.HZ) {
        last_sync = now;
        if (blk.dirty_count() > 0) { blk.sync(); }
    }
    signal.deliver(f);
}
