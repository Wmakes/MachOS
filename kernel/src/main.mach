# kernel entry

use info:   machos.boot.info;
use limine: machos.boot.limine;
use cpu:    machos.arch.x86_64.cpu;
use gdt:    machos.arch.x86_64.gdt;
use idt:    machos.arch.x86_64.idt;
use serial: machos.dev.serial;
use fbcon:  machos.dev.fbcon;
use kprint: machos.kern.kprint;
use pmm:    machos.mm.pmm;
use vmm:    machos.mm.vmm;
use heap:   machos.mm.heap;
use apic:   machos.arch.x86_64.apic;
use kbd:    machos.dev.ps2kbd;
use tty:    machos.kern.tty;
use trap:   machos.kern.trap;
use syscall: machos.arch.x86_64.syscall;
use proc:   machos.kern.proc;
use sys:    machos.kern.sys;
use abi:    sdk.abi;
use vfs:    machos.fs.vfs;
use mount:  machos.fs.mount;
use parts:  machos.fs.parts;
use acpi:   machos.acpi.acpi;
use mem:    machos.kern.mem;
use initrd: machos.fs.initrd;
use version: machos.abi.version;
use clock:  machos.kern.clock;
use pci:    machos.dev.pci;
use xhci:   machos.dev.xhci;
use dsk:    machos.dev.disk;

var boot: info.BootInfo;

# the boot stack, in the kernel image so it stays mapped once Limine's
# memory is no longer trusted
#[align(16)]
#[symbol("boot_stack")]
var boot_stack: [65536]u8;

#[symbol("kmain")]
fun kmain() {
    serial.init();
    cpu.pic_disable();
    cpu.init();
    val err: *u8 = limine.collect(?boot);
    if (err != nil) { kprint.panic(err); }
    val have_fb: u8 = fbcon.init(?boot.fb);

    kprint.puts("MachOS \0");
    kprint.puts(version.VERSION);
    kprint.putc(10);
    if (have_fb != 0) {
        kprint.puts("fb: \0");
        kprint.dec(boot.fb.width);
        kprint.putc(120);
        kprint.dec(boot.fb.height);
        kprint.puts(", \0");
        kprint.dec(fbcon.cols_of());
        kprint.putc(120);
        kprint.dec(fbcon.rows_of());
        kprint.puts(" text\n\0");
    } or {
        kprint.puts("fb: none, serial only\n\0");
    }
    kprint.puts("boot: \0");
    kprint.dec(boot.mem_len);
    kprint.puts(" memory regions, hhdm \0");
    kprint.hex(boot.hhdm);
    kprint.puts("  rsdp \0");
    kprint.hex(boot.rsdp);
    kprint.putc(10);

    gdt.init();
    idt.init();
    kprint.puts("gdt, tss, idt loaded\n\0");

    pmm.init(?boot);
    val verr: *u8 = vmm.init(?boot);
    if (verr != nil) { kprint.panic(verr); }
    kprint.puts("vmm: own page tables live\n\0");
    kprint.puts("cpu: \0");
    if (cpu.has_smep() != 0) { kprint.puts("smep \0"); }
    if (cpu.has_smap() != 0) { kprint.puts("smap \0"); }
    if (cpu.has_umip() != 0) { kprint.puts("umip \0"); }
    if (cpu.has_smep() == 0 && cpu.has_smap() == 0) { kprint.puts("no smep/smap on this cpu\0"); }
    kprint.putc(10);
    kprint.puts("pmm: \0");
    kprint.dec(pmm.free_pages() * pmm.PAGE / 1024 / 1024);
    kprint.puts(" MiB free\n\0");

    val a: u64 = pmm.alloc();
    val b: u64 = pmm.alloc();
    pmm.free(a);
    val c: u64 = pmm.alloc();
    if (a == 0 || b == 0 || c != a) { kprint.panic("pmm self-test failed\0"); }
    pmm.free(b);
    pmm.free(c);

    val h1: u64 = heap.alloc(100);
    val h2: u64 = heap.alloc(5000);
    val h3: u64 = heap.zalloc(40);
    if (h1 == 0 || h2 == 0 || h3 == 0 || (h1 & 15) != 0) { kprint.panic("heap self-test failed\0"); }
    heap.free(h2);
    heap.free(h1);
    val h4: u64 = heap.alloc(5100); # fits the merged h1+h2 hole
    if (h4 != h1) { kprint.panic("heap did not merge free blocks\0"); }
    heap.free(h4);
    heap.free(h3);
    if (heap.used() != 0) { kprint.panic("heap leaked\0"); }
    kprint.puts("heap: ok, \0");
    kprint.dec(heap.mapped() / 1024);
    kprint.puts(" KiB mapped\n\0");

    val aerr: *u8 = apic.init(boot.rsdp);
    if (aerr != nil) { kprint.panic(aerr); }
    if (kbd.init() != 0) { apic.route(1, apic.IRQ_BASE + 1); }
    serial.enable_rx();
    apic.route(4, apic.IRQ_BASE + 4);
    kprint.puts("apic: timer at \0");
    kprint.dec(apic.HZ);
    kprint.puts(" Hz, keyboard and serial input routed\n\0");
    if (apic.timer_calibrated() == 0) { kprint.puts("apic: no PIT to calibrate against, timer speed is a guess\n\0"); }

    syscall.init();
    clock.init();
    acpi.init_power(boot.rsdp);

    kprint.puts("pci: \0");
    kprint.dec(pci.scan());
    kprint.puts(" functions\n\0");
    val nkbd: u64 = xhci.init();
    if (xhci.controllers() > 0) {
        kprint.puts("usb: \0");
        kprint.dec(xhci.controllers());
        kprint.puts(" xhci controller(s), \0");
        kprint.dec(nkbd);
        kprint.puts(" keyboard(s)\n\0");
    }
    val ndisk: u64 = dsk.init();
    var di: u64 = 0;
    for (di < ndisk) {
        val d: *dsk.Disk = dsk.disk(di);
        kprint.puts("disk: \0");
        kprint.puts(?d.name[0]);
        kprint.puts(": \0");
        kprint.dec(d.sectors / 2048);
        kprint.puts(" MiB, \0");
        var mi: u64 = 0;
        for (mi < 40) {
            if (d.model[mi] != 32 || (mi + 1 < 40 && d.model[mi + 1] != 32)) { kprint.putc(d.model[mi]); }
            mi = mi + 1;
        }
        kprint.putc(10);
        di = di + 1;
    }

    parts.probe();
    mount_root();
    val dev: *vfs.Node = vfs.create_ram(vfs.get_root(), "dev\0", 3, abi.KIND_DIR);
    if (dev == nil) { kprint.panic("vfs: out of memory\0"); }
    make_dev(dev, "console\0", 7, vfs.DEV_CONSOLE);
    var tn: [5]u8;
    tn[0] = 116; tn[1] = 116; tn[2] = 121; tn[4] = 0; # "ttyN"
    var ti: u64 = 0;
    for (ti < 6) {
        tn[3] = 49 + ti::u8;
        make_dev(dev, ?tn[0], 4, vfs.DEV_TTY + ti);
        ti = ti + 1;
    }
    make_dev(dev, "null\0", 4, vfs.DEV_NULL);
    make_dev(dev, "zero\0", 4, vfs.DEV_ZERO);
    parts.publish(dev);
    if (vfs.child(vfs.get_root(), "tmp\0", 3) == nil) {
        val tmp: *vfs.Node = vfs.create_ram(vfs.get_root(), "tmp\0", 3, abi.KIND_DIR);
        if (tmp == nil) { kprint.panic("vfs: out of memory\0"); }
        tmp.mode = 0x3FF; # 01777: everyone may make files, only owners remove them
    }

    val pid: u64 = sys.spawn_init("/bin/init\0", rescue());
    if (abi.is_err(pid) != 0) {
        kprint.puts("/bin/init: \0");
        kprint.panic(abi.err_name(pid));
    }
    proc.scheduler();
}

fun make_dev(dir: *vfs.Node, name: *u8, n: u64, id: u64) {
    val d: *vfs.Node = vfs.create_ram(dir, name, n, abi.KIND_DEV);
    if (d == nil) { kprint.panic("vfs: out of memory\0"); }
    d.dev = id;
    d.mode = 0x1B6; # 0666: anyone may use the console, null and zero
}

# the root filesystem: ext2 on the first MachOS root partition found,
# otherwise the initrd unpacked into memory
fun rescue() u8 {
    val c: *u8 = boot.cmdline;
    if (c == nil) { ret 0; }
    var i: u64 = 0;
    for (c[i] != 0) {
        if (mem.equal(?c[i], "rescue\0", 6) != 0) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

fun mount_root() {
    var b: *parts.Bdev = parts.find_root();
    if (rescue() != 0) {
        kprint.puts("rescue mode: running from memory, the disks stay unmounted\n\0");
        b = nil;
    }
    if (b != nil) {
        val err: *u8 = mount.mount_root(b);
        kprint.puts("root: \0");
        if (err == nil) { kprint.puts("ext2 on \0"); }
        var dn: [32]u8;
        val dl: u64 = parts.dev_name(b, ?dn[0]);
        dn[dl] = 0;
        kprint.puts(?dn[0]);
        if (err == nil) {
            kprint.putc(10);
            if (mount.root_was_clean() == 0) {
                kprint.puts("root: \x1b[1;33mnot shut down cleanly last time\x1b[0m; to check it, boot\n\0");
                kprint.puts("      'MachOS (rescue)' and run fsck -y on it\n\0");
            }
            ret;
        }
        kprint.puts(": \0");
        kprint.puts(err);
        kprint.putc(10);
    }
    if (vfs.init_ram() == 0) { kprint.panic("vfs: out of memory\0"); }
    if (boot.initrd == 0) { kprint.panic("no root partition and no initrd\0"); }
    kprint.puts("root: initrd in memory (no disk root), \0");
    kprint.dec(initrd.unpack(boot.initrd, boot.initrd_len));
    kprint.puts(" files\n\0");
}

#[naked]
#[symbol("_start")]
fun start() {
    asm x86_64 {
        lea rsp, [boot_stack]
        add rsp, 65536
        call kmain
    }
}
