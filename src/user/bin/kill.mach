# kill PID...: end processes

use abi: machos.abi.sys;
use sys: machos.user.sys;
use io:  machos.user.io;
use rt:  machos.user.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc < 2) {
        io.err("usage: kill PID...\n\0");
        ret 2;
    }
    var status: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        var ok: u8 = 0;
        val pid: u64 = io.parse_dec(argv[i], io.len(argv[i]), ?ok);
        if (ok == 0) {
            io.err("kill: not a pid: \0");
            io.err(argv[i]);
            io.err("\n\0");
            status = 1;
        } or {
            val r: u64 = sys.kill(pid);
            if (abi.is_err(r) != 0) {
                io.fail("kill\0", argv[i], r);
                status = 1;
            }
        }
        i = i + 1;
    }
    ret status;
}
