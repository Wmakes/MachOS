# the MachOS system call interface, shared word for word by the kernel and
# every user program (the kernel and the SDK both build this file). a call is `syscall` with the number in rax and up to
# five arguments in rdi, rsi, rdx, r10, r8; the result comes back in rax.
# results at or above ERR_MIN are errors: 0 - E_*

pub val EXIT:    u64 = 0;  # (code)                                  never returns
pub val READ:    u64 = 1;  # (handle, buf, len)                      -> bytes, 0 = end
pub val WRITE:   u64 = 2;  # (handle, buf, len)                      -> bytes
pub val OPEN:    u64 = 3;  # (path, path_len, O_*, mode)             -> fd; mode (less the umask) for a new file
pub val CLOSE:   u64 = 4;  # (handle)
pub val SPAWN:   u64 = 5;  # (path, path_len, args, args_len, *Spawn) -> pid; the record is required
pub val WAIT:    u64 = 6;  # (pid, *status, WNOHANG)                 -> pid (0: none ready)
pub val READDIR: u64 = 7;  # (handle, index, *Entry)                 -> 1, or 0 past the end
pub val STAT:    u64 = 8;  # (path, path_len, *Stat)
pub val MKDIR:   u64 = 9;  # (path, path_len, mode)
pub val REMOVE:  u64 = 10; # (path, path_len)                        file or empty dir
pub val CHDIR:   u64 = 11; # (path, path_len)
pub val GETCWD:  u64 = 12; # (buf, len)                              -> length
pub val PIPE:    u64 = 13; # (*[2]u64)                               [0] reads, [1] writes
pub val SLEEP:   u64 = 14; # (milliseconds)
pub val INFO:    u64 = 15; # (*Info)
pub val GETPID:  u64 = 16; # ()                                      -> pid
pub val PROCS:   u64 = 17; # (index, *ProcInfo)                      -> 1, or 0 past the end
pub val KILL:    u64 = 18; # (pid, sig)    pid > 0: it, 0: my group, ANY_CHILD-style -1: all, -g: group g
pub val SBRK:    u64 = 19; # (bytes)                                 -> old break
pub val SETFG:   u64 = 20; # (group)                                 = TCSETPGRP on the console
pub val RENAME:  u64 = 21; # (from, from_len, to, to_len)
pub val SEEK:    u64 = 22; # (fd, offset, SEEK_*)                    -> new offset
pub val SYNC:    u64 = 23; # ()                                      put every pending write on the disk
pub val TIME:    u64 = 24; # ()                                      -> seconds since 1970-01-01 UTC
pub val MOUNT:   u64 = 25; # (dev, dev_len, dir, dir_len)            the ext2 on /dev/sdXN on dir
pub val UMOUNT:  u64 = 26; # (path, len)                            a mountpoint or a mounted device
pub val UNAME:   u64 = 27; # (*Uname)
pub val TCGETATTR: u64 = 28; # (handle, *Termios)                 E_NOTTY unless it is a terminal
pub val TCSETATTR: u64 = 29; # (handle, *Termios)
pub val MOUNTS:  u64 = 30; # (index, *MountInfo)                  -> 1, or 0 past the end
pub val REBOOT:  u64 = 31; # (REBOOT_*)                            sync, unmount, then never returns
pub val DUP:     u64 = 32; # (fd)                                    -> the lowest free fd, same file
pub val DUP2:    u64 = 33; # (fd, newfd)                             -> newfd (closed first if open)
pub val FCNTL:   u64 = 34; # (fd, F_*, arg)
pub val FSTAT:   u64 = 35; # (fd, *Stat)
pub val FORK:    u64 = 36; # ()                                      -> child pid, 0 in the child
pub val EXECVE:  u64 = 37; # (path, path_len, args, args_len, env, env_len)  replaces the program
pub val GETPPID: u64 = 38; # ()                                      -> parent pid
pub val SIGACTION:   u64 = 39; # (sig, handler, restorer, mask)    -> the old handler
pub val SIGPROCMASK: u64 = 40; # (SIG_*, set)                      -> the old mask
pub val SIGRETURN:   u64 = 41; # ()  only from the SDK's restorer, at the end of a handler
pub val ALARM:       u64 = 42; # (seconds)                         -> seconds left on the old one
pub val SETPGID:     u64 = 43; # (pid, pgid)                       0, 0: lead a new group
pub val GETPGID:     u64 = 44; # (pid)                             0: me
pub val SETSID:      u64 = 45; # ()                                -> the new session (= group = my pid)
pub val GETSID:      u64 = 46; # (pid)
pub val TCSETPGRP:   u64 = 47; # (fd, pgid)                        the terminal's foreground group
pub val TCGETPGRP:   u64 = 48; # (fd)
pub val CHMOD:   u64 = 49; # (path, path_len, mode)                owner or root
pub val CHOWN:   u64 = 50; # (path, path_len, uid, gid)            root; NO_ID leaves one as it is
pub val SETUID:  u64 = 51; # (uid)     root: any; others: back to their real uid
pub val SETGID:  u64 = 52; # (gid)
pub val GETUID:  u64 = 53;
pub val GETEUID: u64 = 54;
pub val GETGID:  u64 = 55;
pub val GETEGID: u64 = 56;
pub val UMASK:   u64 = 57; # (mask)                                -> the old one
pub val ACCESS:  u64 = 58; # (path, path_len, R_OK|W_OK|X_OK)      with the real uid
pub val COUNT:   u64 = 59;

pub val NO_ID: u64 = 0xFFFFFFFFFFFFFFFF;
pub val R_OK: u64 = 4;
pub val W_OK: u64 = 2;
pub val X_OK: u64 = 1;

# mode bits: permissions for owner, group and others (rwx each), plus
pub val S_ISUID: u64 = 0x800; # 04000 run with the file owner's user id
pub val S_ISGID: u64 = 0x400; # 02000 ... and group id
pub val S_ISVTX: u64 = 0x200; # 01000 sticky: in a directory, only owners remove entries

# signal handlers and masks
pub val SIG_DFL: u64 = 0;
pub val SIG_IGN: u64 = 1;
pub val SIG_BLOCK:   u64 = 0;
pub val SIG_UNBLOCK: u64 = 1;
pub val SIG_SETMASK: u64 = 2;
pub fun sigbit(sig: u64) u64 { ret 1::u64 << sig; }

# SEEK whence
pub val SEEK_SET: u64 = 0;
pub val SEEK_CUR: u64 = 1; # the offset is added as a signed (two's complement) number
pub val SEEK_END: u64 = 2;

# FCNTL commands
pub val F_DUPFD: u64 = 0; # lowest free fd >= arg
pub val F_GETFD: u64 = 1; # -> FD_CLOEXEC or 0
pub val F_SETFD: u64 = 2;
pub val F_GETFL: u64 = 3; # -> the O_* flags it was opened with
pub val F_SETFL: u64 = 4; # only O_APPEND can change
pub val FD_CLOEXEC: u64 = 1;

pub val REBOOT_POWEROFF: u64 = 0;
pub val REBOOT_RESTART:  u64 = 1;

# WAIT: pid > 0 that child, ANY_CHILD any of them. the status is POSIX's:
# exit code << 8 for an exit, the signal number for a kill
pub val ANY_CHILD: u64 = 0xFFFFFFFFFFFFFFFF;
pub val WNOHANG:   u64 = 1; # return 0 instead of waiting while children run
pub val WUNTRACED: u64 = 2; # also report children that stopped (status: sig << 8 | 0x7F)

pub fun wifexited(st: u64) u8 { ret ((st & 0x7F) == 0)::u8; }
pub fun wexitstatus(st: u64) u64 { ret (st >> 8) & 0xFF; }
pub fun wifsignaled(st: u64) u8 { ret ((st & 0x7F) != 0 && (st & 0x7F) != 0x7F)::u8; }
pub fun wtermsig(st: u64) u64 { ret st & 0x7F; }
pub fun wifstopped(st: u64) u8 { ret ((st & 0xFF) == 0x7F)::u8; }
pub fun wstopsig(st: u64) u64 { ret (st >> 8) & 0xFF; }

# signal numbers (the kernel uses them for exit statuses already)
pub val SIGHUP:  u64 = 1;
pub val SIGINT:  u64 = 2;
pub val SIGQUIT: u64 = 3;
pub val SIGILL:  u64 = 4;
pub val SIGTRAP: u64 = 5;
pub val SIGABRT: u64 = 6;
pub val SIGBUS:  u64 = 7;
pub val SIGFPE:  u64 = 8;
pub val SIGKILL: u64 = 9;
pub val SIGUSR1: u64 = 10;
pub val SIGSEGV: u64 = 11;
pub val SIGUSR2: u64 = 12;
pub val SIGPIPE: u64 = 13;
pub val SIGALRM: u64 = 14;
pub val SIGTERM: u64 = 15;
pub val SIGCHLD: u64 = 17;
pub val SIGCONT: u64 = 18;
pub val SIGSTOP: u64 = 19;
pub val SIGTSTP: u64 = 20;
pub val NSIG:    u64 = 32;

# OPEN flags
pub val O_READ:   u64 = 1;
pub val O_WRITE:  u64 = 2;
pub val O_CREATE: u64 = 4;
pub val O_TRUNC:  u64 = 8;
pub val O_APPEND: u64 = 16;
pub val O_CLOEXEC: u64 = 32; # closed in the new program after exec

# errors, returned negated
pub val E_NOENT:    u64 = 1;  # no such file or directory
pub val E_EXIST:    u64 = 2;  # already exists
pub val E_NOTDIR:   u64 = 3;  # not a directory
pub val E_ISDIR:    u64 = 4;  # is a directory
pub val E_BADF:     u64 = 5;  # bad handle
pub val E_FAULT:    u64 = 6;  # bad user pointer
pub val E_NOMEM:    u64 = 7;  # out of memory
pub val E_INVAL:    u64 = 8;  # invalid argument
pub val E_NOEXEC:   u64 = 9;  # not an executable
pub val E_CHILD:    u64 = 10; # no such child
pub val E_NOTEMPTY: u64 = 11; # directory not empty
pub val E_PIPE:     u64 = 12; # nobody reads the pipe
pub val E_NOSYS:    u64 = 13; # no such call
pub val E_MFILE:    u64 = 14; # too many handles
pub val E_AGAIN:    u64 = 15; # out of processes
pub val E_SRCH:     u64 = 16; # no such process
pub val E_NAMETOOLONG: u64 = 17;
pub val E_NOSPC:    u64 = 18; # disk full
pub val E_IO:       u64 = 19; # the disk failed
pub val E_XDEV:     u64 = 20; # across filesystems
pub val E_BUSY:     u64 = 21; # in use
pub val E_NOTTY:    u64 = 22; # not a terminal
pub val E_INTR:     u64 = 23; # interrupted by a signal
pub val E_PERM:     u64 = 24; # not allowed
pub val E_ACCES:    u64 = 25; # permission denied

pub val ERR_MIN: u64 = 0xFFFFFFFFFFFFF000;

pub fun is_err(v: u64) u8 {
    if (v >= ERR_MIN) { ret 1; }
    ret 0;
}

pub fun err(e: u64) u64 { ret 0 - e; }

pub fun err_code(v: u64) u64 { ret 0 - v; }

pub fun err_name(v: u64) *u8 {
    val e: u64 = 0 - v;
    if (e == E_NOENT)    { ret "no such file or directory\0"; }
    if (e == E_EXIST)    { ret "already exists\0"; }
    if (e == E_NOTDIR)   { ret "not a directory\0"; }
    if (e == E_ISDIR)    { ret "is a directory\0"; }
    if (e == E_BADF)     { ret "bad handle\0"; }
    if (e == E_FAULT)    { ret "bad address\0"; }
    if (e == E_NOMEM)    { ret "out of memory\0"; }
    if (e == E_INVAL)    { ret "invalid argument\0"; }
    if (e == E_NOEXEC)   { ret "not an executable\0"; }
    if (e == E_CHILD)    { ret "no such child\0"; }
    if (e == E_NOTEMPTY) { ret "directory not empty\0"; }
    if (e == E_PIPE)     { ret "broken pipe\0"; }
    if (e == E_NOSYS)    { ret "no such system call\0"; }
    if (e == E_MFILE)    { ret "too many open handles\0"; }
    if (e == E_AGAIN)    { ret "too many processes\0"; }
    if (e == E_SRCH)     { ret "no such process\0"; }
    if (e == E_NAMETOOLONG) { ret "name too long\0"; }
    if (e == E_NOSPC)    { ret "no space left on device\0"; }
    if (e == E_IO)       { ret "input/output error\0"; }
    if (e == E_XDEV)     { ret "cannot move across filesystems\0"; }
    if (e == E_BUSY)     { ret "busy\0"; }
    if (e == E_NOTTY)    { ret "not a terminal\0"; }
    if (e == E_INTR)     { ret "interrupted\0"; }
    if (e == E_PERM)     { ret "operation not permitted\0"; }
    if (e == E_ACCES)    { ret "permission denied\0"; }
    ret "unknown error\0";
}

# file descriptors: every process starts with its parent's (except those
# marked FD_CLOEXEC), or for pid 1 the console as 0, 1 and 2
pub val STDIN:  u64 = 0;
pub val STDOUT: u64 = 1;
pub val STDERR: u64 = 2;
pub val MAX_HANDLES: u64 = 32;

# how SPAWN starts the child. with map_fds 0 it inherits every fd that is
# not FD_CLOEXEC; with map_fds 1, handles[i] is the parent's fd that becomes
# the child's fd i (FD_NONE: closed) for fds 0-9, and the rest are closed.
# env is its environment, "NAME=value" strings each ending in NUL (env_len
# bytes in all; the SDK fills in the caller's own when it is nil).
# `group`: 0 = the parent's, NEW_GROUP = the child leads a new one,
# otherwise join that group
pub val NEW_GROUP: u64 = 0xFFFFFFFFFFFFFFFF;

pub val SPAWN_FDS: u64 = 10;
pub val FD_NONE: u64 = 0xFFFFFFFFFFFFFFFF;

pub rec Spawn {
    handles: [10]u64;
    group:   u64;
    map_fds: u64;
    env:     *u8;
    env_len: u64;
}

pub val KIND_FILE: u64 = 1;
pub val KIND_DIR:  u64 = 2;
pub val KIND_DEV:  u64 = 3;
pub val KIND_PIPE: u64 = 4;

pub val NAME_MAX: u64 = 59;

pub rec Stat {
    kind:  u64;
    size:  u64;
    mtime: u64; # last change, seconds since 1970-01-01 UTC
    mode:  u64; # permission bits (07777)
    uid:   u64;
    gid:   u64;
    sector: u64; # a disk's (or partition's) sector size, 0 otherwise
    rdev:  u64; # a device's number (DEV_*), 0 otherwise
}

# device numbers (Stat.rdev)
pub val DEV_CONSOLE: u64 = 1;  # the console: tty1
pub val DEV_TTY:     u64 = 4;  # + 0..5: tty1..tty6

pub rec Entry {
    kind:     u64;
    size:     u64;
    mtime:    u64;
    mode:     u64;
    uid:      u64;
    gid:      u64;
    name_len: u64;
    name:     [60]u8;
}

# one mounted filesystem, as MOUNTS reports it (NUL-terminated strings)
pub rec MountInfo {
    dev:   [16]u8;  # "/dev/sda2"
    dir:   [256]u8; # where it is mounted
    total: u64;     # bytes
    free:  u64;
}

pub rec Info {
    mem_total: u64; # bytes
    mem_free:  u64;
    heap_used: u64;
    uptime_ms: u64;
    procs:     u64;
    cpus:      u64;     # processor cores in use
    screen_w:  u64;     # the console's pixels, 0 without a framebuffer
    screen_h:  u64;
    cpu_name:  [48]u8;  # the processor's name, NUL padded
}

# the terminal's modes (POSIX termios, local flags only). the default is
# ISIG | ICANON | ECHO: ^C interrupts, input arrives a line at a time, echoed
pub val ISIG:   u64 = 1; # ^C kills the foreground group instead of being read
pub val ICANON: u64 = 2; # line editing; read returns whole lines
pub val ECHO:   u64 = 8; # typed characters are shown

pub rec Termios {
    lflag: u64;
    rows:  u64; # the screen size (filled in by TCGETATTR, ignored by TCSETATTR)
    cols:  u64;
}

# what UNAME fills in: NUL-terminated strings
pub rec Uname {
    sysname: [32]u8; # "MachOS"
    release: [32]u8; # the kernel's version
    machine: [32]u8; # "x86_64"
}

pub val STATE_RUNNABLE: u64 = 1;
pub val STATE_RUNNING:  u64 = 2;
pub val STATE_BLOCKED:  u64 = 3;
pub val STATE_ZOMBIE:   u64 = 4;
pub val STATE_STOPPED:  u64 = 5;

pub rec ProcInfo {
    pid:      u64;
    uid:      u64;
    ppid:     u64;
    group:    u64;
    state:    u64;
    pages:    u64; # user pages mapped
    name_len: u64;
    name:     [32]u8;
}
