# top [-n COUNT]: how busy each core is and which processes use it,
# refreshed every second (COUNT times, or until ^C)

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;
use users:  userland.lib.accounts;
use system: userland.lib.system;
use tmos:   std.terminal.machos;

val MAXP: u64 = 256;

rec Row {
    pid:   u64;
    uid:   u64;
    state: u8;   # R, S, T or Z
    pages: u64;
    ticks: u64;  # cpu ticks in all
    delta: u64;  # cpu ticks in the last interval
    nlen:  u64;
    name:  [32]u8;
}

var rows: [256]Row;
var nrows: u64 = 0;
var prev_pid: [256]u64;
var prev_ticks: [256]u64;
var nprev: u64 = 0;

fun collect(p: *system.Proc) {
    if (nrows >= MAXP) { ret; }
    val w: *Row = ?rows[nrows];
    w.pid = p.pid;
    w.uid = p.uid;
    w.state = p.state;
    w.pages = p.pages;
    w.ticks = p.ticks;
    w.nlen = p.name_len;
    io.copy(?w.name[0], ?p.name[0], p.name_len);
    w.delta = p.ticks;
    var k: u64 = 0;
    for (k < nprev) {
        if (prev_pid[k] == p.pid) {
            w.delta = p.ticks - prev_ticks[k];
            brk;
        }
        k = k + 1;
    }
    nrows = nrows + 1;
}

fun snapshot() {
    nrows = 0;
    system.processes(collect);
    nprev = nrows;
    var i: u64 = 0;
    for (i < nrows) {
        prev_pid[i] = rows[i].pid;
        prev_ticks[i] = rows[i].ticks;
        i = i + 1;
    }
}

# busiest first
fun sort() {
    var i: u64 = 1;
    for (i < nrows) {
        var j: u64 = i;
        for (j > 0 && (rows[j].delta > rows[j - 1].delta || (rows[j].delta == rows[j - 1].delta && rows[j].pid < rows[j - 1].pid))) {
            val t: Row = rows[j];
            rows[j] = rows[j - 1];
            rows[j - 1] = t;
            j = j - 1;
        }
        i = i + 1;
    }
}

fun bar(pct: u64) {
    io.putc(91);
    var k: u64 = 0;
    io.out("\x1b[95m\0");
    for (k < 20) {
        if (k * 5 < pct) { io.putc(124); }
        or               { io.putc(32); }
        k = k + 1;
    }
    io.out("\x1b[0m\0");
    io.putc(93);
}

var prev_busy: [64]u64;
var prev_all: [64]u64;

# what the header shows, from /proc
rec Info {
    uptime_ms: u64;
    mem:       system.Memory;
    cpu:       system.Cpus;
}

fun sample(inf: *Info) {
    inf.uptime_ms = system.uptime_ms();
    system.memory(?inf.mem);
    system.cpus(?inf.cpu);
}

fun screen(inf: *Info, rows_max: u64) {
    io.out("\x1b[2J\x1b[H\0");
    val secs: u64 = inf.uptime_ms / 1000;
    io.out("\x1b[1mtop\x1b[0m - up \0");
    io.dec(secs / 3600);
    io.putc(58);
    io.dec_pad((secs / 60) % 60, 2);
    io.out(", \0");
    io.dec(nrows);
    io.out(" processes, \0");
    io.dec(inf.cpu.count);
    io.out(" cores, memory \0");
    io.dec((inf.mem.total - inf.mem.free) / 1048576);
    io.out(" / \0");
    io.dec(inf.mem.total / 1048576);
    io.out(" MiB\n\n\0");
    var c: u64 = 0;
    for (c < inf.cpu.count) {
        val db: u64 = inf.cpu.busy[c] - prev_busy[c];
        val da: u64 = inf.cpu.ticks[c] - prev_all[c];
        prev_busy[c] = inf.cpu.busy[c];
        prev_all[c] = inf.cpu.ticks[c];
        var pct: u64 = 0;
        if (da > 0) { pct = db * 100 / da; }
        io.out("  cpu\0");
        io.dec(c);
        if (c < 10) { io.putc(32); }
        io.putc(32);
        bar(pct);
        io.dec_pad(pct, 4);
        io.out("%\n\0");
        c = c + 1;
    }
    io.out("\n\x1b[7m  PID USER     STATE     CPU%   MEM     TIME  NAME          \x1b[0m\n\0");
    var shown: u64 = 0;
    var i: u64 = 0;
    for (i < nrows && shown < rows_max) {
        val w: *Row = ?rows[i];
        io.dec_pad(w.pid, 5);
        io.putc(32);
        var nm: [32]u8;
        var nl: u64 = users.user_name(w.uid, ?nm[0]);
        if (nl == 0) { nl = io.fmt_dec(w.uid, ?nm[0]); }
        if (nl > 8) { nl = 8; }
        io.outn(?nm[0], nl);
        var pad: u64 = nl;
        for (pad < 9) {
            io.putc(32);
            pad = pad + 1;
        }
        if (w.state == 82)      { io.out("running \0"); }
        or (w.state == 83)      { io.out("waiting \0"); }
        or (w.state == 84)      { io.out("stopped \0"); }
        or                                      { io.out("zombie  \0"); }
        io.dec_pad(w.delta, 5); # ticks per second = percent of one core
        io.out("%\0");
        io.dec_pad(w.pages * 4, 6);
        io.out("K\0");
        val t: u64 = w.ticks / 100;
        io.dec_pad(t / 60, 6);
        io.putc(58);
        io.dec_pad(t % 60, 2);
        io.out("  \0");
        io.outn(?w.name[0], w.nlen);
        io.putc(10);
        shown = shown + 1;
        i = i + 1;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    var count: u64 = 0xFFFFFFFFFFFFFFFF;
    if (argc == 3 && io.streq(argv[1], "-n\0") != 0) {
        var okk: u8 = 0;
        count = io.parse_dec(argv[2], io.len(argv[2]), ?okk);
        if (okk == 0) {
            io.err("usage: top [-n COUNT]\n\0");
            ret 2;
        }
    }
    var height: u64 = 24;
    var trows: u64 = 0;
    var tcols: u64 = 0;
    if (tmos.size(1, ?trows, ?tcols) >= 0 && trows > 0) { height = trows; }
    var inf: Info;
    sample(?inf);
    var c: u64 = 0;
    for (c < inf.cpu.count) {
        prev_busy[c] = inf.cpu.busy[c];
        prev_all[c] = inf.cpu.ticks[c];
        c = c + 1;
    }
    snapshot();
    var n: u64 = 0;
    for (n < count) {
        io.sleep_ms(1000);
        sample(?inf);
        snapshot();
        sort();
        var room: u64 = 6;
        if (height > inf.cpu.count + 7) { room = height - inf.cpu.count - 7; }
        screen(?inf, room);
        n = n + 1;
    }
    ret 0;
}
