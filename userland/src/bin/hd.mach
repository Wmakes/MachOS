# hd [-n BYTES] [FILE]: hex dump, 16 bytes a row with their characters
# (handy on disks: hd -n 512 /dev/sda)

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

val HEX: *u8 = "0123456789abcdef\0";

fun hex(v: u64, digits: u64) {
    var k: u64 = digits;
    for (k > 0) {
        k = k - 1;
        io.putc(HEX[(v >> (k * 4)) & 15]);
    }
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var limit: u64 = 0xFFFFFFFFFFFFFFFF;
    var i: u64 = 1;
    if (i + 1 < argc && io.streq(argv[i], "-n\0") != 0) {
        var okk: u8 = 0;
        limit = io.parse_dec(argv[i + 1], io.len(argv[i + 1]), ?okk);
        if (okk == 0) {
            io.err("usage: hd [-n BYTES] [FILE]\n\0");
            ret 2;
        }
        i = i + 2;
    }
    var h: u64 = abi.STDIN;
    if (i < argc) {
        h = sys.open(argv[i], io.len(argv[i]), abi.O_READ);
        if (abi.is_err(h) != 0) {
            io.fail("hd\0", argv[i], h);
            ret 1;
        }
    }
    var off: u64 = 0;
    var row: [16]u8;
    for (off < limit) {
        var want: u64 = 16;
        if (limit - off < 16) { want = limit - off; }
        var got: u64 = 0;
        for (got < want) {
            val r: u64 = sys.read(h, ?row[got], want - got);
            if (abi.is_err(r) != 0 || r == 0) { brk; }
            got = got + r;
        }
        if (got == 0) { brk; }
        hex(off, 8);
        io.out("  \0");
        var k: u64 = 0;
        for (k < 16) {
            if (k < got) {
                hex(row[k]::u64, 2);
                io.putc(32);
            } or {
                io.out("   \0");
            }
            if (k == 7) { io.putc(32); }
            k = k + 1;
        }
        io.out(" |\0");
        k = 0;
        for (k < got) {
            if (row[k] >= 32 && row[k] < 127) { io.putc(row[k]); }
            or                               { io.putc(46); }
            k = k + 1;
        }
        io.out("|\n\0");
        off = off + got;
        if (got < want) { brk; }
    }
    ret 0;
}
