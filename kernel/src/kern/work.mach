# Bounded kernel work that can continue without the scheduler's global lock.
# Boot and host tests retain the locked path until the runtime hooks exist.

pub val IO: u64 = 1;
pub val MEMORY: u64 = 2;
var ready: u8 = 0;
var enter: fun(u64) u8;
var leave: fun();

pub rec Stats {
    io_releases: u64;
    memory_releases: u64;
    max_parallel: u64;
    io_memory_overlap: u64;
    memory_parallel: u64;
}
var stats: Stats;
var io_active: u64 = 0;
var memory_active: u64 = 0;

# Accounting is updated only while the scheduler lock is held.
pub fun started(kind: u64) {
    if (kind == IO) { io_active = io_active + 1; stats.io_releases = stats.io_releases + 1; }
    or { memory_active = memory_active + 1; stats.memory_releases = stats.memory_releases + 1; }
    if (io_active != 0 && memory_active != 0) { stats.io_memory_overlap = stats.io_memory_overlap + 1; }
    if (memory_active > 1) { stats.memory_parallel = stats.memory_parallel + 1; }
    if (io_active + memory_active > stats.max_parallel) { stats.max_parallel = io_active + memory_active; }
}

pub fun finished(kind: u64) {
    if (kind == IO) { io_active = io_active - 1; }
    or { memory_active = memory_active - 1; }
}

pub fun snapshot(out: *Stats) { @out = stats; }

pub fun configure(begin: fun(u64) u8, end: fun()) { enter = begin; leave = end; ready = 1; }
pub fun begin(kind: u64) u8 { if (ready == 0) { ret 0; } ret enter(kind); }
pub fun end(active: u8) { if (active != 0) { leave(); } }
