# sending and receiving through a socket, for the system calls and for
# read/write on a socket's handle. a receive waits (polling the card each
# tick) until a datagram is there, the socket's timeout passes, or a signal
# comes

use abi:    sdk.abi;
use net:    machos.net.net;
use socket: machos.net.socket;
use proc:   machos.kern.proc;
use mem:    machos.kern.mem;
use apic:   machos.arch.x86_64.apic;
use tcp:    machos.net.tcp;

fun e(code: u64) u64 { ret abi.err(code); }

# give s a local port (or echo id) if it has none yet; 0 or an error
pub fun autobind(s: *socket.Sock) u64 {
    if (s.port != 0) { ret 0; }
    val p: u16 = socket.free_port(s.kind);
    if (p == 0) { ret e(abi.E_AGAIN); }
    s.port = p;
    ret 0;
}

# send len bytes to ip:port (ip 0: the connected peer); bytes sent or an error
pub fun send(s: *socket.Sock, buf: *u8, len: u64, ip: u32, port: u16) u64 {
    if (s.kind == socket.TCP) { ret tcp_send(s, buf, len); }
    val i: *net.Iface = net.iface();
    var dst: u32 = ip;
    var dport: u16 = port;
    if (dst == 0) {
        if (s.connected == 0) { ret e(abi.E_NOTCONN); }
        dst = s.peer_ip;
        dport = s.peer_port;
    }
    if (dst == net.BROADCAST && s.broadcast == 0) { ret e(abi.E_ACCES); }
    if (net.is_local(dst) == 0) {
        if (i.present == 0) { ret e(abi.E_NETUNREACH); }
        if (i.up == 0 && dst != net.BROADCAST) { ret e(abi.E_NETUNREACH); }
    }
    val b: u64 = autobind(s);
    if (abi.is_err(b) != 0) { ret b; }
    net.poll();
    var ok: u8 = 0;
    if (s.kind == socket.ICMP) {
        ok = net.icmp_send(s, dst, buf, len);
    } or {
        if (len > 1472) { ret e(abi.E_2BIG); }
        var source: u32 = s.local_ip;
        if (source == 0) { source = net.source_for(dst); }
        ok = net.udp_send(source, s.port, dst, dport, buf, len);
    }
    if (ok == 0) { ret e(abi.E_NETUNREACH); }
    ret len;
}

# the next datagram into buf (cut at len); its whole length or an error.
# *ip and *port get where it came from
pub fun recv(s: *socket.Sock, buf: *u8, len: u64, ip: *u32, port: *u16) u64 {
    ret recv_message(s, buf, len, ip, port, nil);
}

# the same receive, optionally returning truncation and destination metadata.
pub fun recv_message(s: *socket.Sock, buf: *u8, len: u64, ip: *u32, port: *u16, meta: *abi.RecvMeta) u64 {
    if (s.kind == socket.TCP) {
        @ip = s.peer_ip;
        @port = s.peer_port;
        ret tcp_recv(s, buf, len);
    }
    val start: u64 = proc.uptime_ticks();
    for {
        net.poll();
        if (s.count > 0) { brk; }
        if (s.nonblock != 0) { ret e(abi.E_AGAIN); }
        if (s.timeout != 0 && (proc.uptime_ticks() - start) * 1000 >= s.timeout * apic.HZ) { ret e(abi.E_AGAIN); }
        if (proc.interrupted(proc.current()) != 0) { ret e(abi.E_INTR); }
        proc.sleep_ticks(1);
    }
    val d: *socket.Datagram = socket.peek(s);
    var n: u64 = d.len;
    if (n > len) { n = len; }
    mem.copy(buf::u64, (?d.data[0])::u64, n);
    @ip = d.ip;
    @port = d.port;
    if (meta != nil) {
        socket.put_addr(?meta.peer[0], d.ip, d.port);
        meta.destination = d.destination;
        meta.interface_index = 1; # the current stack has one receiving interface
        meta.flags = 0;
        if (d.len > len) { meta.flags = 0x20; }
    }
    socket.take_done(s);
    ret n;
}

# --- TCP --------------------------------------------------------------------------

fun conn(s: *socket.Sock) *tcp.Conn { ret s.conn::*tcp.Conn; }

fun tcp_error(c: *tcp.Conn) u64 {
    if (c.err == tcp.ERR_REFUSED) { ret e(abi.E_CONNREFUSED); }
    if (c.err == tcp.ERR_RESET) { ret e(abi.E_CONNRESET); }
    if (c.err == tcp.ERR_TIMEOUT) { ret e(abi.E_TIMEDOUT); }
    ret e(abi.E_NOTCONN);
}

# a free local port for a TCP socket
pub fun tcp_port() u16 {
    var tries: u64 = 0;
    for (tries < 16384) {
        val p: u16 = socket.free_port(socket.TCP);
        if (p != 0 && tcp.port_used(p) == 0) { ret p; }
        tries = tries + 1;
    }
    ret 0;
}

# wait (polling the card) until `ready` says so, the timeout passes or a
# signal comes; 0, or the error
fun wait_until(s: *socket.Sock, start: u64) u64 {
    if (s.timeout != 0 && (proc.uptime_ticks() - start) * 1000 >= s.timeout * apic.HZ) { ret e(abi.E_AGAIN); }
    if (proc.interrupted(proc.current()) != 0) { ret e(abi.E_INTR); }
    proc.sleep_ticks(1);
    net.poll();
    ret 0;
}

pub fun tcp_connect(s: *socket.Sock, ip: u32, port: u16) u64 {
    if (s.conn != 0) { ret e(abi.E_INVAL); }
    val i: *net.Iface = net.iface();
    if (i.up == 0 && net.is_local(ip) == 0) { ret e(abi.E_NETUNREACH); }
    if (s.port == 0) {
        s.port = tcp_port();
        if (s.port == 0) { ret e(abi.E_AGAIN); }
    }
    val c: *tcp.Conn = tcp.connect(s.port, ip, port);
    if (c == nil) { ret e(abi.E_NFILE); }
    s.conn = c::u64;
    s.peer_ip = ip;
    s.peer_port = port;
    if (s.nonblock != 0) {
        s.connected = 1; # its outcome: SOCK_STATUS, once the queue says it can write
        ret e(abi.E_INPROGRESS);
    }
    # a connect waits for the handshake (the socket's timeout aside)
    for (c.state == tcp.SYN_SENT) {
        if (proc.interrupted(proc.current()) != 0) { ret e(abi.E_INTR); }
        proc.sleep_ticks(1);
        net.poll();
    }
    if (c.state != tcp.ESTABLISHED && c.state != tcp.CLOSE_WAIT) { ret tcp_error(c); }
    s.connected = 1;
    ret 0;
}

pub fun tcp_listen(s: *socket.Sock, backlog: u64) u64 {
    if (s.conn != 0) {
        if (conn(s).state == tcp.LISTEN) { ret 0; }
        ret e(abi.E_INVAL);
    }
    if (s.port == 0) {
        s.port = tcp_port();
        if (s.port == 0) { ret e(abi.E_AGAIN); }
    }
    val c: *tcp.Conn = tcp.listen(s.port, backlog);
    if (c == nil) { ret e(abi.E_NFILE); }
    s.conn = c::u64;
    ret 0;
}

# the next connection on listening socket s: a new socket for it, or nil
# with *err set
pub fun tcp_accept(s: *socket.Sock, err: *u64) *socket.Sock {
    @err = 0;
    if (s.conn == 0 || conn(s).state != tcp.LISTEN) {
        @err = e(abi.E_INVAL);
        ret nil;
    }
    val l: *tcp.Conn = conn(s);
    val start: u64 = proc.uptime_ticks();
    for (l.qlen == 0) {
        if (s.nonblock != 0) {
            net.poll();
            if (l.qlen > 0) { brk; }
            @err = e(abi.E_AGAIN);
            ret nil;
        }
        val w: u64 = wait_until(s, start);
        if (abi.is_err(w) != 0) {
            @err = w;
            ret nil;
        }
    }
    val ns: *socket.Sock = socket.alloc(socket.TCP);
    if (ns == nil) {
        @err = e(abi.E_NFILE);
        ret nil;
    }
    val c: *tcp.Conn = tcp.take(l);
    ns.conn = c::u64;
    ns.port = c.lport;
    ns.peer_ip = c.rip;
    ns.peer_port = c.rport;
    ns.connected = 1;
    ret ns;
}

pub fun tcp_send(s: *socket.Sock, buf: *u8, len: u64) u64 {
    if (s.conn == 0) { ret e(abi.E_NOTCONN); }
    val c: *tcp.Conn = conn(s);
    if (c.state == tcp.SYN_SENT) {
        if (s.nonblock != 0) { ret e(abi.E_AGAIN); }
        for (c.state == tcp.SYN_SENT) {
            if (proc.interrupted(proc.current()) != 0) { ret e(abi.E_INTR); }
            proc.sleep_ticks(1);
            net.poll();
        }
    }
    var done: u64 = 0;
    for (done < len) {
        if (c.err != tcp.ERR_NONE) { ret tcp_error(c); }
        if (c.state != tcp.ESTABLISHED && c.state != tcp.CLOSE_WAIT) {
            if (done > 0) { ret done; }
            ret e(abi.E_PIPE);
        }
        if (c.fin_want != 0) { ret e(abi.E_PIPE); }
        val k: u64 = tcp.write(c, ?buf[done], len - done);
        done = done + k;
        if (done < len && s.nonblock != 0) {
            if (done > 0) { ret done; }
            ret e(abi.E_AGAIN);
        }
        if (done < len) { # the send ring is full: wait for acknowledgements
            if (proc.interrupted(proc.current()) != 0) {
                if (done > 0) { ret done; }
                ret e(abi.E_INTR);
            }
            proc.sleep_ticks(1);
            net.poll();
        }
    }
    ret done;
}

pub fun tcp_recv(s: *socket.Sock, buf: *u8, len: u64) u64 {
    if (s.conn == 0) { ret e(abi.E_NOTCONN); }
    val c: *tcp.Conn = conn(s);
    val start: u64 = proc.uptime_ticks();
    for {
        net.poll();
        if (c.rx_len > 0) { ret tcp.read(c, buf, len); }
        if (c.peer_fin != 0) { ret 0; }
        if (c.err != tcp.ERR_NONE) { ret tcp_error(c); }
        if (c.state == tcp.CLOSED) { ret 0; }
        if (s.nonblock != 0) { ret e(abi.E_AGAIN); }
        val w: u64 = wait_until(s, start);
        if (abi.is_err(w) != 0) { ret w; }
    }
    ret 0;
}

pub fun tcp_shutdown(s: *socket.Sock, how: u64) u64 {
    if (s.conn == 0) { ret e(abi.E_NOTCONN); }
    if (how == abi.SHUT_WR || how == abi.SHUT_RDWR) { tcp.finish(conn(s)); }
    ret 0;
}

# the socket's last handle went: let the connection finish by itself
pub fun close(s: *socket.Sock) {
    if (s.kind == socket.TCP && s.conn != 0) {
        if ((s.linger >> 32) != 0 && (s.linger & 0xFFFFFFFF) == 0) { tcp.abort(conn(s)); }
        or { tcp.release(conn(s)); }
        s.conn = 0;
    }
}

# how a connect went: 0 connected, E_INPROGRESS still trying, or why not
pub fun status(s: *socket.Sock) u64 {
    if (s.kind != socket.TCP || s.conn == 0) { ret e(abi.E_NOTCONN); }
    val c: *tcp.Conn = conn(s);
    net.poll();
    if (c.state == tcp.SYN_SENT) { ret e(abi.E_INPROGRESS); }
    if (c.err != tcp.ERR_NONE) { ret tcp_error(c); }
    ret 0;
}

# what socket s is ready for (abi.EV_*)
pub fun readiness(s: *socket.Sock) u64 {
    var ev: u64 = 0;
    if (s.kind != socket.TCP) {
        if (s.count > 0) { ev = ev | abi.EV_READ; }
        ret ev | abi.EV_WRITE;
    }
    if (s.conn == 0) { ret abi.EV_WRITE | abi.EV_HANGUP; }
    val c: *tcp.Conn = conn(s);
    if (c.state == tcp.LISTEN) {
        if (c.qlen > 0) { ev = ev | abi.EV_READ; }
        ret ev;
    }
    if (c.err != tcp.ERR_NONE) { ret abi.EV_READ | abi.EV_WRITE | abi.EV_ERROR | abi.EV_HANGUP; }
    if (c.state == tcp.SYN_SENT) { ret 0; }
    if (c.rx_len > 0) { ev = ev | abi.EV_READ; }
    if (c.peer_fin != 0 || c.state == tcp.CLOSED) { ev = ev | abi.EV_READ | abi.EV_HANGUP; }
    if ((c.state == tcp.ESTABLISHED || c.state == tcp.CLOSE_WAIT) && c.fin_want == 0 && c.tx_len < tcp.BUFSZ) { ev = ev | abi.EV_WRITE; }
    ret ev;
}

# without taking anything: 1 when data waits, 0 at the end, E_AGAIN when
# neither yet
pub fun peek(s: *socket.Sock) u64 {
    net.poll();
    val ev: u64 = readiness(s);
    if (s.kind == socket.TCP && s.conn != 0 && conn(s).rx_len > 0) { ret 1; }
    if (s.kind != socket.TCP && s.count > 0) { ret 1; }
    if ((ev & abi.EV_HANGUP) != 0) { ret 0; }
    if ((ev & abi.EV_ERROR) != 0) { ret tcp_error(conn(s)); }
    ret e(abi.E_AGAIN);
}
