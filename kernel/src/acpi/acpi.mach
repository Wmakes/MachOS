# ACPI tables: find the MADT through the RSDP and pull out what interrupt
# routing needs: the I/O APIC and the legacy IRQ overrides

use vmm: machos.mm.vmm;
use mem: machos.kern.mem;
use kprint: machos.kern.kprint;

pub val MAX_OVERRIDES: u64 = 16;

pub rec Override {
    irq:   u8;  # legacy ISA irq
    gsi:   u32; # global system interrupt it is wired to
    flags: u16; # MPS INTI polarity (bits 0-1) and trigger mode (bits 2-3)
}

pub rec Madt {
    lapic:      u64; # physical address of the local APIC registers
    ioapic:     u64; # physical address of the first I/O APIC, 0 if none
    ioapic_gsi: u32; # first gsi it handles
    overrides:  [16]Override;
    n_override: u64;
}

fun rd8(a: u64) u8 { ret @(a::*u8); }
fun rd16(a: u64) u16 { ret @(a::*u16); }
fun rd32(a: u64) u32 { ret @(a::*u32); }
fun rd64(a: u64) u64 { ret @(a::*u64); }

fun sum(a: u64, n: u64) u8 {
    var s: u64 = 0;
    var i: u64 = 0;
    for (i < n) {
        s = s + rd8(a + i)::u64;
        i = i + 1;
    }
    ret (s & 0xFF)::u8;
}

# map a whole table given its physical address; 0 if its checksum fails
fun table(pa: u64) u64 {
    val hdr: u64 = vmm.map_phys(pa, 36, 0);
    val len: u32 = rd32(hdr + 4);
    val t: u64 = vmm.map_phys(pa, len::u64, 0);
    if (sum(t, len::u64) != 0) { ret 0; }
    ret t;
}

fun find(rsdp_pa: u64, sig: *u8) u64 {
    val rsdp: u64 = vmm.map_phys(rsdp_pa, 36, 0);
    if (mem.equal(rsdp::*u8, "RSD PTR \0", 8) == 0) { ret 0; }
    var root: u64 = 0;
    var entry: u64 = 4;
    if (rd8(rsdp + 15) >= 2 && rd64(rsdp + 24) != 0) {
        root = table(rd64(rsdp + 24)); # xsdt: 64-bit entries
        entry = 8;
    } or {
        root = table(rd32(rsdp + 16)::u64); # rsdt: 32-bit entries
    }
    if (root == 0) { ret 0; }
    val n: u64 = (rd32(root + 4)::u64 - 36) / entry;
    var i: u64 = 0;
    for (i < n) {
        var pa: u64 = 0;
        if (entry == 8) { pa = rd64(root + 36 + i * 8); }
        or              { pa = rd32(root + 36 + i * 4)::u64; }
        val t: u64 = table(pa);
        if (t != 0 && mem.equal(t::*u8, sig, 4) != 0) { ret t; }
        i = i + 1;
    }
    ret 0;
}

fun chars(a: u64, n: u64) {
    var i: u64 = 0;
    for (i < n) {
        var c: u8 = rd8(a + i);
        if (c < 32 || c > 126) { c = 32; }
        kprint.putc(c);
        i = i + 1;
    }
}

# one line per ACPI table, as Linux prints them: signature, address,
# length, revision, OEM and table ids. the MADT's processors at the end
pub fun report(rsdp_pa: u64) {
    if (rsdp_pa == 0) {
        kprint.warn("acpi\0");
        kprint.puts("no RSDP: no ACPI tables\n\0");
        ret;
    }
    val rsdp: u64 = vmm.map_phys(rsdp_pa, 36, 0);
    if (mem.equal(rsdp::*u8, "RSD PTR \0", 8) == 0) { ret; }
    kprint.info("acpi\0");
    kprint.puts("RSDP \0");
    kprint.hex(rsdp_pa);
    kprint.puts(" (v\0");
    kprint.dec(rd8(rsdp + 15)::u64);
    kprint.putc(32);
    chars(rsdp + 9, 6);
    kprint.puts(")\n\0");
    var root_pa: u64 = rd32(rsdp + 16)::u64;
    var entry: u64 = 4;
    if (rd8(rsdp + 15) >= 2 && rd64(rsdp + 24) != 0) {
        root_pa = rd64(rsdp + 24);
        entry = 8;
    }
    val root: u64 = table(root_pa);
    if (root == 0) {
        kprint.warn("acpi\0");
        kprint.puts("the root table's checksum is wrong\n\0");
        ret;
    }
    val n: u64 = (rd32(root + 4)::u64 - 36) / entry;
    var i: u64 = 0;
    for (i < n) {
        var pa: u64 = 0;
        if (entry == 8) { pa = rd64(root + 36 + i * 8); }
        or              { pa = rd32(root + 36 + i * 4)::u64; }
        val hdr: u64 = vmm.map_phys(pa, 36, 0);
        kprint.info("acpi\0");
        chars(hdr, 4);
        kprint.putc(32);
        kprint.hex(pa);
        kprint.puts(" len \0");
        kprint.dec(rd32(hdr + 4)::u64);
        kprint.puts(" (v\0");
        kprint.dec(rd8(hdr + 8)::u64);
        kprint.putc(32);
        chars(hdr + 10, 6);
        kprint.putc(32);
        chars(hdr + 16, 8);
        kprint.putc(41);
        if (table(pa) == 0) { kprint.puts(" bad checksum\0"); }
        kprint.putc(10);
        i = i + 1;
    }
    # processors in the MADT (type 0 entries with the enabled bit)
    val madt_t: u64 = find(rsdp_pa, "APIC\0");
    if (madt_t != 0) {
        val len: u64 = rd32(madt_t + 4)::u64;
        var at: u64 = 44;
        var cpus: u64 = 0;
        var ioapics: u64 = 0;
        var overrides: u64 = 0;
        for (at + 2 <= len) {
            val t: u8 = rd8(madt_t + at);
            val l: u64 = rd8(madt_t + at + 1)::u64;
            if (l < 2) { brk; }
            if (t == 0 && (rd32(madt_t + at + 4) & 1) != 0) { cpus = cpus + 1; }
            if (t == 9 && (rd32(madt_t + at + 8) & 1) != 0) { cpus = cpus + 1; } # x2apic
            if (t == 1) { ioapics = ioapics + 1; }
            if (t == 2) { overrides = overrides + 1; }
            at = at + l;
        }
        kprint.info("acpi\0");
        kprint.puts("MADT: \0");
        kprint.dec(cpus);
        kprint.puts(" processor(s), \0");
        kprint.dec(ioapics);
        kprint.puts(" I/O APIC(s), \0");
        kprint.dec(overrides);
        kprint.puts(" interrupt override(s)\n\0");
    }
}

# fill `m` from the MADT; returns an error message or nil
pub fun madt(rsdp_pa: u64, m: *Madt) *u8 {
    if (rsdp_pa == 0) { ret "acpi: no rsdp\0"; }
    val t: u64 = find(rsdp_pa, "APIC\0");
    if (t == 0) { ret "acpi: no madt\0"; }
    m.lapic = rd32(t + 36)::u64;
    m.ioapic = 0;
    m.n_override = 0;
    val end: u64 = t + rd32(t + 4)::u64;
    var e: u64 = t + 44;
    for (e + 2 <= end) {
        val kind: u8 = rd8(e);
        val len: u8 = rd8(e + 1);
        if (len < 2) { brk; }
        if (kind == 1 && m.ioapic == 0) {
            m.ioapic = rd32(e + 4)::u64;
            m.ioapic_gsi = rd32(e + 8);
        } or (kind == 2 && m.n_override < MAX_OVERRIDES) {
            val o: *Override = ?m.overrides[m.n_override];
            o.irq = rd8(e + 3);
            o.gsi = rd32(e + 4);
            o.flags = rd16(e + 8);
            m.n_override = m.n_override + 1;
        } or (kind == 5) {
            m.lapic = rd64(e + 4); # 64-bit local APIC address override
        }
        e = e + len::u64;
    }
    if (m.ioapic == 0) { ret "acpi: no i/o apic\0"; }
    ret nil;
}

# --- power off --------------------------------------------------------------
# entering the S5 (soft off) state needs PM1a/b control ports from the FADT
# and the S5 sleep type, which only the DSDT's \_S5 package holds

var pm1a: u64 = 0;
var pm1b: u64 = 0;
var slp_a: u64 = 0;
var slp_b: u64 = 0;
var can_off: u8 = 0;
var reset_port: u64 = 0;  # FADT reset register, when it is an I/O port
var reset_value: u8 = 0;

# the value of an AML integer at `a` (ZeroOp, OneOp, BytePrefix x); the
# number of bytes it took in *used
fun aml_int(a: u64, used: *u64) u64 {
    val op: u8 = rd8(a);
    if (op == 0x0A) {
        @used = 2;
        ret rd8(a + 1)::u64;
    }
    @used = 1;
    if (op == 0x01) { ret 1; }
    ret 0;
}

pub fun init_power(rsdp_pa: u64) {
    if (rsdp_pa == 0) { ret; }
    val fadt: u64 = find(rsdp_pa, "FACP\0");
    if (fadt == 0) { ret; }
    val flen: u64 = rd32(fadt + 4)::u64;
    pm1a = rd32(fadt + 64)::u64;
    pm1b = rd32(fadt + 68)::u64;
    if (flen >= 129 && rd8(fadt + 116) == 1) { # reset register in I/O space
        reset_port = rd64(fadt + 120);
        reset_value = rd8(fadt + 128);
    }
    var dsdt_pa: u64 = rd32(fadt + 40)::u64;
    if (flen >= 148 && rd64(fadt + 140) != 0) { dsdt_pa = rd64(fadt + 140); }
    if (dsdt_pa == 0 || pm1a == 0) { ret; }
    val dsdt: u64 = table(dsdt_pa);
    if (dsdt == 0) { ret; }
    val end: u64 = dsdt + rd32(dsdt + 4)::u64;
    var p: u64 = dsdt + 36;
    for (p + 8 < end) {
        # NameOp "_S5_" PackageOp PkgLength NumElements SLP_TYPa SLP_TYPb ...
        if (rd8(p) == 0x5F && rd8(p + 1) == 0x53 && rd8(p + 2) == 0x35 && rd8(p + 3) == 0x5F
            && rd8(p + 4) == 0x12) {
            var q: u64 = p + 5;
            q = q + ((rd8(q) >> 6)::u64) + 1; # skip PkgLength
            q = q + 1;                        # NumElements
            var used: u64 = 0;
            slp_a = aml_int(q, ?used);
            slp_b = aml_int(q + used, ?used);
            can_off = 1;
            ret;
        }
        p = p + 1;
    }
}

pub fun poweroff_possible() u8 { ret can_off; }
pub fun pm1a_port() u64 { ret pm1a; }
pub fun pm1b_port() u64 { ret pm1b; }
pub fun slp_typ_a() u64 { ret slp_a; }
pub fun slp_typ_b() u64 { ret slp_b; }
pub fun reset_reg() u64 { ret reset_port; }
pub fun reset_val() u8 { ret reset_value; }
