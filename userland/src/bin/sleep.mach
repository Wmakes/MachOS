# sleep SECONDS: wait that long, even when stopped and continued on the way

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    var ok: u8 = 0;
    if (argc == 2) {
        val s: u64 = io.parse_dec(argv[1], io.len(argv[1]), ?ok);
        if (ok != 0) {
            val until: u64 = io.now_ms() + s * 1000;
            for (io.now_ms() < until) { io.sleep_ms(until - io.now_ms()); }
            ret 0;
        }
    }
    io.err("usage: sleep SECONDS\n\0");
    ret 2;
}
