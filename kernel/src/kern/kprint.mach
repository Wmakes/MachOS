# kernel printing: NUL-terminated strings, hex and decimal numbers,
# to the serial port and the framebuffer console

use cpu:    machos.arch.x86_64.cpu;
use serial: machos.dev.serial;
use fbcon:  machos.dev.fbcon;

val LOG: u64 = 65536;
var log: [65536]u8;  # the last LOG bytes of kernel messages, for dmesg
var logged: u64 = 0; # bytes ever logged

# kernel messages: tty1 (and the serial port), and the log
pub fun putc(c: u8) {
    log[logged % LOG] = c;
    logged = logged + 1;
    putc_to(0, c);
}

# copy the log (oldest first) into dst, at most n bytes; how many
pub fun read_log(dst: *u8, n: u64) u64 {
    var start: u64 = 0;
    if (logged > LOG) { start = logged - LOG; }
    var k: u64 = 0;
    for (start + k < logged && k < n) {
        dst[k] = log[(start + k) % LOG];
        k = k + 1;
    }
    ret k;
}

# a byte for terminal `n`'s screen; tty1 is mirrored on the serial port
pub fun putc_to(n: u64, c: u8) {
    if (n == 0) {
        if (c == 10) { serial.putc(13); }
        serial.putc(c);
    }
    fbcon.putc_on(n, c);
}

pub fun puts(s: *u8) {
    var i: u64 = 0;
    for (s[i] != 0) {
        putc(s[i]);
        i = i + 1;
    }
}

pub fun hex(v: u64) {
    puts("0x\0");
    var shift: u64 = 64;
    for (shift > 0) {
        shift = shift - 4;
        val d: u8 = ((v >> shift) & 0xF)::u8;
        if (d < 10) { putc(48 + d); }
        or          { putc(87 + d); }
    }
}

pub fun dec(v: u64) {
    var buf: [20]u8;
    var n: u64 = 0;
    var x: u64 = v;
    for {
        buf[n] = 48 + (x % 10)::u8;
        n = n + 1;
        x = x / 10;
        if (x == 0) { brk; }
    }
    for (n > 0) {
        n = n - 1;
        putc(buf[n]);
    }
}

pub fun panic(msg: *u8) {
    fbcon.show_screen(0);
    puts("\npanic: \0");
    puts(msg);
    putc(10);
    cpu.halt();
}
