# tr SET1 SET2: replace characters of SET1 with those of SET2
# tr -d SET: delete them. sets take ranges (a-z) and \n \t \\

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

var map: [256]u8;
var drop: [256]u8;
var buf: [8192]u8;
var out: [8192]u8;

# expand a set into chars; the count
fun expand(s: *u8, chars: *u8) u64 {
    var n: u64 = 0;
    var i: u64 = 0;
    val len: u64 = io.len(s);
    for (i < len && n < 256) {
        var c: u8 = s[i];
        if (c == 92 && i + 1 < len) {
            i = i + 1;
            c = s[i];
            if (c == 110) { c = 10; }
            or (c == 116) { c = 9; }
        }
        if (i + 2 < len && s[i + 1] == 45) {
            val last: u8 = s[i + 2];
            var x: u64 = c::u64;
            for (x <= last::u64 && n < 256) {
                chars[n] = x::u8;
                n = n + 1;
                x = x + 1;
            }
            i = i + 3;
            cnt;
        }
        chars[n] = c;
        n = n + 1;
        i = i + 1;
    }
    ret n;
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var a: [256]u8;
    var b: [256]u8;
    var i: u64 = 0;
    for (i < 256) {
        map[i] = i::u8;
        drop[i] = 0;
        i = i + 1;
    }
    if (argc == 3 && io.streq(argv[1], "-d\0") != 0) {
        val n: u64 = expand(argv[2], ?a[0]);
        i = 0;
        for (i < n) {
            drop[a[i]] = 1;
            i = i + 1;
        }
    } or (argc == 3) {
        val n: u64 = expand(argv[1], ?a[0]);
        val m: u64 = expand(argv[2], ?b[0]);
        if (m == 0) {
            io.err("tr: empty SET2\n\0");
            ret 2;
        }
        i = 0;
        for (i < n) {
            var j: u64 = i;
            if (j >= m) { j = m - 1; } # SET2 runs short: repeat its last
            map[a[i]] = b[j];
            i = i + 1;
        }
    } or {
        io.err("usage: tr SET1 SET2 | tr -d SET\n\0");
        ret 2;
    }
    for {
        val r: u64 = sys.read(abi.STDIN, ?buf[0], 8192);
        if (abi.is_err(r) != 0 || r == 0) { brk; }
        var k: u64 = 0;
        var o: u64 = 0;
        for (k < r) {
            if (drop[buf[k]] == 0) {
                out[o] = map[buf[k]];
                o = o + 1;
            }
            k = k + 1;
        }
        io.write_all(abi.STDOUT, ?out[0], o);
    }
    ret 0;
}
