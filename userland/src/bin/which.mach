# which NAME...: where each command would be found (through $PATH)

use io:   sdk.io;
use path: sdk.path;
use rt:   sdk.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var status: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        var p: [256]u8;
        val n: u64 = path.lookup(argv[i], ?p[0]);
        if (n == 0) { status = 1; }
        or {
            io.outn(?p[0], n);
            io.putc(10);
        }
        i = i + 1;
    }
    ret status;
}
