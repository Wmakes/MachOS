# AHCI (SATA) disks. polled: a command is issued and the port watched until
# it completes, so no interrupts are involved. each disk port gets one page:
# command list at +0 (32 headers), received FISes at +1024, and the one
# command table we use at +2048 (128-byte header, then up to 120 PRDs)

use kprint: machos.kern.kprint;
use cpu:    machos.arch.x86_64.cpu;
use pci:    machos.dev.pci;
use vmm:    machos.mm.vmm;
use pmm:    machos.mm.pmm;
use mem:    machos.kern.mem;

pub val SECTOR: u64 = 512;
pub val MAX_DISKS: u64 = 8;
val MAX_SECTORS: u64 = 128; # per command: 64 KiB, at most 17 PRDs

#[volatile]
rec Reg { v: u32; }

pub rec Disk {
    port:    u64; # register base of its port
    page:    u64; # physical page: command list, FIS area, command table
    sectors: u64;
    model:   [40]u8;
}

var abar: u64 = 0;
var disks: [8]Disk;
var ndisks: u64 = 0;

fun rd(a: u64) u32 { ret (@(a::*Reg)).v; }
fun wr(a: u64, v: u32) { (@(a::*Reg)).v = v; }

val P_CLB:  u64 = 0x00;
val P_CLBU: u64 = 0x04;
val P_FB:   u64 = 0x08;
val P_FBU:  u64 = 0x0C;
val P_IS:   u64 = 0x10;
val P_IE:   u64 = 0x14;
val P_CMD:  u64 = 0x18;
val P_TFD:  u64 = 0x20;
val P_SIG:  u64 = 0x24;
val P_SSTS: u64 = 0x28;
val P_SERR: u64 = 0x30;
val P_CI:   u64 = 0x38;

val CMD_ST:  u32 = 0x0001;
val CMD_FRE: u32 = 0x0010;
val CMD_FR:  u32 = 0x4000;
val CMD_CR:  u32 = 0x8000;

val ATA_IDENTIFY:  u8 = 0xEC;
val ATA_READ_EXT:  u8 = 0x25;
val ATA_WRITE_EXT: u8 = 0x35;
val ATA_FLUSH_EXT: u8 = 0xEA;

# wait until (reg & mask) == want, giving up after a long while
fun wait(a: u64, mask: u32, want: u32) u8 {
    var spins: u64 = 0;
    for (spins < 50000000) {
        if ((rd(a) & mask) == want) { ret 1; }
        spins = spins + 1;
    }
    ret 0;
}

fun stop(port: u64) {
    wr(port + P_CMD, rd(port + P_CMD) & ~CMD_ST);
    wait(port + P_CMD, CMD_CR, 0);
    wr(port + P_CMD, rd(port + P_CMD) & ~CMD_FRE);
    wait(port + P_CMD, CMD_FR, 0);
}

fun start(port: u64) {
    wait(port + P_CMD, CMD_CR, 0);
    wr(port + P_CMD, rd(port + P_CMD) | CMD_FRE);
    wr(port + P_CMD, rd(port + P_CMD) | CMD_ST);
}

# run one command on slot 0. `buf` is kernel memory of `bytes` bytes;
# returns 0 on any error
fun command(d: *Disk, cmd: u8, lba: u64, count: u64, buf: u64, bytes: u64, write: u8) u8 {
    val port: u64 = d.port;
    if (wait(port + P_TFD, 0x88, 0) == 0) { ret 0; } # BSY, DRQ

    val table_pa: u64 = d.page + 2048;
    val table: u64 = vmm.phys_to_virt(table_pa);
    mem.fill(table, 0, 128);

    # scatter the buffer into PRDs, splitting at page boundaries
    var prds: u64 = 0;
    var done: u64 = 0;
    for (done < bytes) {
        val va: u64 = buf + done;
        var chunk: u64 = 4096 - (va & 4095);
        if (chunk > bytes - done) { chunk = bytes - done; }
        val pa: u64 = vmm.kernel_phys(va);
        if (pa == 0 || prds == 120) { ret 0; }
        val prd: *u32 = (table + 128 + prds * 16)::*u32;
        prd[0] = (pa & 0xFFFFFFFF)::u32;
        prd[1] = (pa >> 32)::u32;
        prd[2] = 0;
        prd[3] = (chunk - 1)::u32;
        prds = prds + 1;
        done = done + chunk;
    }

    # register host-to-device FIS
    val fis: *u8 = table::*u8;
    fis[0] = 0x27;
    fis[1] = 0x80;          # this is a command
    fis[2] = cmd;
    fis[4] = (lba & 0xFF)::u8;
    fis[5] = ((lba >> 8) & 0xFF)::u8;
    fis[6] = ((lba >> 16) & 0xFF)::u8;
    fis[7] = 0x40;          # LBA mode
    fis[8] = ((lba >> 24) & 0xFF)::u8;
    fis[9] = ((lba >> 32) & 0xFF)::u8;
    fis[10] = ((lba >> 40) & 0xFF)::u8;
    fis[12] = (count & 0xFF)::u8;
    fis[13] = ((count >> 8) & 0xFF)::u8;

    val hdr: *u32 = vmm.phys_to_virt(d.page)::*u32;
    var flags: u32 = 5 | (prds::u32 << 16); # FIS is 5 dwords
    if (write != 0) { flags = flags | 0x40; }
    hdr[0] = flags;
    hdr[1] = 0;
    hdr[2] = (table_pa & 0xFFFFFFFF)::u32;
    hdr[3] = (table_pa >> 32)::u32;

    wr(port + P_IS, 0xFFFFFFFF);
    wr(port + P_CI, 1);
    var spins: u64 = 0;
    for ((rd(port + P_CI) & 1) != 0) {
        if ((rd(port + P_IS) & 0x40000000) != 0) { ret 0; } # task file error
        spins = spins + 1;
        if (spins > 100000000) { ret 0; }
    }
    if ((rd(port + P_IS) & 0x40000000) != 0 || (rd(port + P_TFD) & 1) != 0) { ret 0; }
    ret 1;
}

# an ATA string (byte-swapped words), trailing spaces dropped
fun swapped(w: *u16, first: u64, words: u64) {
    var b: [80]u8;
    var i: u64 = 0;
    for (i < words) {
        b[2 * i] = (w[first + i] >> 8)::u8;
        b[2 * i + 1] = (w[first + i] & 0xFF)::u8;
        i = i + 1;
    }
    var n: u64 = words * 2;
    for (n > 0 && (b[n - 1] == 32 || b[n - 1] == 0)) { n = n - 1; }
    var s: u64 = 0;
    for (s < n && b[s] == 32) { s = s + 1; }
    for (s < n) {
        kprint.putc(b[s]);
        s = s + 1;
    }
}

fun identify(d: *Disk) u8 {
    val page: u64 = pmm.alloc();
    if (page == 0) { ret 0; }
    val buf: u64 = vmm.phys_to_virt(page);
    var ok: u8 = command(d, ATA_IDENTIFY, 0, 0, buf, 512, 0);
    if (ok != 0) {
        val w: *u16 = buf::*u16;
        d.sectors = w[100]::u64 | (w[101]::u64 << 16) | (w[102]::u64 << 32) | (w[103]::u64 << 48);
        if (d.sectors == 0) { d.sectors = w[60]::u64 | (w[61]::u64 << 16); }
        # the model string is byte-swapped within each word
        var i: u64 = 0;
        for (i < 20) {
            d.model[2 * i] = (w[27 + i] >> 8)::u8;
            d.model[2 * i + 1] = (w[27 + i] & 0xFF)::u8;
            i = i + 1;
        }
        kprint.debug("ahci\0");
        kprint.puts("  serial \0");
        swapped(w, 10, 10);
        kprint.puts(", firmware \0");
        swapped(w, 23, 4);
        if ((w[106] & 0xC000) == 0x4000 && (w[106] & 0x2000) != 0) {
            kprint.puts(", physical sectors 2^\0");
            kprint.dec((w[106] & 0xF)::u64);
            kprint.puts(" x 512\0");
        }
        if ((w[76] & 0x100) != 0) { kprint.puts(", NCQ\0"); }
        if (w[217] == 1) { kprint.puts(", solid state\0"); }
        kprint.putc(10);
    }
    pmm.free(page);
    ret ok;
}

fun add_port(port: u64) {
    if (ndisks == MAX_DISKS) { ret; }
    val num: u64 = (port - abar - 0x100) / 0x80;
    val ssts: u32 = rd(port + P_SSTS);
    if ((ssts & 0xF) != 3 || ((ssts >> 8) & 0xF) != 1) { # present, active
        kprint.debug("ahci\0");
        kprint.puts("port \0");
        kprint.dec(num);
        kprint.puts(": no device\n\0");
        ret;
    }
    val speed: u32 = (ssts >> 4) & 0xF;
    kprint.info("ahci\0");
    kprint.puts("port \0");
    kprint.dec(num);
    kprint.puts(": link up at \0");
    if (speed == 1) { kprint.puts("1.5\0"); }
    or (speed == 2) { kprint.puts("3\0"); }
    or (speed == 3) { kprint.puts("6\0"); }
    or { kprint.puts("?\0"); }
    kprint.puts(" Gbps, \0");
    # the port receives FISes first (the signature arrives in one), then
    # the device gets time to finish its reset (BSY clear)
    val page: u64 = pmm.alloc();
    if (page == 0) { ret; }
    stop(port);
    wr(port + P_CLB, (page & 0xFFFFFFFF)::u32);
    wr(port + P_CLBU, (page >> 32)::u32);
    wr(port + P_FB, ((page + 1024) & 0xFFFFFFFF)::u32);
    wr(port + P_FBU, ((page + 1024) >> 32)::u32);
    wr(port + P_SERR, 0xFFFFFFFF);
    wr(port + P_IS, 0xFFFFFFFF);
    wr(port + P_IE, 0);
    start(port);
    var spins: u64 = 0;
    for ((rd(port + P_TFD) & 0x80) != 0 && spins < 2000) { # up to ~2 s
        cpu.delay_us(1000);
        spins = spins + 1;
    }
    val sig: u32 = rd(port + P_SIG);
    var what: *u8 = nil;
    if (sig == 0xEB140101) { what = "ATAPI device (CD/DVD: not supported)\n\0"; }
    or (sig == 0xC33C0101) { what = "enclosure bridge (not supported)\n\0"; }
    or (sig == 0x96690101) { what = "port multiplier (not supported)\n\0"; }
    or (sig != 0x00000101) { what = "unknown device \0"; }
    if (what != nil) {
        kprint.puts(what);
        if (sig != 0xEB140101 && sig != 0xC33C0101 && sig != 0x96690101) {
            kprint.puts("(signature \0");
            kprint.hex(sig::u64);
            kprint.puts(")\n\0");
        }
        stop(port);
        pmm.free(page);
        ret;
    }
    kprint.puts("SATA disk\n\0");

    val d: *Disk = ?disks[ndisks];
    d.port = port;
    d.page = page;
    if (identify(d) == 0) {
        stop(port);
        pmm.free(page);
        ret;
    }
    ndisks = ndisks + 1;
}

# find the first AHCI controller and its disks; returns how many
pub fun init() u64 {
    val dev: *pci.Device = pci.find(0x01, 0x06, 0x01);
    if (dev == nil) { ret 0; }
    pci.enable(dev);
    abar = vmm.map_phys(pci.bar(dev, 5), 0x1100, 1);
    wr(abar + 0x04, rd(abar + 0x04) | 0x80000000); # GHC.AE: AHCI mode
    val pi: u32 = rd(abar + 0x0C);
    val cap: u32 = rd(abar + 0x00);
    val vs: u32 = rd(abar + 0x10);
    kprint.info("ahci\0");
    kprint.puts("AHCI \0");
    kprint.dec((vs >> 16)::u64);
    kprint.putc(46);
    kprint.dec(((vs >> 8) & 0xFF)::u64);
    kprint.puts(", \0");
    kprint.dec(((cap & 0x1F) + 1)::u64);
    kprint.puts(" ports, \0");
    kprint.dec((((cap >> 8) & 0x1F) + 1)::u64);
    kprint.puts(" command slots\0");
    if ((cap & (1 << 31)) != 0) { kprint.puts(", 64-bit\0"); }
    if ((cap & (1 << 30)) != 0) { kprint.puts(", NCQ\0"); }
    kprint.putc(10);
    var i: u64 = 0;
    for (i < 32) {
        if ((pi & (1::u32 << i::u32)) != 0) { add_port(abar + 0x100 + i * 0x80); }
        i = i + 1;
    }
    ret ndisks;
}

pub fun disk_count() u64 { ret ndisks; }
pub fun disk(i: u64) *Disk { ret ?disks[i]; }

fun transfer(d: *Disk, lba: u64, n: u64, buf: u64, write: u8) u8 {
    var done: u64 = 0;
    for (done < n) {
        var k: u64 = n - done;
        if (k > MAX_SECTORS) { k = MAX_SECTORS; }
        var cmd: u8 = ATA_READ_EXT;
        if (write != 0) { cmd = ATA_WRITE_EXT; }
        if (command(d, cmd, lba + done, k, buf + done * SECTOR, k * SECTOR, write) == 0) { ret 0; }
        done = done + k;
    }
    ret 1;
}

# read/write `n` sectors at `lba` to/from kernel memory; 0 on error
pub fun read(d: *Disk, lba: u64, n: u64, buf: u64) u8 {
    if (lba + n > d.sectors) { ret 0; }
    ret transfer(d, lba, n, buf, 0);
}

pub fun write(d: *Disk, lba: u64, n: u64, buf: u64) u8 {
    if (lba + n > d.sectors) { ret 0; }
    ret transfer(d, lba, n, buf, 1);
}

# ask the drive to put its write cache on the platter
pub fun flush(d: *Disk) u8 {
    ret command(d, ATA_FLUSH_EXT, 0, 0, 0, 0, 0);
}
