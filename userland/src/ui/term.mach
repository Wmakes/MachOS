# full-screen terminal programs: raw mode, the screen size, cursor control,
# and keys (escape sequences decoded into KEY_* codes)

use io:   userland.lib.cli;
use tmos: std.terminal.machos;
use std.types.size.usize;

pub val KEY_UP:    u64 = 0x101;
pub val KEY_DOWN:  u64 = 0x102;
pub val KEY_RIGHT: u64 = 0x103;
pub val KEY_LEFT:  u64 = 0x104;
pub val KEY_HOME:  u64 = 0x105;
pub val KEY_END:   u64 = 0x106;
pub val KEY_DEL:   u64 = 0x107;
pub val KEY_PGUP:  u64 = 0x108;
pub val KEY_PGDN:  u64 = 0x109;
pub val KEY_EOF:   u64 = 0xFFFFFFFFFFFFFFFF;
pub val KEY_ALT:   u64 = 0x1000; # + the key: alt+key, or escape then key ("M-x")

var tty: i64 = 0;     # where keys come from (a terminal handle)
var rows: u64 = 24;
var cols: u64 = 80;

# take over the terminal `h`: raw mode, and learn its size
pub fun start(h: i64) u8 {
    tty = h;
    if (tmos.size(h::usize, ?rows, ?cols) < 0) { ret 0; }
    tmos.raw(h::usize);
    io.out("\x1b[2J\x1b[H\0");
    ret 1;
}

# hand the terminal back: line mode, a clean screen
pub fun stop() {
    tmos.restore(tty::usize);
    io.out("\x1b[0m\x1b[2J\x1b[H\0");
}

pub fun height() u64 { ret rows; }
pub fun width() u64 { ret cols; }

# row and col count from 0
pub fun go(row: u64, col: u64) {
    io.out("\x1b[\0");
    io.dec(row + 1);
    io.putc(59);
    io.dec(col + 1);
    io.putc(72);
}

pub fun clear_eol() { io.out("\x1b[K\0"); }
pub fun reverse(on: u8) {
    if (on != 0) { io.out("\x1b[7m\0"); }
    or           { io.out("\x1b[0m\0"); }
}

fun byte() u64 {
    var c: u8 = 0;
    val r: i64 = io.read(tty, ?c, 1);
    if (r <= 0) { ret KEY_EOF; }
    ret c::u64;
}

pub fun key() u64 {
    val c: u64 = byte();
    if (c != 27) {
        if (c == 13) { ret 10; }
        ret c;
    }
    val c2: u64 = byte();
    if (c2 == 27 || c2 == KEY_EOF) { ret 27; }
    if (c2 != 91 && c2 != 79) { ret KEY_ALT + c2; }
    var num: u64 = 0;
    var f: u64 = byte();
    for (f >= 48 && f <= 57) {
        num = num * 10 + f - 48;
        f = byte();
    }
    if (f == 65) { ret KEY_UP; }
    if (f == 66) { ret KEY_DOWN; }
    if (f == 67) { ret KEY_RIGHT; }
    if (f == 68) { ret KEY_LEFT; }
    if (f == 72) { ret KEY_HOME; }
    if (f == 70) { ret KEY_END; }
    if (f == 126) {
        if (num == 1 || num == 7) { ret KEY_HOME; }
        if (num == 4 || num == 8) { ret KEY_END; }
        if (num == 3) { ret KEY_DEL; }
        if (num == 5) { ret KEY_PGUP; }
        if (num == 6) { ret KEY_PGDN; }
    }
    ret 0;
}
