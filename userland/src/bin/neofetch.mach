# neofetch: the logo and a summary of the system beside it

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;
use std.types.size.usize;
use logo: userland.lib.logo;
use system: userland.lib.system;

var lines: [16][160]u8;
var lens: [16]u64;
var nlines: u64 = 0;
var cur: u64 = 0;

fun add(s: *u8) {
    val n: u64 = io.len(s);
    io.copy(?lines[nlines][cur], s, n);
    cur = cur + n;
}

fun addn(s: *u8, n: u64) {
    io.copy(?lines[nlines][cur], s, n);
    cur = cur + n;
}

fun add_dec(v: u64) {
    var b: [20]u8;
    addn(?b[0], io.fmt_dec(v, ?b[0]));
}

# a "Title: " in the mach colour, then the value
fun title(t: *u8) {
    add(logo.COLOR);
    add("\x1b[1m\0");
    add(t);
    add(logo.RESET);
    add(": \0");
}

fun end_line() {
    lens[nlines] = cur;
    nlines = nlines + 1;
    cur = 0;
}

fun plural(n: u64, unit: *u8) {
    add_dec(n);
    add(" \0");
    add(unit);
    if (n != 1) { add("s\0"); }
}

fun uptime(ms: u64) {
    val mins: u64 = ms / 60000;
    val days: u64 = mins / 1440;
    val hours: u64 = (mins / 60) % 24;
    val m: u64 = mins % 60;
    var any: u8 = 0;
    if (days > 0) { plural(days, "day\0"); any = 1; }
    if (hours > 0) {
        if (any != 0) { add(", \0"); }
        plural(hours, "hour\0");
        any = 1;
    }
    if (any != 0) { add(", \0"); }
    plural(m, "min\0");
}

fun programs() u64 {
    var d: io.Dir;
    if (io.dir_open(?d, "/bin") < 0) { ret 0; }
    var n: u64 = 0;
    for (io.dir_next(?d) > 0) {
        if (io.dir_kind(?d) == io.KIND_FILE) { n = n + 1; }
    }
    io.dir_close(?d);
    ret n;
}

# $NAME into buf, or nil when it is not set
fun getenv(name: *u8, buf: *u8, cap: u64) *u8 {
    val n: i64 = os.getenv(name, buf, cap::usize);
    if (n < 0 || n::u64 >= cap) { ret nil; }
    ret buf;
}

# the number in word w (from 0) of s
fun word(s: *u8, w: u64) u64 {
    var i: u64 = 0;
    var k: u64 = 0;
    for (s[i] != 0) {
        for (s[i] == 32) { i = i + 1; }
        var v: u64 = 0;
        for (s[i] >= 48 && s[i] <= 57) {
            v = v * 10 + (s[i] - 48)::u64;
            i = i + 1;
        }
        if (k == w) { ret v; }
        k = k + 1;
        for (s[i] != 0 && s[i] != 32) { i = i + 1; }
    }
    ret 0;
}

# the last part of a path
fun base(p: *u8) *u8 {
    var s: *u8 = p;
    var i: u64 = 0;
    for (p[i] != 0) {
        if (p[i] == 47 && p[i + 1] != 0) { s = ?p[i + 1]; }
        i = i + 1;
    }
    ret s;
}

# the CPU's name with runs of spaces squeezed
fun cpu_name(name: *u8) {
    var i: u64 = 0;
    for (i < 48 && name[i] == 32) { i = i + 1; }
    var last: u8 = 0;
    for (i < 48 && name[i] != 0) {
        if (name[i] != 32 || last != 32) { addn(?name[i], 1); }
        last = name[i];
        i = i + 1;
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    var release: [32]u8;
    system.release(?release[0], 32);
    var host: [64]u8;
    system.line("/proc/sys/kernel/hostname", ?host[0], 64);
    var mem: system.Memory;
    system.memory(?mem);
    var cpus: system.Cpus;
    system.cpus(?cpus);
    var cpu: [64]u8;
    system.cpu_name(?cpu[0], 64);
    var screen: [64]u8;
    system.line("/proc/screen", ?screen[0], 64);

    var ubuf: [64]u8;
    var user: *u8 = getenv("USER", ?ubuf[0], 64);
    if (user == nil) { user = "root\0"; }
    add(logo.COLOR);
    add("\x1b[1m\0");
    add(user);
    add(logo.RESET);
    add("@\0");
    add(logo.COLOR);
    add("\x1b[1m\0");
    add(?host[0]);
    add(logo.RESET);
    end_line();
    var k: u64 = io.len(user) + 1 + io.len(?host[0]);
    for (k > 0) {
        add("-\0");
        k = k - 1;
    }
    end_line();

    title("OS\0");
    add("MachOS \0");
    add(?release[0]);
    add(" x86_64\0");
    end_line();

    title("Kernel\0");
    add("machos \0");
    add(?release[0]);
    end_line();

    title("Uptime\0");
    uptime(system.uptime_ms());
    end_line();

    title("Programs\0");
    add_dec(programs());
    add(" (/bin)\0");
    end_line();

    title("Shell\0");
    var sbuf: [128]u8;
    var sh: *u8 = getenv("SHELL", ?sbuf[0], 128);
    if (sh == nil) { sh = "/bin/sh\0"; }
    add(base(sh));
    end_line();

    if (word(?screen[0], 0) > 0) {
        title("Resolution\0");
        add_dec(word(?screen[0], 0));
        add("x\0");
        add_dec(word(?screen[0], 1));
        end_line();
    }

    val tn: u64 = system.tty_number(io.STDIN);
    if (tn != 0) {
        title("Terminal\0");
        add("tty\0");
        add_dec(tn);
        end_line();
    }

    title("CPU\0");
    if (cpu[0] != 0) { cpu_name(?cpu[0]); }
    or { add("x86_64\0"); }
    add(" (\0");
    add_dec(cpus.count);
    add(")\0");
    end_line();

    title("Memory\0");
    add_dec((mem.total - mem.free) / 1048576);
    add("MiB / \0");
    add_dec(mem.total / 1048576);
    add("MiB\0");
    end_line();

    end_line();
    # the colour blocks: normal and bright
    var c: u64 = 0;
    for (c < 8) {
        add("\x1b[4\0");
        add_dec(c);
        add("m   \0");
        c = c + 1;
    }
    add(logo.RESET);
    end_line();
    c = 0;
    for (c < 8) {
        add("\x1b[10\0");
        add_dec(c);
        add("m   \0");
        c = c + 1;
    }
    add(logo.RESET);
    end_line();

    # the logo on the left, the lines beside it
    io.putc(10);
    var i: u64 = 0;
    for (i < nlines || i < logo.LINES) {
        io.out("  \0");
        if (i < logo.LINES) {
            io.out(logo.COLOR);
            io.out(logo.line(i));
            io.out(logo.RESET);
            var w: u64 = io.len(logo.line(i));
            for (w < logo.WIDTH + 3) {
                io.putc(32);
                w = w + 1;
            }
        } or {
            var w: u64 = 0;
            for (w < logo.WIDTH + 3) {
                io.putc(32);
                w = w + 1;
            }
        }
        if (i < nlines) { io.outn(?lines[i][0], lens[i]); }
        io.putc(10);
        i = i + 1;
    }
    io.putc(10);
    ret 0;
}
