# tail [-N] [FILE]: the last N (default 10) lines

use abi:  sdk.abi;
use io:   sdk.io;
use rt:   sdk.rt;
use text: userland.lib.text;

var buf: [4194304]u8;
var starts: [262144]u64;
var lens: [262144]u64;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var want: u64 = 10;
    var i: u64 = 1;
    if (i < argc && argv[i][0] == 45 && argv[i][1] != 0) {
        var okk: u8 = 0;
        want = io.parse_dec(?argv[i][1], io.len(argv[i]) - 1, ?okk);
        if (okk == 0) {
            io.err("usage: tail [-N] [FILE]\n\0");
            ret 2;
        }
        i = i + 1;
    }
    var path: *u8 = nil;
    if (i < argc) { path = argv[i]; }
    val h: u64 = text.open_in("tail\0", path);
    if (abi.is_err(h) != 0) { ret 1; }
    val n: u64 = text.read_all(h, ?buf[0], 4194304);
    val count: u64 = text.split_lines(?buf[0], n, ?starts[0], ?lens[0], 262144);
    var k: u64 = 0;
    if (count > want) { k = count - want; }
    for (k < count) {
        io.outn(?buf[starts[k]], lens[k]);
        io.putc(10);
        k = k + 1;
    }
    ret 0;
}
