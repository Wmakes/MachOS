# framebuffer text console: 8x16 glyphs on a 32 bpp linear framebuffer.
# the character grid and each cell's colours are mirrored in `cells` and
# `attrs`, so scrolling redraws only the cells that change and never reads
# video memory back. understands the ANSI sequences a shell needs:
# SGR colours (ESC[...m), clear screen (ESC[2J), home (ESC[H), and clear to
# end of line (ESC[K). lines scrolled off the top are kept in a history
# ring that shift+pgup/pgdn page back through (view_up / view_down); any
# output jumps back to the live screen

use machos.boot.info;

#[embed("font8x16.bin")]
val FONT: [59216]u8; # 3701 Unicode glyphs, 16 rows each, msb = leftmost pixel

# Sorted little-endian Unicode values for FONT slots 128 onward. Slots 0..127
# match ASCII directly. Keeping the map binary avoids thousands of integer
# literals in this module while retaining a logarithmic lookup.
#[embed("font8x16.map")]
val FONT_MAP: [14292]u8;
val FONT_MAP_COUNT: u64 = 3573;
val REPLACEMENT_GLYPH: u64 = 3452;

val GW:        u64 = 8;
val GH:        u64 = 16;
val MAX_CELLS: u64 = 32768; # 240x135 cells is 1920x2160, plenty

# the 16 colours, in ANSI order: black red green yellow blue magenta cyan
# white, then their bright versions
pub val SCREENS: u64 = 6;

# one terminal's screen: its characters, colours, cursor, escape parser
# and history. only the screen shown is painted
rec Screen {
    cells:     [32768]u64; # base + two 21-bit combining codepoints
    attrs:     [32768]u64; # packed framebuffer pixels: foreground low, background high
    hist_c:    [98304]u64; # lines that scrolled off, a ring of hist_max lines
    hist_a:    [98304]u64;
    hist_head: u64; # where the next line goes
    hist_n:    u64; # lines kept
    view:      u64; # lines scrolled back, 0 = live
    cx:        u64;
    cy:        u64;
    fg:        u32;
    bg:        u32;
    fg_index:  u64; # basic ANSI index, or 256 for an explicit colour
    bold:      u8;
    reverse:   u8;
    esc:       u8; # 0 normal, 1 after ESC, 2 inside ESC[
    params:    [32]u64;
    nparams:   u64;
    invalid:   u8; # discard overlong or overflowing CSI sequences
    utf_code:  u32; # partially decoded UTF-8 codepoint
    utf_min:   u32; # shortest legal value for this sequence length
    utf_need:  u8;  # continuation bytes still required
}

var screens: [6]Screen;
var s:       *Screen = nil; # the screen being written
var shown:   u64     = 0; # the screen on display

# bright magenta (13) is the mach colour, #fe01ff
val PAL_R: [16]u8 = [16]u8{0x00, 0xAA, 0x00, 0xAA, 0x00, 0xAA, 0x00, 0xAA, 0x55, 0xFF, 0x55, 0xFF, 0x55, 0xFE, 0x55, 0xFF};
val PAL_G: [16]u8 = [16]u8{0x00, 0x00, 0xAA, 0x55, 0x00, 0x00, 0xAA, 0xAA, 0x55, 0x55, 0xFF, 0xFF, 0x55, 0x01, 0xFF, 0xFF};
val PAL_B: [16]u8 = [16]u8{0x00, 0x00, 0x00, 0x00, 0xAA, 0xAA, 0xAA, 0xAA, 0x55, 0x55, 0x55, 0x55, 0xFF, 0xFF, 0xFF, 0xFF};

var base:      u64 = 0; # virtual address of pixel (0,0), 0 = no console
var pitch:     u64 = 0;
var width_px:  u64 = 0;
var height_px: u64 = 0;
var cols:      u64 = 0;
var rows:      u64 = 0;
var palette:   [16]u32;
var format:    info.Framebuffer;

val HIST_CELLS: u64 = 98304;
var hist_max:   u64 = 0;

fun channel(v: u32, size: u8, shift: u8) u32 {
    # scale an 8-bit channel down to `size` bits, then place it
    ret (v >> (8 - size::u32)) << shift::u32;
}

fun rgb(f: *info.Framebuffer, r: u32, g: u32, b: u32) u32 {
    ret channel(r, f.r_size, f.r_shift)
        | channel(g, f.g_size, f.g_shift)
        | channel(b, f.b_size, f.b_shift);
}

fun paint(i: u64, a: u64) {
    val cell: u64 = s.cells[i];
    if ((cell >> 21) == 0) { paint_char(i, cell::u32, a); ret; }
    paint_cell(i, cell::u32 & 0x1FFFFF, ((cell >> 21)::u32) & 0x1FFFFF,
               ((cell >> 42)::u32) & 0x1FFFFF, a);
}

fun map_code(i: u64) u32 {
    val at: u64 = i * 4;
    ret FONT_MAP[at]::u32 | (FONT_MAP[at + 1]::u32 << 8) |
        (FONT_MAP[at + 2]::u32 << 16) | (FONT_MAP[at + 3]::u32 << 24);
}

fun font_index(cp: u32) u64 {
    if (cp < 128) { ret cp::u64; }
    var lo: u64 = 0;
    var hi: u64 = FONT_MAP_COUNT;
    for (lo < hi) {
        val mid: u64 = lo + (hi - lo) / 2;
        val found: u32 = map_code(mid);
        if (found < cp) { lo = mid + 1; }
        or              { hi = mid; }
    }
    if (lo < FONT_MAP_COUNT && map_code(lo) == cp) { ret lo + 128; }
    ret REPLACEMENT_GLYPH;
}

fun glyph_row(cp: u32, y: u64) u8 {
    if (cp < 128) { ret FONT[cp::u64 * GH + y]; }
    ret FONT[font_index(cp) * GH + y];
}

fun paint_char(i: u64, cp: u32, a: u64) {
    val fg: u32 = a::u32;
    val bg: u32 = (a >> 32)::u32;
    val px: u64 = base + (i / cols) * GH * pitch + (i % cols) * GW * 4;
    var y:  u64 = 0;
    for (y < GH) {
        val bits: u8   = glyph_row(cp, y);
        val row:  *u32 = (px + y * pitch)::*u32;
        var x:    u64  = 0;
        for (x < GW) {
            if (((bits << x::u8) & 0x80) != 0) { row[x] = fg; }
            or                                 { row[x] = bg; }
            x = x + 1;
        }
        y = y + 1;
    }
}

fun overlay_char(i: u64, cp: u32, fg: u32) {
    if (cp == 0) { ret; }
    val px: u64 = base + (i / cols) * GH * pitch + (i % cols) * GW * 4;
    var y: u64 = 0;
    for (y < GH) {
        val bits: u8 = glyph_row(cp, y);
        val row: *u32 = (px + y * pitch)::*u32;
        var x: u64 = 0;
        for (x < GW) {
            if (((bits << x::u8) & 0x80) != 0) { row[x] = fg; }
            x = x + 1;
        }
        y = y + 1;
    }
}

fun paint_cell(i: u64, cp: u32, m1: u32, m2: u32, a: u64) {
    paint_char(i, cp, a);
    if (m1 != 0) { overlay_char(i, m1, a::u32); }
    if (m2 != 0) { overlay_char(i, m2, a::u32); }
}

fun draw(i: u64) {
    paint(i, s.attrs[i]);
}

# whether what is written now should reach the pixels
fun visible() u8 {
    ret (s == ?screens[shown] && s.view == 0)::u8;
}

fun set_packed(i: u64, cell: u64, a: u64) {
    if (s.cells[i] != cell || s.attrs[i] != a) {
        s.cells[i] = cell;
        s.attrs[i] = a;
        if (visible() != 0) { draw(i); }
    }
}

fun set_full(i: u64, c: u32, m1: u32, m2: u32, a: u64) {
    set_packed(i, c::u64 | (m1::u64 << 21) | (m2::u64 << 42), a);
}

fun set(i: u64, c: u32, a: u64) { set_packed(i, c::u64, a); }

# the cursor is the cell under it drawn with fg and bg swapped
fun cursor_cell() u64 {
    var x: u64 = s.cx;
    if (x >= cols) { x = cols - 1; }
    ret s.cy * cols + x;
}

fun hide() {
    if (visible() != 0) { draw(cursor_cell()); }
}

fun show() {
    if (visible() == 0) { ret; }
    val i: u64 = cursor_cell();
    val a: u64 = s.attrs[i];
    paint(i, (a << 32) | (a >> 32));
}

# an empty cell: the current background, a visible foreground for the cursor
fun colours() u64 {
    var fg: u32 = s.fg;
    if (s.bold != 0 && s.fg_index < 8) { fg = palette[s.fg_index + 8]; }
    if (s.reverse != 0)                { ret s.bg::u64 | (fg::u64 << 32); }
    ret fg::u64 | (s.bg::u64 << 32);
}

fun blank() u64 {
    ret (colours() & 0xFFFFFFFF00000000) | palette[7]::u64;
}

# keep the top line before it scrolls away
fun remember() {
    if (hist_max == 0) { ret; }
    val at: u64 = s.hist_head * cols;
    var k:  u64 = 0;
    for (k < cols) {
        s.hist_c[at + k] = s.cells[k];
        s.hist_a[at + k] = s.attrs[k];
        k                = k + 1;
    }
    s.hist_head = (s.hist_head + 1) % hist_max;
    if (s.hist_n < hist_max) { s.hist_n = s.hist_n + 1; }
}

fun scroll() {
    remember();
    val n: u64 = (rows - 1) * cols;
    var i: u64 = 0;
    for (i < n) {
        set_packed(i, s.cells[i + cols], s.attrs[i + cols]);
        i = i + 1;
    }
    for (i < rows * cols) {
        set(i, 32, blank());
        i = i + 1;
    }
}

fun newline() {
    s.cx = 0;
    if (s.cy + 1 < rows) { s.cy = s.cy + 1; }
    or                   { scroll(); }
}

fun clear_from(i: u64, end: u64) {
    var k: u64 = i;
    for (k < end) {
        set(k, 32, blank());
        k = k + 1;
    }
}

# indexed colours use the ANSI palette, 6x6x6 cube and 24 grey levels
fun indexed(n: u64) u32 {
    if (n < 16) { ret palette[n]; }
    if (n >= 232) {
        val v: u32 = (8 + (n - 232) * 10)::u32;
        ret rgb(?format, v, v, v);
    }
    val k:     u64    = n - 16;
    val level: [6]u32 = [6]u32{0, 95, 135, 175, 215, 255};
    ret rgb(?format, level[k / 36], level[(k / 6) % 6], level[k % 6]);
}

fun foreground(n: u64) {
    s.fg_index = n;
    s.fg       = palette[n];
}

fun sgr(p: u64) {
    if (p == 0) {
        foreground(7);
        s.bg      = palette[0];
        s.bold    = 0;
        s.reverse = 0;
    }
    or (p == 1)               { s.bold = 1; }
    or (p == 22)              { s.bold = 0; }
    or (p == 7)               { s.reverse = 1; }
    or (p == 27)              { s.reverse = 0; }
    or (p >= 30 && p <= 37)   { foreground(p - 30); }
    or (p >= 90 && p <= 97)   { foreground(p - 90 + 8); }
    or (p == 39)              { foreground(7); }
    or (p >= 40 && p <= 47)   { s.bg = palette[p - 40]; }
    or (p >= 100 && p <= 107) { s.bg = palette[p - 100 + 8]; }
    or (p == 49)              { s.bg = palette[0]; }
}

fun sgr_all() {
    if (s.nparams == 0) { sgr(0); }
    var i: u64 = 0;
    for (i < s.nparams) {
        val p: u64 = s.params[i];
        if (p == 38 || p == 48) {
            # consume the whole colour operand, even when its channels are invalid
            if (i + 1 >= s.nparams) { brk; }
            val mode:   u64 = s.params[i + 1];
            var colour: u32 = 0;
            var valid:  u8  = 0;
            if (mode == 2) {
                if (i + 4 >= s.nparams) { brk; }
                val r: u64 = s.params[i + 2];
                val g: u64 = s.params[i + 3];
                val b: u64 = s.params[i + 4];
                if (r <= 255 && g <= 255 && b <= 255) {
                    colour = rgb(?format, r::u32, g::u32, b::u32);
                    valid  = 1;
                }
                i = i + 5;
            }
            or (mode == 5) {
                if (i + 2 >= s.nparams) { brk; }
                if (s.params[i + 2] <= 255) {
                    colour = indexed(s.params[i + 2]);
                    valid  = 1;
                }
                i = i + 3;
            }
            or { brk; }
            if (valid != 0) {
                if (p == 38) {
                    s.fg       = colour;
                    s.fg_index = 256;
                }
                or { s.bg = colour; }
            }
        }
        or {
            sgr(p);
            i = i + 1;
        }
    }
}

fun csi(final: u8) {
    if (final == 109) { # m
        sgr_all();
    }
    or (final == 74) { # J: 2 = whole screen
        if (s.nparams > 0 && s.params[0] == 2) {
            clear_from(0, rows * cols);
            s.cx = 0;
            s.cy = 0;
        }
        or {
            clear_from(cursor_cell(), rows * cols);
        }
    }
    or (final == 72) { # H: row;col, 1-based
        var r: u64 = 1;
        var c: u64 = 1;
        if (s.nparams > 0 && s.params[0] > 0) { r = s.params[0]; }
        if (s.nparams > 1 && s.params[1] > 0) { c = s.params[1]; }
        if (r > rows)                         { r = rows; }
        if (c > cols)                         { c = cols; }
        s.cy = r - 1;
        s.cx = c - 1;
    }
    or (final == 67 || final == 68) { # C / D: n columns right / left
        var k: u64 = 1;
        if (s.nparams > 0 && s.params[0] > 0) { k = s.params[0]; }
        if (final == 67) {
            s.cx = s.cx + k;
            if (s.cx >= cols) { s.cx = cols - 1; }
        }
        or {
            if (k > s.cx) { s.cx = 0; }
            or            { s.cx = s.cx - k; }
        }
    }
    or (final == 71) { # G: column n, 1-based
        var k: u64 = 1;
        if (s.nparams > 0 && s.params[0] > 0) { k = s.params[0]; }
        if (k > cols)                         { k = cols; }
        s.cx = k - 1;
    }
    or (final == 75) { # K: to the end of the line
        clear_from(cursor_cell(), (s.cy + 1) * cols);
    }
}

# take over the framebuffer; returns 0 when it is missing or not 32 bpp
pub fun init(f: *info.Framebuffer) u8 {
    if (f.addr == 0 || f.bpp != 32)                                                                                        { ret 0; }
    if (f.r_size == 0 || f.g_size == 0 || f.b_size == 0 || f.r_size > 8 || f.g_size > 8 || f.b_size > 8)                   { ret 0; }
    if (f.r_shift::u64 + f.r_size::u64 > 32 || f.g_shift::u64 + f.g_size::u64 > 32 || f.b_shift::u64 + f.b_size::u64 > 32) { ret 0; }
    if (f.width < GW || f.height < GH || f.pitch < f.width * 4)                                                            { ret 0; }
    format    = @f;
    width_px  = f.width;
    height_px = f.height;
    base      = f.addr;
    pitch     = f.pitch;
    cols      = f.width / GW;
    rows      = f.height / GH;
    if (cols * rows > MAX_CELLS) { rows = MAX_CELLS / cols; }
    var k: u64 = 0;
    for (k < 16) {
        palette[k] = rgb(f, PAL_R[k]::u32, PAL_G[k]::u32, PAL_B[k]::u32);
        k          = k + 1;
    }

    # paint every pixel, including the strip right of the last column
    var y: u64 = 0;
    for (y < f.height) {
        val row: *u32 = (base + y * pitch)::*u32;
        var x:   u64  = 0;
        for (x < f.width) {
            row[x] = palette[0];
            x      = x + 1;
        }
        y = y + 1;
    }
    var n: u64 = 0;
    for (n < SCREENS) {
        s = ?screens[n];
        var i: u64 = 0;
        for (i < rows * cols) {
            s.cells[i] = 32;
            s.attrs[i] = palette[7]::u64 | (palette[0]::u64 << 32);
            i          = i + 1;
        }
        sgr(0);
        s.cx        = 0;
        s.cy        = 0;
        s.hist_head = 0;
        s.hist_n    = 0;
        s.view      = 0;
        s.esc       = 0;
        s.nparams   = 0;
        s.invalid   = 0;
        s.utf_code  = 0;
        s.utf_min   = 0;
        s.utf_need  = 0;
        n           = n + 1;
    }
    hist_max = HIST_CELLS / cols;
    shown    = 0;
    s        = ?screens[0];
    show();
    ret 1;
}

# paint the screen as seen `view` lines back
fun repaint() {
    var r: u64 = 0;
    for (r < rows) {
        var k: u64 = 0;
        if (r < s.view) {
            # history line (view - r) back from the newest
            val line: u64 = (s.hist_head + hist_max - (s.view - r)) % hist_max;
            for (k < cols) {
                val cell: u64 = s.hist_c[line * cols + k];
                paint_cell(r * cols + k, cell::u32 & 0x1FFFFF, ((cell >> 21)::u32) & 0x1FFFFF,
                           ((cell >> 42)::u32) & 0x1FFFFF, s.hist_a[line * cols + k]);
                k = k + 1;
            }
        }
        or {
            val src: u64 = (r - s.view) * cols;
            for (k < cols) {
                val cell: u64 = s.cells[src + k];
                paint_cell(r * cols + k, cell::u32 & 0x1FFFFF, ((cell >> 21)::u32) & 0x1FFFFF,
                           ((cell >> 42)::u32) & 0x1FFFFF, s.attrs[src + k]);
                k = k + 1;
            }
        }
        r = r + 1;
    }
    show();
}

# put screen `n` on display
pub fun show_screen(n: u64) {
    if (base == 0 || n >= SCREENS) { ret; }
    shown = n;
    s     = ?screens[n];
    repaint();
}

# page back through the history of the screen on display (shift+pgup) and
# forward again (shift+pgdn)
pub fun view_up() {
    if (base == 0) { ret; }
    s = ?screens[shown];
    if (s.hist_n == 0) { ret; }
    var v: u64 = s.view + rows / 2;
    if (v > s.hist_n) { v = s.hist_n; }
    if (v == s.view)  { ret; }
    s.view = v;
    repaint();
}

pub fun view_down() {
    if (base == 0) { ret; }
    s = ?screens[shown];
    if (s.view == 0)       { ret; }
    if (s.view > rows / 2) { s.view = s.view - rows / 2; }
    or                     { s.view = 0; }
    repaint();
}

pub fun cols_of() u64 {
    ret cols;
}

pub fun width_of() u64 {
    ret width_px;
}

pub fun height_of() u64 {
    ret height_px;
}

pub fun rows_of() u64 {
    ret rows;
}

# The Unicode codepoint stored in a terminal cell (also useful to diagnostics).
pub fun cell_at(screen: u64, cell: u64) u32 {
    if (screen >= SCREENS || cell >= rows * cols) { ret 0; }
    ret screens[screen].cells[cell]::u32 & 0x1FFFFF;
}

pub fun mark_at(screen: u64, cell: u64, second: u8) u32 {
    if (screen >= SCREENS || cell >= rows * cols) { ret 0; }
    val packed: u64 = screens[screen].cells[cell];
    if (second != 0) { ret ((packed >> 42)::u32) & 0x1FFFFF; }
    ret ((packed >> 21)::u32) & 0x1FFFFF;
}

fun combining(cp: u32) u8 {
    ret ((cp >= 0x0300 && cp <= 0x036F) || (cp >= 0x1AB0 && cp <= 0x1AFF) ||
         (cp >= 0x1DC0 && cp <= 0x1DFF) || (cp >= 0x20D0 && cp <= 0x20FF) ||
         (cp >= 0xFE20 && cp <= 0xFE2F))::u8;
}

fun put_code(cp: u32) {
    if (combining(cp) != 0) {
        if (s.cx == 0) { ret; }
        val i: u64 = s.cy * cols + s.cx - 1;
        var cell: u64 = s.cells[i];
        if (((cell >> 21) & 0x1FFFFF) == 0) { cell = cell | (cp::u64 << 21); }
        or                                  { cell = (cell & 0x3FFFFFFFFFF) | (cp::u64 << 42); }
        s.cells[i] = cell;
        if (visible() != 0) { draw(i); }
        ret;
    }
    if (s.cx >= cols) { newline(); }
    set(s.cy * cols + s.cx, cp, colours());
    s.cx = s.cx + 1;
}

fun replacement() {
    s.utf_code = 0;
    s.utf_min = 0;
    s.utf_need = 0;
    put_code(0xFFFD);
}

fun put(c: u8) {
    if (s.esc == 1) {
        if (c == 91) { # [
            s.esc       = 2;
            s.nparams   = 0;
            s.params[0] = 0;
            s.invalid   = 0;
        }
        or {
            s.esc = 0;
        }
        ret;
    }
    if (s.esc == 2) {
        if (c >= 48 && c <= 57) {
            if (s.nparams == 0)                    { s.nparams = 1; }
            if (s.params[s.nparams - 1] > 1000000) { s.invalid = 1; }
            if (s.invalid == 0)                    { s.params[s.nparams - 1] = s.params[s.nparams - 1] * 10 + (c - 48)::u64; }
        }
        or (c == 59) { # ;
            if (s.nparams == 0) { s.nparams = 1; }
            if (s.nparams < 32) {
                s.params[s.nparams] = 0;
                s.nparams           = s.nparams + 1;
            }
            or { s.invalid = 1; }
        }
        or (c >= 64 && c <= 126) {
            s.esc = 0;
            if (s.invalid == 0) { csi(c); }
        }
        or (c != 63) { # tolerate '?' in private modes, give up on the rest
            s.esc = 0;
        }
        ret;
    }
    if (c == 27) {
        if (s.utf_need != 0) { replacement(); }
        s.esc = 1;
        ret;
    }
    if (c == 10) {
        if (s.utf_need != 0) { replacement(); }
        newline();
        ret;
    }
    if (c == 13) {
        if (s.utf_need != 0) { replacement(); }
        s.cx = 0;
        ret;
    }
    if (c == 12) { # form feed clears the screen
        if (s.utf_need != 0) { replacement(); }
        clear_from(0, rows * cols);
        s.cx = 0;
        s.cy = 0;
        ret;
    }
    if (c == 8) {
        if (s.utf_need != 0) { replacement(); }
        if (s.cx > 0) { s.cx = s.cx - 1; }
        ret;
    }
    if (c == 9) {
        if (s.utf_need != 0) { replacement(); }
        put_code(32);
        for ((s.cx % 8) != 0 && s.cx < cols) { put_code(32); }
        ret;
    }
    if (c < 32) {
        if (s.utf_need != 0) { replacement(); }
        ret;
    }
    if (c < 128) {
        if (s.utf_need != 0) { replacement(); }
        put_code(c::u32);
        ret;
    }
    if (c >= 0x80 && c < 0xC0) {
        if (s.utf_need == 0) { replacement(); ret; }
        s.utf_code = (s.utf_code << 6) | (c & 0x3F)::u32;
        s.utf_need = s.utf_need - 1;
        if (s.utf_need == 0) {
            val cp: u32 = s.utf_code;
            val minimum: u32 = s.utf_min;
            s.utf_code = 0;
            s.utf_min = 0;
            if (cp < minimum || (cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF) { replacement(); }
            or { put_code(cp); }
        }
        ret;
    }
    if (s.utf_need != 0) { replacement(); }
    if (c >= 0xC2 && c <= 0xDF) {
        s.utf_code = (c & 0x1F)::u32;
        s.utf_min = 0x80;
        s.utf_need = 1;
    }
    or (c >= 0xE0 && c <= 0xEF) {
        s.utf_code = (c & 0x0F)::u32;
        s.utf_min = 0x800;
        s.utf_need = 2;
    }
    or (c >= 0xF0 && c <= 0xF4) {
        s.utf_code = (c & 0x07)::u32;
        s.utf_min = 0x10000;
        s.utf_need = 3;
    }
    or { replacement(); }
}

# a byte for screen `n`
pub fun putc_on(n: u64, c: u8) {
    if (base == 0 || n >= SCREENS) { ret; }
    s = ?screens[n];
    if (s.view != 0 && n == shown) { # output: back to the live screen
        s.view = 0;
        repaint();
    }
    hide();
    put(c);
    show();
}
