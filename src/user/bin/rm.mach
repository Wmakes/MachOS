# rm [-r] PATH...: remove files and empty directories (-r: and everything in them)

use abi: machos.abi.sys;
use sys: machos.user.sys;
use io:  machos.user.io;
use rt:  machos.user.rt;

var recursive: u8 = 0;

fun remove(p: *u8, n: u64) u8 {
    if (recursive != 0) {
        var st: abi.Stat;
        val s: u64 = sys.stat(p, n, ?st);
        if (abi.is_err(s) == 0 && st.kind == abi.KIND_DIR) {
            val h: u64 = sys.open(p, n, abi.O_READ);
            if (abi.is_err(h) == 0) {
                # always take entry 0: removing it shifts the rest down
                for {
                    var e: abi.Entry;
                    val got: u64 = sys.readdir(h, 0, ?e);
                    if (abi.is_err(got) != 0 || got == 0) { brk; }
                    var child: [256]u8;
                    if (n + 1 + e.name_len >= 256) { brk; }
                    io.copy(?child[0], p, n);
                    child[n] = 47;
                    io.copy(?child[n + 1], ?e.name[0], e.name_len);
                    if (remove(?child[0], n + 1 + e.name_len) == 0) { brk; }
                }
                sys.close(h);
            }
        }
    }
    val r: u64 = sys.remove(p, n);
    if (abi.is_err(r) != 0) {
        io.err("rm: \0");
        io.errn(p, n);
        io.err(": \0");
        io.err(abi.err_name(r));
        io.err("\n\0");
        ret 0;
    }
    ret 1;
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var i: u64 = 1;
    if (argc > 1 && io.streq(argv[1], "-r\0") != 0) {
        recursive = 1;
        i = 2;
    }
    if (i == argc) {
        io.err("usage: rm [-r] PATH...\n\0");
        ret 2;
    }
    var status: u64 = 0;
    for (i < argc) {
        if (remove(argv[i], io.len(argv[i])) == 0) { status = 1; }
        i = i + 1;
    }
    ret status;
}
