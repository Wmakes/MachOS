# finding commands the way a shell does: a name with a slash is used as it
# is, anything else is looked for in each directory of $PATH (/bin when
# PATH is unset; an empty entry means the current directory)

use abi: sdk.abi;
use sys: sdk.sys;
use env: sdk.env;

fun slen(s: *u8) u64 {
    var n: u64 = 0;
    for (s[n] != 0) { n = n + 1; }
    ret n;
}

fun put(out: *u8, at: u64, s: *u8, n: u64) {
    var i: u64 = 0;
    for (i < n) {
        out[at + i] = s[i];
        i = i + 1;
    }
}

fun is_file(p: *u8, n: u64) u8 {
    var st: abi.Stat;
    if (abi.is_err(sys.stat(p, n, ?st)) != 0) { ret 0; }
    if (st.kind == abi.KIND_FILE) { ret 1; }
    ret 0;
}

# the path `name` runs from into out (256 bytes, NUL-terminated); its
# length, or 0 when there is no such command
pub fun lookup(name: *u8, out: *u8) u64 {
    val n: u64 = slen(name);
    if (n == 0 || n >= 255) { ret 0; }
    var i: u64 = 0;
    for (i < n) {
        if (name[i] == 47) {
            put(out, 0, name, n);
            out[n] = 0;
            if (is_file(out, n) == 0) { ret 0; }
            ret n;
        }
        i = i + 1;
    }
    var p: *u8 = env.get("PATH\0");
    if (p == nil) { p = "/bin\0"; }
    val pn: u64 = slen(p);
    var s: u64 = 0;
    i = 0;
    for (i <= pn) {
        if (i == pn || p[i] == 58) {
            var len: u64 = i - s;
            if (len == 0) {
                out[0] = 46;
                len = 1;
            } or {
                put(out, 0, ?p[s], len);
            }
            if (len + 1 + n < 256) {
                out[len] = 47;
                put(out, len + 1, name, n);
                out[len + 1 + n] = 0;
                if (is_file(out, len + 1 + n) != 0) { ret len + 1 + n; }
            }
            s = i + 1;
        }
        i = i + 1;
    }
    ret 0;
}
