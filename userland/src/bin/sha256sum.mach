# sha256sum [FILE...]: SHA-256 of each file (or stdin)

use abi:    sdk.abi;
use sys:    sdk.sys;
use io:     sdk.io;
use sha256: sdk.sha256;
use rt:     sdk.rt;

var buf: [8192]u8;
val HEX: *u8 = "0123456789abcdef\0";

fun sum(h: u64, name: *u8) {
    var c: sha256.Ctx;
    sha256.init(?c);
    for {
        val r: u64 = sys.read(h, ?buf[0], 8192);
        if (abi.is_err(r) != 0 || r == 0) { brk; }
        sha256.update(?c, ?buf[0], r);
    }
    var d: [32]u8;
    sha256.finish(?c, ?d[0]);
    var k: u64 = 0;
    for (k < 32) {
        io.putc(HEX[d[k] >> 4]);
        io.putc(HEX[d[k] & 15]);
        k = k + 1;
    }
    io.out("  \0");
    io.out(name);
    io.putc(10);
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc < 2) {
        sum(abi.STDIN, "-\0");
        ret 0;
    }
    var status: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        val h: u64 = sys.open(argv[i], io.len(argv[i]), abi.O_READ);
        if (abi.is_err(h) != 0) {
            io.fail("sha256sum\0", argv[i], h);
            status = 1;
        } or {
            sum(h, argv[i]);
            sys.close(h);
        }
        i = i + 1;
    }
    ret status;
}
