# sync: put every pending write on the disk

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    val r: u64 = sys.sync();
    if (abi.is_err(r) != 0) {
        io.fail("sync\0", nil, r);
        ret 1;
    }
    ret 0;
}
