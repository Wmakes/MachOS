# Copy files and directory trees, optionally retaining existing destinations.

use os:  std.system.os;
use io:  userland.lib.cli;
use opt: userland.lib.options;
use std.runtime;

var recursive: u8 = 0;
var keep: u8 = 0;
var verbose: u8 = 0;
var root_dev: u64 = 0;
var root_ino: u64 = 0;
var buf: [8192]u8;

fun is_dir(p: *u8, n: u64) u8 {
    var st: os.stat_t;
    if (io.stat(p, ?st) < 0) { ret 0; }
    if (io.kind_of(st.st_mode) == io.KIND_DIR) { ret 1; }
    ret 0;
}

fun complain(p: *u8, n: u64, e: i64) {
    io.emsg("cp: \0");
    io.errn(p, n);
    io.emsg(": \0");
    io.err(io.reason(e));
    io.emsg("\n\0");
}

fun copy_file(src: *u8, sn: u64, dst: *u8, dn: u64) u8 {
    val from: i64 = io.open_read(src);
    if (from < 0) {
        complain(src, sn, from);
        ret 0;
    }
    var st: os.stat_t;
    if (io.fstat(from, ?st) < 0) { io.close(from); io.emsg("cp: cannot stat source\n"); ret 0; }
    var dstst: os.stat_t;
    if (io.stat(dst, ?dstst) >= 0) {
        if (st.st_dev == dstst.st_dev && st.st_ino == dstst.st_ino) {
            io.close(from); io.emsg("cp: source and destination are the same file\n"); ret 0;
        }
        if (keep != 0) { io.close(from); ret 1; }
    }
    val to: i64 = io.open_mode(dst, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, io.perms(?st) & 0x1FF);
    if (to < 0) {
        io.close(from);
        complain(dst, dn, to);
        ret 0;
    }
    var ok: u8 = 1;
    for {
        val r: i64 = io.read(from, ?buf[0], 8192);
        if (r < 0) {
            complain(src, sn, r);
            ok = 0;
            brk;
        }
        if (r == 0) { brk; }
        if (io.write_all(to, ?buf[0], r::u64) == 0) {
            io.emsg("cp: write failed: \0");
            io.errn(dst, dn);
            io.emsg("\n\0");
            ok = 0;
            brk;
        }
    }
    io.close(from);
    io.close(to);
    # Do not grant set-id privileges when creating a copy owned by another user.
    io.chmod(dst, io.perms(?st) & 0o777);
    if (ok != 0 && verbose != 0) { io.outn(src, sn); io.msg(" -> "); io.outn(dst, dn); io.putc(10); }
    ret ok;
}

fun copy(src: *u8, sn: u64, dst: *u8, dn: u64) u8 {
    var identity: os.stat_t;
    if (io.stat(src, ?identity) >= 0 && identity.st_dev::u64 == root_dev && identity.st_ino::u64 == root_ino) {
        io.emsg("cp: cannot copy a directory into itself\n"); ret 0;
    }
    if (is_dir(src, sn) == 0) { ret copy_file(src, sn, dst, dn); }
    var target: os.stat_t;
    if (io.stat(dst, ?target) >= 0 && io.stat(src, ?identity) >= 0 && target.st_dev == identity.st_dev && target.st_ino == identity.st_ino) {
        io.emsg("cp: source and destination are the same directory\n"); ret 0;
    }
    if (recursive == 0) {
        io.emsg("cp: \0");
        io.errn(src, sn);
        io.emsg(": is a directory (use -r)\n\0");
        ret 0;
    }
    if (is_dir(dst, dn) == 0) {
        var sst: os.stat_t;
        io.stat(src, ?sst);
        val m: i64 = io.mkdir(dst, io.perms(?sst));
        if (m < 0) {
            complain(dst, dn, m);
            ret 0;
        }
    }
    var created: os.stat_t;
    if (io.stat(dst, ?created) < 0) { io.emsg("cp: cannot stat destination\n"); ret 0; }
    if (root_ino == 0) { root_dev = created.st_dev::u64; root_ino = created.st_ino::u64; }
    val h: i64 = io.open_read(src);
    if (h < 0) {
        complain(src, sn, h);
        ret 0;
    }
    var ok: u8 = 1;
    var dir: io.Dir;
    if (io.dir_from(?dir, h) < 0) {
        complain(src, sn, -1);
        ret 0;
    }
    for (io.dir_next(?dir) > 0) {
        var s: [256]u8;
        var d: [256]u8;
        if (sn + 1 + dir.len >= 256 || dn + 1 + dir.len >= 256) {
            io.emsg("cp: path too long\n\0");
            ok = 0;
            cnt;
        }
        io.copy(?s[0], src, sn);
        s[sn] = 47;
        io.copy(?s[sn + 1], dir.name, dir.len);
        s[sn + 1 + dir.len] = 0;
        io.copy(?d[0], dst, dn);
        d[dn] = 47;
        io.copy(?d[dn + 1], dir.name, dir.len);
        d[dn + 1 + dir.len] = 0;
        if (copy(?s[0], sn + 1 + dir.len, ?d[0], dn + 1 + dir.len) == 0) { ok = 0; }
    }
    io.dir_close(?dir);
    ret ok;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    if (opt.standard(argc, argv, "cp", "usage: cp [-rRnv] [--] SOURCE... DEST\n  -r, -R, --recursive  copy directories\n  -n, --no-clobber     keep existing files\n  -v, --verbose        print copied paths") != 0) { ret 0; }
    var p: opt.Parser; opt.init(?p, argc, argv);
    for {
        val c: u8 = opt.next(?p, "recursive=r,no-clobber=n,verbose=v"); if (c == 0) { brk; }
        if (c == 114 || c == 82) { recursive = 1; } or (c == 110) { keep = 1; }
        or (c == 118) { verbose = 1; } or { p.bad = 1; }
    }
    if (p.bad != 0 || argc - p.at < 2) { ret opt.error("cp"); }
    var i: u64 = p.at;
    val dest: *u8 = argv[argc - 1];
    val dl: u64 = io.len(dest);
    val into: u8 = is_dir(dest, dl);
    if (argc - i > 2 && into == 0) {
        io.emsg("cp: \0");
        io.err(dest);
        io.emsg(": not a directory\n\0");
        ret 1;
    }
    var status: u64 = 0;
    for (i < argc - 1) {
        root_dev = 0; root_ino = 0;
        val src: *u8 = argv[i];
        val sl: u64 = io.len(src);
        if (into == 0) {
            if (copy(src, sl, dest, dl) == 0) { status = 1; }
        } or {
            # DEST/basename(SRC)
            var b: u64 = sl;
            for (b > 0 && src[b - 1] == 47) { b = b - 1; }
            var s: u64 = b;
            for (s > 0 && src[s - 1] != 47) { s = s - 1; }
            var d: [256]u8;
            if (dl + 1 + (b - s) >= 256) {
                io.emsg("cp: path too long\n\0");
                status = 1;
            } or {
                io.copy(?d[0], dest, dl);
                d[dl] = 47;
                io.copy(?d[dl + 1], ?src[s], b - s);
                d[dl + 1 + (b - s)] = 0;
                if (copy(src, sl, ?d[0], dl + 1 + (b - s)) == 0) { status = 1; }
            }
        }
        i = i + 1;
    }
    ret status;
}
