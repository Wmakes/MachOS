# xargs COMMAND [ARGS...]: run COMMAND with ARGS and the words read from stdin

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;
use path: sdk.path;

val CAP: u64 = 65536;
var args: [65536]u8;
var input: [65536]u8;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc < 2) {
        io.err("usage: xargs COMMAND [ARGS...]\n\0");
        ret 2;
    }
    var full: [256]u8;
    val pn: u64 = path.lookup(argv[1], ?full[0]);
    if (pn == 0) {
        io.err("xargs: \0");
        io.err(argv[1]);
        io.err(": command not found\n\0");
        ret 127;
    }
    var n: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        val l: u64 = io.len(argv[i]);
        if (n + l + 1 > CAP) { ret 2; }
        io.copy(?args[n], argv[i], l + 1);
        n = n + l + 1;
        i = i + 1;
    }
    var got: u64 = 0;
    for (got < CAP) {
        val r: u64 = sys.read(abi.STDIN, ?input[got], CAP - got);
        if (abi.is_err(r) != 0 || r == 0) { brk; }
        got = got + r;
    }
    i = 0;
    for (i < got) {
        for (i < got && (input[i] == 32 || input[i] == 10 || input[i] == 9)) { i = i + 1; }
        val s: u64 = i;
        for (i < got && input[i] != 32 && input[i] != 10 && input[i] != 9) { i = i + 1; }
        if (i > s) {
            if (n + (i - s) + 1 > CAP) {
                io.err("xargs: too much input\n\0");
                ret 1;
            }
            io.copy(?args[n], ?input[s], i - s);
            n = n + (i - s);
            args[n] = 0;
            n = n + 1;
        }
    }
    val pid: u64 = sys.spawn(?full[0], pn, ?args[0], n, nil);
    if (abi.is_err(pid) != 0) {
        io.fail("xargs\0", argv[1], pid);
        ret 127;
    }
    val st: u64 = sys.wait(pid);
    if (abi.is_err(st) != 0) { ret 1; }
    ret st;
}
