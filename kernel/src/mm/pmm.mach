# Physical page allocator: untouched ranges plus a list of returned pages.
# Do not write into every free page at boot: large guests would immediately
# consume their entire RAM allocation on the host before running any work.

use info: machos.boot.info;

pub val PAGE: u64 = 4096;

var hhdm: u64 = 0;
var head: u64 = 0; # physical address of the first free page, 0 = empty
var free_count: u64 = 0;
var total_count: u64 = 0;

rec Range { start: u64; end: u64; }
var ranges: [256]Range;
var range_count: u64 = 0;

# Detached pages stay intact until every CPU has discarded old translations.
var pending: [4096]u64;
var pending_count: u64 = 0;
var synchronize: fun();
var deferred: u8 = 0;

pub fun defer_reuse(sync: fun()) { synchronize = sync; deferred = 1; }

fun return_page(phys: u64) {
    @link_of(phys) = head;
    head = phys;
    free_count = free_count + 1;
}

pub fun reclaim() {
    if (pending_count == 0) { ret; }
    synchronize();
    for (pending_count != 0) {
        pending_count = pending_count - 1;
        return_page(pending[pending_count]);
    }
}

fun link_of(phys: u64) *u64 {
    ret (phys + hhdm)::*u64;
}

pub fun free(phys: u64) {
    if (deferred == 0) { return_page(phys); ret; }
    if (pending_count == 4096) { reclaim(); }
    pending[pending_count] = phys;
    pending_count = pending_count + 1;
}

# one 4 KiB page as it is (not zeroed), or 0 when out of memory
pub fun alloc_raw() u64 {
    if (free_count == 0 && pending_count != 0) { reclaim(); }
    if (head != 0) {
        val phys: u64 = head;
        head = @link_of(phys);
        free_count = free_count - 1;
        ret phys;
    }
    for (range_count != 0) {
        val r: *Range = ?ranges[range_count - 1];
        if (r.end == r.start) { range_count = range_count - 1; cnt; }
        r.end = r.end - PAGE;
        free_count = free_count - 1;
        ret r.end;
    }
    ret 0;
}

# one zeroed 4 KiB page, or 0 when out of memory
pub fun alloc() u64 {
    val phys: u64 = alloc_raw();
    if (phys == 0) { ret 0; }
    val p: *u64 = link_of(phys);
    var i: u64 = 0;
    for (i < PAGE / 8) {
        p[i] = 0;
        i = i + 1;
    }
    ret phys;
}

pub fun free_pages() u64 { ret free_count; }
pub fun total_pages() u64 { ret total_count; }

# sharing counts for pages mapped by several address spaces (copy-on-write
# after fork): refs[pfn] = owners - 1, so 0 means "only one". kept in a run
# of physical memory set aside at init, reached through the hhdm
var refs: u64 = 0;    # virtual address of the u16 array
var ref_pages: u64 = 0;

fun ref_of(pa: u64) *u16 { ret (refs + (pa / PAGE) * 2)::*u16; }

pub fun share(pa: u64) {
    val r: *u16 = ref_of(pa);
    @r = @r + 1;
}

pub fun shared(pa: u64) u8 {
    if (@ref_of(pa) != 0) { ret 1; }
    ret 0;
}

# drop one owner of a page; it is freed when it was the last
pub fun release(pa: u64) {
    val r: *u16 = ref_of(pa);
    if (@r != 0) {
        @r = @r - 1;
        ret;
    }
    free(pa);
}

pub fun init(bi: *info.BootInfo) u8 {
    hhdm = bi.hhdm;
    pending_count = 0;
    deferred = 0;
    head = 0;
    free_count = 0;
    total_count = 0;
    range_count = 0;
    if (bi.mem_len > info.MEM_MAX) { ret 0; }
    # room for the sharing counts: one u16 per page up to the highest one
    var top: u64 = 0;
    var i: u64 = 0;
    for (i < bi.mem_len) {
        val r: *info.MemRegion = ?bi.mem[i];
        if (r.kind == info.MEM_USABLE && r.base + r.len > top) { top = r.base + r.len; }
        i = i + 1;
    }
    ref_pages = ((top / PAGE) * 2 + PAGE - 1) / PAGE;
    var ref_at: u64 = 0;
    i = 0;
    for (i < bi.mem_len && ref_at == 0) {
        val r: *info.MemRegion = ?bi.mem[i];
        var p: u64 = (r.base + PAGE - 1) & ~(PAGE - 1);
        if (p == 0) { p = PAGE; }
        val end: u64 = (r.base + r.len) & ~(PAGE - 1);
        if (r.kind == info.MEM_USABLE && end > p && end - p >= ref_pages * PAGE) { ref_at = p; }
        i = i + 1;
    }
    if (ref_at == 0 || ref_pages == 0) { ret 0; }
    refs = ref_at + hhdm;
    var z: u64 = 0;
    for (z < ref_pages * PAGE / 8) {
        @((refs + z * 8)::*u64) = 0;
        z = z + 1;
    }

    i = 0;
    for (i < bi.mem_len) {
        val r: *info.MemRegion = ?bi.mem[i];
        if (r.kind == info.MEM_USABLE) {
            # round inward to whole pages; keep page 0 out so 0 can mean "none"
            var p: u64 = (r.base + PAGE - 1) & ~(PAGE - 1);
            val end: u64 = (r.base + r.len) & ~(PAGE - 1);
            if (p == 0) { p = PAGE; }
            if (p == ref_at) { p = p + ref_pages * PAGE; } # the counts live here
            if (p < end) {
                ranges[range_count].start = p;
                ranges[range_count].end = end;
                range_count = range_count + 1;
                val pages: u64 = (end - p) / PAGE;
                free_count = free_count + pages;
                total_count = total_count + pages;
            }
        }
        i = i + 1;
    }
    ret 1;
}
