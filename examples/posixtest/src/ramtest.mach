# Physical memory stress: touch every page, detect aliases, and reclaim it.

use abi: sdk.abi;
use sys: sdk.sys;
use io: sdk.io;
use rt: sdk.rt;

fun number(s: *u8) u64 {
    var n: u64 = 0;
    for (s[n] != 0) { n = n + 1; }
    var good: u8 = 0;
    val v: u64 = io.parse_dec(s, n, ?good);
    if (good == 0) { ret 0; }
    ret v;
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc != 3) { io.out("usage: ramtest EXPECTED_MIB ALLOCATE_MIB\n\0"); ret 1; }
    val mib: u64 = 1048576;
    val expected: u64 = number(argv[1]);
    val amount: u64 = number(argv[2]);
    if (expected == 0 || amount == 0 || amount > expected || expected > 1048576) { ret 1; }
    var before: abi.Info;
    sys.info(?before);
    io.out("RAM usable MiB: \0"); io.dec(before.mem_total / mib); io.putc(10);
    # Firmware, kernel, and allocator metadata consume part of configured RAM.
    if (before.mem_total < expected * mib * 9 / 10 || before.mem_total > expected * mib) {
        io.out("FAIL detected RAM\n\0"); ret 1;
    }
    val bytes: u64 = amount * mib;
    if (before.mem_free < bytes + 64 * mib) { io.out("FAIL insufficient free RAM\n\0"); ret 1; }
    val a: u64 = sys.mmap(0, bytes, abi.PROT_READ | abi.PROT_WRITE, abi.MAP_PRIVATE | abi.MAP_ANONYMOUS, 0, 0);
    if (abi.is_err(a) != 0) { io.out("FAIL reserve RAM\n\0"); ret 1; }
    var offset: u64 = 0;
    for (offset < bytes) {
        val p: *u64 = (a + offset)::*u64;
        if (p[0] != 0 || p[511] != 0) { io.out("FAIL zero fill\n\0"); ret 1; }
        p[0] = offset ^ 0xD1CEB00C12345678;
        p[511] = ~offset;
        offset = offset + 4096;
    }
    var during: abi.Info;
    sys.info(?during);
    if (during.mem_free > before.mem_free || before.mem_free - during.mem_free < bytes) {
        io.out("FAIL resident accounting\n\0"); ret 1;
    }
    offset = 0;
    for (offset < bytes) {
        val p: *u64 = (a + offset)::*u64;
        if (p[0] != (offset ^ 0xD1CEB00C12345678) || p[511] != ~offset) {
            io.out("FAIL page contents\n\0"); ret 1;
        }
        offset = offset + 4096;
    }
    if (sys.munmap(a, bytes) != 0) { io.out("FAIL unmap RAM\n\0"); ret 1; }
    var after: abi.Info;
    sys.info(?after);
    if (after.mem_free + 256 * 1024 < before.mem_free) { io.out("FAIL reclaim RAM\n\0"); ret 1; }
    io.out("ok resident RAM MiB: \0"); io.dec(amount); io.putc(10);
    ret 0;
}
