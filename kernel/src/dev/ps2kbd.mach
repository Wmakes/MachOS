# PS/2 keyboard (scancode set 1, as the 8042 translates by default) -> tty

use cpu: machos.arch.x86_64.cpu;
use tty: machos.kern.tty;
use fbcon: machos.dev.fbcon;

val NORMAL: [58]u8 = [58]u8{0x00, 0x1b, 0x31, 0x32, 0x33, 0x34, 0x35, 0x36, 0x37, 0x38, 0x39, 0x30, 0x2d, 0x3d, 0x08, 0x09, 0x71, 0x77, 0x65, 0x72, 0x74, 0x79, 0x75, 0x69, 0x6f, 0x70, 0x5b, 0x5d, 0x0a, 0x00, 0x61, 0x73, 0x64, 0x66, 0x67, 0x68, 0x6a, 0x6b, 0x6c, 0x3b, 0x27, 0x60, 0x00, 0x5c, 0x7a, 0x78, 0x63, 0x76, 0x62, 0x6e, 0x6d, 0x2c, 0x2e, 0x2f, 0x00, 0x2a, 0x00, 0x20};
val SHIFTED: [58]u8 = [58]u8{0x00, 0x1b, 0x21, 0x40, 0x23, 0x24, 0x25, 0x5e, 0x26, 0x2a, 0x28, 0x29, 0x5f, 0x2b, 0x08, 0x09, 0x51, 0x57, 0x45, 0x52, 0x54, 0x59, 0x55, 0x49, 0x4f, 0x50, 0x7b, 0x7d, 0x0a, 0x00, 0x41, 0x53, 0x44, 0x46, 0x47, 0x48, 0x4a, 0x4b, 0x4c, 0x3a, 0x22, 0x7e, 0x00, 0x7c, 0x5a, 0x58, 0x43, 0x56, 0x42, 0x4e, 0x4d, 0x3c, 0x3e, 0x3f, 0x00, 0x2a, 0x00, 0x20};

var shift: u8 = 0;
var ctrl: u8 = 0;
var caps: u8 = 0;
var extended: u8 = 0;

var present: u8 = 0;

# a byte waiting? never true without a controller (its status reads 0xFF)
fun waiting() u8 {
    val st: u8 = cpu.inb(0x64);
    if (st == 0xFF) { ret 0; }
    ret ((st & 1) != 0)::u8;
}

# whether there is a PS/2 controller (USB-only machines have none)
pub fun init() u8 {
    if (cpu.inb(0x64) == 0xFF) { ret 0; }
    # drop whatever the firmware left in the output buffer
    var i: u64 = 0;
    for (waiting() != 0 && i < 64) {
        cpu.inb(0x60);
        i = i + 1;
    }
    present = 1;
    ret 1;
}

fun key(code: u8) {
    if (code == 0x2A || code == 0x36) { shift = 1; ret; }
    if (code == 0x1D) { ctrl = 1; ret; }
    if (code == 0x3A) { caps = caps ^ 1; ret; }
    if (code::u64 >= 58) { ret; }
    var c: u8 = NORMAL[code];
    if (shift != 0) { c = SHIFTED[code]; }
    if (caps != 0 && c >= 97 && c <= 122 && shift == 0) { c = c - 32; }
    or (caps != 0 && c >= 65 && c <= 90 && shift != 0) { c = c + 32; }
    if (ctrl != 0 && c >= 97 && c <= 122) { c = c - 96; } # ^A = 1 ...
    if (c != 0) { tty.input(c); }
}

fun seq(final: u8) {
    tty.input(27);
    tty.input(91);
    tty.input(final);
}

fun tilde(n: u8) {
    tty.input(27);
    tty.input(91);
    tty.input(n);
    tty.input(126);
}

# keys behind the 0xE0 prefix: what a VT100-style terminal would send
fun special(code: u8) {
    if (code == 0x48) { seq(65); }          # up     ESC [ A
    or (code == 0x50) { seq(66); }          # down   ESC [ B
    or (code == 0x4D) { seq(67); }          # right  ESC [ C
    or (code == 0x4B) { seq(68); }          # left   ESC [ D
    or (code == 0x47) { seq(72); }          # home   ESC [ H
    or (code == 0x4F) { seq(70); }          # end    ESC [ F
    or (code == 0x53) {                     # delete ESC [ 3 ~
        tty.input(27);
        tty.input(91);
        tty.input(51);
        tty.input(126);
    }
    or (code == 0x1C) { tty.input(10); }    # keypad enter
    or (code == 0x49) {                     # page up   ESC [ 5 ~, shift: scroll back
        if (shift != 0) { fbcon.view_up(); }
        or              { tilde(53); }
    }
    or (code == 0x51) {                     # page down ESC [ 6 ~
        if (shift != 0) { fbcon.view_down(); }
        or              { tilde(54); }
    }
}

pub fun irq() {
    var guard: u64 = 0;
    for (waiting() != 0 && guard < 64) {
        guard = guard + 1;
        val code: u8 = cpu.inb(0x60);
        if (code == 0xE0) { extended = 1; cnt; }
        if (extended != 0) {
            extended = 0;
            if ((code & 0x7F) == 0x1D) { ctrl = (code & 0x80) ^ 0x80; } # right ctrl
            if ((code & 0x80) == 0) { special(code); }
            cnt;
        }
        if ((code & 0x80) != 0) {
            val up: u8 = code & 0x7F;
            if (up == 0x2A || up == 0x36) { shift = 0; }
            if (up == 0x1D) { ctrl = 0; }
        } or {
            key(code);
        }
    }
}
