# which NAME...: where each command would be found (through $PATH)

use io:  userland.lib.cli;
use path: userland.lib.path;
use std.runtime;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    var status: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        var p: [256]u8;
        val n: u64 = path.lookup(argv[i], ?p[0]);
        if (n == 0) { status = 1; }
        or {
            io.outn(?p[0], n);
            io.putc(10);
        }
        i = i + 1;
    }
    ret status;
}
