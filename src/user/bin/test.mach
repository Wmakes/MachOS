# test EXPR: succeed (0) if EXPR holds, else fail (1). supports
#   -e PATH  exists          -f PATH  is a file      -d PATH  is a directory
#   -b PATH  is a disk/device -n STR  not empty      -z STR   empty
#   STR = STR, STR != STR, and a single STR (not empty)

use abi: machos.abi.sys;
use sys: machos.user.sys;
use io:  machos.user.io;
use rt:  machos.user.rt;

fun kind(p: *u8) u64 {
    var st: abi.Stat;
    if (abi.is_err(sys.stat(p, io.len(p), ?st)) != 0) { ret 0; }
    ret st.kind;
}

fun yes(c: u8) u64 {
    if (c != 0) { ret 0; }
    ret 1;
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc == 1) { ret 1; }
    if (argc == 2) { ret yes((io.len(argv[1]) > 0)::u8); }
    if (argc == 3) {
        val op: *u8 = argv[1];
        val a: *u8 = argv[2];
        if (io.streq(op, "-n\0") != 0) { ret yes((io.len(a) > 0)::u8); }
        if (io.streq(op, "-z\0") != 0) { ret yes((io.len(a) == 0)::u8); }
        if (io.streq(op, "-e\0") != 0) { ret yes((kind(a) != 0)::u8); }
        if (io.streq(op, "-f\0") != 0) { ret yes((kind(a) == abi.KIND_FILE)::u8); }
        if (io.streq(op, "-d\0") != 0) { ret yes((kind(a) == abi.KIND_DIR)::u8); }
        if (io.streq(op, "-b\0") != 0) { ret yes((kind(a) == abi.KIND_DEV)::u8); }
    }
    if (argc == 4) {
        if (io.streq(argv[2], "=\0") != 0) { ret yes(io.streq(argv[1], argv[3])); }
        if (io.streq(argv[2], "!=\0") != 0) { ret yes(io.streq(argv[1], argv[3]) ^ 1); }
    }
    io.err("test: unsupported expression\n\0");
    ret 2;
}
