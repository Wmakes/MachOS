# ps: list processes

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    io.out("  PID  PPID  GROUP STATE     MEM  NAME\n\0");
    var i: u64 = 0;
    for {
        var p: abi.ProcInfo;
        val r: u64 = sys.procs(i, ?p);
        if (abi.is_err(r) != 0 || r == 0) { brk; }
        io.dec_pad(p.pid, 5);
        io.dec_pad(p.ppid, 6);
        io.dec_pad(p.group, 7);
        if (p.state == abi.STATE_RUNNING)       { io.out(" running \0"); }
        or (p.state == abi.STATE_RUNNABLE)      { io.out(" ready   \0"); }
        or (p.state == abi.STATE_BLOCKED)       { io.out(" waiting \0"); }
        or                                      { io.out(" zombie  \0"); }
        io.dec_pad(p.pages * 4, 5);
        io.out("K  \0");
        io.outn(?p.name[0], p.name_len);
        io.putc(10);
        i = i + 1;
    }
    ret 0;
}
