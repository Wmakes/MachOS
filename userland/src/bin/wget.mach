# wget fetches HTTP and verified HTTPS URLs, following at most five redirects.

use std.runtime;
use secure: userland.lib.tls_socket;
use roots: userland.lib.tls_roots;
use os:     std.system.os;
use io:     userland.lib.cli;
use addr:   userland.lib.netaddr;
use std.types.size.usize;
use pki.cert;
use parser: http.h1.parser;
use http.core.field;
use http.core.method;
use std.types.bool.true;
use std.types.result.res;
use std.net.ip;
use std.net.tcp;
use io_error: std.io.error;

var response: parser.Parser;
var response_line: [8192]u8;
var response_storage: [32768]u8;
var response_fields: [128]field.Field;
var response_trailers: [32]field.Field;
var body_bytes: u64;
var body_write_failed: u8;

# Feed borrowed wire bytes to mach-http and write only decoded body spans.
fun body_feed(fd: i64, data: *u8, length: usize) u8 {
    var at: usize = 0;
    for (at < length) {
        val result: parser.Feed = parser.feed(?response, ?data[at], length - at);
        if (result.status == parser.PARSE_ERROR) { ret 0; }
        if (result.body_length != 0) {
            if (io.write_all(fd, result.body, result.body_length::u64) == 0) {
                body_write_failed = 1;
                ret 0;
            }
            body_bytes = body_bytes + result.body_length::u64;
        }
        at = at + result.consumed;
        if (result.status == parser.PARSE_MESSAGE && at != length) { ret 0; }
        if (result.consumed == 0) { ret 0; }
    }
    ret 1;
}

var head:    [8192]u8;   # the reply's header, and what came after it
var chunk:   [4096]u8;
var host:    [256]u8;    # of the URL being fetched
var path:    [1024]u8;   # its path (with the query), always starting with /
var port:    u64 = 80;
var encrypted: u8;
var https_only: u8;
var target:  [1024]u8;   # the URL itself
var outname: [256]u8;

fun default_port() u64 {
    if (encrypted != 0) { ret 443; }
    ret 80;
}

fun usage() i64 {
    io.err("usage: wget [-q] [--https-only] [-O FILE|-] http[s]://HOST[:PORT]/PATH\n");
    ret 2;
}

fun lower(c: u8) u8 {
    if (c >= 65 && c <= 90) { ret c + 32; }
    ret c;
}

# does s begin with p?
fun starts(s: *u8, p: *u8) u8 {
    var i: u64 = 0;
    for (p[i] != 0) {
        if (s[i] != p[i]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

# the text s (NUL-terminated) into buf at `at`; where it ends
fun put(buf: *u8, at: u64, s: *u8) u64 {
    var p: u64 = at;
    var i: u64 = 0;
    for (s[i] != 0) {
        buf[p] = s[i];
        p = p + 1;
        i = i + 1;
    }
    ret p;
}

# n bytes of src into buf at `at`; where they end
fun put_n(buf: *u8, at: u64, src: *u8, n: u64) u64 {
    var p: u64 = at;
    var i: u64 = 0;
    for (i < n) {
        buf[p] = src[i];
        p = p + 1;
        i = i + 1;
    }
    ret p;
}

# the number v, in decimal, into buf at `at`; where it ends
fun put_num(buf: *u8, at: u64, v: u64) u64 {
    var t: [24]u8;
    val n: u64 = io.fmt_dec(v, ?t[0]);
    ret put_n(buf, at, ?t[0], n);
}

fun crlf(buf: *u8, at: u64) u64 {
    buf[at] = 13;
    buf[at + 1] = 10;
    ret at + 2;
}

# Split the URL into its host, port, and request path.
fun parse_url() u8 {
    encrypted = starts(?target[0], "https://");
    if (encrypted == 0 && starts(?target[0], "http://") == 0) { ret 0; }
    var at: u64 = 7;
    if (encrypted != 0) { at = 8; }
    var h: u64 = 0;
    for (target[at] != 0 && target[at] != 47 && target[at] != 58 && target[at] != 63 && target[at] != 35) {
        if (h >= 255) { ret 0; }
        host[h] = target[at];
        h = h + 1;
        at = at + 1;
    }
    host[h] = 0;
    if (h == 0) { ret 0; }
    port = 80;
    if (encrypted != 0) { port = 443; }
    if (target[at] == 58) {
        at = at + 1;
        var p: u64 = 0;
        var digits: u64 = 0;
        for (target[at] >= 48 && target[at] <= 57) {
            p = p * 10 + (target[at] - 48)::u64;
            if (p > 65535) { ret 0; }
            digits = digits + 1;
            at = at + 1;
        }
        if (digits == 0 || p == 0) { ret 0; }
        port = p;
    }
    var k: u64 = 0;
    if (target[at] != 47) {
        path[0] = 47;
        k = 1;
    }
    for (target[at] != 0 && target[at] != 35) {
        if (k >= 1023) { ret 0; }
        path[k] = target[at];
        k = k + 1;
        at = at + 1;
    }
    path[k] = 0;
    ret 1;
}

# the file name for the path: what follows its last /, without the query
fun derive_name() {
    var start: u64 = 0;
    var i: u64 = 0;
    for (path[i] != 0 && path[i] != 63) {
        if (path[i] == 47) { start = i + 1; }
        i = i + 1;
    }
    var n: u64 = 0;
    var k: u64 = start;
    for (k < i && n < 255) {
        outname[n] = path[k];
        n = n + 1;
        k = k + 1;
    }
    if (n == 0) { n = put(?outname[0], 0, "index.html"); }
    outname[n] = 0;
}

# where the value of header `name` (lower case) starts in head[0..n], or 0
# when the reply has no such header
fun find_header(n: u64, name: *u8) u64 {
    var i: u64 = 0;
    for (i + 1 < n) {
        if (head[i] == 10) {
            val s: u64 = i + 1;
            var k: u64 = 0;
            var same: u8 = 1;
            for (name[k] != 0) {
                if (s + k >= n) {
                    same = 0;
                    brk;
                }
                if (lower(head[s + k]) != name[k]) {
                    same = 0;
                    brk;
                }
                k = k + 1;
            }
            if (same != 0 && s + k < n && head[s + k] == 58) {
                var v: u64 = s + k + 1;
                for (v < n && (head[v] == 32 || head[v] == 9)) { v = v + 1; }
                ret v;
            }
        }
        i = i + 1;
    }
    ret 0;
}

# the end of the header line that starts at v
fun line_end(v: u64, n: u64) u64 {
    var e: u64 = v;
    for (e < n && head[e] != 13 && head[e] != 10) { e = e + 1; }
    ret e;
}

# The HTTP parser consumes the same plaintext stream for both schemes.
fun receive(socket: *tcp.Stream, data: *u8, length: usize) res[usize, io_error.Error] {
    if (encrypted == 0) { ret tcp.stream_read(socket, data, length); }
    val count: i64 = secure.read(data, length);
    if (count < 0) {
        ret res[usize, io_error.Error].err{io_error.make(io_error.IO, io_error.OP_READ)};
    }
    ret res[usize, io_error.Error].ok{count::usize};
}

fun send(socket: *tcp.Stream, data: *u8, length: usize) res[usize, io_error.Error] {
    if (encrypted == 0) { ret tcp.stream_write(socket, data, length); }
    val count: i64 = secure.write(data, length);
    if (count < 0) {
        ret res[usize, io_error.Error].err{io_error.make(io_error.IO, io_error.OP_WRITE)};
    }
    ret res[usize, io_error.Error].ok{count::usize};
}

fun disconnect(socket: *tcp.Stream) {
    if (encrypted != 0) { secure.destroy(); }
    tcp.stream_close(socket);
}

# fetches the URL in host/port/path from the server at ip4. 0: it was saved;
# 1: it failed (and said why); 2: a redirect, with the new URL in `target`
fun get(ip4: u32, quiet: u8, output: *u8) i64 {
    var req: [2048]u8;
    var n: u64 = put(?req[0], 0, "GET ");
    n = put(?req[0], n, ?path[0]);
    n = put(?req[0], n, " HTTP/1.1");
    n = crlf(?req[0], n);
    n = put(?req[0], n, "Host: ");
    n = put(?req[0], n, ?host[0]);
    if (port != default_port()) {
        n = put(?req[0], n, ":");
        n = put_num(?req[0], n, port);
    }
    n = crlf(?req[0], n);
    n = put(?req[0], n, "User-Agent: wget (MachOS)");
    n = crlf(?req[0], n);
    n = put(?req[0], n, "Accept: */*");
    n = crlf(?req[0], n);
    n = put(?req[0], n, "Connection: close");
    n = crlf(?req[0], n);
    n = crlf(?req[0], n);

    val ep: ip.Endpoint = ip.endpoint_v4(ip.ipv4_from_u32(ip4), port::u16);
    val c: res[tcp.Stream, io_error.Error] = tcp.connect(ep);
    if (sel c.err) {
        io.fail("wget", "connect", c.err.code);
        ret 1;
    }
    var s: tcp.Stream = c.ok;
    tcp.stream_set_read_timeout(?s, 30000);
    if (encrypted != 0) {
        val trust: *cert.TrustStore = roots.load(quiet == 0);
        if (trust == nil) {
            io.err("wget: cannot load trusted CA certificates\n");
            tcp.stream_close(?s);
            ret 1;
        }
        if (!secure.open(?s, ?host[0], trust)) {
            io.err("wget: TLS handshake or certificate verification failed: ");
            io.err(secure.reason());
            io.err("\n");
            disconnect(?s);
            ret 1;
        }
    }

    var sent: u64 = 0;
    for (sent < n) {
        val w: res[usize, io_error.Error] = send(?s, ?req[sent], (n - sent)::usize);
        if (sel w.err) {
            io.err("wget: sending the request failed\n");
            disconnect(?s);
            ret 1;
        }
        sent = sent + w.ok::u64;
    }

    # the header: everything up to the empty line
    var have: u64 = 0;
    var hlen: u64 = 0;
    for (hlen == 0) {
        if (have >= 8192) {
            io.err("wget: the reply's header is too long\n");
            disconnect(?s);
            ret 1;
        }
        val r: res[usize, io_error.Error] = receive(?s, ?head[have], (8192 - have)::usize);
        if (sel r.err) {
            io.err("wget: no reply\n");
            disconnect(?s);
            ret 1;
        }
        if (r.ok == 0) {
            io.err("wget: the server closed the connection without a reply\n");
            disconnect(?s);
            ret 1;
        }
        val before: u64 = have;
        have = have + r.ok::u64;
        var j: u64 = 0;
        if (before >= 3) { j = before - 3; }
        for (j + 3 < have) {
            if (head[j] == 13 && head[j + 1] == 10 && head[j + 2] == 13 && head[j + 3] == 10) {
                hlen = j + 4;
                brk;
            }
            j = j + 1;
        }
    }

    # "HTTP/1.x NNN reason"
    var bad: u8 = 0;
    if (hlen < 12 || starts(?head[0], "HTTP/1.") == 0) { bad = 1; }
    if (bad == 0) {
        var d: u64 = 9;
        for (d < 12) {
            if (head[d] < 48 || head[d] > 57) { bad = 1; }
            d = d + 1;
        }
    }
    if (bad != 0) {
        io.err("wget: that is no HTTP reply\n");
        disconnect(?s);
        ret 1;
    }
    val code: u64 = (head[9] - 48)::u64 * 100 + (head[10] - 48)::u64 * 10 + (head[11] - 48)::u64;
    if (quiet == 0 || code != 200) {
        io.errn(?head[0], line_end(0, hlen));
        io.err("\n");
    }

    if (code == 301 || code == 302 || code == 303 || code == 307 || code == 308) {
        val l: u64 = find_header(hlen, "location");
        if (l == 0) {
            io.err("wget: a redirect without a Location\n");
            disconnect(?s);
            ret 1;
        }
        val e: u64 = line_end(l, hlen);
        val len: u64 = e - l;
        if (len == 0 || len > 900) {
            io.err("wget: the Location is unusable\n");
            disconnect(?s);
            ret 1;
        }
        var t: u64 = 0;
        if (head[l] == 47) {
            # an absolute path: same server
            if (encrypted != 0) { t = put(?target[0], 0, "https://"); }
            or { t = put(?target[0], 0, "http://"); }
            t = put(?target[0], t, ?host[0]);
            if (port != default_port()) {
                t = put(?target[0], t, ":");
                t = put_num(?target[0], t, port);
            }
            t = put_n(?target[0], t, ?head[l], len);
        } or (starts(?head[l], "http://") != 0 || starts(?head[l], "https://") != 0) {
            t = put_n(?target[0], 0, ?head[l], len);
        } or {
            io.err("wget: only absolute redirects work\n");
            disconnect(?s);
            ret 1;
        }
        if (t >= 1023) {
            io.err("wget: the Location is too long\n");
            disconnect(?s);
            ret 1;
        }
        target[t] = 0;
        disconnect(?s);
        ret 2;
    }
    if (code != 200) {
        disconnect(?s);
        ret 1;
    }

    var limits: parser.Limits = parser.limits_default();
    # Downloads stream to disk and retain no body in memory.
    limits.max_body_bytes = 0xFFFFFFFFFFFFFFFF;
    if (!parser.init_response(?response, method.GET, ?response_line[0], 8192,
        ?response_storage[0], 32768, ?response_fields[0], 128,
        ?response_trailers[0], 32, limits)) { disconnect(?s); ret 1; }
    val headers: parser.Feed = parser.feed(?response, ?head[0], hlen::usize);
    if (headers.status != parser.PARSE_HEADERS || headers.consumed != hlen::usize) {
        io.err("wget: invalid HTTP response framing\n");
        disconnect(?s);
        ret 1;
    }

    # where it goes
    var name: *u8 = output;
    if (output == nil) {
        derive_name();
        name = ?outname[0];
    }
    var fd: i64 = 1;
    if (io.streq(name, "-") == 0) {
        fd = io.open_mode(name, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o644);
        if (fd < 0) {
            io.fail("wget", name, fd);
            disconnect(?s);
            ret 1;
        }
    }

    body_bytes = 0;
    body_write_failed = 0;
    var lost: u8 = 0;
    if (body_feed(fd, ?head[hlen], (have - hlen)::usize) == 0) { lost = 1; }
    for (lost == 0 && (encrypted != 0 || response.phase != parser.MESSAGE_COMPLETE)) {
        val received: res[usize, io_error.Error] = receive(?s, ?chunk[0], 4096);
        if (sel received.err) { lost = 1; brk; }
        if (received.ok == 0) {
            val end: parser.Feed = parser.finish_eof(?response, true);
            if (end.status != parser.PARSE_MESSAGE) { lost = 1; }
            brk;
        }
        if (body_feed(fd, ?chunk[0], received.ok) == 0) { lost = 1; }
    }
    val got: u64 = body_bytes;
    disconnect(?s);
    if (fd != 1) { io.close(fd); }
    if (body_write_failed != 0) {
        io.err("wget: writing the file failed\n");
        ret 1;
    }
    if (lost != 0) {
        io.err("wget: truncated, invalid, or unauthenticated response body\n");
        ret 1;
    }
    if (quiet == 0) {
        var nb: [24]u8;
        io.err("wget: ");
        io.err(name);
        io.err(" saved, ");
        io.errn(?nb[0], io.fmt_dec(got, ?nb[0]));
        io.err(" bytes\n");
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    var quiet: u8 = 0;
    var output: *u8 = nil;
    var i: i64 = 1;
    for (i < argc && argv[i][0] == 45 && argv[i][1] != 0) {
        if (io.streq(argv[i], "--https-only") != 0) { https_only = 1; }
        or (io.streq(argv[i], "-q") != 0) { quiet = 1; }
        or (io.streq(argv[i], "-O") != 0 && i + 1 < argc) {
            i = i + 1;
            output = argv[i];
        } or { ret usage(); }
        i = i + 1;
    }
    if (argc - i != 1) { ret usage(); }
    val ulen: u64 = io.len(argv[i]);
    if (ulen >= 1023) {
        io.err("wget: that URL is too long\n");
        ret 1;
    }
    io.copy(?target[0], argv[i], ulen);
    target[ulen] = 0;

    var hops: u64 = 0;
    for {
        val parsed: u8 = parse_url();
        if (parsed == 0) {
            io.err("wget: not an http:// or https:// URL: ");
            io.err(?target[0]);
            io.err("\n");
            ret 1;
        }
        if (https_only != 0 && encrypted == 0) {
            io.err("wget: HTTPS is required for this download\n");
            ret 1;
        }
        var ip4: u32 = 0;
        if (addr.lookup(?host[0], ?ip4) == 0) {
            io.err("wget: ");
            io.err(?host[0]);
            io.err(": not found\n");
            ret 1;
        }
        val r: i64 = get(ip4, quiet, output);
        if (r != 2) { ret r; }
        hops = hops + 1;
        if (hops > 5) {
            io.err("wget: too many redirects\n");
            ret 1;
        }
        if (quiet == 0) {
            io.err("wget: redirected to ");
            io.err(?target[0]);
            io.err("\n");
        }
    }
    ret 1;
}
