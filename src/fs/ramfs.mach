# the in-memory filesystem: a tree of nodes, file contents in heap buffers.
# the initrd is unpacked into it at boot and everything stays writable

use abi:  machos.abi.sys;
use heap: machos.mm.heap;
use mem:  machos.kern.mem;
use path: machos.fs.path;

pub val DEV_CONSOLE: u64 = 1;
pub val DEV_NULL:    u64 = 2;
pub val DEV_ZERO:    u64 = 3;

pub rec Node {
    kind:     u64; # abi.KIND_*
    size:     u64;
    cap:      u64;
    data:     u64; # heap buffer of `cap` bytes, 0 when empty
    dev:      u64; # DEV_* for KIND_DEV
    parent:   *Node;
    child:    *Node; # first entry of a directory
    next:     *Node; # next entry in the parent
    opens:    u64;   # handles open on it
    unlinked: u8;    # removed from the tree, freed at the last close
    name_len: u64;
    name:     [60]u8;
}

var root: *Node = nil;
var files: u64 = 0;
var bytes: u64 = 0;

fun new_node(kind: u64, name: *u8, n: u64) *Node {
    if (n > abi.NAME_MAX) { ret nil; }
    val nd: *Node = heap.zalloc($size_of(Node)::u64)::*Node;
    if (nd == nil) { ret nil; }
    nd.kind = kind;
    nd.name_len = n;
    mem.copy((?nd.name[0])::u64, name::u64, n);
    ret nd;
}

pub fun init() u8 {
    root = new_node(abi.KIND_DIR, "\0", 0);
    if (root == nil) { ret 0; }
    root.parent = root;
    ret 1;
}

pub fun get_root() *Node { ret root; }

pub fun child(dir: *Node, name: *u8, n: u64) *Node {
    if (dir.kind != abi.KIND_DIR) { ret nil; }
    var c: *Node = dir.child;
    for (c != nil) {
        if (c.name_len == n && mem.equal(?c.name[0], name, n) != 0) { ret c; }
        c = c.next;
    }
    ret nil;
}

pub fun nth_child(dir: *Node, idx: u64) *Node {
    var c: *Node = dir.child;
    var i: u64 = 0;
    for (c != nil && i < idx) {
        c = c.next;
        i = i + 1;
    }
    ret c;
}

# the node at a normalized absolute path, or nil
pub fun lookup(p: *u8, n: u64) *Node {
    var nd: *Node = root;
    var i: u64 = 1;
    for (i < n) {
        val start: u64 = i;
        for (i < n && p[i] != 47) { i = i + 1; }
        nd = child(nd, ?p[start], i - start);
        if (nd == nil) { ret nil; }
        i = i + 1;
    }
    ret nd;
}

# the directory that would hold a normalized absolute path, or nil
pub fun parent_dir(p: *u8, n: u64) *Node {
    val b: u64 = path.base_index(p, n);
    var dl: u64 = 1;
    if (b > 1) { dl = b - 1; }
    val d: *Node = lookup(p, dl);
    if (d == nil || d.kind != abi.KIND_DIR) { ret nil; }
    ret d;
}

pub fun attach(dir: *Node, nd: *Node) {
    nd.parent = dir;
    nd.next = nil;
    # keep entries in creation order, so `ls` is stable
    if (dir.child == nil) {
        dir.child = nd;
        ret;
    }
    var c: *Node = dir.child;
    for (c.next != nil) { c = c.next; }
    c.next = nd;
}

pub fun detach(nd: *Node) {
    val dir: *Node = nd.parent;
    if (dir.child == nd) {
        dir.child = nd.next;
    } or {
        var c: *Node = dir.child;
        for (c != nil && c.next != nd) { c = c.next; }
        if (c != nil) { c.next = nd.next; }
    }
    nd.next = nil;
}

pub fun create(dir: *Node, name: *u8, n: u64, kind: u64) *Node {
    val nd: *Node = new_node(kind, name, n);
    if (nd == nil) { ret nil; }
    attach(dir, nd);
    if (kind == abi.KIND_FILE) { files = files + 1; }
    ret nd;
}

fun destroy(nd: *Node) {
    if (nd.kind == abi.KIND_FILE) {
        files = files - 1;
        bytes = bytes - nd.size;
    }
    heap.free(nd.data);
    heap.free(nd::u64);
}

# take a file or empty directory out of the tree
pub fun unlink(nd: *Node) {
    detach(nd);
    nd.unlinked = 1;
    if (nd.opens == 0) { destroy(nd); }
}

pub fun release(nd: *Node) {
    nd.opens = nd.opens - 1;
    if (nd.unlinked != 0 && nd.opens == 0) { destroy(nd); }
}

# whether `a` is `b` or inside it
pub fun within(a: *Node, b: *Node) u8 {
    var n: *Node = a;
    for {
        if (n == b) { ret 1; }
        if (n == root) { ret 0; }
        n = n.parent;
    }
    ret 0;
}

pub fun read(nd: *Node, off: u64, buf: u64, n: u64) u64 {
    if (off >= nd.size) { ret 0; }
    var k: u64 = nd.size - off;
    if (k > n) { k = n; }
    mem.copy(buf, nd.data + off, k);
    ret k;
}

fun reserve(nd: *Node, need: u64) u8 {
    if (need <= nd.cap) { ret 1; }
    var cap: u64 = nd.cap * 2;
    if (cap < 256) { cap = 256; }
    if (cap < need) { cap = need; }
    val d: u64 = heap.alloc(cap);
    if (d == 0) { ret 0; }
    if (nd.data != 0) {
        mem.copy(d, nd.data, nd.size);
        heap.free(nd.data);
    }
    nd.data = d;
    nd.cap = cap;
    ret 1;
}

# write at `off`, growing the file; returns bytes written or an error
pub fun write(nd: *Node, off: u64, buf: u64, n: u64) u64 {
    if (off + n < off) { ret abi.err(abi.E_INVAL); }
    if (reserve(nd, off + n) == 0) { ret abi.err(abi.E_NOMEM); }
    if (off > nd.size) { mem.fill(nd.data + nd.size, 0, off - nd.size); }
    mem.copy(nd.data + off, buf, n);
    if (off + n > nd.size) {
        bytes = bytes + (off + n - nd.size);
        nd.size = off + n;
    }
    ret n;
}

pub fun truncate(nd: *Node) {
    bytes = bytes - nd.size;
    nd.size = 0;
}

pub fun file_count() u64 { ret files; }
pub fun byte_count() u64 { ret bytes; }
