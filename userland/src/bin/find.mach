# find [PATH...] [-name PATTERN] [-type f|d]: list everything under PATH
# (default .), or what matches. PATTERN takes * and ?

use abi:  sdk.abi;
use sys:  sdk.sys;
use io:   sdk.io;
use rt:   sdk.rt;
use text: userland.lib.text;

var pat: *u8 = nil;
var want: u64 = 0; # 0 any, else abi.KIND_*

fun base(p: *u8, n: u64) u64 {
    var s: u64 = n;
    for (s > 0 && p[s - 1] != 47) { s = s - 1; }
    ret s;
}

fun visit(p: *u8, n: u64, kind: u64) {
    var show: u8 = 1;
    if (want != 0 && kind != want) { show = 0; }
    if (pat != nil) {
        val b: u64 = base(p, n);
        if (text.glob(pat, io.len(pat), ?p[b], n - b) == 0) { show = 0; }
    }
    if (show != 0) {
        io.outn(p, n);
        io.putc(10);
    }
    if (kind != abi.KIND_DIR) { ret; }
    val h: u64 = sys.open(p, n, abi.O_READ);
    if (abi.is_err(h) != 0) { ret; }
    var i: u64 = 0;
    for {
        var e: abi.Entry;
        val got: u64 = sys.readdir(h, i, ?e);
        if (abi.is_err(got) != 0 || got == 0) { brk; }
        i = i + 1;
        if (n + 1 + e.name_len >= 256) { cnt; }
        var c: [256]u8;
        io.copy(?c[0], p, n);
        var cn: u64 = n;
        if (n == 0 || p[n - 1] != 47) {
            c[cn] = 47;
            cn = cn + 1;
        }
        io.copy(?c[cn], ?e.name[0], e.name_len);
        visit(?c[0], cn + e.name_len, e.kind);
    }
    sys.close(h);
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var roots: [16]*u8;
    var nroots: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        if (io.streq(argv[i], "-name\0") != 0 && i + 1 < argc) {
            pat = argv[i + 1];
            i = i + 2;
        } or (io.streq(argv[i], "-type\0") != 0 && i + 1 < argc) {
            if (argv[i + 1][0] == 100) { want = abi.KIND_DIR; }
            or                         { want = abi.KIND_FILE; }
            i = i + 2;
        } or (nroots < 16) {
            roots[nroots] = argv[i];
            nroots = nroots + 1;
            i = i + 1;
        } or {
            i = i + 1;
        }
    }
    if (nroots == 0) {
        roots[0] = ".\0";
        nroots = 1;
    }
    var status: u64 = 0;
    i = 0;
    for (i < nroots) {
        var st: abi.Stat;
        val n: u64 = io.len(roots[i]);
        val r: u64 = sys.stat(roots[i], n, ?st);
        if (abi.is_err(r) != 0) {
            io.fail("find\0", roots[i], r);
            status = 1;
        } or {
            visit(roots[i], n, st.kind);
        }
        i = i + 1;
    }
    ret status;
}
