# du [-s] [PATH...]: disk use of each directory in KiB (-s: totals only)

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;

var summary: u8 = 0;

fun kib(bytes: u64) u64 { ret (bytes + 1023) / 1024; }

fun walk(p: *u8, n: u64, top: u8) u64 {
    var st: os.stat_t;
    if (io.stat(p, ?st) < 0) { ret 0; }
    if (io.kind_of(st.st_mode) != io.KIND_DIR) {
        if (top != 0) {
            io.dec(kib(st.st_size::u64));
            io.putc(9);
            io.outn(p, n);
            io.putc(10);
        }
        ret st.st_size::u64;
    }
    var total: u64 = 0;
    val h: i64 = io.open_read(p);
    if (h < 0) { ret 0; }
    var dir: io.Dir;
    if (io.dir_from(?dir, h) < 0) { ret 0; }
    for (io.dir_next(?dir) > 0) {
        if (io.dir_kind(?dir) == io.KIND_DEV) { cnt; }
        if (n + 1 + dir.len >= 256) { cnt; }
        var c: [256]u8;
        io.copy(?c[0], p, n);
        var cn: u64 = n;
        if (n == 0 || p[n - 1] != 47) {
            c[cn] = 47;
            cn = cn + 1;
        }
        io.copy(?c[cn], dir.name, dir.len);
        c[cn + dir.len] = 0;
        total = total + walk(?c[0], cn + dir.len, 0);
    }
    io.dir_close(?dir);
    if (summary == 0 || top != 0) {
        io.dec(kib(total));
        io.putc(9);
        io.outn(p, n);
        io.putc(10);
    }
    ret total;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    var i: u64 = 1;
    if (i < argc && io.streq(argv[i], "-s\0") != 0) {
        summary = 1;
        i = i + 1;
    }
    if (i == argc) {
        walk(".", 1, 1);
        ret 0;
    }
    for (i < argc) {
        walk(argv[i], io.len(argv[i]), 1);
        i = i + 1;
    }
    ret 0;
}
