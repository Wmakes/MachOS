# ext2 with 4 KiB blocks on a blk.Part, read and write. works in inode
# numbers only; fs/vfs.mach turns them into the node tree. every change goes
# straight to the disk (blk is write-through).
#
# supported: direct, single, double and triple indirect blocks (files up to
# 2 TiB; past 2 GiB the large_file feature is switched on),
# linear directories with file types. a filesystem with any incompatible
# feature besides `filetype` is refused rather than risked

use abi:  sdk.abi;
use blk:  machos.fs.blk;
use heap: machos.mm.heap;
use mem:  machos.kern.mem;
use kprint: machos.kern.kprint;
use clock: machos.kern.clock;

pub val ROOT_INO: u64 = 2;
val BS: u64 = 4096;
val PTRS: u64 = 1024; # block numbers per block

val S_IFDIR: u16 = 0x4000;
val S_IFREG: u16 = 0x8000;
val S_IFCHR: u16 = 0x2000;
val S_IFMT:  u16 = 0xF000;
val INDEX_FL: u32 = 0x1000; # hashed directory; cleared when we edit one

val FT_REG: u8 = 1;
val FT_DIR: u8 = 2;

pub rec Inode {
    mode:      u16;
    uid:       u16;
    size:      u32;
    atime:     u32;
    ctime:     u32;
    mtime:     u32;
    dtime:     u32;
    gid:       u16;
    links:     u16;
    blocks:    u32; # 512-byte units, indirect blocks included
    flags:     u32;
    osd1:      u32;
    block:     [15]u32;
    gen:       u32;
    file_acl:  u32;
    size_high: u32;
    faddr:     u32;
    osd2:      [12]u8;
}

rec Group {
    block_bitmap: u32;
    inode_bitmap: u32;
    inode_table:  u32;
    free_blocks:  u16;
    free_inodes:  u16;
    used_dirs:    u16;
    pad:          u16;
    reserved:     [12]u8;
}

# one mounted filesystem
pub rec Fs {
    part:         *blk.Part;
    sb:           [1024]u8;
    blocks_count: u64;
    bpg:          u64;
    ipg:          u64;
    inode_size:   u64;
    first_data:   u64;
    groups:       u64;
    was_clean:    u8; # the clean flag as it was found at mount
}

fun sb32(fs: *Fs, off: u64) u32 { ret @((?fs.sb[off])::*u32); }
fun sb16(fs: *Fs, off: u64) u16 { ret @((?fs.sb[off])::*u16); }
fun set_sb32(fs: *Fs, off: u64, v: u32) { @((?fs.sb[off])::*u32) = v; }

fun e(code: u64) u64 { ret abi.err(code); }

# returns an error message, or nil once mounted
pub fun mount(fs: *Fs, p: *blk.Part) *u8 {
    fs.part = p;
    fs.inode_size = 128;
    fs.first_data = 0;
    if (blk.read_bytes(p, 1024, 1024, (?fs.sb[0])::u64) == 0) { ret "ext2: cannot read the superblock\0"; }
    if (sb16(fs, 56) != 0xEF53) { ret "ext2: not an ext2 filesystem\0"; }
    if (sb32(fs, 24) != 2) { ret "ext2: only 4 KiB blocks are supported\0"; }
    if (sb32(fs, 76) >= 1) {
        fs.inode_size = sb16(fs, 88)::u64;
        if ((sb32(fs, 96) & ~2::u32) != 0) { ret "ext2: unsupported incompatible features\0"; }
        if ((sb32(fs, 100) & ~3::u32) != 0) { ret "ext2: unsupported read-only features\0"; }
    }
    if (fs.inode_size < 128 || fs.inode_size > BS) { ret "ext2: bad inode size\0"; }
    fs.blocks_count = sb32(fs, 4)::u64;
    fs.first_data = sb32(fs, 20)::u64;
    fs.bpg = sb32(fs, 32)::u64;
    fs.ipg = sb32(fs, 40)::u64;
    if (fs.bpg == 0 || fs.ipg == 0 || fs.blocks_count > blk.blocks(p)) { ret "ext2: bad superblock\0"; }
    fs.groups = (fs.blocks_count - fs.first_data + fs.bpg - 1) / fs.bpg;
    fs.was_clean = (sb16(fs, 58) & 1)::u8;
    report(fs);
    ret nil;
}

# what the superblock says, for the log
fun report(fs: *Fs) {
    kprint.info("ext2\0");
    var label: u8 = 0;
    var i: u64 = 0;
    for (i < 16 && fs.sb[120 + i] != 0) { i = i + 1; }
    if (i > 0) {
        kprint.putc(39);
        var k: u64 = 0;
        for (k < i) {
            kprint.putc(fs.sb[120 + k]);
            k = k + 1;
        }
        kprint.puts("', \0");
        label = 1;
    }
    val total: u64 = sb32(fs, 4)::u64;
    val free: u64 = sb32(fs, 12)::u64;
    kprint.dec(total * 4 / 1024);
    kprint.puts(" MiB in \0");
    kprint.dec(fs.groups);
    kprint.puts(" group(s), \0");
    kprint.dec(free * 4 / 1024);
    kprint.puts(" MiB free, \0");
    kprint.dec((sb32(fs, 0) - sb32(fs, 16))::u64);
    kprint.putc(47);
    kprint.dec(sb32(fs, 0)::u64);
    kprint.puts(" inodes used, \0");
    kprint.dec(fs.inode_size);
    kprint.puts("-byte inodes\n\0");
    kprint.info("ext2\0");
    kprint.puts("mounted \0");
    kprint.dec(sb16(fs, 52)::u64);
    kprint.puts(" times before, \0");
    if (fs.was_clean != 0) { kprint.puts("cleanly unmounted\0"); }
    or { kprint.puts("NOT cleanly unmounted\0"); }
    if ((sb32(fs, 96) & 2) != 0) { kprint.puts(", filetype\0"); }
    if ((sb32(fs, 100) & 1) != 0) { kprint.puts(", sparse_super\0"); }
    if ((sb32(fs, 100) & 2) != 0) { kprint.puts(", large_file\0"); }
    kprint.putc(10);
}

fun write_sb(fs: *Fs) u8 { ret blk.write_bytes(fs.part, 1024, 1024, (?fs.sb[0])::u64); }

fun group_off(fs: *Fs, g: u64) u64 { ret (fs.first_data + 1) * BS + g * 32; }

fun read_group(fs: *Fs, g: u64, out: *Group) u8 { ret blk.read_bytes(fs.part, group_off(fs, g), 32, out::u64); }
fun write_group(fs: *Fs, g: u64, gd: *Group) u8 { ret blk.write_bytes(fs.part, group_off(fs, g), 32, gd::u64); }

fun inode_off(fs: *Fs, ino: u64) u64 {
    var gd: Group;
    read_group(fs, (ino - 1) / fs.ipg, ?gd);
    ret gd.inode_table::u64 * BS + ((ino - 1) % fs.ipg) * fs.inode_size;
}

pub fun read_inode(fs: *Fs, ino: u64, out: *Inode) u8 {
    if (ino == 0 || ino > fs.ipg * fs.groups) { ret 0; }
    ret blk.read_bytes(fs.part, inode_off(fs, ino), 128, out::u64);
}

fun write_inode(fs: *Fs, ino: u64, i: *Inode) u8 {
    ret blk.write_bytes(fs.part, inode_off(fs, ino), 128, i::u64);
}

pub fun kind_of(i: *Inode) u64 {
    val t: u16 = i.mode & S_IFMT;
    if (t == S_IFDIR) { ret abi.KIND_DIR; }
    if (t == S_IFCHR) { ret abi.KIND_DEV; }
    ret abi.KIND_FILE;
}

pub fun size_of(i: *Inode) u64 {
    if ((i.mode & S_IFMT) == S_IFREG) { ret i.size::u64 | (i.size_high::u64 << 32); }
    ret i.size::u64;
}

fun set_size(i: *Inode, n: u64) {
    i.size = (n & 0xFFFFFFFF)::u32;
    if ((i.mode & S_IFMT) == S_IFREG) { i.size_high = (n >> 32)::u32; }
}

# --- bitmaps -----------------------------------------------------------------

# find, set and return a clear bit below `limit` in bitmap block `b`, or NONE
fun take_bit(fs: *Fs, b: u64, limit: u64) u64 {
    val buf: u64 = heap.alloc(BS);
    if (buf == 0) { ret 0xFFFFFFFFFFFFFFFF; }
    var found: u64 = 0xFFFFFFFFFFFFFFFF;
    if (blk.read(fs.part, b, buf) != 0) {
        val bits: *u8 = buf::*u8;
        var i: u64 = 0;
        for (i < limit) {
            if (bits[i / 8] == 0xFF) {
                i = (i / 8 + 1) * 8;
                cnt;
            }
            if ((bits[i / 8] & (1::u8 << (i % 8)::u8)) == 0) {
                bits[i / 8] = bits[i / 8] | (1::u8 << (i % 8)::u8);
                if (blk.write(fs.part, b, buf) != 0) { found = i; }
                brk;
            }
            i = i + 1;
        }
    }
    heap.free(buf);
    ret found;
}

fun clear_bit(fs: *Fs, b: u64, bit: u64) {
    val buf: u64 = heap.alloc(BS);
    if (buf == 0) { ret; }
    if (blk.read(fs.part, b, buf) != 0) {
        val bits: *u8 = buf::*u8;
        bits[bit / 8] = bits[bit / 8] & ~(1::u8 << (bit % 8)::u8);
        blk.write(fs.part, b, buf);
    }
    heap.free(buf);
}

fun blocks_in_group(fs: *Fs, g: u64) u64 {
    val left: u64 = fs.blocks_count - fs.first_data - g * fs.bpg;
    if (left < fs.bpg) { ret left; }
    ret fs.bpg;
}

# a zeroed block, near group `goal` if possible; 0 when the disk is full
fun alloc_block(fs: *Fs, goal: u64) u64 {
    var k: u64 = 0;
    for (k < fs.groups) {
        val g: u64 = (goal + k) % fs.groups;
        var gd: Group;
        if (read_group(fs, g, ?gd) != 0 && gd.free_blocks > 0) {
            val bit: u64 = take_bit(fs, gd.block_bitmap::u64, blocks_in_group(fs, g));
            if (bit != 0xFFFFFFFFFFFFFFFF) {
                gd.free_blocks = gd.free_blocks - 1;
                write_group(fs, g, ?gd);
                set_sb32(fs, 12, sb32(fs, 12) - 1);
                write_sb(fs);
                val b: u64 = fs.first_data + g * fs.bpg + bit;
                val zero: u64 = heap.zalloc(BS);
                if (zero != 0) {
                    blk.write(fs.part, b, zero);
                    heap.free(zero);
                }
                ret b;
            }
        }
        k = k + 1;
    }
    ret 0;
}

fun free_block(fs: *Fs, b: u64) {
    if (b < fs.first_data || b >= fs.blocks_count) { ret; }
    val g: u64 = (b - fs.first_data) / fs.bpg;
    var gd: Group;
    if (read_group(fs, g, ?gd) == 0) { ret; }
    clear_bit(fs, gd.block_bitmap::u64, (b - fs.first_data) % fs.bpg);
    gd.free_blocks = gd.free_blocks + 1;
    write_group(fs, g, ?gd);
    set_sb32(fs, 12, sb32(fs, 12) + 1);
    write_sb(fs);
}

fun alloc_inode(fs: *Fs, goal: u64, dir: u8) u64 {
    var k: u64 = 0;
    for (k < fs.groups) {
        val g: u64 = (goal + k) % fs.groups;
        var gd: Group;
        if (read_group(fs, g, ?gd) != 0 && gd.free_inodes > 0) {
            val bit: u64 = take_bit(fs, gd.inode_bitmap::u64, fs.ipg);
            if (bit != 0xFFFFFFFFFFFFFFFF) {
                gd.free_inodes = gd.free_inodes - 1;
                if (dir != 0) { gd.used_dirs = gd.used_dirs + 1; }
                write_group(fs, g, ?gd);
                set_sb32(fs, 16, sb32(fs, 16) - 1);
                write_sb(fs);
                ret g * fs.ipg + bit + 1;
            }
        }
        k = k + 1;
    }
    ret 0;
}

fun free_inode(fs: *Fs, ino: u64, dir: u8) {
    val g: u64 = (ino - 1) / fs.ipg;
    var gd: Group;
    if (read_group(fs, g, ?gd) == 0) { ret; }
    clear_bit(fs, gd.inode_bitmap::u64, (ino - 1) % fs.ipg);
    gd.free_inodes = gd.free_inodes + 1;
    if (dir != 0 && gd.used_dirs > 0) { gd.used_dirs = gd.used_dirs - 1; }
    write_group(fs, g, ?gd);
    set_sb32(fs, 16, sb32(fs, 16) + 1);
    write_sb(fs);
}

# --- block mapping -----------------------------------------------------------

# entry `idx` of indirect block `b`, allocating it when `create`; 0 = hole
fun slot(fs: *Fs, b: u64, idx: u64, create: u8, i: *Inode, goal: u64) u64 {
    val d: u64 = blk.peek(fs.part, b); # read in place: no copy
    if (d == 0) { ret 0; }
    var v: u64 = (@((d + idx * 4)::*u32))::u64;
    if (v == 0 && create != 0) {
        v = alloc_block(fs, goal);
        if (v != 0) {
            # allocating touched other blocks: look the cached one up again
            val d2: u64 = blk.peek(fs.part, b);
            if (d2 == 0) { ret 0; }
            @((d2 + idx * 4)::*u32) = v::u32;
            blk.changed(fs.part, b);
            i.blocks = i.blocks + 8;
        }
    }
    ret v;
}

# a pointer held in the inode itself
fun direct(fs: *Fs, i: *Inode, n: u64, create: u8, goal: u64) u64 {
    var v: u64 = i.block[n]::u64;
    if (v == 0 && create != 0) {
        v = alloc_block(fs, goal);
        if (v != 0) {
            i.block[n] = v::u32;
            i.blocks = i.blocks + 8;
        }
    }
    ret v;
}

# the disk block holding file block `lbn`; 0 for a hole (or a failed create).
# may change `i` (the caller writes it back)
fun bmap(fs: *Fs, ino: u64, i: *Inode, lbn: u64, create: u8) u64 {
    val goal: u64 = (ino - 1) / fs.ipg;
    if (lbn < 12) { ret direct(fs, i, lbn, create, goal); }
    var n: u64 = lbn - 12;
    if (n < PTRS) {
        val ind: u64 = direct(fs, i, 12, create, goal);
        if (ind == 0) { ret 0; }
        ret slot(fs, ind, n, create, i, goal);
    }
    n = n - PTRS;
    if (n < PTRS * PTRS) {
        val dind: u64 = direct(fs, i, 13, create, goal);
        if (dind == 0) { ret 0; }
        val ind: u64 = slot(fs, dind, n / PTRS, create, i, goal);
        if (ind == 0) { ret 0; }
        ret slot(fs, ind, n % PTRS, create, i, goal);
    }
    n = n - PTRS * PTRS;
    if (n < PTRS * PTRS * PTRS) {
        val tind: u64 = direct(fs, i, 14, create, goal);
        if (tind == 0) { ret 0; }
        val dind: u64 = slot(fs, tind, n / (PTRS * PTRS), create, i, goal);
        if (dind == 0) { ret 0; }
        val ind: u64 = slot(fs, dind, (n / PTRS) % PTRS, create, i, goal);
        if (ind == 0) { ret 0; }
        ret slot(fs, ind, n % PTRS, create, i, goal);
    }
    ret 0;
}

fun free_tree(fs: *Fs, b: u64, depth: u64) {
    if (b == 0) { ret; }
    if (depth > 0) {
        val buf: u64 = heap.alloc(BS);
        if (buf != 0) {
            if (blk.read(fs.part, b, buf) != 0) {
                val t: *u32 = buf::*u32;
                var k: u64 = 0;
                for (k < PTRS) {
                    free_tree(fs, t[k]::u64, depth - 1);
                    k = k + 1;
                }
            }
            heap.free(buf);
        }
    }
    free_block(fs, b);
}

fun free_blocks(fs: *Fs, i: *Inode) {
    var k: u64 = 0;
    for (k < 12) {
        free_tree(fs, i.block[k]::u64, 0);
        k = k + 1;
    }
    free_tree(fs, i.block[12]::u64, 1);
    free_tree(fs, i.block[13]::u64, 2);
    free_tree(fs, i.block[14]::u64, 3);
    k = 0;
    for (k < 15) {
        i.block[k] = 0;
        k = k + 1;
    }
    i.blocks = 0;
}

# --- file data ---------------------------------------------------------------

pub fun read(fs: *Fs, ino: u64, off: u64, dst: u64, n: u64) u64 {
    var i: Inode;
    if (read_inode(fs, ino, ?i) == 0) { ret e(abi.E_IO); }
    val size: u64 = size_of(?i);
    if (off >= size) { ret 0; }
    var want: u64 = n;
    if (want > size - off) { want = size - off; }
    val buf: u64 = heap.alloc(BS);
    if (buf == 0) { ret e(abi.E_NOMEM); }
    var done: u64 = 0;
    for (done < want) {
        val at: u64 = off + done;
        var k: u64 = BS - at % BS;
        if (k > want - done) { k = want - done; }
        val pb: u64 = bmap(fs, ino, ?i, at / BS, 0);
        if (pb == 0) {
            mem.fill(dst + done, 0, k);
        } or {
            if (blk.read(fs.part, pb, buf) == 0) {
                heap.free(buf);
                ret e(abi.E_IO);
            }
            mem.copy(dst + done, buf + at % BS, k);
        }
        done = done + k;
    }
    heap.free(buf);
    ret want;
}

pub fun write(fs: *Fs, ino: u64, off: u64, src: u64, n: u64) u64 {
    var i: Inode;
    if (read_inode(fs, ino, ?i) == 0) { ret e(abi.E_IO); }
    val buf: u64 = heap.alloc(BS);
    if (buf == 0) { ret e(abi.E_NOMEM); }
    var done: u64 = 0;
    var err: u64 = 0;
    for (done < n) {
        val at: u64 = off + done;
        var k: u64 = BS - at % BS;
        if (k > n - done) { k = n - done; }
        val pb: u64 = bmap(fs, ino, ?i, at / BS, 1);
        if (pb == 0) { err = e(abi.E_NOSPC); brk; }
        if (k < BS && blk.read(fs.part, pb, buf) == 0) { err = e(abi.E_IO); brk; }
        mem.copy(buf + at % BS, src + done, k);
        if (blk.write(fs.part, pb, buf) == 0) { err = e(abi.E_IO); brk; }
        done = done + k;
    }
    heap.free(buf);
    if (off + done > size_of(?i)) {
        set_size(?i, off + done);
        if (off + done >= 0x80000000 && (sb32(fs, 100) & 2) == 0) { # large_file
            set_sb32(fs, 100, sb32(fs, 100) | 2);
            write_sb(fs);
        }
    }
    i.mtime = clock.now()::u32;
    i.ctime = i.mtime;
    write_inode(fs, ino, ?i);
    if (done == 0 && err != 0) { ret err; }
    ret done;
}

pub fun truncate(fs: *Fs, ino: u64) {
    var i: Inode;
    if (read_inode(fs, ino, ?i) == 0) { ret; }
    free_blocks(fs, ?i);
    set_size(?i, 0);
    i.mtime = clock.now()::u32;
    i.ctime = i.mtime;
    write_inode(fs, ino, ?i);
}

# --- directories ---------------------------------------------------------------

# the next entry at byte *pos of directory `dir` (skipping empty slots, "."
# and ".."); fills name/len/ino/kind and advances *pos. 0 at the end
pub fun dir_next(fs: *Fs, dir: u64, pos: *u64, name: *u8, len: *u64, ino: *u64, kind: *u64) u8 {
    var hdr: [8]u8;
    for {
        if (read(fs, dir, @pos, (?hdr[0])::u64, 8) != 8) { ret 0; }
        val inum: u64 = (@((?hdr[0])::*u32))::u64;
        val rec: u64 = (@((?hdr[4])::*u16))::u64;
        val nl: u64 = hdr[6]::u64;
        val ft: u8 = hdr[7];
        if (rec < 8) { ret 0; }
        val at: u64 = @pos;
        @pos = at + rec;
        if (inum == 0 || nl == 0 || nl > abi.NAME_MAX) { cnt; }
        read(fs, dir, at + 8, name::u64, nl);
        if (nl == 1 && name[0] == 46) { cnt; }
        if (nl == 2 && name[0] == 46 && name[1] == 46) { cnt; }
        @len = nl;
        @ino = inum;
        if (ft == FT_DIR) { @kind = abi.KIND_DIR; }
        or (ft == FT_REG) { @kind = abi.KIND_FILE; }
        or {
            var i: Inode;
            read_inode(fs, inum, ?i);
            @kind = kind_of(?i);
        }
        ret 1;
    }
    ret 0;
}

fun rec_size(nl: u64) u64 { ret (8 + nl + 3) & ~3::u64; }

fun put_entry(at: u64, ino: u64, rec: u64, name: *u8, nl: u64, ft: u8) {
    @(at::*u32) = ino::u32;
    @((at + 4)::*u16) = rec::u16;
    @((at + 6)::*u8) = nl::u8;
    @((at + 7)::*u8) = ft;
    mem.copy(at + 8, name::u64, nl);
}

fun drop_index(fs: *Fs, dir: u64, i: *Inode) {
    if ((i.flags & INDEX_FL) != 0) {
        i.flags = i.flags & ~INDEX_FL;
        write_inode(fs, dir, i);
    }
}

fun dir_add(fs: *Fs, dir: u64, name: *u8, nl: u64, ino: u64, ft: u8) u64 {
    var i: Inode;
    if (read_inode(fs, dir, ?i) == 0) { ret e(abi.E_IO); }
    drop_index(fs, dir, ?i);
    val need: u64 = rec_size(nl);
    val buf: u64 = heap.alloc(BS);
    if (buf == 0) { ret e(abi.E_NOMEM); }
    val nblocks: u64 = size_of(?i) / BS;
    var lbn: u64 = 0;
    for (lbn < nblocks) {
        val pb: u64 = bmap(fs, dir, ?i, lbn, 0);
        if (pb != 0 && blk.read(fs.part, pb, buf) != 0) {
            var off: u64 = 0;
            for (off + 8 <= BS) {
                val at: u64 = buf + off;
                val rec: u64 = (@((at + 4)::*u16))::u64;
                if (rec < 8 || off + rec > BS) { brk; }
                var used: u64 = 0;
                if (@(at::*u32) != 0) { used = rec_size((@((at + 6)::*u8))::u64); }
                if (rec - used >= need) {
                    if (used == 0) {
                        put_entry(at, ino, rec, name, nl, ft);
                    } or {
                        @((at + 4)::*u16) = used::u16;
                        put_entry(at + used, ino, rec - used, name, nl, ft);
                    }
                    val ok: u8 = blk.write(fs.part, pb, buf);
                    heap.free(buf);
                    if (ok == 0) { ret e(abi.E_IO); }
                    ret 0;
                }
                off = off + rec;
            }
        }
        lbn = lbn + 1;
    }
    # no room: a new block holding just this entry
    val pb: u64 = bmap(fs, dir, ?i, nblocks, 1);
    if (pb == 0) {
        heap.free(buf);
        write_inode(fs, dir, ?i);
        ret e(abi.E_NOSPC);
    }
    mem.fill(buf, 0, BS);
    put_entry(buf, ino, BS, name, nl, ft);
    val ok: u8 = blk.write(fs.part, pb, buf);
    heap.free(buf);
    set_size(?i, (nblocks + 1) * BS);
    write_inode(fs, dir, ?i);
    if (ok == 0) { ret e(abi.E_IO); }
    ret 0;
}

# remove `name` from `dir`; returns its inode number, 0 if it was not there
fun dir_remove(fs: *Fs, dir: u64, name: *u8, nl: u64) u64 {
    var i: Inode;
    if (read_inode(fs, dir, ?i) == 0) { ret 0; }
    drop_index(fs, dir, ?i);
    val buf: u64 = heap.alloc(BS);
    if (buf == 0) { ret 0; }
    val nblocks: u64 = size_of(?i) / BS;
    var lbn: u64 = 0;
    for (lbn < nblocks) {
        val pb: u64 = bmap(fs, dir, ?i, lbn, 0);
        if (pb != 0 && blk.read(fs.part, pb, buf) != 0) {
            var off: u64 = 0;
            var prev: u64 = 0xFFFFFFFFFFFFFFFF;
            for (off + 8 <= BS) {
                val at: u64 = buf + off;
                val rec: u64 = (@((at + 4)::*u16))::u64;
                if (rec < 8 || off + rec > BS) { brk; }
                val inum: u64 = (@(at::*u32))::u64;
                if (inum != 0 && (@((at + 6)::*u8))::u64 == nl && mem.equal((at + 8)::*u8, name, nl) != 0) {
                    if (prev == 0xFFFFFFFFFFFFFFFF) {
                        @(at::*u32) = 0;
                    } or {
                        val p: u64 = buf + prev;
                        @((p + 4)::*u16) = ((@((p + 4)::*u16))::u64 + rec)::u16;
                    }
                    blk.write(fs.part, pb, buf);
                    heap.free(buf);
                    ret inum;
                }
                prev = off;
                off = off + rec;
            }
        }
        lbn = lbn + 1;
    }
    heap.free(buf);
    ret 0;
}

# point the ".." of directory `dir` at `parent`
fun set_dotdot(fs: *Fs, dir: u64, parent: u64) {
    var i: Inode;
    if (read_inode(fs, dir, ?i) == 0) { ret; }
    val pb: u64 = bmap(fs, dir, ?i, 0, 0);
    if (pb == 0) { ret; }
    val buf: u64 = heap.alloc(BS);
    if (buf == 0) { ret; }
    if (blk.read(fs.part, pb, buf) != 0) {
        val rec: u64 = (@((buf + 4)::*u16))::u64; # "." comes first
        if (rec >= 12 && rec + 8 <= BS) {
            @((buf + rec)::*u32) = parent::u32;
            blk.write(fs.part, pb, buf);
        }
    }
    heap.free(buf);
}

fun add_links(fs: *Fs, ino: u64, up: u8) {
    var i: Inode;
    if (read_inode(fs, ino, ?i) == 0) { ret; }
    if (up != 0) { i.links = i.links + 1; }
    or (i.links > 0) { i.links = i.links - 1; }
    write_inode(fs, ino, ?i);
}

# a new file or directory `name` in `dir`; returns its inode or an error
pub fun create(fs: *Fs, dir: u64, name: *u8, nl: u64, kind: u64, mode: u64, uid: u64, gid: u64) u64 {
    var is_dir: u8 = 0;
    if (kind == abi.KIND_DIR) { is_dir = 1; }
    val ino: u64 = alloc_inode(fs, (dir - 1) / fs.ipg, is_dir);
    if (ino == 0) { ret e(abi.E_NOSPC); }
    var i: Inode;
    mem.fill((?i)::u64, 0, 128);
    i.atime = clock.now()::u32;
    i.ctime = i.atime;
    i.mtime = i.atime;
    var ft: u8 = FT_REG;
    if (is_dir != 0) {
        ft = FT_DIR;
        i.mode = S_IFDIR | (mode & 0xFFF)::u16;
        i.links = 2;
        val b: u64 = alloc_block(fs, (ino - 1) / fs.ipg);
        if (b == 0) {
            free_inode(fs, ino, 1);
            ret e(abi.E_NOSPC);
        }
        val buf: u64 = heap.zalloc(BS);
        if (buf == 0) {
            free_block(fs, b);
            free_inode(fs, ino, 1);
            ret e(abi.E_NOMEM);
        }
        put_entry(buf, ino, 12, ".\0", 1, FT_DIR);
        put_entry(buf + 12, dir, BS - 12, "..\0", 2, FT_DIR);
        blk.write(fs.part, b, buf);
        heap.free(buf);
        i.block[0] = b::u32;
        i.blocks = 8;
        i.size = BS::u32;
    } or {
        i.mode = S_IFREG | (mode & 0xFFF)::u16;
        i.links = 1;
    }
    i.uid = (uid & 0xFFFF)::u16;
    i.gid = (gid & 0xFFFF)::u16;
    write_inode(fs, ino, ?i);
    val r: u64 = dir_add(fs, dir, name, nl, ino, ft);
    if (abi.is_err(r) != 0) {
        free_blocks(fs, ?i);
        free_inode(fs, ino, is_dir);
        ret r;
    }
    if (is_dir != 0) { add_links(fs, dir, 1); }
    ret ino;
}

# take `name` (inode `ino`) out of `dir`; returns the links left on it.
# a directory must already be empty
pub fun unlink(fs: *Fs, dir: u64, name: *u8, nl: u64, ino: u64, is_dir: u8) u64 {
    dir_remove(fs, dir, name, nl);
    var i: Inode;
    if (read_inode(fs, ino, ?i) == 0) { ret 0; }
    if (is_dir != 0) {
        i.links = 0; # its own "." and the entry just removed
        add_links(fs, dir, 0);
    } or (i.links > 0) {
        i.links = i.links - 1;
    }
    write_inode(fs, ino, ?i);
    ret i.links::u64;
}

# give back the blocks and inode of something with no links left
pub fun release(fs: *Fs, ino: u64) {
    var i: Inode;
    if (read_inode(fs, ino, ?i) == 0 || i.links != 0) { ret; }
    val is_dir: u8 = ((i.mode & S_IFMT) == S_IFDIR)::u8;
    free_blocks(fs, ?i);
    set_size(?i, 0);
    i.dtime = clock.now()::u32;
    write_inode(fs, ino, ?i);
    free_inode(fs, ino, is_dir);
}

pub fun rename(fs: *Fs, odir: u64, oname: *u8, onl: u64, ndir: u64, nname: *u8, nnl: u64, ino: u64, is_dir: u8) u64 {
    var ft: u8 = FT_REG;
    if (is_dir != 0) { ft = FT_DIR; }
    val r: u64 = dir_add(fs, ndir, nname, nnl, ino, ft);
    if (abi.is_err(r) != 0) { ret r; }
    dir_remove(fs, odir, oname, onl);
    if (is_dir != 0 && odir != ndir) {
        set_dotdot(fs, ino, ndir);
        add_links(fs, odir, 0);
        add_links(fs, ndir, 1);
    }
    ret 0;
}

# permission bits (07777), owner and group of an inode
pub fun set_attr(fs: *Fs, ino: u64, mode: u64, uid: u64, gid: u64) u8 {
    var i: Inode;
    if (read_inode(fs, ino, ?i) == 0) { ret 0; }
    i.mode = (i.mode & S_IFMT) | (mode & 0xFFF)::u16;
    i.uid = (uid & 0xFFFF)::u16;
    i.gid = (gid & 0xFFFF)::u16;
    i.ctime = clock.now()::u32;
    ret write_inode(fs, ino, ?i);
}

# the superblock's "cleanly unmounted" bit (s_state & 1): cleared while
# mounted, set again by a clean unmount, so a crash leaves it clear
pub fun set_clean(fs: *Fs, clean: u8) {
    var st: u16 = sb16(fs, 58);
    if (clean != 0) { st = st | 1; }
    or              { st = st & 0xFFFE; }
    @((?fs.sb[58])::*u16) = st;
    write_sb(fs);
}

pub fun free_space(fs: *Fs) u64 { ret sb32(fs, 12)::u64 * BS; }
pub fun total_space(fs: *Fs) u64 { ret fs.blocks_count * BS; }
