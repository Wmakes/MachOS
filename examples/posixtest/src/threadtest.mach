# Same-process parallelism, shared page faults, and running-thread cleanup.

use abi: sdk.abi;
use sys: sdk.sys;
use io: sdk.io;
use rt: sdk.rt;

#[volatile]
rec Word { value: u64; }
var gate: Word;
var ready: [16]Word;
var alive: [16]Word;
var counters: [16]Word;
var stacks: [16]u64;
var mode: u64 = 0;
var page: u64 = 0;
var marker: Word;
var tids: [16]u64;
var process_id: u64 = 0;

fun memory_faults(index: u64) u8 {
    var round: u64 = 0;
    for (round < 2) {
        val bytes: u64 = 4 * 1048576;
        val a: u64 = sys.mmap(0, bytes, abi.PROT_READ | abi.PROT_WRITE, abi.MAP_PRIVATE | abi.MAP_ANONYMOUS, 0, 0);
        if (abi.is_err(a) != 0) { ret 0; }
        var off: u64 = 0;
        for (off < bytes) {
            val p: *u64 = (a + off)::*u64;
            if (p[0] != 0 || p[511] != 0) { ret 0; }
            p[0] = off + index + 1; p[511] = ~off;
            off = off + 4096;
        }
        off = 0;
        for (off < bytes) {
            val p: *u64 = (a + off)::*u64;
            if (p[0] != off + index + 1 || p[511] != ~off) { ret 0; }
            off = off + 4096;
        }
        if (sys.munmap(a, bytes) != 0) { ret 0; }
        round = round + 1;
    }
    ret 1;
}

fun worker(index: u64) {
    var mask: u64 = 1u64 << index;
    if (sys.raw(abi.AFFINITY, 1, (?mask)::u64, 1, 0, 0) != 0) { sys.exit(90); }
    if (mode == 2) { @((page)::*u64) = 7; }
    ready[index].value = 1;
    for (gate.value == 0) { sys.sleep(1); }
    if (mode == 8) {
        if (memory_faults(index) == 0) { sys.exit(86); }
        sys.raw(abi.THREAD_EXIT, 0, 0, 0, 0, 0);
        for {}
    }
    if (mode == 5 || mode == 6 || mode == 7) {
        if (mode == 7 && index == 0) { sys.kill(process_id, abi.SIGSTOP); }
        var n: u64 = 0;
        for (n < 50000 || mode == 6 || mode == 7) {
            if (sys.getpid() != process_id || sys.raw(abi.GETTID, 0, 0, 0, 0, 0) != tids[index]) { sys.exit(87); }
            n = n + 1;
        }
        sys.raw(abi.THREAD_EXIT, 0, 0, 0, 0, 0);
        for {}
    }
    if (mode == 2) { @((page)::*u64) = 99; sys.exit(91); }
    if (mode == 3 && index == 0) { sys.kill(sys.getpid(), abi.SIGSTOP); }
    var now: abi.Info;
    sys.info(?now);
    val start: u64 = now.uptime_ms;
    var value: u64 = index + 1;
    for (mode != 0 || now.uptime_ms - start < 2000) {
        var n: u64 = 0;
        for (n < 100000) {
            value = (value ^ (value >> 13)) * 6364136223846793005 + 1;
            n = n + 1;
        }
        counters[index].value = value;
        sys.info(?now);
    }
    sys.raw(abi.THREAD_EXIT, 0, 0, 0, 0, 0);
    for {}
}

fun start(count: u64) u8 {
    gate.value = 0;
    var i: u64 = 0;
    for (i < count) {
        ready[i].value = 0;
        alive[i].value = 1;
        stacks[i] = sys.mmap(0, 1048576, abi.PROT_READ | abi.PROT_WRITE, abi.MAP_PRIVATE | abi.MAP_ANONYMOUS, 0, 0);
        if (abi.is_err(stacks[i]) != 0) { ret 0; }
        val tid: u64 = sys.raw(abi.THREAD_SPAWN, worker::u64, stacks[i] + 1048576 - 8, i, 0, (?alive[i].value)::u64);
        if (abi.is_err(tid) != 0) { ret 0; }
        tids[i] = tid;
        i = i + 1;
    }
    i = 0;
    for (i < count) { for (ready[i].value == 0) { sys.sleep(1); } i = i + 1; }
    ret 1;
}

fun parallel(count: u64) u8 {
    mode = 0;
    if (start(count) == 0) { ret 0; }
    var before: abi.Info;
    sys.info(?before);
    gate.value = 1;
    var i: u64 = 0;
    for (i < count) {
        for (alive[i].value != 0) { sys.sleep(1); }
        if (sys.munmap(stacks[i], 1048576) != 0) { ret 0; }
        i = i + 1;
    }
    var after: abi.Info;
    sys.info(?after);
    var busy: u64 = 0;
    i = 0;
    for (i < count) {
        val ticks: u64 = after.cpu_busy[i] - before.cpu_busy[i];
        io.out("thread cpu\0"); io.dec(i); io.out(" ticks: \0"); io.dec(ticks); io.putc(10);
        if (ticks < 10) { ret 0; }
        busy = busy + ticks;
        i = i + 1;
    }
    ret (busy * 10 > (after.uptime_ms - before.uptime_ms) * 3 / 2)::u8;
}

fun identifiers(count: u64) u8 {
    mode = 5;
    process_id = sys.getpid();
    if (start(count) == 0) { ret 0; }
    var before: abi.Timespec;
    if (sys.raw(abi.CLOCK, abi.CLOCK_MONOTONIC, (?before)::u64, 0, 0, 0) != 0) { ret 0; }
    gate.value = 1;
    var i: u64 = 0;
    for (i < count) {
        for (alive[i].value != 0) { sys.sleep(1); }
        sys.munmap(stacks[i], 1048576);
        i = i + 1;
    }
    var after: abi.Timespec;
    if (sys.raw(abi.CLOCK, abi.CLOCK_MONOTONIC, (?after)::u64, 0, 0, 0) != 0) { ret 0; }
    val elapsed: u64 = (after.sec - before.sec) * 1000000000 + after.nsec - before.nsec;
    io.out("identifier calls: \0"); io.dec(count * 100000);
    io.out(" in ns: \0"); io.dec(elapsed); io.putc(10);
    io.out("ok concurrent process and thread identifiers\n\0");
    ret 1;
}

fun queued_faults(count: u64) u8 {
    mode = 8;
    if (start(count) == 0) { ret 0; }
    gate.value = 1;
    var i: u64 = 0;
    for (i < count) {
        for (alive[i].value != 0) { sys.sleep(1); }
        if (sys.munmap(stacks[i], 1048576) != 0) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

fun cleanup(which: u64, count: u64) u8 {
    val pid: u64 = sys.fork();
    if (pid == 0) {
        mode = 1;
        process_id = sys.getpid();
        if (which == 4) { mode = 3; }
        if (which == 5 || which == 6) { mode = 6; }
        if (which == 7) { mode = 7; }
        if (start(count) == 0) { sys.exit(92); }
        gate.value = 1;
        if (which == 4 || which == 7) { sys.sleep(150); sys.exit(0); }
        sys.sleep(30);
        if (which == 0 || which == 5) { sys.exit(0); }
        if (which == 1 || which == 6) { sys.execve("/bin/true\0", 9, "true\0", 5); sys.exit(93); }
        if (which == 3) {
            var n: u64 = 0;
            for (n < 16) {
                marker.value = 123456;
                val child: u64 = sys.fork();
                if (child == 0) { marker.value = 654321; sys.exit(0); }
                var status: u64 = 0;
                if (abi.is_err(child) != 0 || sys.waitpid(child, ?status, 0) != child || status != 0 || marker.value != 123456) { sys.exit(89); }
                n = n + 1;
            }
            sys.exit(0);
        }
        # Loading a regular non-executable image fails after siblings pause.
        val path: *u8 = "/tmp/thread-bad\0";
        val fd: u64 = sys.open_mode(path, io.len(path), abi.O_CREATE | abi.O_WRITE | abi.O_TRUNC, 0x1FF);
        if (abi.is_err(fd) != 0) { sys.exit(94); }
        sys.write(fd, "bad\0", 3);
        sys.close(fd);
        if (abi.is_err(sys.execve(path, io.len(path), "bad\0", 4)) == 0) { sys.exit(95); }
        val previous: u64 = counters[0].value;
        sys.sleep(30);
        if (counters[0].value == previous) { sys.exit(96); }
        sys.exit(0);
    }
    var status: u64 = 0;
    if ((which == 4 || which == 7) && abi.is_err(pid) == 0) {
        if (sys.waitpid(pid, ?status, abi.WUNTRACED) != pid || abi.wifstopped(status) == 0) { ret 0; }
        val before: u64 = process_ticks(pid);
        sys.sleep(30);
        if (process_ticks(pid) != before) { sys.kill(pid, abi.SIGKILL); ret 0; }
        if (sys.kill(pid, abi.SIGCONT) != 0) { ret 0; }
    }
    ret (abi.is_err(pid) == 0 && sys.waitpid(pid, ?status, 0) == pid && status == 0)::u8;
}

fun process_ticks(pid: u64) u64 {
    var i: u64 = 0;
    var p: abi.ProcInfo;
    for (sys.procs(i, ?p) != 0) {
        if (p.pid == pid) { ret p.cpu_ticks; }
        i = i + 1;
    }
    ret 0;
}

fun protection() u8 {
    val pid: u64 = sys.fork();
    if (pid == 0) {
        mode = 2;
        var mask: u64 = 2;
        if (sys.raw(abi.AFFINITY, 1, (?mask)::u64, 1, 0, 0) != 0) { sys.exit(88); }
        page = sys.mmap(0, 4096, abi.PROT_READ | abi.PROT_WRITE, abi.MAP_PRIVATE | abi.MAP_ANONYMOUS, 0, 0);
        if (abi.is_err(page) != 0 || start(1) == 0) { sys.exit(97); }
        if (sys.mprotect(page, 4096, abi.PROT_READ) != 0) { sys.exit(98); }
        gate.value = 1;
        sys.sleep(1000);
        sys.exit(99);
    }
    var status: u64 = 0;
    ret (abi.is_err(pid) == 0 && sys.waitpid(pid, ?status, 0) == pid && abi.wifsignaled(status) != 0 && abi.wtermsig(status) == abi.SIGSEGV)::u8;
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var inf: abi.Info;
    sys.info(?inf);
    if (inf.cpus < 2 || inf.cpus > 16) { ret 1; }
    if (argc > 1 && io.eq(argv[1], io.len(argv[1]), "ids\0", 3) != 0) { ret (identifiers(inf.cpus) == 0)::u64; }
    if (identifiers(inf.cpus) == 0) { io.out("FAIL identifiers\n\0"); ret 1; }
    if (queued_faults(inf.cpus) == 0) { io.out("FAIL queued faults\n\0"); ret 1; }
    io.out("ok concurrent shared-address-space faults\n\0");
    io.out("running parallel threads\n\0");
    if (parallel(inf.cpus) == 0) { io.out("FAIL parallel threads\n\0"); ret 1; }
    io.out("ok parallel threads\n\0");
    if (protection() == 0) { io.out("FAIL remote protection\n\0"); ret 1; }
    io.out("ok remote protection\n\0");
    var i: u64 = 0;
    for (i < 8) {
        io.out("running thread cleanup \0"); io.dec(i); io.putc(10);
        if (cleanup(i, inf.cpus) == 0) { io.out("FAIL thread cleanup\n\0"); ret 1; }
        i = i + 1;
    }
    io.out("ok exit exec and failed exec with running threads\n\0");
    io.out("ok concurrent fork and copy-on-write\n\0");
    io.out("ok process-wide stop and continue\n\0");
    io.out("ok lifecycle with identifier-only threads\n\0");
    ret 0;
}
