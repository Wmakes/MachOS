# the process's environment: "NAME=value" strings, read from what the
# kernel passed at start, changed with set/unset, handed to new programs by
# sys.spawn (pack). kept in fixed buffers: 16 KiB, 256 variables

use start: sdk.start;

val STORE: u64 = 16384;
val MAX: u64 = 256;

var store: [16384]u8;
var used: u64 = 0;
var offs: [256]u64;
var count: u64 = 0;
var loaded: u8 = 0;

fun slen(s: *u8) u64 {
    var n: u64 = 0;
    for (s[n] != 0) { n = n + 1; }
    ret n;
}

fun add(s: *u8, n: u64) u8 {
    if (count == MAX || used + n + 1 > STORE) { ret 0; }
    var i: u64 = 0;
    for (i < n) {
        store[used + i] = s[i];
        i = i + 1;
    }
    store[used + n] = 0;
    offs[count] = used;
    count = count + 1;
    used = used + n + 1;
    ret 1;
}

fun load() {
    if (loaded != 0) { ret; }
    loaded = 1;
    if (start.envp == 0) { ret; }
    val vp: **u8 = start.envp::**u8;
    var i: u64 = 0;
    for (vp[i] != nil) {
        add(vp[i], slen(vp[i]));
        i = i + 1;
    }
}

# index of the variable `name` (n bytes), or MAX
fun find(name: *u8, n: u64) u64 {
    load();
    var i: u64 = 0;
    for (i < count) {
        val e: *u8 = ?store[offs[i]];
        var k: u64 = 0;
        for (k < n && e[k] == name[k]) { k = k + 1; }
        if (k == n && e[n] == 61) { ret i; }
        i = i + 1;
    }
    ret MAX;
}

# the value of `name` (n bytes), NUL-terminated, or nil
pub fun getn(name: *u8, n: u64) *u8 {
    val i: u64 = find(name, n);
    if (i == MAX) { ret nil; }
    ret ?store[offs[i] + n + 1];
}

pub fun get(name: *u8) *u8 { ret getn(name, slen(name)); }

fun remove(i: u64) {
    var k: u64 = i;
    for (k + 1 < count) {
        offs[k] = offs[k + 1];
        k = k + 1;
    }
    count = count - 1;
}

# squeeze out the bytes of removed variables
fun compact() {
    var tmp: [16384]u8;
    var o: u64 = 0;
    var i: u64 = 0;
    for (i < count) {
        val e: *u8 = ?store[offs[i]];
        val n: u64 = slen(e);
        var k: u64 = 0;
        for (k <= n) {
            tmp[o + k] = e[k];
            k = k + 1;
        }
        offs[i] = o;
        o = o + n + 1;
        i = i + 1;
    }
    i = 0;
    for (i < o) {
        store[i] = tmp[i];
        i = i + 1;
    }
    used = o;
}

pub fun unsetn(name: *u8, n: u64) {
    val i: u64 = find(name, n);
    if (i != MAX) { remove(i); }
}

pub fun unset(name: *u8) { unsetn(name, slen(name)); }

# name (n bytes) = value (vn bytes); 0 if there is no room
pub fun setn(name: *u8, n: u64, value: *u8, vn: u64) u8 {
    unsetn(name, n);
    if (used + n + vn + 2 > STORE) { compact(); }
    if (count == MAX || used + n + vn + 2 > STORE) { ret 0; }
    offs[count] = used;
    var i: u64 = 0;
    for (i < n) {
        store[used + i] = name[i];
        i = i + 1;
    }
    store[used + n] = 61;
    i = 0;
    for (i < vn) {
        store[used + n + 1 + i] = value[i];
        i = i + 1;
    }
    store[used + n + 1 + vn] = 0;
    used = used + n + vn + 2;
    count = count + 1;
    ret 1;
}

pub fun set(name: *u8, value: *u8) u8 { ret setn(name, slen(name), value, slen(value)); }

pub fun size() u64 {
    load();
    ret count;
}

# the i-th variable as "NAME=value"
pub fun nth(i: u64) *u8 {
    load();
    ret ?store[offs[i]];
}

# every variable, each NUL-terminated, into out; the bytes used (or the
# bytes that fit)
pub fun pack(out: *u8, cap: u64) u64 {
    load();
    var o: u64 = 0;
    var i: u64 = 0;
    for (i < count) {
        val e: *u8 = ?store[offs[i]];
        val n: u64 = slen(e) + 1;
        if (o + n > cap) { brk; }
        var k: u64 = 0;
        for (k < n) {
            out[o + k] = e[k];
            k = k + 1;
        }
        o = o + n;
        i = i + 1;
    }
    ret o;
}
