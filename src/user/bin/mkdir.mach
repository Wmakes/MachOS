# mkdir DIR...: make directories

use abi: machos.abi.sys;
use sys: machos.user.sys;
use io:  machos.user.io;
use rt:  machos.user.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc < 2) {
        io.err("usage: mkdir DIR...\n\0");
        ret 2;
    }
    var status: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        val r: u64 = sys.mkdir(argv[i], io.len(argv[i]));
        if (abi.is_err(r) != 0) {
            io.fail("mkdir\0", argv[i], r);
            status = 1;
        }
        i = i + 1;
    }
    ret status;
}
