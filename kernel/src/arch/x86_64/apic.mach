# local APIC (timer, end-of-interrupt) and I/O APIC (routing device irqs)

use acpi: machos.acpi.acpi;
use cpu:  machos.arch.x86_64.cpu;
use vmm:  machos.mm.vmm;
use kprint: machos.kern.kprint;

pub val TIMER_VECTOR:    u64 = 48;
pub val IRQ_BASE:        u64 = 32; # legacy irq n arrives on vector 32 + n
pub val SPURIOUS_VECTOR: u64 = 63;
pub val WAKE_VECTOR:     u64 = 49; # an idle cpu is told there is work
pub val HZ:              u64 = 100;

#[volatile]
rec Reg { v: u32; }

val ID:        u64 = 0x020;
val EOI:       u64 = 0x0B0;
val SVR:       u64 = 0x0F0;
val LVT_TIMER: u64 = 0x320;
val INIT:      u64 = 0x380;
val CURRENT:   u64 = 0x390;
val DIVIDE:    u64 = 0x3E0;

var lapic: u64 = 0;
var ioapic: u64 = 0;
var ioapic_gsi: u32 = 0;
var madt: acpi.Madt;

fun lr(off: u64) u32 { ret (@((lapic + off)::*Reg)).v; }
fun lw(off: u64, v: u32) { (@((lapic + off)::*Reg)).v = v; }

fun ior(reg: u32) u32 {
    (@(ioapic::*Reg)).v = reg;
    ret (@((ioapic + 16)::*Reg)).v;
}

fun iow(reg: u32, v: u32) {
    (@(ioapic::*Reg)).v = reg;
    (@((ioapic + 16)::*Reg)).v = v;
}

pub fun eoi() { lw(EOI, 0); }

var calibrated: u8 = 1;
var per_tick: u32 = 0;

fun icr_wait() {
    var spins: u64 = 0;
    for ((lr(0x300) & (1 << 12)) != 0 && spins < 1000000) { spins = spins + 1; }
}

# INIT, then (after the caller waits) startup at page `page` (physical
# address page * 4096): how a cpu that firmware left halted is started
pub fun send_init(id: u32) {
    icr_wait();
    lw(0x310, id << 24);
    lw(0x300, 0x4500); # INIT, assert
    icr_wait();
}

pub fun send_sipi(id: u32, page: u64) {
    icr_wait();
    lw(0x310, id << 24);
    lw(0x300, 0x4600 | (page & 0xFF)::u32); # startup
    icr_wait();
}

# the processors the MADT lists
pub fun cpu_count() u64 { ret madt.n_cpu; }
pub fun cpu_id(i: u64) u32 { ret madt.cpu_ids[i]; }

# send a fixed interrupt `vector` to the cpu with APIC id `id`
pub fun send_ipi(id: u32, vector: u64) {
    var spins: u64 = 0;
    for ((lr(0x300) & (1 << 12)) != 0 && spins < 100000) { spins = spins + 1; } # last one delivered
    lw(0x310, id << 24);
    lw(0x300, vector::u32 | (1 << 14)); # fixed, assert
}

# what was found and set up, for the boot log
pub fun report() {
    kprint.info("apic\0");
    kprint.puts("local APIC at \0");
    kprint.hex(madt.lapic);
    kprint.puts(" (id \0");
    kprint.dec(id()::u64);
    kprint.puts("), I/O APIC at \0");
    kprint.hex(madt.ioapic);
    kprint.puts(" with \0");
    kprint.dec((((ior(1) >> 16) & 0xFF) + 1)::u64);
    kprint.puts(" inputs from GSI \0");
    kprint.dec(ioapic_gsi::u64);
    kprint.putc(10);
    var i: u64 = 0;
    for (i < madt.n_override) {
        kprint.debug("apic\0");
        kprint.puts("irq \0");
        kprint.dec(madt.overrides[i].irq::u64);
        kprint.puts(" -> gsi \0");
        kprint.dec(madt.overrides[i].gsi::u64);
        kprint.puts(", flags \0");
        kprint.hex(madt.overrides[i].flags::u64);
        kprint.putc(10);
        i = i + 1;
    }
    if (calibrated == 0) {
        kprint.warn("apic\0");
        kprint.puts("no PIT to calibrate against, timer speed is a guess\n\0");
    }
    kprint.info("apic\0");
    kprint.puts("timer at \0");
    kprint.dec(HZ);
    kprint.puts(" Hz (\0");
    kprint.dec(per_tick::u64);
    kprint.puts(" counts per tick, bus ~\0");
    kprint.dec(per_tick::u64 * HZ * 16 / 1000000);
    kprint.puts(" MHz)\n\0");
    kprint.info("tsc\0");
    val hz: u64 = cpu.tsc_hz();
    kprint.dec(hz / 1000000);
    kprint.putc(46);
    val khz: u64 = (hz / 1000) % 1000;
    if (khz < 100) { kprint.putc(48); }
    if (khz < 10) { kprint.putc(48); }
    kprint.dec(khz);
    kprint.puts(" MHz\0");
    if (calibrated != 0) { kprint.puts(" (measured against the PIT)\0"); }
    kprint.putc(10);
}

# this cpu's local APIC id
pub fun id() u32 { ret lr(ID) >> 24; }

# another cpu: its local APIC on, its timer like the first cpu's
pub fun init_ap() {
    cpu.wrmsr(0x1B, cpu.rdmsr(0x1B) | (1 << 11));
    lw(SVR, 0x100 | SPURIOUS_VECTOR::u32);
    lw(0x080, 0);
    lw(DIVIDE, 3);
    lw(LVT_TIMER, TIMER_VECTOR::u32 | (1 << 17));
    lw(INIT, per_tick);
}

pub fun timer_calibrated() u8 { ret calibrated; }

# lapic ticks (divide by 16) in 10 ms, measured against PIT channel 2.
# some machines have no working PIT; then give up after ~5 million port
# reads (well over 10 ms) and fall back to a typical value
fun calibrate() u32 {
    cpu.outb(0x61, (cpu.inb(0x61) & 0xFD) | 1); # gate on, speaker off
    cpu.outb(0x43, 0xB0);                        # ch 2, lo/hi, one-shot
    val count: u64 = 1193182 / 100;
    cpu.outb(0x42, (count & 0xFF)::u8);
    cpu.outb(0x42, (count >> 8)::u8);
    val g: u8 = cpu.inb(0x61) & 0xFE;
    cpu.outb(0x61, g);                           # restart the count
    cpu.outb(0x61, g | 1);
    lw(DIVIDE, 3);
    lw(INIT, 0xFFFFFFFF);
    val t0: u64 = cpu.rdtsc();
    var spins: u64 = 0;
    for ((cpu.inb(0x61) & 0x20) == 0 && spins < 5000000) { spins = spins + 1; }
    val left: u32 = lr(CURRENT);
    val t1: u64 = cpu.rdtsc();
    lw(INIT, 0);
    if (spins == 5000000) {
        calibrated = 0;
        # the time-stamp counter's rate from cpuid, or a typical one
        var hz: u64 = cpu.tsc_hz_from_cpuid();
        if (hz == 0) { hz = 2000000000; }
        cpu.set_tsc_hz(hz);
        ret 62500; # 100 MHz bus / 16, per 10 ms
    }
    cpu.set_tsc_hz((t1 - t0) * 100); # counts in the same 10 ms
    ret 0xFFFFFFFF - left;
}

# route legacy irq `irq` to `vector` on this cpu, honouring MADT overrides
pub fun route(irq: u8, vector: u64) {
    var gsi: u32 = irq::u32;
    var flags: u16 = 0;
    var i: u64 = 0;
    for (i < madt.n_override) {
        if (madt.overrides[i].irq == irq) {
            gsi = madt.overrides[i].gsi;
            flags = madt.overrides[i].flags;
        }
        i = i + 1;
    }
    var lo: u32 = vector::u32;
    if ((flags & 3) == 3) { lo = lo | (1 << 13); }    # active low
    if ((flags & 12) == 12) { lo = lo | (1 << 15); }  # level triggered
    val reg: u32 = 0x10 + 2 * (gsi - ioapic_gsi);
    iow(reg + 1, (lr(ID) >> 24) << 24);               # deliver to this cpu
    iow(reg, lo);
}

# returns an error message or nil
pub fun init(rsdp: u64) *u8 {
    val err: *u8 = acpi.madt(rsdp, ?madt);
    if (err != nil) { ret err; }
    lapic = vmm.map_phys(madt.lapic, 4096, 1);
    ioapic = vmm.map_phys(madt.ioapic, 4096, 1);
    ioapic_gsi = madt.ioapic_gsi;

    # mask every I/O APIC input until a driver routes it
    val n: u32 = ((ior(1) >> 16) & 0xFF) + 1;
    var i: u32 = 0;
    for (i < n) {
        iow(0x10 + 2 * i, 1 << 16);
        i = i + 1;
    }

    cpu.wrmsr(0x1B, cpu.rdmsr(0x1B) | (1 << 11)); # apic global enable
    lw(SVR, 0x100 | SPURIOUS_VECTOR::u32);
    lw(0x080, 0);                                 # accept every priority

    per_tick = calibrate() * 100 / HZ::u32;
    lw(DIVIDE, 3);
    lw(LVT_TIMER, TIMER_VECTOR::u32 | (1 << 17)); # periodic
    lw(INIT, per_tick);
    ret nil;
}
