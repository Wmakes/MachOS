# cat [FILE...]: copy files (or stdin) to stdout

use std.runtime;
use std.print;
use std.filesystem;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;
use std.system.os;
use io_error: std.io.error;

var buf: [4096]u8;

fun complain(name: str, e: io_error.Error) {
    print.eprintlnf("cat: {}: {}", name, os.message(e));
}

# copy everything f has to stdout; whether it all went
fun pump(f: filesystem.File, name: str) bool {
    for {
        val r: res[usize, io_error.Error] = filesystem.read(f, ?buf[0], 4096);
        if (sel r.err) {
            complain(name, r.err);
            ret false;
        }
        val n: usize = r.ok;
        if (n == 0) { ret true; }
        var at: usize = 0;
        for (at < n) {
            val w: res[usize, io_error.Error] = filesystem.write(filesystem.STDOUT, ?buf[at], n - at);
            if (sel w.err) { ret false; }
            at = at + w.ok;
        }
    }
    ret true;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    if (argc < 2) {
        if (!pump(filesystem.STDIN, "stdin")) { ret 1; }
        ret 0;
    }
    var status: i64 = 0;
    var i: i64 = 1;
    for (i < argc) {
        val name: str = argv[i]::str;
        val opened: res[filesystem.File, io_error.Error] = filesystem.open(name);
        if (sel opened.ok) {
            var f: filesystem.File = opened.ok;
            if (!pump(f, name)) { status = 1; }
            filesystem.close(?f);
        }
        if (sel opened.err) {
            complain(name, opened.err);
            status = 1;
        }
        i = i + 1;
    }
    ret status;
}
