# find [PATH...] [-name PATTERN] [-type f|d]: list everything under PATH
# (default .), or what matches. PATTERN takes * and ?

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;
use text: userland.lib.text;

var pat: *u8 = nil;
var want: u64 = 0; # 0 any, else io.KIND_*

fun base(p: *u8, n: u64) u64 {
    var s: u64 = n;
    for (s > 0 && p[s - 1] != 47) { s = s - 1; }
    ret s;
}

fun visit(p: *u8, n: u64, kind: u64) {
    var show: u8 = 1;
    if (want != 0 && kind != want) { show = 0; }
    if (pat != nil) {
        val b: u64 = base(p, n);
        if (text.glob(pat, io.len(pat), ?p[b], n - b) == 0) { show = 0; }
    }
    if (show != 0) {
        io.outn(p, n);
        io.putc(10);
    }
    if (kind != io.KIND_DIR) { ret; }
    val h: i64 = io.open_read(p);
    if (h < 0) { ret; }
    var dir: io.Dir;
    if (io.dir_from(?dir, h) < 0) { ret; }
    for (io.dir_next(?dir) > 0) {
        if (n + 1 + dir.len >= 256) { cnt; }
        var c: [256]u8;
        io.copy(?c[0], p, n);
        var cn: u64 = n;
        if (n == 0 || p[n - 1] != 47) {
            c[cn] = 47;
            cn = cn + 1;
        }
        io.copy(?c[cn], dir.name, dir.len);
        c[cn + dir.len] = 0;
        visit(?c[0], cn + dir.len, io.dir_kind(?dir));
    }
    io.dir_close(?dir);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    var roots: [16]*u8;
    var nroots: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        if (io.streq(argv[i], "-name\0") != 0 && i + 1 < argc) {
            pat = argv[i + 1];
            i = i + 2;
        } or (io.streq(argv[i], "-type\0") != 0 && i + 1 < argc) {
            if (argv[i + 1][0] == 100) { want = io.KIND_DIR; }
            or                         { want = io.KIND_FILE; }
            i = i + 2;
        } or (nroots < 16) {
            roots[nroots] = argv[i];
            nroots = nroots + 1;
            i = i + 1;
        } or {
            i = i + 1;
        }
    }
    if (nroots == 0) {
        roots[0] = ".\0";
        nroots = 1;
    }
    var status: u64 = 0;
    i = 0;
    for (i < nroots) {
        var st: os.stat_t;
        val n: u64 = io.len(roots[i]);
        val r: i64 = io.stat(roots[i], ?st);
        if (r < 0) {
            io.fail("find\0", roots[i], r);
            status = 1;
        } or {
            visit(roots[i], n, io.kind_of(st.st_mode));
        }
        i = i + 1;
    }
    ret status;
}
