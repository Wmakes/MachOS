# kernel entry

use info:   machos.boot.info;
use limine: machos.boot.limine;
use cpu:    machos.arch.x86_64.cpu;
use gdt:    machos.arch.x86_64.gdt;
use idt:    machos.arch.x86_64.idt;
use serial: machos.dev.serial;
use fbcon:  machos.dev.fbcon;
use kprint: machos.kern.kprint;
use pmm:    machos.mm.pmm;
use vmm:    machos.mm.vmm;
use heap:   machos.mm.heap;
use apic:   machos.arch.x86_64.apic;
use kbd:    machos.dev.ps2kbd;
use tty:    machos.kern.tty;
use trap:   machos.kern.trap;
use syscall: machos.arch.x86_64.syscall;
use proc:   machos.kern.proc;
use sys:    machos.kern.sys;
use abi:    sdk.abi;
use vfs:    machos.fs.vfs;
use mount:  machos.fs.mount;
use parts:  machos.fs.parts;
use acpi:   machos.acpi.acpi;
use mem:    machos.kern.mem;
use initrd: machos.fs.initrd;
use version: machos.abi.version;
use clock:  machos.kern.clock;
use pci:    machos.dev.pci;
use xhci:   machos.dev.xhci;
use dsk:    machos.dev.disk;
use smp:    machos.arch.x86_64.smp;

var boot: info.BootInfo;

# the boot stack, in the kernel image so it stays mapped once Limine's
# memory is no longer trusted
#[align(16)]
#[symbol("boot_stack")]
var boot_stack: [65536]u8;

#[symbol("kmain")]
fun kmain() {
    cpu.tsc_begin();
    serial.init();
    cpu.pic_disable();
    cpu.init();
    val err: *u8 = limine.collect(?boot);
    if (err != nil) { kprint.panic(err); }
    val have_fb: u8 = fbcon.init(?boot.fb);
    console_level_from_cmdline();

    kprint.level(kprint.NOTICE);
    kprint.puts("MachOS \0");
    kprint.puts(version.VERSION);
    kprint.puts(" (x86_64), kernel written in mach\n\0");
    kprint.info("boot\0");
    kprint.puts("command line: '\0");
    if (boot.cmdline != nil) { kprint.puts(boot.cmdline); }
    kprint.puts("'\n\0");
    kprint.info("boot\0");
    kprint.puts("kernel at \0");
    kprint.hex(boot.kphys);
    kprint.puts(" (virtual \0");
    kprint.hex(boot.kvirt);
    kprint.puts("), image \0");
    kprint.dec(boot.kelf_len / 1024);
    kprint.puts(" KiB, initrd \0");
    kprint.dec(boot.initrd_len / 1024);
    kprint.puts(" KiB\n\0");
    if (have_fb != 0) {
        kprint.info("fb\0");
        kprint.dec(boot.fb.width);
        kprint.putc(120);
        kprint.dec(boot.fb.height);
        kprint.puts(" at \0");
        kprint.dec(boot.fb.bpp::u64);
        kprint.puts(" bpp, pitch \0");
        kprint.dec(boot.fb.pitch);
        kprint.puts(", \0");
        kprint.dec(fbcon.cols_of());
        kprint.putc(120);
        kprint.dec(fbcon.rows_of());
        kprint.puts(" text, 6 terminals\n\0");
    } or {
        kprint.warn("fb\0");
        kprint.puts("none, serial only\n\0");
    }
    memory_map();
    cpu_report();

    gdt.init();
    idt.init();
    kprint.info("cpu\0");
    kprint.puts("GDT, TSS and IDT loaded (double faults on their own stack)\n\0");

    pmm.init(?boot);
    val verr: *u8 = vmm.init(?boot);
    if (verr != nil) { kprint.panic(verr); }
    kprint.info("vmm\0");
    kprint.puts("own page tables live, hhdm at \0");
    kprint.hex(boot.hhdm);
    kprint.putc(10);
    kprint.info("cpu\0");
    kprint.puts("protection: \0");
    if (cpu.has_smep() != 0) { kprint.puts("smep \0"); }
    if (cpu.has_smap() != 0) { kprint.puts("smap \0"); }
    if (cpu.has_umip() != 0) { kprint.puts("umip \0"); }
    kprint.puts("nx wp\n\0");
    if (cpu.has_smep() == 0 && cpu.has_smap() == 0) {
        kprint.warn("cpu\0");
        kprint.puts("no SMEP/SMAP on this cpu: the kernel is less protected from user memory\n\0");
    }
    kprint.info("pmm\0");
    kprint.dec(pmm.free_pages() * pmm.PAGE / 1024 / 1024);
    kprint.puts(" MiB free of \0");
    kprint.dec(pmm.total_pages() * pmm.PAGE / 1024 / 1024);
    kprint.puts(" MiB usable\n\0");

    val a: u64 = pmm.alloc();
    val b: u64 = pmm.alloc();
    pmm.free(a);
    val c: u64 = pmm.alloc();
    if (a == 0 || b == 0 || c != a) { kprint.panic("pmm self-test failed\0"); }
    pmm.free(b);
    pmm.free(c);

    val h1: u64 = heap.alloc(100);
    val h2: u64 = heap.alloc(5000);
    val h3: u64 = heap.zalloc(40);
    if (h1 == 0 || h2 == 0 || h3 == 0 || (h1 & 15) != 0) { kprint.panic("heap self-test failed\0"); }
    heap.free(h2);
    heap.free(h1);
    val h4: u64 = heap.alloc(5100); # fits the merged h1+h2 hole
    if (h4 != h1) { kprint.panic("heap did not merge free blocks\0"); }
    heap.free(h4);
    heap.free(h3);
    if (heap.used() != 0) { kprint.panic("heap leaked\0"); }
    kprint.info("heap\0");
    kprint.puts("self-test passed, \0");
    kprint.dec(heap.mapped() / 1024);
    kprint.puts(" KiB mapped\n\0");

    acpi.report(boot.rsdp);
    val aerr: *u8 = apic.init(boot.rsdp);
    if (aerr != nil) { kprint.panic(aerr); }
    smp.set_first(apic.id());
    smp.lock(); # held by this cpu until it first runs a program
    if (kbd.init() != 0) { apic.route(1, apic.IRQ_BASE + 1); }
    serial.enable_rx();
    apic.route(4, apic.IRQ_BASE + 4);
    apic.report();
    kprint.info("input\0");
    if (kbd.present_now() != 0) { kprint.puts("PS/2 keyboard controller found, irq 1 routed\n\0"); }
    or { kprint.puts("no PS/2 controller (USB keyboards only)\n\0"); }
    kprint.info("serial\0");
    kprint.puts("COM1 at 115200 baud, irq 4 routed (mirrors tty1)\n\0");

    syscall.init();
    clock.init();
    acpi.init_power(boot.rsdp);

    kprint.info("pci\0");
    kprint.dec(pci.scan());
    kprint.puts(" functions found\n\0");
    pci.report();
    val nkbd: u64 = xhci.init();
    if (xhci.controllers() > 0) {
        kprint.puts("usb: \0");
        kprint.dec(xhci.controllers());
        kprint.puts(" xhci controller(s), \0");
        kprint.dec(nkbd);
        kprint.puts(" keyboard(s)\n\0");
    }
    val ndisk: u64 = dsk.init();
    var di: u64 = 0;
    for (di < ndisk) {
        val d: *dsk.Disk = dsk.disk(di);
        kprint.puts("disk: \0");
        kprint.puts(?d.name[0]);
        kprint.puts(": \0");
        kprint.dec(d.sectors / 2048);
        kprint.puts(" MiB, \0");
        var mi: u64 = 0;
        for (mi < 40) {
            if (d.model[mi] != 32 || (mi + 1 < 40 && d.model[mi + 1] != 32)) { kprint.putc(d.model[mi]); }
            mi = mi + 1;
        }
        kprint.putc(10);
        di = di + 1;
    }

    parts.probe();
    mount_root();
    val dev: *vfs.Node = vfs.create_ram(vfs.get_root(), "dev\0", 3, abi.KIND_DIR);
    if (dev == nil) { kprint.panic("vfs: out of memory\0"); }
    make_dev(dev, "console\0", 7, vfs.DEV_CONSOLE);
    var tn: [5]u8;
    tn[0] = 116; tn[1] = 116; tn[2] = 121; tn[4] = 0; # "ttyN"
    var ti: u64 = 0;
    for (ti < 6) {
        tn[3] = 49 + ti::u8;
        make_dev(dev, ?tn[0], 4, vfs.DEV_TTY + ti);
        ti = ti + 1;
    }
    make_dev(dev, "null\0", 4, vfs.DEV_NULL);
    make_dev(dev, "zero\0", 4, vfs.DEV_ZERO);
    parts.publish(dev);
    if (vfs.child(vfs.get_root(), "tmp\0", 3) == nil) {
        val tmp: *vfs.Node = vfs.create_ram(vfs.get_root(), "tmp\0", 3, abi.KIND_DIR);
        if (tmp == nil) { kprint.panic("vfs: out of memory\0"); }
        tmp.mode = 0x3FF; # 01777: everyone may make files, only owners remove them
    }

    start_cpus();
    kprint.info("boot\0");
    kprint.puts("kernel ready after \0");
    val us: u64 = cpu.us_since_boot(cpu.rdtsc());
    kprint.dec(us / 1000);
    kprint.puts(" ms, starting /bin/init\0");
    if (rescue() != 0) { kprint.puts(" (rescue mode)\0"); }
    kprint.putc(10);
    val pid: u64 = sys.spawn_init("/bin/init\0", rescue());
    if (abi.is_err(pid) != 0) {
        kprint.puts("/bin/init: \0");
        kprint.panic(abi.err_name(pid));
    }
    proc.scheduler(0);
}

#[symbol("ap_cr3")]
var ap_cr3: u64 = 0;

# where another cpu starts: no-execute pages on (EFER.NXE) and our page
# tables loaded before it touches its own stack (extra_argument, in the
# kernel heap Limine's tables do not map), then into ap_main
#[naked]
#[symbol("ap_entry")]
fun ap_entry() {
    asm x86_64 {
        mov rsi, rdi
        mov ecx, 0xC0000080
        rdmsr
        or eax, 0x800
        wrmsr
        mov rax, [ap_cr3]
        mov cr3, rax
        mov rdi, rsi
        mov rsp, [rdi + 24]
        call ap_main
        cli
        hlt
    }
}

#[symbol("ap_main")]
fun ap_main(r: *limine.MpInfo) {
    cpu.init();                       # no-execute pages on before our page tables
    cpu.set_cr3(vmm.kernel_space());
    val me: u64 = smp.here();
    gdt.init_cpu(me);
    idt.load();
    syscall.init_cpu(me);
    apic.init_ap();
    smp.came_up(me);
    smp.lock();
    kprint.info("smp\0");
    kprint.puts("cpu\0");
    kprint.dec(me);
    kprint.puts(" up (APIC id \0");
    kprint.dec(apic.id()::u64);
    kprint.puts(")\n\0");
    proc.scheduler(me);
}

# start the other processors and wait (up to ~1 s) until they run
fun start_cpus() {
    ap_cr3 = vmm.kernel_space();
    var want: u64 = 1;
    var k: u64 = 0;
    for (k < boot.cpus) {
        if (boot.cpu_lapic[k] != boot.bsp_lapic) {
            val idx: u64 = smp.add(boot.cpu_lapic[k]);
            if (idx == smp.MAX) { brk; }
            val stack: u64 = heap.alloc(16384);
            if (stack == 0) { brk; }
            val r: *limine.MpInfo = boot.cpu_start[k]::*limine.MpInfo;
            r.extra_argument = stack + 16384;
            r.goto_address = ap_entry::u64;
            want = want + 1;
        }
        k = k + 1;
    }
    var spins: u64 = 0;
    for (smp.online() < want && spins < 1000000) {
        cpu.outb(0x80, 0);
        spins = spins + 1;
    }
    kprint.info("smp\0");
    kprint.dec(smp.online());
    kprint.puts(" cpu(s) running\0");
    if (smp.online() < want) {
        kprint.puts(", \0");
        kprint.dec(want - smp.online());
        kprint.puts(" did not start\0");
    }
    kprint.putc(10);
}

fun make_dev(dir: *vfs.Node, name: *u8, n: u64, id: u64) {
    val d: *vfs.Node = vfs.create_ram(dir, name, n, abi.KIND_DEV);
    if (d == nil) { kprint.panic("vfs: out of memory\0"); }
    d.dev = id;
    d.mode = 0x1B6; # 0666: anyone may use the console, null and zero
}

# the root filesystem: ext2 on the first MachOS root partition found,
# otherwise the initrd unpacked into memory
# a word of the boot command line, or nil
fun cmdline_has(w: *u8, n: u64) *u8 {
    val c: *u8 = boot.cmdline;
    if (c == nil) { ret nil; }
    var i: u64 = 0;
    for (c[i] != 0) {
        if ((i == 0 || c[i - 1] == 32) && mem.equal(?c[i], w, n) != 0) { ret ?c[i + n]; }
        i = i + 1;
    }
    ret nil;
}

# quiet: only warnings and worse on the console; debug: everything;
# loglevel=N: up to level N (everything is always in the log, see dmesg)
fun console_level_from_cmdline() {
    if (cmdline_has("quiet\0", 5) != nil) { kprint.set_console_level(kprint.WARN); }
    if (cmdline_has("debug\0", 5) != nil) { kprint.set_console_level(kprint.DEBUG); }
    val l: *u8 = cmdline_has("loglevel=\0", 9);
    if (l != nil && l[0] >= 48 && l[0] <= 55) { kprint.set_console_level((l[0] - 48)::u64); }
}

fun kind_name(k: u8) *u8 {
    if (k == info.MEM_USABLE) { ret "usable\0"; }
    if (k == info.MEM_RECLAIMABLE) { ret "reclaimable\0"; }
    if (k == info.MEM_ACPI) { ret "ACPI\0"; }
    if (k == info.MEM_KERNEL) { ret "kernel and modules\0"; }
    if (k == info.MEM_FRAMEBUFFER) { ret "framebuffer\0"; }
    ret "reserved\0";
}

# every region of the memory map (debug), then the totals by kind
fun memory_map() {
    var totals: [6]u64;
    var k: u64 = 0;
    for (k < 6) {
        totals[k] = 0;
        k = k + 1;
    }
    var i: u64 = 0;
    for (i < boot.mem_len) {
        val r: *info.MemRegion = ?boot.mem[i];
        kprint.debug("mem\0");
        kprint.hex(r.base);
        kprint.putc(45);
        kprint.hex(r.base + r.len - 1);
        kprint.putc(32);
        kprint.puts(kind_name(r.kind));
        kprint.putc(10);
        if (r.kind::u64 < 6) { totals[r.kind::u64] = totals[r.kind::u64] + r.len; }
        i = i + 1;
    }
    kprint.info("mem\0");
    kprint.dec(boot.mem_len);
    kprint.puts(" regions: \0");
    kprint.dec(totals[info.MEM_USABLE::u64] / 1048576);
    kprint.puts(" MiB usable, \0");
    kprint.dec(totals[info.MEM_RECLAIMABLE::u64] / 1048576);
    kprint.puts(" MiB reclaimable, \0");
    kprint.dec(totals[info.MEM_KERNEL::u64] / 1024);
    kprint.puts(" KiB kernel and modules, \0");
    kprint.dec(totals[info.MEM_ACPI::u64] / 1024);
    kprint.puts(" KiB ACPI\n\0");
}

# the processor: who made it, its name, what it can do
fun cpu_report() {
    var v: [13]u8;
    cpu.vendor(?v[0]);
    v[12] = 0;
    var name: [49]u8;
    cpu.brand(?name[0]);
    name[48] = 0;
    var s: u64 = 0;
    for (s < 48 && name[s] == 32) { s = s + 1; }
    kprint.info("cpu\0");
    kprint.puts(?v[0]);
    kprint.puts(", \0");
    kprint.puts(?name[s]);
    kprint.puts(", \0");
    kprint.dec(boot.cpus);
    kprint.puts(" processor(s)\n\0");
    var f: [3]u32;
    cpu.features(?f[0]);
    kprint.info("cpu\0");
    kprint.puts("features:\0");
    if ((f[1] & (1 << 25)) != 0) { kprint.puts(" sse\0"); }
    if ((f[1] & (1 << 26)) != 0) { kprint.puts(" sse2\0"); }
    if ((f[0] & 1) != 0) { kprint.puts(" sse3\0"); }
    if ((f[0] & (1 << 9)) != 0) { kprint.puts(" ssse3\0"); }
    if ((f[0] & (1 << 19)) != 0) { kprint.puts(" sse4.1\0"); }
    if ((f[0] & (1 << 20)) != 0) { kprint.puts(" sse4.2\0"); }
    if ((f[0] & (1 << 23)) != 0) { kprint.puts(" popcnt\0"); }
    if ((f[0] & (1 << 25)) != 0) { kprint.puts(" aes\0"); }
    if ((f[0] & (1 << 28)) != 0) { kprint.puts(" avx\0"); }
    if ((f[2] & (1 << 5)) != 0) { kprint.puts(" avx2\0"); }
    if ((f[2] & (1 << 16)) != 0) { kprint.puts(" avx512f\0"); }
    if ((f[0] & (1 << 30)) != 0) { kprint.puts(" rdrand\0"); }
    if ((f[0] & (1 << 21)) != 0) { kprint.puts(" x2apic\0"); }
    if ((f[1] & (1 << 4)) != 0) { kprint.puts(" tsc\0"); }
    if ((f[0] & (1 << 31)) != 0) { kprint.puts(" hypervisor\0"); }
    kprint.putc(10);
}

fun rescue() u8 {
    val c: *u8 = boot.cmdline;
    if (c == nil) { ret 0; }
    var i: u64 = 0;
    for (c[i] != 0) {
        if (mem.equal(?c[i], "rescue\0", 6) != 0) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

fun mount_root() {
    var b: *parts.Bdev = parts.find_root();
    if (rescue() != 0) {
        kprint.puts("rescue mode: running from memory, the disks stay unmounted\n\0");
        b = nil;
    }
    if (b != nil) {
        val err: *u8 = mount.mount_root(b);
        kprint.puts("root: \0");
        if (err == nil) { kprint.puts("ext2 on \0"); }
        var dn: [32]u8;
        val dl: u64 = parts.dev_name(b, ?dn[0]);
        dn[dl] = 0;
        kprint.puts(?dn[0]);
        if (err == nil) {
            kprint.putc(10);
            if (mount.root_was_clean() == 0) {
                kprint.puts("root: \x1b[1;33mnot shut down cleanly last time\x1b[0m; to check it, boot\n\0");
                kprint.puts("      'MachOS (rescue)' and run fsck -y on it\n\0");
            }
            ret;
        }
        kprint.puts(": \0");
        kprint.puts(err);
        kprint.putc(10);
    }
    if (vfs.init_ram() == 0) { kprint.panic("vfs: out of memory\0"); }
    if (boot.initrd == 0) { kprint.panic("no root partition and no initrd\0"); }
    kprint.puts("root: initrd in memory (no disk root), \0");
    kprint.dec(initrd.unpack(boot.initrd, boot.initrd_len));
    kprint.puts(" files\n\0");
}

#[naked]
#[symbol("_start")]
fun start() {
    asm x86_64 {
        lea rsp, [boot_stack]
        add rsp, 65536
        call kmain
    }
}
