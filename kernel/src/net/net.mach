# the network: one interface on the first Ethernet card, speaking ARP,
# IPv4, ICMP (echo) and UDP. frames come in by polling the card (the timer
# tick and every network system call do it); datagrams go to the sockets
# that wait for them (net/socket.mach). addresses are kept in host order,
# so 10.0.2.15 is 0x0A00020F
#
# the address comes from DHCP (net/dhcp.mach) unless it is set by hand
# (through /proc/net/config)

use e1000:  machos.dev.e1000;
use socket: machos.net.socket;
use mem:    machos.kern.mem;
use kprint: machos.kern.kprint;
use events: machos.kern.events;
use proc:   machos.kern.proc;
use apic:   machos.arch.x86_64.apic;

pub val ETH_IP:  u16 = 0x0800;
pub val ETH_ARP: u16 = 0x0806;
pub val PROTO_ICMP: u8 = 1;
pub val PROTO_UDP:  u8 = 17;
pub val BROADCAST: u32 = 0xFFFFFFFF;

# the interface
pub rec Iface {
    present: u8;
    up:      u8;    # it has an address
    nic:     *e1000.Nic;
    mac:     [6]u8;
    ip:      u32;
    mask:    u32;
    gateway: u32;
    dns:     u32;
    dhcp:    u8;    # the address came from DHCP
    lease:   u64;   # seconds DHCP gave it for
    rx_packets: u64;
    rx_bytes:   u64;
    tx_packets: u64;
    tx_bytes:   u64;
    rx_dropped: u64;
    tx_dropped: u64;
}

var ifc: Iface;

pub fun iface() *Iface { ret ?ifc; }

# --- byte order -----------------------------------------------------------------

pub fun get16(p: *u8) u16 { ret (p[0]::u16 << 8) | p[1]::u16; }
pub fun get32(p: *u8) u32 { ret (p[0]::u32 << 24) | (p[1]::u32 << 16) | (p[2]::u32 << 8) | p[3]::u32; }

pub fun put16(p: *u8, v: u16) {
    p[0] = (v >> 8)::u8;
    p[1] = (v & 0xFF)::u8;
}

pub fun put32(p: *u8, v: u32) {
    p[0] = (v >> 24)::u8;
    p[1] = ((v >> 16) & 0xFF)::u8;
    p[2] = ((v >> 8) & 0xFF)::u8;
    p[3] = (v & 0xFF)::u8;
}

# the Internet checksum of p[0..n), added to `sum` (start with 0)
pub fun csum_add(sum: u64, p: *u8, n: u64) u64 {
    var s: u64 = sum;
    var i: u64 = 0;
    for (i + 1 < n) {
        s = s + ((p[i]::u64 << 8) | p[i + 1]::u64);
        i = i + 2;
    }
    if (i < n) { s = s + (p[i]::u64 << 8); }
    ret s;
}

pub fun csum_end(sum: u64) u16 {
    var s: u64 = sum;
    for ((s >> 16) != 0) { s = (s & 0xFFFF) + (s >> 16); }
    ret (~s & 0xFFFF)::u16;
}

# --- Ethernet --------------------------------------------------------------------

var frame: [2048]u8;   # the one being built
var rxbuf: [2048]u8;   # the one being taken apart

fun eth_send(dst: *u8, kind: u16, payload: *u8, len: u64) u8 {
    if (ifc.present == 0 || len + 14 > e1000.BUF) {
        ifc.tx_dropped = ifc.tx_dropped + 1;
        ret 0;
    }
    mem.copy((?frame[0])::u64, dst::u64, 6);
    mem.copy((?frame[6])::u64, (?ifc.mac[0])::u64, 6);
    put16(?frame[12], kind);
    mem.copy((?frame[14])::u64, payload::u64, len);
    var n: u64 = 14 + len;
    if (n < 60) {
        mem.fill((?frame[n])::u64, 0, 60 - n);
        n = 60;
    }
    if (e1000.send(ifc.nic, ?frame[0], n) == 0) {
        ifc.tx_dropped = ifc.tx_dropped + 1;
        ret 0;
    }
    ifc.tx_packets = ifc.tx_packets + 1;
    ifc.tx_bytes = ifc.tx_bytes + n;
    ret 1;
}

# --- ARP --------------------------------------------------------------------------

val ARPS: u64 = 32;

rec Arp {
    used: u8;
    ip:   u32;
    mac:  [6]u8;
    seen: u64;   # tick it was learned
}

var arps: [32]Arp;

# packets waiting for their next hop's hardware address
val WAITS: u64 = 8;

rec Waiting {
    used: u8;
    hop:  u32;
    since: u64;
    len:  u64;
    data: [1500]u8;
}

var waits: [8]Waiting;

pub fun arp_slot(i: u64) *Arp { ret ?arps[i]; }
pub fun arp_count() u64 { ret ARPS; }
pub fun arp_ip(i: u64) u32 { ret arps[i].ip; }
pub fun arp_used(i: u64) u8 { ret arps[i].used; }
pub fun arp_mac(i: u64) *u8 { ret ?arps[i].mac[0]; }

fun arp_find(ip: u32) *Arp {
    var i: u64 = 0;
    for (i < ARPS) {
        if (arps[i].used != 0 && arps[i].ip == ip) { ret ?arps[i]; }
        i = i + 1;
    }
    ret nil;
}

fun arp_learn(ip: u32, mac: *u8) {
    var a: *Arp = arp_find(ip);
    if (a == nil) {
        # a free slot, else the oldest
        var i: u64 = 0;
        var best: u64 = 0;
        for (i < ARPS) {
            if (arps[i].used == 0) {
                best = i;
                brk;
            }
            if (arps[i].seen < arps[best].seen) { best = i; }
            i = i + 1;
        }
        a = ?arps[best];
    }
    a.used = 1;
    a.ip = ip;
    mem.copy((?a.mac[0])::u64, mac::u64, 6);
    a.seen = proc.uptime_ticks();
    # what waited for it goes now
    var w: u64 = 0;
    for (w < WAITS) {
        val p: *Waiting = ?waits[w];
        if (p.used != 0 && p.hop == ip) {
            p.used = 0;
            eth_send(mac, ETH_IP, ?p.data[0], p.len);
        }
        w = w + 1;
    }
}

fun arp_send(op: u16, tmac: *u8, tip: u32, dst: *u8) {
    var p: [28]u8;
    put16(?p[0], 1);        # Ethernet
    put16(?p[2], ETH_IP);
    p[4] = 6;
    p[5] = 4;
    put16(?p[6], op);
    mem.copy((?p[8])::u64, (?ifc.mac[0])::u64, 6);
    put32(?p[14], ifc.ip);
    mem.copy((?p[18])::u64, tmac::u64, 6);
    put32(?p[24], tip);
    eth_send(dst, ETH_ARP, ?p[0], 28);
}

var ALL: [6]u8;   # ff:ff:ff:ff:ff:ff, filled in by init
var NONE: [6]u8;

fun arp_input(p: *u8, n: u64) {
    if (n < 28 || get16(?p[0]) != 1 || get16(?p[2]) != ETH_IP) { ret; }
    val op: u16 = get16(?p[6]);
    val sip: u32 = get32(?p[14]);
    val tip: u32 = get32(?p[24]);
    if (sip != 0) { arp_learn(sip, ?p[8]); }
    if (op == 1 && ifc.up != 0 && tip == ifc.ip) { arp_send(2, ?p[8], sip, ?p[8]); }
}

# --- IPv4 --------------------------------------------------------------------------

var ip_id: u16 = 1;
var packet: [1500]u8;

# where a packet for dst goes first: dst itself on our own network, else
# the gateway (0 when there is none)
fun next_hop(dst: u32) u32 {
    if (dst == BROADCAST) { ret dst; }
    if ((dst & ifc.mask) == (ifc.ip & ifc.mask)) { ret dst; }
    ret ifc.gateway;
}

# send an IPv4 packet carrying `len` bytes of protocol `proto` to dst
# (from src: our address, or 0 before DHCP has given one); whether it went
# or waits for its next hop's address
pub fun ip_send(src: u32, dst: u32, proto: u8, payload: *u8, len: u64) u8 {
    if (ifc.present == 0 || len + 20 > 1500) { ret 0; }
    val p: *u8 = ?packet[0];
    p[0] = 0x45;
    p[1] = 0;
    put16(?p[2], (20 + len)::u16);
    put16(?p[4], ip_id);
    ip_id = ip_id + 1;
    put16(?p[6], 0x4000);   # don't fragment
    p[8] = 64;
    p[9] = proto;
    put16(?p[10], 0);
    put32(?p[12], src);
    put32(?p[16], dst);
    put16(?p[10], csum_end(csum_add(0, p, 20)));
    mem.copy((?p[20])::u64, payload::u64, len);
    val total: u64 = 20 + len;
    if (dst == BROADCAST) { ret eth_send(?ALL[0], ETH_IP, p, total); }
    val hop: u32 = next_hop(dst);
    if (hop == 0) { ret 0; }
    val a: *Arp = arp_find(hop);
    if (a != nil) { ret eth_send(?a.mac[0], ETH_IP, p, total); }
    # ask who has it, and keep the packet until the answer comes
    var w: u64 = 0;
    var slot: u64 = 0;
    for (w < WAITS) {
        if (waits[w].used == 0) {
            slot = w;
            brk;
        }
        if (waits[w].since < waits[slot].since) { slot = w; }
        w = w + 1;
    }
    val q: *Waiting = ?waits[slot];
    q.used = 1;
    q.hop = hop;
    q.since = proc.uptime_ticks();
    q.len = total;
    mem.copy((?q.data[0])::u64, p::u64, total);
    arp_send(1, ?NONE[0], hop, ?ALL[0]);
    ret 1;
}

# --- ICMP ---------------------------------------------------------------------------

var reply: [1500]u8;

fun icmp_input(src: u32, p: *u8, n: u64) {
    if (n < 8 || csum_end(csum_add(0, p, n)) != 0) { ret; }
    val kind: u8 = p[0];
    if (kind == 8) { # echo request: the same back, as a reply
        mem.copy((?reply[0])::u64, p::u64, n);
        reply[0] = 0;
        put16(?reply[2], 0);
        put16(?reply[2], csum_end(csum_add(0, ?reply[0], n)));
        ip_send(ifc.ip, src, PROTO_ICMP, ?reply[0], n);
        ret;
    }
    if (kind == 0) { # echo reply: to the socket with that id
        val s: *socket.Sock = socket.find(socket.ICMP, get16(?p[4]));
        if (s != nil) { socket.deliver(s, src, 0, p, n); }
    }
}

# an echo request (or anything ICMP) from socket s: p is the ICMP message;
# its id becomes the socket's and the checksum is filled in
pub fun icmp_send(s: *socket.Sock, dst: u32, p: *u8, n: u64) u8 {
    if (n < 8 || n > 1472) { ret 0; }
    mem.copy((?reply[0])::u64, p::u64, n);
    put16(?reply[4], s.port);
    put16(?reply[2], 0);
    put16(?reply[2], csum_end(csum_add(0, ?reply[0], n)));
    ret ip_send(ifc.ip, dst, PROTO_ICMP, ?reply[0], n);
}

# --- UDP -----------------------------------------------------------------------------

var dgram: [1500]u8;

fun udp_input(src: u32, dst: u32, p: *u8, n: u64) {
    if (n < 8) { ret; }
    val len: u64 = get16(?p[4])::u64;
    if (len < 8 || len > n) { ret; }
    val s: *socket.Sock = socket.find(socket.UDP, get16(?p[2]));
    if (s == nil) { ret; }
    if (s.local_ip != 0 && dst != s.local_ip && dst != BROADCAST) { ret; }
    socket.deliver(s, src, get16(?p[0]), ?p[8], len - 8);
}

# send `len` bytes from src:sport to dst:dport
pub fun udp_send(src: u32, sport: u16, dst: u32, dport: u16, data: *u8, len: u64) u8 {
    if (len + 28 > 1500) { ret 0; }
    put16(?dgram[0], sport);
    put16(?dgram[2], dport);
    put16(?dgram[4], (8 + len)::u16);
    put16(?dgram[6], 0);
    mem.copy((?dgram[8])::u64, data::u64, len);
    # the checksum covers a pseudo header too
    var ph: [12]u8;
    put32(?ph[0], src);
    put32(?ph[4], dst);
    ph[8] = 0;
    ph[9] = PROTO_UDP;
    put16(?ph[10], (8 + len)::u16);
    var c: u16 = csum_end(csum_add(csum_add(0, ?ph[0], 12), ?dgram[0], 8 + len));
    if (c == 0) { c = 0xFFFF; }
    put16(?dgram[6], c);
    ret ip_send(src, dst, PROTO_UDP, ?dgram[0], 8 + len);
}

# --- receiving ---------------------------------------------------------------------

fun ip_input(p: *u8, n: u64) {
    if (n < 20 || (p[0] >> 4) != 4) { ret; }
    val hl: u64 = ((p[0] & 15)::u64) * 4;
    val total: u64 = get16(?p[2])::u64;
    if (hl < 20 || total < hl || total > n) { ret; }
    if (csum_end(csum_add(0, p, hl)) != 0) { ret; }
    if ((get16(?p[6]) & 0x3FFF) != 0) { ret; } # fragments: not put together (yet)
    val src: u32 = get32(?p[12]);
    val dst: u32 = get32(?p[16]);
    # ours, a broadcast, or anything while DHCP is still asking
    if (ifc.up != 0 && dst != ifc.ip && dst != BROADCAST && (dst | ifc.mask) != BROADCAST) { ret; }
    val proto: u8 = p[9];
    if (proto == PROTO_ICMP) { icmp_input(src, ?p[hl], total - hl); }
    or (proto == PROTO_UDP) { udp_input(src, dst, ?p[hl], total - hl); }
}

# take in whatever the card received
pub fun poll() {
    if (ifc.present == 0) { ret; }
    var budget: u64 = 64;
    for (budget > 0) {
        val n: u64 = e1000.receive(ifc.nic, ?rxbuf[0]);
        if (n == 0) { brk; }
        budget = budget - 1;
        ifc.rx_packets = ifc.rx_packets + 1;
        ifc.rx_bytes = ifc.rx_bytes + n;
        if (n < 14) { cnt; }
        val kind: u16 = get16(?rxbuf[12]);
        if (kind == ETH_ARP) { arp_input(?rxbuf[14], n - 14); }
        or (kind == ETH_IP) { ip_input(?rxbuf[14], n - 14); }
    }
    # packets whose next hop never answered go after 3 seconds
    var w: u64 = 0;
    for (w < WAITS) {
        if (waits[w].used != 0 && proc.uptime_ticks() - waits[w].since > 3 * apic.HZ) {
            waits[w].used = 0;
            ifc.tx_dropped = ifc.tx_dropped + 1;
        }
        w = w + 1;
    }
}

# --- setting it up -----------------------------------------------------------------

fun ip_text(ip: u32) {
    kprint.dec((ip >> 24)::u64);
    kprint.putc(46);
    kprint.dec(((ip >> 16) & 0xFF)::u64);
    kprint.putc(46);
    kprint.dec(((ip >> 8) & 0xFF)::u64);
    kprint.putc(46);
    kprint.dec((ip & 0xFF)::u64);
}

fun ip_event(ip: u32) {
    events.dec((ip >> 24)::u64);
    events.char(46);
    events.dec(((ip >> 16) & 0xFF)::u64);
    events.char(46);
    events.dec(((ip >> 8) & 0xFF)::u64);
    events.char(46);
    events.dec((ip & 0xFF)::u64);
}

fun prefix(mask: u32) u64 {
    var n: u64 = 0;
    var m: u32 = mask;
    for ((m & 0x80000000) != 0) {
        n = n + 1;
        m = m << 1;
    }
    ret n;
}

# the interface has an address now (dhcp: it came from DHCP)
pub fun configure(ip: u32, mask: u32, gateway: u32, dns: u32, dhcp: u8, lease: u64) {
    ifc.ip = ip;
    ifc.mask = mask;
    ifc.gateway = gateway;
    ifc.dns = dns;
    ifc.dhcp = dhcp;
    ifc.lease = lease;
    ifc.up = (ip != 0)::u8;
    kprint.level(kprint.INFO);
    kprint.puts("net: \0");
    if (ifc.up == 0) {
        kprint.puts("eth0 has no address now\n\0");
        events.begin("net down eth0\0");
        events.end();
        ret;
    }
    kprint.puts("eth0 \0");
    ip_text(ip);
    kprint.putc(47);
    kprint.dec(prefix(mask));
    kprint.puts(", gateway \0");
    ip_text(gateway);
    kprint.puts(", dns \0");
    ip_text(dns);
    if (dhcp != 0) {
        kprint.puts(" (DHCP, \0");
        kprint.dec(lease);
        kprint.puts(" s)\0");
    }
    kprint.putc(10);
    events.begin("net up eth0 \0");
    ip_event(ip);
    events.end();
}

pub fun prefix_of(mask: u32) u64 { ret prefix(mask); }

# find the card; whether there is one
pub fun init() u8 {
    var i: u64 = 0;
    for (i < 6) {
        ALL[i] = 0xFF;
        NONE[i] = 0;
        i = i + 1;
    }
    if (e1000.init() == 0) { ret 0; }
    ifc.present = 1;
    ifc.nic = e1000.get(0);
    mem.copy((?ifc.mac[0])::u64, (?ifc.nic.mac[0])::u64, 6);
    kprint.level(kprint.INFO);
    kprint.puts("net: eth0: Intel \0");
    kprint.puts(ifc.nic.model);
    kprint.puts(", MAC \0");
    i = 0;
    for (i < 6) {
        val digits: *u8 = "0123456789abcdef\0";
        if (i > 0) { kprint.putc(58); }
        kprint.putc(digits[ifc.mac[i] >> 4]);
        kprint.putc(digits[ifc.mac[i] & 15]);
        i = i + 1;
    }
    if (e1000.link_up(ifc.nic) != 0) {
        kprint.puts(", link up at \0");
        kprint.dec(e1000.speed(ifc.nic));
        kprint.puts(" Mbit/s\n\0");
    } or {
        kprint.puts(", no link\n\0");
    }
    ret 1;
}
