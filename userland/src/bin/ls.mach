# List paths with optional details, hidden names, sizes and color.

use os:    std.system.os;
use io:    userland.lib.cli;
use opt: userland.lib.options;
use std.runtime;
use std.types.size.usize;
use text:  userland.lib.text;
use users: userland.lib.accounts;

# what ls shows of one name
rec Item {
    kind:     u64;
    size:     u64;
    mtime:    u64;
    mode:     u64;
    uid:      u64;
    gid:      u64;
    name:     *u8;
    name_len: u64;
}

val S_ISUID: u64 = 0o4000;
val S_ISGID: u64 = 0o2000;
val S_ISVTX: u64 = 0o1000;

var long: u8 = 0;
var human: u8 = 0;
var directory: u8 = 0;
var hidden: u8 = 0;
var classify: u8 = 0;
var color: u8 = 0; # only on a terminal: pipes get plain names

# names of the last uid and gid looked up (ls lists many of the same)
var last_uid: u64 = 0xFFFFFFFFFFFFFFFF;
var last_gid: u64 = 0xFFFFFFFFFFFFFFFF;
var uname: [32]u8;
var uname_len: u64 = 0;
var gname: [32]u8;
var gname_len: u64 = 0;

fun pad_out(s: *u8, n: u64, width: u64) {
    io.outn(s, n);
    var k: u64 = n;
    for (k < width) {
        io.putc(32);
        k = k + 1;
    }
}

fun mode_string(kind: u64, mode: u64) {
    var m: [10]u8;
    m[0] = 45;
    if (kind == io.KIND_DIR) { m[0] = 100; }
    or (kind == io.KIND_DEV) { m[0] = 99; }
    val rwx: *u8 = "rwxrwxrwx\0";
    var i: u64 = 0;
    for (i < 9) {
        if ((mode & (0x100 >> i::u64)) != 0) { m[1 + i] = rwx[i]; }
        or                                    { m[1 + i] = 45; }
        i = i + 1;
    }
    if ((mode & S_ISUID) != 0) {
        if (m[3] == 120) { m[3] = 115; } or { m[3] = 83; }
    }
    if ((mode & S_ISGID) != 0) {
        if (m[6] == 120) { m[6] = 115; } or { m[6] = 83; }
    }
    if ((mode & S_ISVTX) != 0) {
        if (m[9] == 120) { m[9] = 116; } or { m[9] = 84; }
    }
    io.outn(?m[0], 10);
}

fun show(e: *Item) {
    if (long != 0) {
        mode_string(e.kind, e.mode);
        io.putc(32);
        if (e.uid != last_uid) {
            uname_len = users.user_name(e.uid, ?uname[0]);
            last_uid = e.uid;
        }
        if (e.gid != last_gid) {
            gname_len = users.group_name(e.gid, ?gname[0]);
            last_gid = e.gid;
        }
        pad_out(?uname[0], uname_len, 8);
        io.putc(32);
        pad_out(?gname[0], gname_len, 8);
        if (human != 0) { io.putc(32); opt.size(e.size, 1); } or { io.dec_pad(e.size, 8); }
        io.out("  \0");
        var t: [16]u8;
        io.outn(?t[0], text.fmt_time(e.mtime, ?t[0]));
        io.out("  \0");
    }
    # directories blue, devices yellow, programs green
    var paint: *u8 = nil;
    if (e.kind == io.KIND_DIR) { paint = "\x1b[1;34m\0"; }
    or (e.kind == io.KIND_DEV) { paint = "\x1b[1;33m\0"; }
    or ((e.mode & 0x49) != 0)   { paint = "\x1b[1;32m\0"; }
    if (color != 0 && paint != nil) { io.out(paint); }
    io.outn(e.name, e.name_len);
    if (color != 0 && paint != nil) { io.out("\x1b[0m\0"); }
    if (e.kind == io.KIND_DIR) { io.putc(47); }
    or (classify != 0 && (e.mode & 0o111) != 0) { io.putc(42); }
    io.putc(10);
}

fun item(e: *Item, st: *os.stat_t, name: *u8, n: u64) {
    e.kind = io.kind_of(st.st_mode);
    e.size = st.st_size::u64;
    e.mtime = st.st_mtime::u64;
    e.mode = io.perms(st);
    e.uid = st.st_uid::u64;
    e.gid = st.st_gid::u64;
    e.name = name;
    e.name_len = n;
}

fun list(p: *u8) u8 {
    var st: os.stat_t;
    val r: i64 = io.stat(p, ?st);
    if (r < 0) {
        io.fail("ls\0", p, r);
        ret 0;
    }
    var e: Item;
    if (directory != 0 || !io.is_dir(?st)) {
        item(?e, ?st, p, io.len(p));
        show(?e);
        ret 1;
    }
    var dir: io.Dir;
    val o: i64 = io.dir_open(?dir, p);
    if (o < 0) {
        io.fail("ls\0", p, o);
        ret 0;
    }
    for (io.dir_next(?dir) > 0) {
        if (hidden == 0 && dir.name[0] == 46) { cnt; }
        var est: os.stat_t;
        if (os.stat_path(dir.handle::usize, dir.name, ?est, 0) >= 0) {
            item(?e, ?est, dir.name, dir.len);
            show(?e);
        }
    }
    io.dir_close(?dir);
    ret 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    color = io.isatty(io.STDOUT);
    if (opt.standard(argc, argv, "ls", "usage: ls [-lahdF] [--color=WHEN] [--] [PATH...]\n  -l  detailed listing\n  -a, -A, --all  include hidden names\n  -h, --human-readable  readable sizes with -l\n  -d, --directory  list directory itself\n  -F, --classify  mark executable files with *\n  --color=auto|always|never  select color output") != 0) { ret 0; }
    var p: opt.Parser; opt.init(?p, argc, argv);
    for {
        val c: u8 = opt.next(?p, "all=a,almost-all=A,human-readable=h,directory=d,classify=F,color=C"); if (c == 0) { brk; }
        if (c == 108) { long = 1; } or (c == 104) { human = 1; }
        or (c == 100) { directory = 1; } or (c == 70) { classify = 1; }
        or (c == 97 || c == 65) { hidden = 1; }
        or (c == 67) {
            val value: *u8 = opt.argument(?p);
            if (value != nil) {
                if (io.streq(value, "always") != 0) { color = 1; }
                or (io.streq(value, "never") != 0) { color = 0; }
                or (io.streq(value, "auto") != 0) { color = io.isatty(io.STDOUT); } or { p.bad = 1; }
            }
        } or { p.bad = 1; }
    }
    if (p.bad != 0) { ret opt.error("ls"); }
    var i: u64 = p.at;
    if (i == argc) {
        if (list(".\0") == 0) { ret 1; }
        ret 0;
    }
    var status: u64 = 0;
    val many: u8 = (argc - i > 1)::u8;
    for (i < argc) {
        if (many != 0) {
            io.out(argv[i]);
            io.out(":\n\0");
        }
        if (list(argv[i]) == 0) { status = 1; }
        i = i + 1;
    }
    ret status;
}
