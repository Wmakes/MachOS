# mv FROM TO: rename or move a file or directory

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc != 3) {
        io.err("usage: mv FROM TO\n\0");
        ret 2;
    }
    # moving into an existing directory keeps the name
    var to: [256]u8;
    var tn: u64 = io.len(argv[2]);
    if (tn >= 256) { tn = 255; }
    io.copy(?to[0], argv[2], tn);
    var st: abi.Stat;
    if (abi.is_err(sys.stat(argv[2], io.len(argv[2]), ?st)) == 0 && st.kind == abi.KIND_DIR) {
        val from: *u8 = argv[1];
        val fl: u64 = io.len(from);
        var b: u64 = fl;
        for (b > 0 && from[b - 1] != 47) { b = b - 1; }
        if (tn + 1 + fl - b < 256) {
            to[tn] = 47;
            io.copy(?to[tn + 1], ?from[b], fl - b);
            tn = tn + 1 + fl - b;
        }
    }
    val r: u64 = sys.rename(argv[1], io.len(argv[1]), ?to[0], tn);
    if (abi.is_err(r) != 0) {
        io.fail("mv\0", argv[1], r);
        ret 1;
    }
    ret 0;
}
