# full-screen terminal programs: raw mode, the screen size, cursor control,
# and keys (escape sequences decoded into KEY_* codes)

use io:   userland.lib.cli;
use tmos: std.terminal.machos;
use std.types.size.usize;

pub val KEY_UP:    u64 = 0x110001;
pub val KEY_DOWN:  u64 = 0x110002;
pub val KEY_RIGHT: u64 = 0x110003;
pub val KEY_LEFT:  u64 = 0x110004;
pub val KEY_HOME:  u64 = 0x110005;
pub val KEY_END:   u64 = 0x110006;
pub val KEY_DEL:   u64 = 0x110007;
pub val KEY_PGUP:  u64 = 0x110008;
pub val KEY_PGDN:  u64 = 0x110009;
pub val KEY_EOF:   u64 = 0xFFFFFFFFFFFFFFFF;
pub val KEY_ALT:   u64 = 0x200000; # + the codepoint: alt+key, or escape then key ("M-x")

var tty: i64 = 0;     # where keys come from (a terminal handle)
var rows: u64 = 24;
var cols: u64 = 80;

# take over the terminal `h`: raw mode, and learn its size
pub fun start(h: i64) u8 {
    tty = h;
    if (tmos.size(h::usize, ?rows, ?cols) < 0) { ret 0; }
    tmos.raw(h::usize);
    io.msg("\x1b[2J\x1b[H\0");
    ret 1;
}

# hand the terminal back: line mode, a clean screen
pub fun stop() {
    tmos.restore(tty::usize);
    io.msg("\x1b[0m\x1b[2J\x1b[H\0");
}

pub fun height() u64 { ret rows; }
pub fun width() u64 { ret cols; }

# row and col count from 0
pub fun go(row: u64, col: u64) {
    io.msg("\x1b[\0");
    io.dec(row + 1);
    io.putc(59);
    io.dec(col + 1);
    io.putc(72);
}

pub fun clear_eol() { io.msg("\x1b[K\0"); }
pub fun reverse(on: u8) {
    if (on != 0) { io.msg("\x1b[7m\0"); }
    or           { io.msg("\x1b[0m\0"); }
}

fun byte() u64 {
    var c: u8 = 0;
    val r: i64 = io.read(tty, ?c, 1);
    if (r <= 0) { ret KEY_EOF; }
    ret c::u64;
}

fun decode(first: u64) u64 {
    if (first < 0x80 || first == KEY_EOF) { ret first; }
    var cp: u64 = 0;
    var need: u64 = 0;
    var minimum: u64 = 0;
    if (first >= 0xC2 && first <= 0xDF) { cp = first & 0x1F; need = 1; minimum = 0x80; }
    or (first >= 0xE0 && first <= 0xEF) { cp = first & 0x0F; need = 2; minimum = 0x800; }
    or (first >= 0xF0 && first <= 0xF4) { cp = first & 7; need = 3; minimum = 0x10000; }
    or { ret 0xFFFD; }
    var i: u64 = 0;
    for (i < need) {
        val c: u64 = byte();
        if (c < 0x80 || c >= 0xC0) { ret 0xFFFD; }
        cp = (cp << 6) | (c & 0x3F);
        i = i + 1;
    }
    if (cp < minimum || (cp >= 0xD800 && cp <= 0xDFFF) || cp > 0x10FFFF) { ret 0xFFFD; }
    ret cp;
}

pub fun key() u64 {
    val c: u64 = byte();
    if (c != 27) {
        if (c == 13) { ret 10; }
        ret decode(c);
    }
    val c2: u64 = byte();
    if (c2 == 27 || c2 == KEY_EOF) { ret 27; }
    if (c2 != 91 && c2 != 79) { ret KEY_ALT + decode(c2); }
    var num: u64 = 0;
    var f: u64 = byte();
    for (f >= 48 && f <= 57) {
        num = num * 10 + f - 48;
        f = byte();
    }
    if (f == 65) { ret KEY_UP; }
    if (f == 66) { ret KEY_DOWN; }
    if (f == 67) { ret KEY_RIGHT; }
    if (f == 68) { ret KEY_LEFT; }
    if (f == 72) { ret KEY_HOME; }
    if (f == 70) { ret KEY_END; }
    if (f == 126) {
        if (num == 1 || num == 7) { ret KEY_HOME; }
        if (num == 4 || num == 8) { ret KEY_END; }
        if (num == 3) { ret KEY_DEL; }
        if (num == 5) { ret KEY_PGUP; }
        if (num == 6) { ret KEY_PGDN; }
    }
    ret 0;
}
