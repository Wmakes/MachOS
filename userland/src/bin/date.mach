# date [+%s]: the current date and time (UTC); +%s: seconds since 1970

use io:  userland.lib.cli;
use std.runtime;

val MONTH_DAYS: [12]u64 = [12]u64{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

fun leap(y: u64) u8 {
    if ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) { ret 1; }
    ret 0;
}

fun two(v: u64) {
    if (v < 10) { io.putc(48); }
    io.dec(v);
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    val t: u64 = io.time();
    if (argc > 1 && io.streq(argv[1], "+%s\0") != 0) {
        io.dec(t);
        io.putc(10);
        ret 0;
    }
    var days: u64 = t / 86400;
    val secs: u64 = t % 86400;
    var year: u64 = 1970;
    for {
        var len: u64 = 365;
        if (leap(year) != 0) { len = 366; }
        if (days < len) { brk; }
        days = days - len;
        year = year + 1;
    }
    var month: u64 = 0;
    for (month < 12) {
        var len: u64 = MONTH_DAYS[month];
        if (month == 1 && leap(year) != 0) { len = 29; }
        if (days < len) { brk; }
        days = days - len;
        month = month + 1;
    }
    io.dec(year);
    io.putc(45);
    two(month + 1);
    io.putc(45);
    two(days + 1);
    io.putc(32);
    two(secs / 3600);
    io.putc(58);
    two((secs / 60) % 60);
    io.putc(58);
    two(secs % 60);
    io.out(" UTC\n\0");
    ret 0;
}
