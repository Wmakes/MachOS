# NIST CAVP HMAC-DRBG SHA-256 known-answer test.

use drbg: sdk.hmac_drbg;

#[naked]
#[symbol("_start")]
fun start() {
    asm x86_64 {
        mov rdi, [rsp]
        lea rsi, [rsp + 8]
        and rsp, -16
        call main
        mov rdi, rax
        mov rax, 60
        syscall
    }
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret 0; }

fun nibble(c: u8) u8 {
    if (c >= 48 && c <= 57) { ret c - 48; }
    if (c >= 97 && c <= 102) { ret c - 87; }
    ret 255;
}

fun decode(text: *u8, out: *u8, n: u64) u8 {
    var i: u64 = 0;
    for (i < n) {
        val high: u8 = nibble(text[i * 2]);
        val low:  u8 = nibble(text[i * 2 + 1]);
        if (high > 15 || low > 15) { ret 0; }
        out[i] = (high << 4) | low;
        i = i + 1;
    }
    ret (text[n * 2] == 0)::u8;
}

test hmac_drbg__nist_sha256_no_reseed_count_zero {
    var entropy:  [32]u8;
    var nonce:    [16]u8;
    var expected: [32]u8;
    var output:   [128]u8;
    if (decode("ca851911349384bffe89de1cbdc46e6831e44d34a4fb935ee285dd14b71a7488\0", ?entropy[0], 32) == 0 ||
        decode("659ba96c601dc69fc902940805ec0ca8\0", ?nonce[0], 16) == 0 ||
        decode("e528e9abf2dece54d47c7e75e5fe302149f817ea9fb4bee6f4199697d04d5b89\0", ?expected[0], 32) == 0) { ret 1; }
    var state: drbg.State;
    if (drbg.init(?state, ?entropy[0], 32, ?nonce[0], 16, nil, 0) == 0) { ret 2; }
    if (drbg.generate(?state, ?output[0], 128, nil, 0) == 0) { ret 3; }
    if (drbg.generate(?state, ?output[0], 128, nil, 0) == 0) { ret 4; }
    var i: u64 = 0;
    for (i < 32) {
        if (output[i] != expected[i]) { ret 5; }
        i = i + 1;
    }
    drbg.destroy(?state);
    ret 0;
}
