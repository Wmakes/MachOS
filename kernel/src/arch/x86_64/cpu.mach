# port i/o and small cpu primitives

pub fun outb(port: u16, v: u8) {
    asm x86_64 {
        mov dx, {port}
        mov al, {v}
        out dx, al
    }
}

pub fun inb(port: u16) u8 {
    var v: u8 = 0;
    asm x86_64 {
        mov dx, {port}
        in al, dx
        mov {v}, al
    }
    ret v;
}

pub fun outw(port: u16, v: u16) {
    asm x86_64 {
        mov dx, {port}
        mov ax, {v}
        out dx, ax
    }
}

pub fun outl(port: u16, v: u32) {
    asm x86_64 {
        mov dx, {port}
        mov eax, {v}
        out dx, eax
    }
}

pub fun inl(port: u16) u32 {
    var v: u32 = 0;
    asm x86_64 {
        mov dx, {port}
        in eax, dx
        mov {v}, eax
    }
    ret v;
}

pub fun cr2() u64 {
    var v: u64 = 0;
    asm x86_64 {
        mov rax, cr2
        mov {v}, rax
    }
    ret v;
}

pub fun cr3() u64 {
    var v: u64 = 0;
    asm x86_64 {
        mov rax, cr3
        mov {v}, rax
    }
    ret v;
}

# mask both legacy 8259 PICs; interrupts will come from the APIC
pub fun pic_disable() {
    outb(0x21, 0xFF);
    outb(0xA1, 0xFF);
}

# park the core for good. `nop` after `hlt`: mach treats hlt as no-return
pub fun halt() {
    for {
        asm x86_64 {
            cli
            hlt
            nop
        }
    }
}

pub fun rdmsr(msr: u32) u64 {
    var lo: u32 = 0;
    var hi: u32 = 0;
    asm x86_64 {
        mov ecx, {msr}
        rdmsr
        mov {lo}, eax
        mov {hi}, edx
    }
    ret (hi::u64 << 32) | lo::u64;
}

pub fun wrmsr(msr: u32, v: u64) {
    val lo: u32 = (v & 0xFFFFFFFF)::u32;
    val hi: u32 = (v >> 32)::u32;
    asm x86_64 {
        mov ecx, {msr}
        mov eax, {lo}
        mov edx, {hi}
        wrmsr
    }
}

pub fun set_cr3(v: u64) {
    asm x86_64 {
        mov rax, {v}
        mov cr3, rax
    }
}

pub fun cr0() u64 {
    var v: u64 = 0;
    asm x86_64 {
        mov rax, cr0
        mov {v}, rax
    }
    ret v;
}

pub fun set_cr0(v: u64) {
    asm x86_64 {
        mov rax, {v}
        mov cr0, rax
    }
}

pub fun cr4() u64 {
    var v: u64 = 0;
    asm x86_64 {
        mov rax, cr4
        mov {v}, rax
    }
    ret v;
}

pub fun set_cr4(v: u64) {
    asm x86_64 {
        mov rax, {v}
        mov cr4, rax
    }
}

# drop one page's translation from the TLB (invlpg [rdi])
pub fun invlpg(va: u64) {
    asm x86_64 {
        mov rdi, {va}
        .byte 0x0f, 0x01, 0x3f :: writes()
    }
}

pub val MSR_EFER: u32 = 0xC0000080;

# cpuid leaf 7 (structured extended features): ebx and ecx
fun cpuid7(ecx_out: *u32) u32 {
    var b: u32 = 0;
    var c: u32 = 0;
    asm x86_64 {
        mov eax, 7
        mov ecx, 0
        cpuid
        mov {b}, ebx
        mov {c}, ecx
    }
    @ecx_out = c;
    ret b;
}

fun max_leaf() u32 {
    var a: u32 = 0;
    asm x86_64 {
        mov eax, 0
        cpuid
        mov {a}, eax
    }
    ret a;
}

var smep: u8 = 0;
var smap: u8 = 0;
var umip: u8 = 0;

pub fun has_smep() u8 { ret smep; }
pub fun has_smap() u8 { ret smap; }
pub fun has_umip() u8 { ret umip; }

# no-execute pages, write protection in ring 0, SSE usable everywhere, and
# where the cpu has them: SMEP (ring 0 never runs user pages), SMAP (ring 0
# touches user pages only between stac and clac) and UMIP (no sgdt/sidt
# etc. from user mode)
pub fun init() {
    wrmsr(MSR_EFER, rdmsr(MSR_EFER) | (1 << 11));           # EFER.NXE
    set_cr0((cr0() | (1 << 16) | (1 << 1)) & ~(1::u64 << 2)); # WP, MP, clear EM
    var cr: u64 = cr4() | (1 << 9) | (1 << 10);              # OSFXSR, OSXMMEXCPT
    if (max_leaf() >= 7) {
        var c: u32 = 0;
        val b: u32 = cpuid7(?c);
        if ((b & (1 << 7)) != 0) { smep = 1; cr = cr | (1 << 20); }
        if ((b & (1 << 20)) != 0) { smap = 1; cr = cr | (1 << 21); }
        if ((c & (1 << 2)) != 0) { umip = 1; cr = cr | (1 << 11); }
    }
    set_cr4(cr);
    if (smap != 0) { clac(); }
}

# allow / forbid ring-0 access to user pages (SMAP); only call when has_smap()
# (stac/clac as bytes: mach's assembler does not know them)
pub fun stac() {
    asm x86_64 {
        .byte 0x0f, 0x01, 0xcb :: writes()
    }
}

pub fun clac() {
    asm x86_64 {
        .byte 0x0f, 0x01, 0xca :: writes()
    }
}

# sleep until an interrupt has been handled. naked and stackless so a
# handler running on this stack cannot clobber anything below rsp
#[naked]
#[symbol("cpu_wait")]
pub fun wait() {
    asm x86_64 {
        sti
        hlt
        cli
        ret
    }
}

# load an empty IDT and raise an exception: the cpu resets
pub fun triple_fault() {
    var zero: [10]u8;
    var i: u64 = 0;
    for (i < 10) {
        zero[i] = 0;
        i = i + 1;
    }
    val p: u64 = (?zero[0])::u64;
    asm x86_64 {
        mov rax, {p}
        .byte 0x0f, 0x01, 0x18 :: writes()
        .byte 0xcc :: writes()
    }
    halt();
}
