# block devices, named the Linux way: /dev/sda, /dev/nvme0n1, ... for whole
# disks and /dev/sda1, /dev/nvme0n1p1, ... for the partitions in their GPT. a
# device node's `dev` is DEV_DISK + its slot here. a disk's partitions are
# read again when something that wrote to the whole disk closes it.
# probe() fills the table at boot, before there is a root to put /dev in;
# publish() makes the nodes once there is

use abi:  sdk.abi;
use dsk:  machos.dev.disk;
use mem:  machos.kern.mem;
use gpt:  machos.fs.gpt;
use vfs:  machos.fs.vfs;
use kprint: machos.kern.kprint;

pub val MAX: u64 = 64;

pub rec Bdev {
    used:  u8;
    disk:  u64; # index in dev/disk
    part:  u64; # 0 = the whole disk, else the GPT index
    start: u64; # first sector
    count: u64; # sectors
    kind:  [16]u8; # partition type GUID
    unique: [16]u8; # its own GUID (zeros for whole disks)
    node:  *vfs.Node;
}

var devs: [64]Bdev;
var devdir: *vfs.Node = nil;

pub fun get(dev: u64) *Bdev {
    if (dev < vfs.DEV_DISK || dev - vfs.DEV_DISK >= MAX) { ret nil; }
    val b: *Bdev = ?devs[dev - vfs.DEV_DISK];
    if (b.used == 0) { ret nil; }
    ret b;
}

pub fun disk_of(b: *Bdev) *dsk.Disk { ret dsk.disk(b.disk); }

fun make_node(i: u64) {
    val b: *Bdev = ?devs[i];
    var name: [24]u8;
    val n: u64 = dsk.part_name(dsk.disk(b.disk), b.part, ?name[0]);
    val nd: *vfs.Node = vfs.create_ram(devdir, ?name[0], n, abi.KIND_DEV);
    if (nd == nil) { ret; }
    nd.dev = vfs.DEV_DISK + i;
    nd.size = b.count * dsk.SECTOR;
    nd.mode = 0x180; # 0600: raw disks are root's
    b.node = nd;
}

fun add(disk: u64, part: u64, start: u64, count: u64, kind: *u8, unique: *u8) *Bdev {
    var i: u64 = 0;
    for (i < MAX) {
        val b: *Bdev = ?devs[i];
        if (b.used == 0) {
            b.used = 1;
            b.disk = disk;
            b.part = part;
            b.start = start;
            b.count = count;
            if (kind != nil) { mem.copy((?b.kind[0])::u64, kind::u64, 16); }
            or               { mem.fill((?b.kind[0])::u64, 0, 16); }
            if (unique != nil) { mem.copy((?b.unique[0])::u64, unique::u64, 16); }
            or                 { mem.fill((?b.unique[0])::u64, 0, 16); }
            b.node = nil;
            if (devdir != nil) { make_node(i); }
            ret b;
        }
        i = i + 1;
    }
    ret nil;
}

val ESP_TYPE: [16]u8 = [16]u8{0x28, 0x73, 0x2a, 0xc1, 0x1f, 0xf8, 0xd2, 0x11,
                              0xba, 0x4b, 0x00, 0xa0, 0xc9, 0x3e, 0xc9, 0x3b};
val LINUX_TYPE: [16]u8 = [16]u8{0xaf, 0x3d, 0xc6, 0x0f, 0x83, 0x84, 0x72, 0x47,
                                0x8e, 0x79, 0x3d, 0x69, 0xd8, 0x47, 0x7d, 0xe4};

fun type_name(k: *u8) *u8 {
    if (mem.equal(k, ?gpt.ROOT_TYPE[0], 16) != 0) { ret "MachOS root\0"; }
    if (mem.equal(k, ?ESP_TYPE[0], 16) != 0) { ret "EFI system\0"; }
    if (mem.equal(k, ?LINUX_TYPE[0], 16) != 0) { ret "Linux filesystem\0"; }
    ret "other\0";
}

fun add_partitions(disk: u64) {
    var entries: [32]gpt.Entry;
    val d: *dsk.Disk = dsk.disk(disk);
    val n: u64 = gpt.scan(d, ?entries[0]);
    kprint.info("gpt\0");
    kprint.puts(?d.name[0]);
    if (n == 0) { kprint.puts(": no GPT partition table\n\0"); }
    or {
        kprint.puts(": \0");
        kprint.dec(n);
        kprint.puts(" partition(s)\n\0");
    }
    var i: u64 = 0;
    for (i < n && i < 99) {
        val e: *gpt.Entry = ?entries[i];
        add(disk, e.index, e.first, e.count, ?e.kind[0], ?e.unique[0]);
        var pn: [24]u8;
        val l: u64 = dsk.part_name(d, e.index, ?pn[0]);
        kprint.info("gpt\0");
        kprint.puts("  \0");
        var k: u64 = 0;
        for (k < l) {
            kprint.putc(pn[k]);
            k = k + 1;
        }
        kprint.puts(": \0");
        kprint.puts(type_name(?e.kind[0]));
        kprint.puts(", \0");
        kprint.dec(e.count / 2048);
        kprint.puts(" MiB from sector \0");
        kprint.dec(e.first);
        kprint.putc(10);
        i = i + 1;
    }
}

# every disk and its partitions into the table (boot, before /dev exists)
pub fun probe() {
    var d: u64 = 0;
    for (d < dsk.disk_count()) {
        add(d, 0, 0, dsk.disk(d).sectors, nil, nil);
        add_partitions(d);
        d = d + 1;
    }
}

# /dev/sdX and /dev/sdXN nodes under `dev` for everything probed
pub fun publish(dev: *vfs.Node) {
    devdir = dev;
    var i: u64 = 0;
    for (i < MAX) {
        if (devs[i].used != 0 && devs[i].node == nil) { make_node(i); }
        i = i + 1;
    }
}

# forget disk `disk`'s partitions and read its GPT again. a partition node
# still held open stops being a device and reads as empty
pub fun rescan(disk: u64) {
    var i: u64 = 0;
    for (i < MAX) {
        val b: *Bdev = ?devs[i];
        if (b.used != 0 && b.disk == disk && b.part != 0) {
            if (b.node != nil) {
                b.node.dev = vfs.DEV_NULL;
                vfs.unlink(b.node);
            }
            b.used = 0;
        }
        i = i + 1;
    }
    add_partitions(disk);
}

# the first partition with the MachOS root type, in disk order, or nil
# the MachOS root: the partition whose GUID is `want` (the one the boot
# loader read the kernel from) when it is one, else the first with the
# MachOS root type, in disk order
pub fun find_root(want: *u8) *Bdev {
    var zero: u8 = 1;
    var k: u64 = 0;
    for (k < 16) {
        if (want[k] != 0) { zero = 0; }
        k = k + 1;
    }
    if (zero == 0) {
        var j: u64 = 0;
        for (j < MAX) {
            val b: *Bdev = ?devs[j];
            if (b.used != 0 && b.part != 0 && mem.equal(?b.unique[0], want, 16) != 0 &&
                mem.equal(?b.kind[0], ?gpt.ROOT_TYPE[0], 16) != 0) { ret b; }
            j = j + 1;
        }
    }
    var d: u64 = 0;
    for (d < dsk.disk_count()) {
        var i: u64 = 0;
        for (i < MAX) {
            val b: *Bdev = ?devs[i];
            if (b.used != 0 && b.disk == d && b.part != 0 && mem.equal(?b.kind[0], ?gpt.ROOT_TYPE[0], 16) != 0) {
                ret b;
            }
            i = i + 1;
        }
        d = d + 1;
    }
    ret nil;
}

# the partition of disk `disk` starting at `start`, or nil
pub fun find(disk: u64, start: u64) *Bdev {
    var i: u64 = 0;
    for (i < MAX) {
        val b: *Bdev = ?devs[i];
        if (b.used != 0 && b.disk == disk && b.start == start && b.part != 0) { ret b; }
        i = i + 1;
    }
    ret nil;
}

# "/dev/sda2" style name of `b` into out (24 bytes); its length
pub fun dev_name(b: *Bdev, out: *u8) u64 {
    mem.copy(out::u64, "/dev/\0"::u64, 5);
    ret 5 + dsk.part_name(dsk.disk(b.disk), b.part, ?out[5]);
}

pub fun slot_of(b: *Bdev) u64 { ret (b::u64 - (?devs[0])::u64) / $size_of(Bdev)::u64; }
