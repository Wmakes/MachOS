# what is mounted where. every mount is a filesystem (ext2, FAT16/32 or
# exFAT, recognised by what is on the disk) on a block device (fs/parts)
# with its own Part. a device with something mounted on it, or a whole
# disk with a mounted partition, cannot be written raw

use abi:   sdk.abi;
use dsk:  machos.dev.disk;
use heap:  machos.mm.heap;
use blk:   machos.fs.blk;
use ext2:  machos.fs.ext2;
use fat:   machos.fs.fat;
use exfat: machos.fs.exfat;
use vfs:   machos.fs.vfs;
use parts: machos.fs.parts;

pub val MAX: u64 = 8;

pub val EXT2: u64 = 1;
pub val FAT: u64 = 2;
pub val EXFAT: u64 = 3;

pub rec Mount {
    used:  u8;
    kind:  u64;      # EXT2, FAT or EXFAT
    disk:  u64;      # index in dev/disk
    start: u64;      # first sector of the filesystem
    part:  *blk.Part;
    fs:    *ext2.Fs;
    fatfs: *fat.Fs;
    exfs:  *exfat.Fs;
    root:  *vfs.Node; # the mounted root (nil for the boot root)
}

var mounts: [8]Mount;

fun free_slot() *Mount {
    var i: u64 = 0;
    for (i < MAX) {
        if (mounts[i].used == 0) { ret ?mounts[i]; }
        i = i + 1;
    }
    ret nil;
}

# open the filesystem on `b` into m (part and the fs for its kind); *why
# says what is wrong when nothing fits
fun open_fs(b: *parts.Bdev, m: *Mount, ext2_only: u8, why: **u8) u64 {
    @why = nil;
    val d: *dsk.Disk = parts.disk_of(b);
    blk.forget_disk(d); # the disk may have just been written raw
    val p: *blk.Part = heap.zalloc($size_of(blk.Part)::u64)::*blk.Part;
    if (p == nil) { ret abi.err(abi.E_NOMEM); }
    p.disk = d;
    p.start = b.start;
    p.sectors = b.count;
    m.part = p;
    m.fs = nil;
    m.fatfs = nil;
    m.exfs = nil;
    val f: *ext2.Fs = heap.zalloc($size_of(ext2.Fs)::u64)::*ext2.Fs;
    if (f == nil) {
        heap.free(p::u64);
        ret abi.err(abi.E_NOMEM);
    }
    val err: *u8 = ext2.mount(f, p);
    if (err == nil) {
        m.kind = EXT2;
        m.fs = f;
        ret 0;
    }
    heap.free(f::u64);
    @why = err;
    if (ext2_only == 0) {
        val ff: *fat.Fs = heap.zalloc($size_of(fat.Fs)::u64)::*fat.Fs;
        if (ff != nil) {
            if (fat.mount(ff, p) == nil) {
                m.kind = FAT;
                m.fatfs = ff;
                @why = nil;
                ret 0;
            }
            heap.free(ff::u64);
        }
        val xf: *exfat.Fs = heap.zalloc($size_of(exfat.Fs)::u64)::*exfat.Fs;
        if (xf != nil) {
            if (exfat.mount(xf, p) == nil) {
                m.kind = EXFAT;
                m.exfs = xf;
                @why = nil;
                ret 0;
            }
            heap.free(xf::u64);
        }
        @why = "no ext2, FAT or exFAT filesystem there\0";
    }
    heap.free(p::u64);
    ret abi.err(abi.E_INVAL);
}

fun free_fs(m: *Mount) {
    if (m.fs != nil) { heap.free(m.fs::u64); }
    if (m.fatfs != nil) { heap.free(m.fatfs::u64); }
    if (m.exfs != nil) { heap.free(m.exfs::u64); }
    if (m.part != nil) { heap.free(m.part::u64); }
    m.fs = nil;
    m.fatfs = nil;
    m.exfs = nil;
    m.part = nil;
}

fun record(b: *parts.Bdev, t: *Mount, root: *vfs.Node) {
    val m: *Mount = free_slot();
    m.used = 1;
    m.kind = t.kind;
    m.disk = b.disk;
    m.start = b.start;
    m.part = t.part;
    m.fs = t.fs;
    m.fatfs = t.fatfs;
    m.exfs = t.exfs;
    m.root = root;
}

# boot: make `b` the root; nil, or the reason it cannot be
pub fun mount_root(b: *parts.Bdev) *u8 {
    var t: Mount;
    var why: *u8 = nil;
    val r: u64 = open_fs(b, ?t, 1, ?why);
    if (abi.is_err(r) != 0) {
        if (why != nil) { ret why; }
        ret "out of memory\0";
    }
    if (vfs.init_ext2(t.fs) == 0) { ret "out of memory\0"; }
    record(b, ?t, nil);
    ext2.set_clean(t.fs, 0);
    ret nil;
}

# mount the filesystem on `b` on the directory `at`
pub fun mount_at(b: *parts.Bdev, at: *vfs.Node) u64 {
    if (busy(b) != 0) { ret abi.err(abi.E_BUSY); }
    if (free_slot() == nil) { ret abi.err(abi.E_BUSY); }
    var t: Mount;
    var why: *u8 = nil;
    val r: u64 = open_fs(b, ?t, 0, ?why);
    if (abi.is_err(r) != 0) { ret r; }
    var vr: u64 = 0;
    if (t.kind == EXT2) { vr = vfs.mount(at, t.fs); }
    or (t.kind == FAT) { vr = vfs.mount_fat(at, t.fatfs); }
    or { vr = vfs.mount_exfat(at, t.exfs); }
    if (abi.is_err(vr) != 0) {
        free_fs(?t);
        ret vr;
    }
    record(b, ?t, at.mounted);
    if (t.kind == EXT2) { ext2.set_clean(t.fs, 0); }
    ret 0;
}

fun release(m: *Mount) u64 {
    if (m.root == nil) { ret abi.err(abi.E_BUSY); } # the root stays
    val u: u64 = vfs.unmount(m.root);
    if (abi.is_err(u) != 0) { ret u; }
    if (m.kind == EXT2) { ext2.set_clean(m.fs, 1); }
    blk.forget_disk(m.part.disk); # writes everything back first
    free_fs(m);
    m.used = 0;
    m.root = nil;
    ret 0;
}

# shutdown: every mounted filesystem is about to stop being written
pub fun mark_all_clean() {
    var i: u64 = 0;
    for (i < MAX) {
        if (mounts[i].used != 0 && mounts[i].kind == EXT2) { ext2.set_clean(mounts[i].fs, 1); }
        i = i + 1;
    }
}

# whether the root filesystem was shut down cleanly last time
pub fun root_was_clean() u8 {
    var i: u64 = 0;
    for (i < MAX) {
        if (mounts[i].used != 0 && mounts[i].root == nil && mounts[i].kind == EXT2) { ret mounts[i].fs.was_clean; }
        i = i + 1;
    }
    ret 1;
}

# unmount by the mounted root (what a path to the mountpoint finds)
pub fun unmount(r: *vfs.Node) u64 {
    var i: u64 = 0;
    for (i < MAX) {
        if (mounts[i].used != 0 && mounts[i].root == r) { ret release(?mounts[i]); }
        i = i + 1;
    }
    ret abi.err(abi.E_INVAL);
}

# unmount by device
pub fun unmount_dev(b: *parts.Bdev) u64 {
    var i: u64 = 0;
    for (i < MAX) {
        val m: *Mount = ?mounts[i];
        if (m.used != 0 && m.disk == b.disk && m.start == b.start) { ret release(m); }
        i = i + 1;
    }
    ret abi.err(abi.E_INVAL);
}

# the `idx`-th mount, or nil past the end
pub fun nth(idx: u64) *Mount {
    var seen: u64 = 0;
    var i: u64 = 0;
    for (i < MAX) {
        val m: *Mount = ?mounts[i];
        if (m.used != 0) {
            if (seen == idx) { ret m; }
            seen = seen + 1;
        }
        i = i + 1;
    }
    ret nil;
}

# a mount's size and free space in bytes
pub fun space(m: *Mount, total: *u64, free: *u64) {
    if (m.kind == EXT2) {
        @total = ext2.total_space(m.fs);
        @free = ext2.free_space(m.fs);
    } or (m.kind == FAT) {
        @total = m.fatfs.clusters * m.fatfs.csize;
        @free = fat.free_clusters(m.fatfs) * m.fatfs.csize;
    } or {
        @total = m.exfs.clusters * m.exfs.csize;
        @free = exfat.free_space(m.exfs);
    }
}

pub fun kind_name(m: *Mount) *u8 {
    if (m.kind == FAT) { ret "vfat\0"; }
    if (m.kind == EXFAT) { ret "exfat\0"; }
    ret "ext2\0";
}

# whether `b` (or, for a whole disk, anything on it) is mounted
pub fun busy(b: *parts.Bdev) u8 {
    var i: u64 = 0;
    for (i < MAX) {
        val m: *Mount = ?mounts[i];
        if (m.used != 0 && m.disk == b.disk) {
            if (b.part == 0) { ret 1; }
            # a partition overlapping a mounted filesystem
            if (m.start >= b.start && m.start < b.start + b.count) { ret 1; }
        }
        i = i + 1;
    }
    ret 0;
}
