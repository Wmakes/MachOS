# mount DEV DIR: mount the ext2 filesystem on DEV (e.g. /dev/sdb2) on DIR

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc != 3) {
        io.err("usage: mount DEV DIR\n\0");
        ret 2;
    }
    val r: u64 = sys.mount(argv[1], io.len(argv[1]), argv[2], io.len(argv[2]));
    if (abi.is_err(r) != 0) {
        io.fail("mount\0", argv[1], r);
        ret 1;
    }
    ret 0;
}
