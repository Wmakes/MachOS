use settings: sdk.settings;
# sh: the MachOS shell.
#   words, 'single' and "double" quotes, \escapes, # comments,
#   $? (last status), $0-$9 and $# (script arguments), $$ (the shell's pid),
#   $NAME and ${NAME} (variables), ~ (home), $(command) (its output)
#   NAME=value  set a variable; NAME=value cmd  run cmd with it in its environment
#   builtins: cd pwd exit jobs fg bg wait export unset set history time
#   job control: ^Z stops the foreground job; fg / bg [N] continue it
#   a | b | c        pipelines
#   < f  > f  >> f   redirections, also N< f  N> f  N>> f  N>&M  N>&-  (fds 0-9)
#   a ; b   a && b   a || b   a &   sequencing, conditionals, background
#   on a terminal: line editing, history and tab completion (sh/edit.mach)
# usage: sh                 interactive on the console
#        sh FILE            run the commands in FILE
#        sh -c 'COMMANDS'   run COMMANDS

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;
use edit: userland.sh.edit;
use env:  sdk.env;
use path: sdk.path;
use users: sdk.users;

val T_WORD:   u8 = 1;
val T_PIPE:   u8 = 2;
val T_IN:     u8 = 3;
val T_OUT:    u8 = 4;
val T_APPEND: u8 = 5;
val T_SEMI:   u8 = 6;
val T_AND:    u8 = 7;
val T_OR:     u8 = 8;
val T_BG:     u8 = 9;
val T_DUP:    u8 = 10; # N>&M or N<&M (ts holds N; the next word is M or -)

val MAX_TOK:  u64 = 128;
val WBUF:     u64 = 4096;
val MAX_CMDS: u64 = 8;
val MAX_BG:   u64 = 16;
val NONE:     u64 = 0xFFFFFFFFFFFFFFFF;
val STATUS_MARK: u8 = 1; # stands for $? inside a word until it runs
val PARAM_MARK:  u8 = 2; # followed by '0'-'9' or '#': $N / $#
val VAR_MARK:    u8 = 3; # $NAME: VAR_MARK, the name, VAR_END
val VAR_END:     u8 = 4;
val PID_MARK:    u8 = 5; # $$
val HOME_MARK:   u8 = 6; # a leading ~
val CMD_MARK:    u8 = 7; # $(command): CMD_MARK, the command, CMD_END
val CMD_END:     u8 = 8;
val BG_MARK:     u8 = 14; # $!: the last asynchronous pipeline
var last_background: u64 = 0;

var tk: [128]u8;  # token kinds
var ts: [128]u64; # word start in wbuf
var tl: [128]u64; # word length
var ntok: u64 = 0;
var wbuf: [4096]u8;
var wlen: u64 = 0;
var overflow: u8 = 0;

var status: u64 = 0;
# jobs: pipelines started in the background or stopped with ^Z
rec Job {
    used:    u8;
    id:      u64;
    group:   u64;
    npids:   u64;
    pids:    [8]u64;
    done:    [8]u8;
    stopped: u8;
    tlen:    u64;
    text:    [64]u8;
}

var jobs: [16]Job;
var line_text: [1024]u8; # the line being run, for job listings
var line_text_len: u64 = 0;
var quit: u8 = 0;
var params: **u8 = nil; # $0 $1 ... (a script's path and arguments)

# variables that are not exported (exported ones live in sdk.env)
val NVARS: u64 = 64;
var var_names: [64][32]u8;
var var_name_len: [64]u64;
var var_vals: [64][256]u8;
var var_val_len: [64]u64;
var nvars: u64 = 0;

fun local_find(name: *u8, n: u64) u64 {
    var i: u64 = 0;
    for (i < nvars) {
        if (io.eq(?var_names[i][0], var_name_len[i], name, n) != 0) { ret i; }
        i = i + 1;
    }
    ret NVARS;
}

fun local_unset(name: *u8, n: u64) {
    val i: u64 = local_find(name, n);
    if (i == NVARS) { ret; }
    var k: u64 = i;
    for (k + 1 < nvars) {
        io.copy(?var_names[k][0], ?var_names[k + 1][0], 32);
        var_name_len[k] = var_name_len[k + 1];
        io.copy(?var_vals[k][0], ?var_vals[k + 1][0], 256);
        var_val_len[k] = var_val_len[k + 1];
        k = k + 1;
    }
    nvars = nvars - 1;
}

# a variable's value (n bytes in *len), shell variables first, or nil
fun var_get(name: *u8, n: u64, len: *u64) *u8 {
    val i: u64 = local_find(name, n);
    if (i != NVARS) {
        @len = var_val_len[i];
        ret ?var_vals[i][0];
    }
    val v: *u8 = env.getn(name, n);
    if (v == nil) { ret nil; }
    @len = io.len(v);
    ret v;
}

# NAME=value: an exported variable stays exported, others are the shell's
fun var_set(name: *u8, n: u64, val_: *u8, vn: u64) {
    if (env.getn(name, n) != nil) {
        env.setn(name, n, val_, vn);
        ret;
    }
    var i: u64 = local_find(name, n);
    if (i == NVARS) {
        if (nvars == NVARS || n > 31) { ret; }
        i = nvars;
        nvars = nvars + 1;
        io.copy(?var_names[i][0], name, n);
        var_name_len[i] = n;
    }
    var k: u64 = vn;
    if (k > 255) { k = 255; }
    io.copy(?var_vals[i][0], val_, k);
    var_val_len[i] = k;
}

fun name_char(c: u8, first: u8) u8 {
    if ((c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) { ret 1; }
    if (first == 0 && c >= 48 && c <= 57) { ret 1; }
    ret 0;
}

# the length of NAME in a NAME=value word (raw bytes), or 0
fun assignment(w: *u8, n: u64) u64 {
    if (n == 0 || name_char(w[0], 1) == 0) { ret 0; }
    var i: u64 = 1;
    for (i < n && name_char(w[i], 0) != 0) { i = i + 1; }
    if (i < n && w[i] == 61) { ret i; }
    ret 0;
}
var nparams: u64 = 0;
var interactive: u8 = 0;

fun is_space(c: u8) u8 {
    if (c == 32 || c == 9 || c == 10 || c == 13) { ret 1; }
    ret 0;
}

fun is_special(c: u8) u8 {
    if (c == 124 || c == 60 || c == 62 || c == 59 || c == 38) { ret 1; }
    ret 0;
}

fun push(c: u8) {
    if (wlen + 1 >= WBUF) {
        overflow = 1;
        ret;
    }
    wbuf[wlen] = c;
    wlen = wlen + 1;
}

fun add(kind: u8, start: u64, n: u64) u8 {
    if (ntok == MAX_TOK) { ret 0; }
    tk[ntok] = kind;
    ts[ntok] = start;
    tl[ntok] = n;
    ntok = ntok + 1;
    ret 1;
}

fun word(t: u64) *u8 { ret ?wbuf[ts[t]]; }

# copy word `t` into out[0..cap) with $? replaced by the current status;
# returns the length (NUL written after it), or NONE if it does not fit
fun expand(t: u64, out: *u8, cap: u64) u64 {
    val w: *u8 = word(t);
    var n: u64 = 0;
    var i: u64 = 0;
    for (i < tl[t]) {
        if (w[i] == STATUS_MARK) {
            var num: [20]u8;
            val k: u64 = io.fmt_dec(status, ?num[0]);
            if (n + k >= cap) { ret NONE; }
            io.copy(?out[n], ?num[0], k);
            n = n + k;
        } or (w[i] == CMD_MARK) {
            val cs: u64 = i + 1;
            var ce: u64 = cs;
            for (ce < tl[t] && w[ce] != CMD_END) { ce = ce + 1; }
            val got: u64 = substitute(?w[cs], ce - cs, ?out[n], cap - n);
            if (got == NONE) { ret NONE; }
            n = n + got;
            i = ce;
        } or (w[i] == VAR_MARK) {
            val ns: u64 = i + 1;
            var ne: u64 = ns;
            for (ne < tl[t] && w[ne] != VAR_END) { ne = ne + 1; }
            var vl: u64 = 0;
            val v: *u8 = var_get(?w[ns], ne - ns, ?vl);
            if (v != nil) {
                if (n + vl >= cap) { ret NONE; }
                io.copy(?out[n], v, vl);
                n = n + vl;
            }
            i = ne;
        } or (w[i] == BG_MARK) {
            if (last_background != 0) {
                var num: [20]u8;
                val k: u64 = io.fmt_dec(last_background, ?num[0]);
                if (n + k >= cap) { ret NONE; }
                io.copy(?out[n], ?num[0], k);
                n = n + k;
            }
        } or (w[i] == PID_MARK) {
            var num: [20]u8;
            val k: u64 = io.fmt_dec(sys.getpid(), ?num[0]);
            if (n + k >= cap) { ret NONE; }
            io.copy(?out[n], ?num[0], k);
            n = n + k;
        } or (w[i] == HOME_MARK) {
            var vl: u64 = 0;
            var v: *u8 = var_get("HOME\0", 4, ?vl);
            if (v == nil) {
                v = "/\0";
                vl = 1;
            }
            if (n + vl >= cap) { ret NONE; }
            io.copy(?out[n], v, vl);
            n = n + vl;
        } or (w[i] == PARAM_MARK && i + 1 < tl[t]) {
            i = i + 1;
            var num: [20]u8;
            var src: *u8 = ?num[0];
            var k: u64 = 0;
            if (w[i] == 35) { # $#: arguments after $0
                var c: u64 = 0;
                if (nparams > 0) { c = nparams - 1; }
                k = io.fmt_dec(c, ?num[0]);
            } or ((w[i] - 48)::u64 < nparams) {
                src = params[(w[i] - 48)::u64];
                k = io.len(src);
            }
            if (n + k >= cap) { ret NONE; }
            io.copy(?out[n], src, k);
            n = n + k;
        } or {
            if (n + 1 >= cap) { ret NONE; }
            out[n] = w[i];
            n = n + 1;
        }
        i = i + 1;
    }
    out[n] = 0;
    ret n;
}

var dollar_end: u64 = 0;

# a $ expansion at line[i] (line[i] == '$'): pushes its markers and returns
# the index after it (also left in dollar_end), or i when what follows is
# not an expansion (then nothing is pushed)
fun dollar(line: *u8, n: u64, i: u64) u64 {
    dollar_end = scan_dollar(line, n, i);
    ret dollar_end;
}

fun scan_dollar(line: *u8, n: u64, i: u64) u64 {
    if (i + 1 >= n) { ret i; }
    val c: u8 = line[i + 1];
    if (c == 40) { # $(command), nested parentheses and quotes respected
        var depth: u64 = 1;
        var k: u64 = i + 2;
        var quote: u8 = 0;
        for (k < n && depth > 0) {
            val d: u8 = line[k];
            if (quote != 0) {
                if (d == quote) { quote = 0; }
            } or (d == 39 || d == 34) {
                quote = d;
            } or (d == 40) {
                depth = depth + 1;
            } or (d == 41) {
                depth = depth - 1;
            }
            k = k + 1;
        }
        if (depth != 0) { ret i; }
        push(CMD_MARK);
        var j: u64 = i + 2;
        for (j < k - 1) {
            push(line[j]);
            j = j + 1;
        }
        push(CMD_END);
        ret k;
    }
    if (c == 33) { push(BG_MARK); ret i + 2; }
    if (c == 63) {
        push(STATUS_MARK);
        ret i + 2;
    }
    if (c == 36) {
        push(PID_MARK);
        ret i + 2;
    }
    if ((c >= 48 && c <= 57) || c == 35) {
        push(PARAM_MARK);
        push(c);
        ret i + 2;
    }
    if (c == 123) { # ${NAME}
        var k: u64 = i + 2;
        for (k < n && line[k] != 125) { k = k + 1; }
        if (k >= n || k == i + 2) { ret i; }
        push(VAR_MARK);
        var j: u64 = i + 2;
        for (j < k) {
            push(line[j]);
            j = j + 1;
        }
        push(VAR_END);
        ret k + 1;
    }
    if (name_char(c, 1) != 0) {
        push(VAR_MARK);
        var k: u64 = i + 1;
        for (k < n && name_char(line[k], 0) != 0) {
            push(line[k]);
            k = k + 1;
        }
        push(VAR_END);
        ret k;
    }
    ret i;
}

# run `cmd` (n bytes) in a forked copy of this shell (so it sees every
# variable and $1...), its output into out (at most cap - 1 bytes, trailing
# newlines dropped); the length, or NONE if it does not fit
fun substitute(cmd: *u8, n: u64, out: *u8, cap: u64) u64 {
    var ends: [2]u64;
    if (abi.is_err(sys.pipe(?ends)) != 0) { ret 0; }
    val pid: u64 = sys.fork();
    if (pid == 0) {
        sys.close(ends[0]);
        sys.dup2(ends[1], abi.STDOUT);
        sys.close(ends[1]);
        var text: [1024]u8;
        var k: u64 = n;
        if (k > 1024) { k = 1024; }
        io.copy(?text[0], cmd, k);
        interactive = 0;
        run_string(?text[0], k);
        sys.exit(status);
    }
    sys.close(ends[1]);
    var got: u64 = 0;
    var too_long: u8 = 0;
    for {
        var chunk: [512]u8;
        val r: u64 = sys.read(ends[0], ?chunk[0], 512);
        if (abi.is_err(r) != 0 || r == 0) { brk; }
        if (got + r >= cap) {
            too_long = 1;
            cnt; # keep draining so the child can finish
        }
        io.copy(?out[got], ?chunk[0], r);
        got = got + r;
    }
    sys.close(ends[0]);
    if (abi.is_err(pid) == 0) { sys.wait(pid); }
    if (too_long != 0) { ret NONE; }
    for (got > 0 && out[got - 1] == 10) { got = got - 1; }
    ret got;
}

fun syntax(msg: *u8) u8 {
    io.emsg("sh: \0");
    io.err(msg);
    io.emsg("\n\0");
    status = 2;
    ret 0;
}

# split line[0..n] into tokens; 0 (after printing why) if it is malformed
fun lex(line: *u8, n: u64) u8 {
    ntok = 0;
    wlen = 0;
    overflow = 0;
    var i: u64 = 0;
    for (i < n) {
        val c: u8 = line[i];
        if (is_space(c) != 0) {
            i = i + 1;
            cnt;
        }
        if (c == 35) { brk; } # comment
        # a redirection's fd: digits right before < or >
        var c2: u8 = c;
        var fd: u64 = NONE;
        if (c >= 48 && c <= 57) {
            var k: u64 = i;
            var num: u64 = 0;
            for (k < n && line[k] >= 48 && line[k] <= 57) {
                num = num * 10 + (line[k] - 48)::u64;
                k = k + 1;
            }
            if (k < n && (line[k] == 60 || line[k] == 62) && num < 10) {
                fd = num;
                i = k;
                c2 = line[i];
            }
        }
        var next: u8 = 0;
        if (i + 1 < n) { next = line[i + 1]; }
        var op: u8 = 0;
        var oplen: u64 = 1;
        if (c == 124) {
            op = T_PIPE;
            if (next == 124) { op = T_OR; oplen = 2; }
        } or (c == 38) {
            op = T_BG;
            if (next == 38) { op = T_AND; oplen = 2; }
        } or (c == 59) {
            op = T_SEMI;
        } or (c2 == 60) {
            op = T_IN;
            if (fd == NONE) { fd = 0; }
            if (next == 38) { op = T_DUP; oplen = 2; }
        } or (c2 == 62) {
            op = T_OUT;
            if (fd == NONE) { fd = 1; }
            if (next == 62) { op = T_APPEND; oplen = 2; }
            or (next == 38) { op = T_DUP; oplen = 2; }
        }
        if (op != 0) {
            if (add(op, fd, 0) == 0) { ret syntax("too many words\0"); }
            i = i + oplen;
            cnt;
        }

        val start: u64 = wlen;
        for (i < n && is_space(line[i]) == 0 && is_special(line[i]) == 0) {
            val d: u8 = line[i];
            if (d == 39) { # 'literal'
                i = i + 1;
                for (i < n && line[i] != 39) {
                    push(line[i]);
                    i = i + 1;
                }
                if (i >= n) { ret syntax("unterminated '\0"); }
                i = i + 1;
            } or (d == 34) { # "with \escapes and $?"
                i = i + 1;
                for (i < n && line[i] != 34) {
                    if (line[i] == 36) {
                        val after: u64 = dollar(line, n, i);
                        if (after != i) {
                            i = after;
                            cnt;
                        }
                    }
                    # in double quotes a backslash only escapes $ ` " and \ (POSIX)
                    if (line[i] == 92 && i + 1 < n &&
                        (line[i + 1] == 36 || line[i + 1] == 96 || line[i + 1] == 34 || line[i + 1] == 92)) {
                        i = i + 1;
                    }
                    push(line[i]);
                    i = i + 1;
                }
                if (i >= n) { ret syntax("unterminated \"\0"); }
                i = i + 1;
            } or (d == 92 && i + 1 < n) {
                push(line[i + 1]);
                i = i + 2;
            } or (d == 36 && dollar(line, n, i) != i) { # expanded when it runs
                i = dollar_end;
            } or (d == 126 && wlen == start && (i + 1 >= n || line[i + 1] == 47 || is_space(line[i + 1]) != 0 || is_special(line[i + 1]) != 0)) {
                push(HOME_MARK); # a leading ~
                i = i + 1;
            } or {
                push(d);
                i = i + 1;
            }
        }
        val wl: u64 = wlen - start;
        push(0);
        if (add(T_WORD, start, wl) == 0) { ret syntax("too many words\0"); }
    }
    if (overflow != 0) { ret syntax("line too long\0"); }
    ret 1;
}

fun write_to(h: u64, s: *u8) { io.write_all(h, s, io.len(s)); }

fun cwd(buf: *u8, cap: u64) u64 {
    val n: u64 = sys.getcwd(buf, cap);
    if (abi.is_err(n) != 0 || n > cap) { ret 0; }
    ret n;
}

# run a builtin if `name` is one; returns 0 if it is not
fun builtin(name: *u8, argc: u64, args: **u8, out: u64) u8 {
    if (io.streq(name, "cd\0") != 0) {
        var dir: *u8 = env.get("HOME\0");
        if (dir == nil) { dir = "/\0"; }
        if (argc > 1) { dir = args[1]; }
        val r: u64 = sys.chdir(dir, io.len(dir));
        if (abi.is_err(r) != 0) {
            io.fail("cd\0", dir, r);
            status = 1;
        } or {
            status = 0;
        }
        ret 1;
    }
    if (io.streq(name, "pwd\0") != 0) {
        var buf: [256]u8;
        val n: u64 = cwd(?buf[0], 256);
        io.write_all(out, ?buf[0], n);
        write_to(out, "\n\0");
        status = 0;
        ret 1;
    }
    if (io.streq(name, "exit\0") != 0) {
        var code: u64 = status;
        if (argc > 1) {
            var okk: u8 = 0;
            code = io.parse_dec(args[1], io.len(args[1]), ?okk);
        }
        status = code;
        quit = 1;
        ret 1;
    }
    if (io.streq(name, "export\0") != 0) {
        if (argc == 1) {
            var i: u64 = 0;
            for (i < env.size()) {
                write_to(out, "export \0");
                write_to(out, env.nth(i));
                write_to(out, "\n\0");
                i = i + 1;
            }
        }
        var a: u64 = 1;
        for (a < argc) {
            val w: *u8 = args[a];
            val wn: u64 = io.len(w);
            val eq: u64 = assignment(w, wn);
            if (eq != 0) {
                local_unset(w, eq);
                env.setn(w, eq, ?w[eq + 1], wn - eq - 1);
            } or {
                # export an existing shell variable as it is
                val li: u64 = local_find(w, wn);
                if (li != NVARS) {
                    env.setn(w, wn, ?var_vals[li][0], var_val_len[li]);
                    local_unset(w, wn);
                }
            }
            a = a + 1;
        }
        status = 0;
        ret 1;
    }
    if (io.streq(name, "unset\0") != 0) {
        var a: u64 = 1;
        for (a < argc) {
            local_unset(args[a], io.len(args[a]));
            env.unset(args[a]);
            a = a + 1;
        }
        status = 0;
        ret 1;
    }
    if (io.streq(name, "set\0") != 0) {
        var i: u64 = 0;
        for (i < nvars) {
            io.write_all(out, ?var_names[i][0], var_name_len[i]);
            write_to(out, "=\0");
            io.write_all(out, ?var_vals[i][0], var_val_len[i]);
            write_to(out, "\n\0");
            i = i + 1;
        }
        i = 0;
        for (i < env.size()) {
            write_to(out, env.nth(i));
            write_to(out, "\n\0");
            i = i + 1;
        }
        status = 0;
        ret 1;
    }
    if (io.streq(name, "history\0") != 0) {
        val total: u64 = edit.history_count();
        var i: u64 = 0;
        for (i < total) {
            var n: u64 = 0;
            val e: *u8 = edit.history_entry(i, ?n);
            var num: [20]u8;
            val k: u64 = io.fmt_dec(i + 1, ?num[0]);
            var pad: u64 = k;
            for (pad < 5) {
                write_to(out, " \0");
                pad = pad + 1;
            }
            io.write_all(out, ?num[0], k);
            write_to(out, "  \0");
            io.write_all(out, e, n);
            write_to(out, "\n\0");
            i = i + 1;
        }
        status = 0;
        ret 1;
    }
    if (io.streq(name, "time\0") != 0) { # time COMMAND...: how long it took
        if (argc < 2) {
            status = 0;
            ret 1;
        }
        var text: [1024]u8;
        var tl: u64 = 0;
        var a: u64 = 1;
        for (a < argc) {
            val n: u64 = io.len(args[a]);
            if (tl + n + 1 >= 1024) { brk; }
            io.copy(?text[tl], args[a], n);
            tl = tl + n;
            text[tl] = 32;
            tl = tl + 1;
            a = a + 1;
        }
        var inf: abi.Info;
        sys.info(?inf);
        val t0: u64 = inf.uptime_ms;
        val pid: u64 = sys.fork();
        if (pid == 0) {
            interactive = 0;
            run_string(?text[0], tl);
            sys.exit(status);
        }
        if (abi.is_err(pid) == 0) { status = sys.wait(pid); }
        sys.info(?inf);
        val ms: u64 = inf.uptime_ms - t0;
        # on stderr, so it does not mix with the command's output
        var tb: [40]u8;
        var tk: u64 = io.fmt_dec(ms / 1000, ?tb[0]);
        tb[tk] = 46;
        tb[tk + 1] = 48 + ((ms / 100) % 10)::u8;
        tb[tk + 2] = 48 + ((ms / 10) % 10)::u8;
        tb[tk + 3] = 48 + (ms % 10)::u8;
        tb[tk + 4] = 115;
        tb[tk + 5] = 10;
        io.emsg("\nreal  \0");
        io.errn(?tb[0], tk + 6);
        ret 1;
    }
    if (io.streq(name, "wait\0") != 0) { # every background job (not the stopped)
        var i: u64 = 0;
        status = 0;
        for (i < MAX_BG) {
            val j: *Job = ?jobs[i];
            if (j.used != 0 && j.stopped == 0) {
                var k: u64 = 0;
                for (k < j.npids) {
                    if (j.done[k] == 0) {
                        var st: u64 = 0;
                        val r: u64 = sys.waitpid(j.pids[k], ?st, 0);
                        if (r == j.pids[k]) { status = abi.wexitstatus(st); }
                        j.done[k] = 1;
                    }
                    k = k + 1;
                }
                j.used = 0;
            }
            i = i + 1;
        }
        ret 1;
    }
    if (io.streq(name, "jobs\0") != 0) {
        var i: u64 = 0;
        for (i < MAX_BG) {
            val j: *Job = ?jobs[i];
            if (j.used != 0) {
                if (j.stopped != 0) { job_line(out, j, "Stopped\0"); }
                or                  { job_line(out, j, "Running\0"); }
            }
            i = i + 1;
        }
        status = 0;
        ret 1;
    }
    if (io.streq(name, "fg\0") != 0 || io.streq(name, "bg\0") != 0) {
        val j: *Job = pick_job(argc, args);
        if (j == nil) {
            io.err(name);
            io.emsg(": no such job\n\0");
            status = 1;
            ret 1;
        }
        if (name[0] == 102) { # fg
            io.outn(?j.text[0], j.tlen);
            io.putc(10);
            if (j.stopped != 0) {
                j.stopped = 0;
                sys.killpg(j.group, abi.SIGCONT);
            }
            wait_job(j);
        } or {
            if (j.stopped != 0) {
                j.stopped = 0;
                sys.killpg(j.group, abi.SIGCONT);
            }
            job_line(out, j, "Running\0");
            status = 0;
        }
        ret 1;
    }
    ret 0;
}

fun job_line(out: u64, j: *Job, state: *u8) {
    var num: [20]u8;
    write_to(out, "[\0");
    io.write_all(out, ?num[0], io.fmt_dec(j.id, ?num[0]));
    write_to(out, "]  \0");
    write_to(out, state);
    write_to(out, "  \0");
    io.write_all(out, ?j.text[0], j.tlen);
    write_to(out, "\n\0");
}

# the job a fg/bg argument names (N or %N), or the newest one
fun pick_job(argc: u64, args: **u8) *Job {
    var want: u64 = 0;
    if (argc > 1) {
        var a: *u8 = args[1];
        if (a[0] == 37) { a = ?a[1]; }
        var okk: u8 = 0;
        want = io.parse_dec(a, io.len(a), ?okk);
        if (okk == 0) { ret nil; }
    }
    var best: *Job = nil;
    var i: u64 = 0;
    for (i < MAX_BG) {
        val j: *Job = ?jobs[i];
        if (j.used != 0) {
            if (want != 0 && j.id == want) { ret j; }
            if (want == 0 && (best == nil || j.id > best.id)) { best = j; }
        }
        i = i + 1;
    }
    ret best;
}

fun job_new(group: u64, pids: *u64, n: u64) *Job {
    var id: u64 = 1;
    var taken: u8 = 1;
    for (taken != 0) {
        taken = 0;
        var i: u64 = 0;
        for (i < MAX_BG) {
            if (jobs[i].used != 0 && jobs[i].id == id) { taken = 1; }
            i = i + 1;
        }
        if (taken != 0) { id = id + 1; }
    }
    var i: u64 = 0;
    for (i < MAX_BG) {
        val j: *Job = ?jobs[i];
        if (j.used == 0) {
            j.used = 1;
            j.id = id;
            j.group = group;
            j.npids = n;
            j.stopped = 0;
            var k: u64 = 0;
            for (k < n) {
                j.pids[k] = pids[k];
                j.done[k] = 0;
                k = k + 1;
            }
            var t: u64 = line_text_len;
            if (t > 64) { t = 64; }
            io.copy(?j.text[0], ?line_text[0], t);
            j.tlen = t;
            ret j;
        }
        i = i + 1;
    }
    ret nil;
}

# run `j` in the foreground until it ends or stops
fun wait_job(j: *Job) {
    # (a pipeline of builtins only runs in the shell's own group, which must
    # never become the foreground: ^C would reach the shell)
    if (interactive != 0 && j.group != sys.getpgid(0)) { sys.tcsetpgrp(abi.STDIN, j.group); }
    var k: u64 = 0;
    for (k < j.npids) {
        if (j.done[k] == 0) {
            var st: u64 = 0;
            val r: u64 = sys.waitpid(j.pids[k], ?st, abi.WUNTRACED);
            if (r == j.pids[k] && abi.wifstopped(st) != 0) {
                j.stopped = 1;
                sys.tcsetpgrp(abi.STDIN, 0);
                io.putc(10);
                job_line(abi.STDOUT, j, "Stopped\0");
                status = 128 + abi.wstopsig(st);
                ret;
            }
            j.done[k] = 1;
            if (k + 1 == j.npids) {
                if (abi.is_err(r) != 0) { status = 1; }
                or (abi.wifexited(st) != 0) { status = abi.wexitstatus(st); }
                or { status = 128 + abi.wtermsig(st); }
            }
        }
        k = k + 1;
    }
    j.used = 0;
    if (interactive != 0) { sys.tcsetpgrp(abi.STDIN, 0); }
}

fun is_builtin(name: *u8) u8 {
    if (io.streq(name, "cd\0") != 0 || io.streq(name, "pwd\0") != 0 ||
        io.streq(name, "exit\0") != 0 || io.streq(name, "jobs\0") != 0 || io.streq(name, "wait\0") != 0 ||
        io.streq(name, "history\0") != 0 || io.streq(name, "time\0") != 0 ||
        io.streq(name, "fg\0") != 0 || io.streq(name, "bg\0") != 0 ||
        io.streq(name, "export\0") != 0 || io.streq(name, "unset\0") != 0 ||
        io.streq(name, "set\0") != 0) { ret 1; }
    ret 0;
}

# "/bin/" + name unless name already has a slash; 0 if it does not exist
# where `name` runs from (see sdk.path); 0 if nowhere
fun resolve(name: *u8, out: *u8) u64 { ret path.lookup(name, out); }

fun close_if(h: u64, keep: u64) {
    if (h != NONE && h != keep) { sys.close(h); }
}

# fds the shell opened for the command being set up, closed once it runs
var opened: [24]u64;
var nopened: u64 = 0;

fun opened_add(h: u64) {
    if (nopened < 24) {
        opened[nopened] = h;
        nopened = nopened + 1;
    }
}

fun opened_close() {
    var i: u64 = 0;
    for (i < nopened) {
        sys.close(opened[i]);
        i = i + 1;
    }
    nopened = 0;
}

# the handle a redirection opens, or NONE after saying why
fun redirect(kind: u8, f: *u8) u64 {
    var flags: u64 = abi.O_READ;
    if (kind == T_OUT) { flags = abi.O_WRITE | abi.O_CREATE | abi.O_TRUNC; }
    if (kind == T_APPEND) { flags = abi.O_WRITE | abi.O_CREATE | abi.O_APPEND; }
    val h: u64 = sys.open(f, io.len(f), flags);
    if (abi.is_err(h) != 0) {
        io.fail("sh\0", f, h);
        ret NONE;
    }
    ret h;
}

# tokens [a, b) are one pipeline
fun run_pipeline(a: u64, b: u64, background: u8) {
    var cs: [8]u64;
    var ce: [8]u64;
    var k: u64 = 0;
    var s: u64 = a;
    var t: u64 = a;
    for (t <= b) {
        if (t == b || tk[t] == T_PIPE) {
            if (k == MAX_CMDS) { syntax("pipeline too long\0"); ret; }
            if (t == s) { syntax("empty command\0"); ret; }
            cs[k] = s;
            ce[k] = t;
            k = k + 1;
            s = t + 1;
        }
        t = t + 1;
    }

    var pids: [8]u64;
    var spawned: u64 = 0;
    var group: u64 = 0;
    var prev_read: u64 = NONE;
    var c: u64 = 0;
    for (c < k) {
        # the command's fds 0-9, as shell fds: start from the shell's own 0-2
        var fds: [10]u64;
        var f: u64 = 0;
        for (f < 10) {
            fds[f] = abi.FD_NONE;
            f = f + 1;
        }
        fds[0] = abi.STDIN;
        fds[1] = abi.STDOUT;
        fds[2] = abi.STDERR;
        nopened = 0;
        if (prev_read != NONE) {
            fds[0] = prev_read;
            opened_add(prev_read);
        }
        var next_read: u64 = NONE;
        if (c + 1 < k) {
            var ends: [2]u64;
            val r: u64 = sys.pipe(?ends);
            if (abi.is_err(r) != 0) {
                io.fail("sh\0", "pipe\0", r);
                opened_close();
                brk;
            }
            fds[1] = ends[1];
            opened_add(ends[1]);
            next_read = ends[0];
        }

        # arguments, NAME=value assignments before them, and redirections
        var args: [32]*u8;
        var argc: u64 = 0;
        var abuf: [2048]u8;
        var alen: u64 = 0;
        var bad: u8 = 0;
        var nassign: u64 = 0;
        var assign_at: [16]u64;  # where each "NAME=value" sits in abuf
        var assign_eq: [16]u64;  # the length of its NAME
        var u: u64 = cs[c];
        for (u < ce[c] && bad == 0) {
            if (tk[u] == T_WORD && argc == 0 && nassign < 16 && assignment(word(u), tl[u]) != 0) {
                val wl: u64 = expand(u, ?abuf[alen], 2048 - alen);
                if (wl == NONE) {
                    syntax("too many arguments\0");
                    bad = 1;
                    brk;
                }
                assign_at[nassign] = alen;
                assign_eq[nassign] = assignment(?abuf[alen], wl);
                nassign = nassign + 1;
                alen = alen + wl + 1;
                u = u + 1;
                cnt;
            }
            if (tk[u] == T_WORD) {
                val wl: u64 = expand(u, ?abuf[alen], 2048 - alen);
                if (argc == 31 || wl == NONE) {
                    syntax("too many arguments\0");
                    bad = 1;
                    brk;
                }
                args[argc] = ?abuf[alen];
                argc = argc + 1;
                alen = alen + wl + 1;
                u = u + 1;
                cnt;
            }
            if (u + 1 >= ce[c] || tk[u + 1] != T_WORD) {
                syntax("redirection needs a file name or fd\0");
                bad = 1;
                brk;
            }
            var fname: [256]u8;
            if (expand(u + 1, ?fname[0], 256) == NONE) {
                syntax("file name too long\0");
                bad = 1;
                brk;
            }
            val target: u64 = ts[u];
            if (tk[u] == T_DUP) {
                if (fname[0] == 45 && fname[1] == 0) { # N>&-  closes N
                    fds[target] = abi.FD_NONE;
                } or {
                    var okk: u8 = 0;
                    val from: u64 = io.parse_dec(?fname[0], io.len(?fname[0]), ?okk);
                    if (okk == 0 || from >= 10 || fds[from] == abi.FD_NONE) {
                        io.emsg("sh: \0");
                        io.err(?fname[0]);
                        io.emsg(": bad file descriptor\n\0");
                        status = 1;
                        bad = 1;
                        brk;
                    }
                    fds[target] = fds[from];
                }
                u = u + 2;
                cnt;
            }
            val h: u64 = redirect(tk[u], ?fname[0]);
            if (h == NONE) {
                status = 1;
                bad = 1;
                brk;
            }
            opened_add(h);
            fds[target] = h;
            u = u + 2;
        }
        args[argc] = nil;
        if (bad == 0 && argc == 0 && nassign > 0 && k == 1) {
            # only assignments: they set shell variables
            var q: u64 = 0;
            for (q < nassign) {
                val w: *u8 = ?abuf[assign_at[q]];
                val eq: u64 = assign_eq[q];
                var vl: u64 = io.len(w);
                var_set(w, eq, ?w[eq + 1], vl - eq - 1);
                q = q + 1;
            }
            status = 0;
            opened_close();
            ret;
        }
        if (bad == 0 && argc == 0) {
            syntax("missing command\0");
            bad = 1;
        }

        if (bad == 0 && k == 1 && background == 0 && is_builtin(args[0]) != 0) {
            var out: u64 = fds[1];
            if (out == abi.FD_NONE) { out = abi.STDOUT; }
            builtin(args[0], argc, ?args[0], out);
            opened_close();
            ret;
        }

        # a builtin in a pipeline or the background runs in a forked copy of
        # the shell, with its fds put in place by dup2
        if (bad == 0 && is_builtin(args[0]) != 0) {
            val pid: u64 = sys.fork();
            if (pid == 0) {
                f = 0;
                for (f < 10) {
                    if (fds[f] == abi.FD_NONE) { sys.close(f); }
                    or (fds[f] != f) { sys.dup2(fds[f], f); }
                    f = f + 1;
                }
                builtin(args[0], argc, ?args[0], abi.STDOUT);
                sys.exit(status);
            }
            if (abi.is_err(pid) != 0) {
                io.fail("sh\0", args[0], pid);
                status = 126;
            } or {
                pids[spawned] = pid;
                spawned = spawned + 1;
            }
            opened_close();
            prev_read = next_read;
            c = c + 1;
            cnt;
        }

        if (bad == 0) {
            var full: [256]u8;
            val fl: u64 = resolve(args[0], ?full[0]);
            if (fl == 0) {
                io.err(args[0]);
                io.emsg(": command not found\n\0");
                status = 127;
            } or {
                var g: u64 = group;
                # scripts inherit their caller's group so group termination reaches descendants
                if (interactive == 0) { g = 0; }
                or (g == 0) { g = abi.NEW_GROUP; }
                var how: abi.Spawn;
                f = 0;
                for (f < 10) {
                    how.handles[f] = fds[f];
                    f = f + 1;
                }
                how.group = g;
                how.map_fds = 1;
                how.env = nil;
                how.env_len = 0;
                # NAME=value before the command: in its environment only
                var envbuf: [16384]u8;
                if (nassign > 0) {
                    var saved: [16][256]u8;
                    var had: [16]u64; # old value length + 1, 0 when unset
                    var q: u64 = 0;
                    for (q < nassign) {
                        val w: *u8 = ?abuf[assign_at[q]];
                        val eq: u64 = assign_eq[q];
                        val old: *u8 = env.getn(w, eq);
                        had[q] = 0;
                        if (old != nil) {
                            var ol: u64 = io.len(old);
                            if (ol > 255) { ol = 255; }
                            io.copy(?saved[q][0], old, ol);
                            had[q] = ol + 1;
                        }
                        env.setn(w, eq, ?w[eq + 1], io.len(w) - eq - 1);
                        q = q + 1;
                    }
                    how.env_len = env.pack(?envbuf[0], 16384);
                    how.env = ?envbuf[0];
                    q = nassign;
                    for (q > 0) {
                        q = q - 1;
                        val w: *u8 = ?abuf[assign_at[q]];
                        if (had[q] != 0) { env.setn(w, assign_eq[q], ?saved[q][0], had[q] - 1); }
                        or               { env.unsetn(w, assign_eq[q]); }
                    }
                }
                var astart: u64 = 0;
                if (nassign > 0) { astart = assign_at[nassign - 1] + io.len(?abuf[assign_at[nassign - 1]]) + 1; }
                val pid: u64 = sys.spawn(?full[0], fl, ?abuf[astart], alen - astart, ?how);
                if (abi.is_err(pid) != 0) {
                    io.fail("sh\0", args[0], pid);
                    status = 126;
                } or {
                    pids[spawned] = pid;
                    spawned = spawned + 1;
                    if (interactive != 0 && group == 0) { group = pid; }
                }
            }
        }
        # the children hold their own references now
        opened_close();
        prev_read = next_read;
        c = c + 1;
    }
    close_if(prev_read, NONE);
    if (spawned == 0) { ret; }

    var g: u64 = group;
    if (g == 0) { g = sys.getpgid(0); } # only builtins: they stay in my group
    val j: *Job = job_new(g, ?pids[0], spawned);
    if (j == nil) { # no room in the table: just wait for them
        var i: u64 = 0;
        for (i < spawned) {
            val r: u64 = sys.wait(pids[i]);
            if (i + 1 == spawned && abi.is_err(r) == 0) { status = r; }
            i = i + 1;
        }
        ret;
    }
    if (background != 0) {
        last_background = pids[spawned - 1];
        if (interactive != 0) {
            io.msg("[\0");
            io.dec(j.id);
            io.msg("] \0");
            io.dec(g);
            io.putc(10);
        }
        status = 0;
        ret;
    }
    wait_job(j);
}

# run every pipeline of the tokenized line, honouring ; && || &
fun run_line() {
    var i: u64 = 0;
    var prev: u8 = T_SEMI;
    for (i < ntok && quit == 0) {
        var j: u64 = i;
        for (j < ntok && tk[j] != T_SEMI && tk[j] != T_AND && tk[j] != T_OR && tk[j] != T_BG) {
            j = j + 1;
        }
        var conn: u8 = T_SEMI;
        if (j < ntok) { conn = tk[j]; }
        if (j == i) {
            syntax("empty command\0");
            ret;
        }
        var go: u8 = 1;
        if (prev == T_AND && status != 0) { go = 0; }
        if (prev == T_OR && status == 0) { go = 0; }
        if (go != 0) {
            var background: u8 = 0;
            if (conn == T_BG) { background = 1; }
            run_pipeline(i, j, background);
        }
        prev = conn;
        i = j + 1;
    }
}

# say which background jobs finished since the last prompt
fun reap_jobs() {
    var i: u64 = 0;
    for (i < MAX_BG) {
        val j: *Job = ?jobs[i];
        if (j.used != 0 && j.stopped == 0) {
            var left: u64 = 0;
            var k: u64 = 0;
            for (k < j.npids) {
                if (j.done[k] == 0) {
                    var st: u64 = 0;
                    val r: u64 = sys.waitpid(j.pids[k], ?st, abi.WNOHANG);
                    if (r == j.pids[k] || abi.is_err(r) != 0) { j.done[k] = 1; }
                    or { left = left + 1; }
                }
                k = k + 1;
            }
            if (left == 0) {
                job_line(abi.STDOUT, j, "Done\0");
                j.used = 0;
            }
        }
        i = i + 1;
    }
}

var prompt_buf: [512]u8;

fun add_str(at: u64, s2: *u8) u64 {
    val n: u64 = io.len(s2);
    io.copy(?prompt_buf[at], s2, n);
    ret at + n;
}

var me: [32]u8; # the user's name, found once
var me_len: u64 = 0;

# "user@hostname:/cwd$ " in colour ("#" for root), NUL-terminated
fun prompt() *u8 {
    if (me_len == 0) { me_len = users.user_name(sys.geteuid(), ?me[0]); }
    var dir: [256]u8;
    val n: u64 = cwd(?dir[0], 256);
    var at: u64 = add_str(0, "\x1b[1;32m\0");
    io.copy(?prompt_buf[at], ?me[0], me_len);
    at = add_str(at + me_len, "@");
    # Read at each prompt so live hostname changes do not leave a stale name.
    var host: [64]u8;
    var host_len: u64 = 0;
    val h: u64 = sys.open("/proc/sys/kernel/hostname", 25, abi.O_READ);
    if (abi.is_err(h) == 0) {
        val r: u64 = sys.read(h, ?host[0], 63);
        sys.close(h);
        if (abi.is_err(r) == 0) {
            host_len = r;
            for (host_len > 0 && (host[host_len - 1] == 10 || host[host_len - 1] == 13)) { host_len = host_len - 1; }
        }
    }
    if (host_len == 0) { at = add_str(at, "machos"); }
    or { io.copy(?prompt_buf[at], ?host[0], host_len); at = at + host_len; }
    at = add_str(at, "\x1b[0m:\x1b[1;34m");
    io.copy(?prompt_buf[at], ?dir[0], n);
    if (sys.geteuid() == 0) { at = add_str(at + n, "\x1b[0m# \0"); }
    or                      { at = add_str(at + n, "\x1b[0m$ \0"); }
    prompt_buf[at] = 0;
    ret ?prompt_buf[0];
}

# lines from a handle: the console gives one per read, files get split
var rbuf: [4096]u8;
var rlen: u64 = 0;
var rpos: u64 = 0;
var reof: u8 = 0;

# the next line (without its newline) into `line`, or NONE at the end
fun getline(h: u64, line: *u8, cap: u64) u64 {
    var n: u64 = 0;
    for {
        if (rpos == rlen) {
            if (reof != 0) {
                if (n > 0) { ret n; }
                ret NONE;
            }
            val r: u64 = sys.read(h, ?rbuf[0], 4096);
            if (abi.is_err(r) != 0 || r == 0) {
                reof = 1;
                cnt;
            }
            rlen = r;
            rpos = 0;
        }
        val c: u8 = rbuf[rpos];
        rpos = rpos + 1;
        if (c == 10) { ret n; }
        if (n < cap) {
            line[n] = c;
            n = n + 1;
        }
    }
    ret n;
}

fun run_string(s: *u8, n: u64) {
    var t: u64 = n;
    if (t > 1024) { t = 1024; }
    io.copy(?line_text[0], s, t);
    line_text_len = t;
    if (lex(s, n) != 0) { run_line(); }
}

fun motd() {
    val h: u64 = sys.open("/etc/motd\0", 9, abi.O_READ);
    if (abi.is_err(h) != 0) { ret; }
    var buf: [512]u8;
    for {
        val r: u64 = sys.read(h, ?buf[0], 512);
        if (abi.is_err(r) != 0 || r == 0) { brk; }
        io.outn(?buf[0], r);
    }
    sys.close(h);
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    # Keep LANG available even when the shell was started by an older login
    # binary or directly in rescue mode.
    if (env.get("LANG\0") == nil) {
        var locale: [64]u8;
        if (settings.get("locale\0", ?locale[0], 64) > 0) { env.set("LANG\0", ?locale[0]); }
    }
    var src: u64 = abi.STDIN;
    if (argc > 2 && io.streq(argv[1], "-c\0") != 0) {
        run_string(argv[2], io.len(argv[2]));
        ret status;
    }
    if (argc > 1) {
        params = ?argv[1];
        nparams = argc - 1;
        src = sys.open(argv[1], io.len(argv[1]), abi.O_READ);
        if (abi.is_err(src) != 0) {
            io.fail("sh\0", argv[1], src);
            ret 127;
        }
    } or {
        interactive = 1;
        # a login shell ("-sh", from login or init) greets with /etc/motd
        if (argc > 0 && argv[0][0] == 45 && settings.yes("sh.motd\0", 1) != 0) { motd(); }
    }

    var line: [1024]u8;
    val editing: u8 = interactive & sys.isatty(abi.STDIN);
    for (quit == 0) {
        if (editing != 0) {
            reap_jobs();
            val en: u64 = edit.read_line(prompt());
            if (en == edit.EOF) {
                io.msg("exit\n\0");
                brk;
            }
            edit.remember(edit.text(), en);
            run_string(edit.text(), en);
            cnt;
        }
        if (interactive != 0) {
            reap_jobs();
            io.out(prompt());
        }
        val n: u64 = getline(src, ?line[0], 1024);
        if (n == NONE) {
            if (interactive != 0) { io.msg("exit\n\0"); }
            brk;
        }
        run_string(?line[0], n);
    }
    ret status;
}
