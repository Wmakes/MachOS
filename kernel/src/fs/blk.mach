# block devices for filesystems: a partition of an AHCI disk, read and
# written in 4 KiB blocks through a write-back cache. writes land in memory
# and are marked dirty; dirty blocks reach the disk when they are evicted,
# when sync() runs (the scheduler calls it whenever the cpu goes idle), or
# when a program asks with the SYNC call.
#
# the cache is direct mapped: block b of a partition can only live in slot
# hash(part, b), so a lookup is one comparison

use pmm:  machos.mm.pmm;
use dsk:  machos.dev.disk;
use heap: machos.mm.heap;
use mem:  machos.kern.mem;

pub val BS: u64 = 4096;
val SPB: u64 = 8;      # sectors per block
val MAX_SLOTS: u64 = 65536; # up to 256 MiB of cached blocks
val MIN_SLOTS: u64 = 2048;  # 8 MiB

pub rec Part {
    disk:    *dsk.Disk;
    start:   u64; # first sector
    sectors: u64;
}

rec Entry {
    part:  *Part;
    block: u64;
    data:  u64; # heap buffer, 0 until the slot is first used
    dirty: u8;
}

var cache: [65536]Entry;
var slots: u64 = 0;     # in use: an eighth of memory, within MIN/MAX_SLOTS
var ndirty: u64 = 0;
var reads: u64 = 0;
var writes: u64 = 0;
var failed: u64 = 0;

pub fun blocks(p: *Part) u64 { ret p.sectors / SPB; }

fun slot_of(p: *Part, b: u64) *Entry {
    if (slots == 0) {
        slots = pmm.total_pages() / 8;
        if (slots < MIN_SLOTS) { slots = MIN_SLOTS; }
        if (slots > MAX_SLOTS) { slots = MAX_SLOTS; }
    }
    ret ?cache[(b ^ (p::u64 >> 4)) % slots];
}

fun flush(e: *Entry) u8 {
    if (e.dirty == 0) { ret 1; }
    if (dsk.write(e.part.disk, e.part.start + e.block * SPB, SPB, e.data) == 0) {
        failed = failed + 1;
        ret 0;
    }
    writes = writes + 1;
    e.dirty = 0;
    ndirty = ndirty - 1;
    ret 1;
}

# the cache slot holding block `b`, filled from the disk when `load` is set
# (otherwise the caller is about to overwrite all of it); nil on error
fun entry(p: *Part, b: u64, load: u8) *Entry {
    if (b >= blocks(p)) { ret nil; }
    val e: *Entry = slot_of(p, b);
    if (e.data != 0 && e.part == p && e.block == b) { ret e; }
    if (e.data == 0) {
        e.data = heap.alloc(BS);
        if (e.data == 0) { ret nil; }
    } or (e.part != nil) {
        if (flush(e) == 0) { ret nil; }
    }
    e.part = nil;
    if (load != 0) {
        if (read_ahead(p, b, e) == 0) {
            if (dsk.read(p.disk, p.start + b * SPB, SPB, e.data) == 0) { ret nil; }
        }
        reads = reads + 1;
    }
    e.part = p;
    e.block = b;
    ret e;
}

val AHEAD: u64 = 8; # blocks fetched by one disk command
var ahead_buf: u64 = 0;

# fetch `b` and the blocks after it in one command: `b` into `e`, the
# others into their own slots when those hold nothing that needs writing.
# 0 when it could not (the caller reads `b` alone)
fun read_ahead(p: *Part, b: u64, e: *Entry) u8 {
    var n: u64 = AHEAD;
    if (b + n > blocks(p)) { n = blocks(p) - b; }
    if (n < 2) { ret 0; }
    if (ahead_buf == 0) {
        ahead_buf = heap.alloc(AHEAD * BS);
        if (ahead_buf == 0) { ret 0; }
    }
    if (dsk.read(p.disk, p.start + b * SPB, n * SPB, ahead_buf) == 0) { ret 0; }
    mem.copy(e.data, ahead_buf, BS);
    var k: u64 = 1;
    for (k < n) {
        val o: *Entry = slot_of(p, b + k);
        val same: u8 = (o.data != 0 && o.part == p && o.block == b + k)::u8;
        # never overwrite a cached copy (it may be newer) or a dirty block
        if (o != e && same == 0 && o.dirty == 0) {
            if (o.data == 0) { o.data = heap.alloc(BS); }
            if (o.data != 0) {
                mem.copy(o.data, ahead_buf + k * BS, BS);
                o.part = p;
                o.block = b + k;
            }
        }
        k = k + 1;
    }
    ret 1;
}

# block `b`'s bytes in the cache, to read or change in place (then call
# changed()); valid only until the next block operation. 0 on error
pub fun peek(p: *Part, b: u64) u64 {
    val e: *Entry = entry(p, b, 1);
    if (e == nil) { ret 0; }
    ret e.data;
}

# the block peek() returned was changed
pub fun changed(p: *Part, b: u64) {
    val e: *Entry = slot_of(p, b);
    if (e.data != 0 && e.part == p && e.block == b) { mark(e); }
}

fun mark(e: *Entry) {
    if (e.dirty == 0) {
        e.dirty = 1;
        ndirty = ndirty + 1;
    }
}

# whole block `b` into dst (BS bytes); 0 on error
pub fun read(p: *Part, b: u64, dst: u64) u8 {
    val e: *Entry = entry(p, b, 1);
    if (e == nil) { ret 0; }
    mem.copy(dst, e.data, BS);
    ret 1;
}

pub fun write(p: *Part, b: u64, src: u64) u8 {
    val e: *Entry = entry(p, b, 0);
    if (e == nil) { ret 0; }
    mem.copy(e.data, src, BS);
    mark(e);
    ret 1;
}

# byte ranges, for structures smaller than a block
pub fun read_bytes(p: *Part, off: u64, n: u64, dst: u64) u8 {
    var done: u64 = 0;
    for (done < n) {
        val at: u64 = off + done;
        var k: u64 = BS - at % BS;
        if (k > n - done) { k = n - done; }
        val e: *Entry = entry(p, at / BS, 1);
        if (e == nil) { ret 0; }
        mem.copy(dst + done, e.data + at % BS, k);
        done = done + k;
    }
    ret 1;
}

pub fun write_bytes(p: *Part, off: u64, n: u64, src: u64) u8 {
    var done: u64 = 0;
    for (done < n) {
        val at: u64 = off + done;
        var k: u64 = BS - at % BS;
        if (k > n - done) { k = n - done; }
        var load: u8 = 1;
        if (k == BS) { load = 0; }
        val e: *Entry = entry(p, at / BS, load);
        if (e == nil) { ret 0; }
        mem.copy(e.data + at % BS, src + done, k);
        mark(e);
        done = done + k;
    }
    ret 1;
}

# write every dirty block to its disk, then ask the disks to flush their own
# caches. returns 0 if any write failed
pub fun sync() u8 {
    if (ndirty == 0) { ret 1; }
    var ok: u8 = 1;
    var i: u64 = 0;
    for (i < slots && ndirty > 0) {
        val e: *Entry = ?cache[i];
        if (e.dirty != 0 && flush(e) == 0) { ok = 0; }
        i = i + 1;
    }
    i = 0;
    for (i < dsk.disk_count()) {
        dsk.flush(dsk.disk(i));
        i = i + 1;
    }
    ret ok;
}

pub fun dirty_count() u64 { ret ndirty; }
pub fun read_count() u64 { ret reads; }
pub fun write_count() u64 { ret writes; }
pub fun failed_count() u64 { ret failed; }

# write back and drop every cached block of partitions on disk `d`, so raw
# writes to the disk and later mounts see the disk as it really is
pub fun forget_disk(d: *dsk.Disk) {
    sync();
    var i: u64 = 0;
    for (i < slots) {
        val e: *Entry = ?cache[i];
        if (e.part != nil && e.part.disk == d) { e.part = nil; }
        i = i + 1;
    }
}
