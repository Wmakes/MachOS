# sync: put every pending write on the disk

use std.runtime;
use os: std.system.os;
use io: userland.lib.cli;
use std.types.size.usize;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    # syncing any file makes MachOS write everything out
    val h: i64 = io.open_read("/");
    if (h < 0) {
        io.fail("sync", nil, h);
        ret 1;
    }
    val r: i64 = os.sync_fd(h::usize);
    io.close(h);
    if (r < 0) {
        io.fail("sync", nil, r);
        ret 1;
    }
    ret 0;
}
