# id: the user and group ids of the caller, with their names

use std.runtime;
use io:     userland.lib.cli;
use system: userland.lib.system;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

use users: userland.lib.accounts;

fun show(label: *u8, id: u64, group: u8) {
    var name: [32]u8;
    io.out(label);
    io.dec(id);
    io.putc(40);
    if (group != 0) { io.outn(?name[0], users.group_name(id, ?name[0])); }
    or              { io.outn(?name[0], users.user_name(id, ?name[0])); }
    io.putc(41);
}

fun run(argc: u64, argv: **u8) u64 {
    var me: system.Proc;
    if (system.process("self", ?me) == 0) {
        io.emsg("id: /proc/self cannot be read\n");
        ret 1;
    }
    show("uid=", me.uid, 0);
    show(" gid=", me.gid, 1);
    if (me.euid != me.uid) { show(" euid=", me.euid, 0); }
    if (me.egid != me.gid) { show(" egid=", me.egid, 1); }
    io.putc(10);
    ret 0;
}
