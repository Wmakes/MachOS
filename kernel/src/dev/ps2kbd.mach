# PS/2 keyboard (scancode set 1, as the 8042 translates by default) -> tty

use cpu: machos.arch.x86_64.cpu;
use tty: machos.kern.tty;
use fbcon: machos.dev.fbcon;
use keymap: machos.dev.keymap;

var shift: u8 = 0;
var ctrl: u8 = 0;
var alt: u8 = 0;
var altgr: u8 = 0;
var caps: u8 = 0;
var extended: u8 = 0;

var present: u8 = 0;

pub fun present_now() u8 { ret present; }

# a byte waiting? never true without a controller (its status reads 0xFF)
fun waiting() u8 {
    val st: u8 = cpu.inb(0x64);
    if (st == 0xFF) { ret 0; }
    ret ((st & 1) != 0)::u8;
}

# whether there is a PS/2 controller (USB-only machines have none)
pub fun init() u8 {
    if (cpu.inb(0x64) == 0xFF) { ret 0; }
    # drop whatever the firmware left in the output buffer
    var i: u64 = 0;
    for (waiting() != 0 && i < 64) {
        cpu.inb(0x60);
        i = i + 1;
    }
    present = 1;
    ret 1;
}

# alt+left/right: the previous / next terminal
fun cycle(dir: u64) { tty.switch_to((tty.current() + dir) % tty.COUNT); }

fun key(code: u8) {
    if (code == 0x2A || code == 0x36) { shift = 1; ret; }
    if (code == 0x38) { alt = 1; ret; }
    if (alt != 0 && code >= 0x3B && code <= 0x40) { # alt+F1..F6 (ctrl too, as on Linux)
        tty.switch_to((code - 0x3B)::u64);
        ret;
    }
    if (code == 0x1D) { ctrl = 1; ret; }
    if (code == 0x3A) { caps = caps ^ 1; ret; }
    if (code == 0x01) { tty.input(27); ret; }
    if (code == 0x0E) { tty.input(127); ret; }
    if (code == 0x0F) { tty.input(9); ret; }
    if (code == 0x1C) { tty.input(10); ret; }
    var cp: u32 = keymap.character(keymap.ps2_usage(code), shift, caps, altgr);
    if (ctrl != 0) {
        if (cp <= 127) { cp = tty.control(cp::u8)::u32; }
        or             { cp = 0; }
    }
    if (cp != 0) {
        if (alt != 0) { tty.input(27); }  # alt+key: ESC first, as terminals send it
        tty.input_codepoint(cp);
    }
}

fun seq(final: u8) {
    tty.input(27);
    tty.input(91);
    tty.input(final);
}

fun tilde(n: u8) {
    tty.input(27);
    tty.input(91);
    tty.input(n);
    tty.input(126);
}

# keys behind the 0xE0 prefix: what a VT100-style terminal would send
fun special(code: u8) {
    if (code == 0x38) { altgr = 1; ret; }   # right alt (AltGr)
    if (alt != 0 && code == 0x4B) { cycle(tty.COUNT - 1); ret; }
    if (alt != 0 && code == 0x4D) { cycle(1); ret; }
    if (code == 0x48) { seq(65); }          # up     ESC [ A
    or (code == 0x50) { seq(66); }          # down   ESC [ B
    or (code == 0x4D) { seq(67); }          # right  ESC [ C
    or (code == 0x4B) { seq(68); }          # left   ESC [ D
    or (code == 0x47) { seq(72); }          # home   ESC [ H
    or (code == 0x4F) { seq(70); }          # end    ESC [ F
    or (code == 0x53) {                     # delete ESC [ 3 ~
        tty.input(27);
        tty.input(91);
        tty.input(51);
        tty.input(126);
    }
    or (code == 0x1C) { tty.input(10); }    # keypad enter
    or (code == 0x49) {                     # page up   ESC [ 5 ~, shift: scroll back
        if (shift != 0) { fbcon.view_up(); }
        or              { tilde(53); }
    }
    or (code == 0x51) {                     # page down ESC [ 6 ~
        if (shift != 0) { fbcon.view_down(); }
        or              { tilde(54); }
    }
}

pub fun irq() {
    var guard: u64 = 0;
    for (waiting() != 0 && guard < 64) {
        guard = guard + 1;
        val code: u8 = cpu.inb(0x60);
        if (code == 0xE0) { extended = 1; cnt; }
        if (extended != 0) {
            extended = 0;
            if ((code & 0x7F) == 0x1D) { ctrl = (code & 0x80) ^ 0x80; } # right ctrl
            if (code == 0xB8) { altgr = 0; }
            if ((code & 0x80) == 0) { special(code); }
            cnt;
        }
        if ((code & 0x80) != 0) {
            val up: u8 = code & 0x7F;
            if (up == 0x2A || up == 0x36) { shift = 0; }
            if (up == 0x1D) { ctrl = 0; }
            if (up == 0x38) { alt = 0; }
        } or {
            key(code);
        }
    }
}
