# mkdir DIR...: make directories

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    if (argc < 2) {
        io.err("usage: mkdir DIR...\n\0");
        ret 2;
    }
    var status: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        val r: i64 = io.mkdir(argv[i], 0o777);
        if (r < 0) {
            io.fail("mkdir\0", argv[i], r);
            status = 1;
        }
        i = i + 1;
    }
    ret status;
}
