# seq [FIRST] LAST: print numbers

use io: machos.user.io;
use rt: machos.user.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var first: u64 = 1;
    var last: u64 = 0;
    var ok: u8 = 0;
    if (argc == 2) {
        last = io.parse_dec(argv[1], io.len(argv[1]), ?ok);
    } or (argc == 3) {
        first = io.parse_dec(argv[1], io.len(argv[1]), ?ok);
        if (ok != 0) { last = io.parse_dec(argv[2], io.len(argv[2]), ?ok); }
    }
    if (ok == 0) {
        io.err("usage: seq [FIRST] LAST\n\0");
        ret 2;
    }
    var i: u64 = first;
    for (i <= last) {
        io.dec(i);
        io.putc(10);
        i = i + 1;
    }
    ret 0;
}
