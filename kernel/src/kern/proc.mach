# processes, their threads, and the scheduler. the kernel runs with
# interrupts off under the big lock, so nothing here needs a lock of its own:
# a thread gives up the cpu only by blocking, exiting, or being preempted on
# its way back to user mode.
#
# a process is a slot whose `leader` is nil; its threads are slots whose
# leader is it. the process's slot holds what its threads share (address
# space, mappings, handles, working directory, ids, signal handlers and
# pending signals); every thread, the leader too, has its own kernel stack,
# registers, state and FS base (where std keeps its per-thread block). the
# threads of a process run on one cpu at a time, so a change to its page
# tables never has to be flushed from other cpus.
#
# each process has its own kernel stack. switching processes means saving
# callee-saved registers and rsp on one kernel stack and restoring them from
# another (`switch_to`); the scheduler loop runs on the boot stack

use events: machos.kern.events;
use pmm:    machos.mm.pmm;
use smp:  machos.arch.x86_64.smp;
use abi:     sdk.abi;
use cpu:     machos.arch.x86_64.cpu;
use gdt:     machos.arch.x86_64.gdt;
use idt:     machos.arch.x86_64.idt;
use apic:    machos.arch.x86_64.apic;
use syscall: machos.arch.x86_64.syscall;
use vmm:     machos.mm.vmm;
use heap:    machos.mm.heap;
use mem:     machos.kern.mem;

pub val MAX: u64 = 256;
pub val KSTACK: u64 = 16384;

pub val FREE:     u64 = 0;
pub val RUNNABLE: u64 = 1;
pub val RUNNING:  u64 = 2;
pub val BLOCKED:  u64 = 3;
pub val ZOMBIE:   u64 = 4;
pub val STOPPED:  u64 = 5;

pub val CWD_MAX: u64 = 256;

# wait channels for things that are not a process or a kernel object
pub val CHAN_TTY:   u64 = 1;
pub val CHAN_TIMER: u64 = 2;
pub val CHAN_EVENTS: u64 = 3; # readers of /dev/events
pub val CHAN_FUTEX:  u64 = 4; # threads in FUTEX_WAIT (Proc.futex: the word)

pub rec Proc {
    pid:       u64;
    ppid:      u64;  # 0 once the parent is gone
    group:     u64;
    state:     u64;
    sig_pending: u64; # bit per signal
    sig_mask:  u64;   # blocked signals
    sig_handler: [32]u64; # abi.SIG_DFL, SIG_IGN, or a user function
    sig_hmask: [32]u64;   # also blocked while that handler runs
    restorer:  u64;   # where handlers return to (the SDK's sigreturn call)
    stop_sig:  u64;   # STOPPED: the signal that stopped it
    report_stop: u8;  # a stop waitpid(WUNTRACED) has not seen yet
    alarm_at:  u64;   # tick SIGALRM is due, 0 = none
    session:   u64;
    uid:       u64;   # real user and group
    gid:       u64;
    euid:      u64;   # effective: what permissions are checked with
    egid:      u64;
    umask:     u64;   # mode bits new files do not get
    exit_code: u64;  # the wait status: code << 8, or the signal
    ksp:       u64;  # saved kernel rsp while switched out
    kstack:    u64;  # heap block holding the kernel stack
    pml4:      u64;
    chan:      u64;  # what a BLOCKED process waits for
    wake_at:   u64;  # tick a CHAN_TIMER sleeper wakes at
    brk:       u64;  # end of the user heap
    brk_base:  u64;
    maps:      *Region; # mmap's regions (kern/mmap.mach), a heap array of maps_cap
    maps_cap:  u64;
    nmaps:     u64;
    mmap_next: u64;  # the next mapping goes below this
    pages:     u64;  # user pages mapped
    cpu_ticks: u64;  # timer ticks spent running
    handles:   [64]u64;
    fdflags:   [64]u8; # FD_CLOEXEC per fd
    cwd:       [256]u8;
    cwd_len:   u64;
    name:      [32]u8;
    name_len:  u64;
    leader:    *Proc;  # a thread: its process; nil: it is a process (its first thread)
    fsbase:    u64;    # the FS base it runs with
    clear_tid: u64;    # a thread: the word set to 0 (and woken) when it ends
    futex:     u64;    # CHAN_FUTEX: the address it waits on
    timed_out: u8;     # a timed wait ran out
    on_cpu:    u64;    # a process: how many of its threads run now (0 or 1)
}

pub rec Region {
    start: u64;
    end:   u64;
    prot:  u64;  # abi.PROT_*
}

var table: [256]Proc;
var next_pid: u64 = 1;
var cur: *Proc = nil;
var last: u64 = 0;      # round robin position
var ticks: u64 = 0;

# per cpu: its scheduler loop's saved stack and the process it runs.
# `cur` is the running process of the cpu inside the kernel (only one is,
# holding the big lock), set on every entry
var sched_ksp: [16]u64;
var running: [16]*Proc;

# the process of the running thread (what system calls act on)
pub fun current() *Proc {
    if (cur != nil && cur.leader != nil) { ret cur.leader; }
    ret cur;
}

# the running thread itself
pub fun current_thread() *Proc { ret cur; }

pub fun process_of(t: *Proc) *Proc {
    if (t.leader != nil) { ret t.leader; }
    ret t;
}

# what cpu 0 does when it has nothing to run (main sets it: write dirty
# disk blocks back). a hook, so the scheduler need not know the disks
var idle_work: fun() u8;
var have_idle: u8 = 0;

pub fun set_idle_work(f: fun() u8) {
    idle_work = f;
    have_idle = 1;
}

var busy: [16]u64;
var all: [16]u64;

# a timer tick on cpu `c`: whoever runs there gets it
pub fun account(c: u64) {
    all[c] = all[c] + 1;
    val p: *Proc = running[c];
    if (p != nil) {
        process_of(p).cpu_ticks = process_of(p).cpu_ticks + 1;
        busy[c] = busy[c] + 1;
    }
}

pub fun busy_ticks(c: u64) u64 { ret busy[c]; }
pub fun all_ticks(c: u64) u64 { ret all[c]; }

# a cpu just entered the kernel (and holds the lock)
pub fun entered() { cur = running[smp.me()]; }

# where a new process's first switch_to "returns": drop the lock the
# scheduler held, then into user mode
#[naked]
#[symbol("first_entry")]
fun first_entry() {
    asm x86_64 {
        call bkl_unlock
        jmp isr_return
    }
}
pub fun uptime_ticks() u64 { ret ticks; }

# "memory low" when less than a twentieth is free, "memory ok" once a
# tenth is again (checked every second)
var memory_low: u8 = 0;

fun watch_memory() {
    val total: u64 = pmm.total_pages();
    val free: u64 = pmm.free_pages();
    if (memory_low == 0 && free * 20 < total) {
        memory_low = 1;
        events.begin("memory low \0");
        events.dec(free * 4);
        events.end();
    } or (memory_low != 0 && free * 10 > total) {
        memory_low = 0;
        events.begin("memory ok \0");
        events.dec(free * 4);
        events.end();
    }
}
pub fun slot(i: u64) *Proc { ret ?table[i]; }

# the process with this pid (threads are not processes)
pub fun find(pid: u64) *Proc {
    var i: u64 = 0;
    for (i < MAX) {
        if (table[i].state != FREE && table[i].leader == nil && table[i].pid == pid) { ret ?table[i]; }
        i = i + 1;
    }
    ret nil;
}

pub fun count() u64 {
    var n: u64 = 0;
    var i: u64 = 0;
    for (i < MAX) {
        if (table[i].state != FREE && table[i].leader == nil) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# how many threads process p has (its first one included)
pub fun thread_count(p: *Proc) u64 {
    var n: u64 = 0;
    var i: u64 = 0;
    for (i < MAX) {
        val t: *Proc = ?table[i];
        if (t.state != FREE && t.state != ZOMBIE && (t == p || t.leader == p)) { n = n + 1; }
        i = i + 1;
    }
    ret n;
}

# save callee-saved registers and rflags on this stack, park rsp in *from,
# and resume whatever was parked at `to` (switch_to(from: *u64, to: u64)).
# rflags travels with each stack so a process blocked inside a system call
# gets its SMAP state (AC) back, and nobody else inherits it
#[naked]
#[symbol("switch_to")]
fun switch_to(from: *u64, to: u64) {
    asm x86_64 {
        push rbp
        push rbx
        push r12
        push r13
        push r14
        push r15
        pushfq
        mov [rdi], rsp
        mov rsp, rsi
        popfq
        pop r15
        pop r14
        pop r13
        pop r12
        pop rbx
        pop rbp
        ret
    }
}

# a free slot with a kernel stack and an empty address space, or nil
pub fun alloc() *Proc {
    var i: u64 = 0;
    for (i < MAX) {
        if (table[i].state == FREE) {
            val p: *Proc = ?table[i];
            mem.fill(p::u64, 0, $size_of(Proc)::u64);
            p.kstack = heap.alloc(KSTACK);
            if (p.kstack == 0) { ret nil; }
            p.pml4 = vmm.new_space();
            if (p.pml4 == 0) {
                heap.free(p.kstack);
                ret nil;
            }
            p.pid = next_pid;
            next_pid = next_pid + 1;
            p.state = BLOCKED; # not runnable until start()
            p.chan = 0xFFFFFFFFFFFFFFFF;
            ret p;
        }
        i = i + 1;
    }
    ret nil;
}

fun kstack_top(p: *Proc) u64 { ret p.kstack + KSTACK; }

# a new thread of process p, not runnable until start(); nil when there is
# no room. it gets a pid of its own (its thread id)
pub fun alloc_thread(p: *Proc) *Proc {
    var i: u64 = 0;
    for (i < MAX) {
        if (table[i].state == FREE) {
            val t: *Proc = ?table[i];
            mem.fill(t::u64, 0, $size_of(Proc)::u64);
            t.kstack = heap.alloc(KSTACK);
            if (t.kstack == 0) { ret nil; }
            t.pml4 = p.pml4;
            t.leader = p;
            t.pid = next_pid;
            next_pid = next_pid + 1;
            t.name_len = p.name_len;
            mem.copy((?t.name[0])::u64, (?p.name[0])::u64, p.name_len);
            t.state = BLOCKED;
            t.chan = 0xFFFFFFFFFFFFFFFF;
            ret t;
        }
        i = i + 1;
    }
    ret nil;
}

# wait on the futex word at addr (the caller checked its value) for up to
# `ticks_left` ticks (0: for ever); 0, 1 when it timed out
pub fun futex_wait(addr: u64, ticks_left: u64) u8 {
    cur.futex = addr;
    cur.timed_out = 0;
    cur.wake_at = 0;
    if (ticks_left != 0) { cur.wake_at = ticks + ticks_left; }
    sleep_on(CHAN_FUTEX);
    cur.futex = 0;
    ret cur.timed_out;
}

# wake up to n threads of process p waiting on addr; how many
pub fun futex_wake(p: *Proc, addr: u64, n: u64) u64 {
    var woke: u64 = 0;
    var i: u64 = 0;
    for (i < MAX && woke < n) {
        val t: *Proc = ?table[i];
        if (t.state == BLOCKED && t.chan == CHAN_FUTEX && t.futex == addr && process_of(t) == p) {
            t.state = RUNNABLE;
            woke = woke + 1;
        }
        i = i + 1;
    }
    if (woke != 0) { smp.kick(); }
    ret woke;
}

# every other thread of the running thread's process ends now (exit, exec)
pub fun end_other_threads() {
    val p: *Proc = current();
    var i: u64 = 0;
    for (i < MAX) {
        val t: *Proc = ?table[i];
        if (t != cur && t.state != FREE && process_of(t) == p && t != p) {
            # never running: its process runs on this cpu only
            heap.free(t.kstack);
            t.state = FREE;
            t.pid = 0;
        }
        i = i + 1;
    }
}

# the running thread ends (THREAD_EXIT). its clear_tid word is set to 0 and
# whoever waits on it is woken; the process goes on. never returns
pub fun thread_exit() {
    val t: *Proc = cur;
    val p: *Proc = current();
    if (t == p) {
        # the first thread cannot go before its process: it just stops
        t.state = BLOCKED;
        t.chan = 0xFFFFFFFFFFFFFFFF;
        sched();
    }
    t.state = ZOMBIE; # reaped by the scheduler once it is off its stack
    t.ppid = 0;
    sched();
}

# make `p` runnable so that it enters user mode at `rip` with stack `rsp`
# and rdi, rsi, rdx set. builds the frame isr_return expects, plus a
# switch_to frame that "returns" into isr_return
pub fun start(p: *Proc, rip: u64, rsp: u64, rdi: u64, rsi: u64, rdx: u64) {
    var sp: u64 = kstack_top(p);
    sp = sp - $size_of(idt.Frame)::u64;
    val f: *idt.Frame = sp::*idt.Frame;
    mem.fill(sp, 0, $size_of(idt.Frame)::u64);
    f.rip = rip;
    f.cs = gdt.UCODE::u64 | 3;
    f.rflags = 0x202; # IF
    f.rsp = rsp;
    f.ss = gdt.UDATA::u64 | 3;
    f.rdi = rdi;
    f.rsi = rsi;
    f.rdx = rdx;

    # a clean fxsave image: x87 control word and MXCSR at their defaults
    sp = sp - idt.FPU_AREA;
    mem.fill(sp, 0, idt.FPU_AREA);
    @(sp::*u16) = 0x037F;
    @((sp + 24)::*u32) = 0x1F80;

    # switch_to pops rflags, r15 r14 r13 r12 rbx rbp, then returns into
    # isr_return; rflags 0x2: interrupts off, AC clear
    sp = sp - 8;
    @(sp::*u64) = first_entry::u64;
    sp = sp - 48;
    mem.fill(sp, 0, 48);
    sp = sp - 8;
    @(sp::*u64) = 0x2;
    p.ksp = sp;
    p.state = RUNNABLE;
    smp.kick();
}

# make `p` runnable as a copy of the process whose saved frame is `f` (with
# the fxsave image right below it): it resumes where that one will, with
# rax = 0, which is how a forked child sees fork() return
pub fun start_copy(p: *Proc, f: *idt.Frame) {
    var sp: u64 = kstack_top(p);
    val fsize: u64 = $size_of(idt.Frame)::u64;
    sp = sp - fsize - idt.FPU_AREA;
    mem.copy(sp, f::u64 - idt.FPU_AREA, fsize + idt.FPU_AREA);
    val cf: *idt.Frame = (sp + idt.FPU_AREA)::*idt.Frame;
    cf.rax = 0;
    sp = sp - 8;
    @(sp::*u64) = first_entry::u64;
    sp = sp - 48;
    mem.fill(sp, 0, 48);
    sp = sp - 8;
    @(sp::*u64) = 0x2;
    p.ksp = sp;
    p.state = RUNNABLE;
    smp.kick();
}

# give the cpu back to the scheduler loop; returns when picked again
fun sched() {
    val p: *Proc = cur;
    switch_to(?p.ksp, sched_ksp[smp.me()]);
}

pub fun yield() {
    cur.state = RUNNABLE;
    sched();
}

# block until wakeup(chan)
pub fun sleep_on(chan: u64) {
    cur.state = BLOCKED;
    cur.chan = chan;
    sched();
}

pub fun wakeup(chan: u64) {
    var woke: u8 = 0;
    var i: u64 = 0;
    for (i < MAX) {
        if (table[i].state == BLOCKED && table[i].chan == chan) {
            table[i].state = RUNNABLE;
            woke = 1;
        }
        i = i + 1;
    }
    if (woke != 0) { smp.kick(); }
}

# a futex word the scheduler should clear and wake once thread t is gone
pub fun cleared_on_exit(t: *Proc) u64 { ret t.clear_tid; }

pub fun sleep_ticks(n: u64) {
    cur.wake_at = ticks + n;
    sleep_on(CHAN_TIMER);
}

# timer interrupt: wake sleepers whose time has come
pub fun tick() {
    ticks = ticks + 1;
    if (ticks % apic.HZ == 0) { watch_memory(); }
    var i: u64 = 0;
    for (i < MAX) {
        val p: *Proc = ?table[i];
        if (p.state == BLOCKED && p.chan == CHAN_TIMER && p.wake_at <= ticks) {
            p.state = RUNNABLE;
            smp.kick();
        }
        if (p.state == BLOCKED && p.chan == CHAN_FUTEX && p.wake_at != 0 && p.wake_at <= ticks) {
            p.timed_out = 1;
            p.state = RUNNABLE;
            smp.kick();
        }
        if (p.alarm_at != 0 && p.alarm_at <= ticks && p.state != FREE) {
            p.alarm_at = 0;
            send(p, abi.SIGALRM);
        }
        i = i + 1;
    }
}

# signals whose default action is to do nothing
fun default_ignored(sig: u64) u8 {
    if (sig == abi.SIGCHLD || sig == abi.SIGCONT || sig == 23 || sig == 28) { ret 1; }
    ret 0;
}

# send `sig` to `p`. it is acted on when `p` next heads back to user mode;
# a blocked call is woken to return E_INTR. SIGCONT resumes a stopped
# process, SIGKILL any process
pub fun send(p: *Proc, sig: u64) {
    if (p.state == FREE || p.state == ZOMBIE || sig == 0 || sig >= abi.NSIG) { ret; }
    if (sig == abi.SIGCONT || sig == abi.SIGKILL) {
        if (p.state == STOPPED) { p.state = RUNNABLE; }
        if (sig == abi.SIGCONT) {
            # a pending stop is cancelled by a continue
            p.sig_pending = p.sig_pending & ~(abi.sigbit(abi.SIGSTOP) | abi.sigbit(abi.SIGTSTP));
        }
    }
    if (sig == abi.SIGSTOP || sig == abi.SIGTSTP) {
        p.sig_pending = p.sig_pending & ~abi.sigbit(abi.SIGCONT);
    }
    val h: u64 = p.sig_handler[sig];
    if (sig != abi.SIGKILL && sig != abi.SIGSTOP) {
        if (h == abi.SIG_IGN) { ret; }
        if (h == abi.SIG_DFL && default_ignored(sig) != 0) { ret; }
    }
    p.sig_pending = p.sig_pending | abi.sigbit(sig);
    # a blocked call of any of its threads gives up (E_INTR)
    if (interrupted(p) != 0) {
        var i: u64 = 0;
        for (i < MAX) {
            val t: *Proc = ?table[i];
            if (t.state == BLOCKED && (t == p || t.leader == p) && t.chan != 0xFFFFFFFFFFFFFFFF) { t.state = RUNNABLE; }
            i = i + 1;
        }
    }
}

# whether a signal waits that `p` will act on (so a blocking call should give up)
pub fun interrupted(p: *Proc) u8 {
    val always: u64 = abi.sigbit(abi.SIGKILL) | abi.sigbit(abi.SIGSTOP);
    if ((p.sig_pending & (~p.sig_mask | always)) != 0) { ret 1; }
    ret 0;
}

# send `sig` to every process of `group`; how many there were
pub fun send_group(group: u64, sig: u64) u64 {
    var n: u64 = 0;
    var i: u64 = 0;
    for (i < MAX) {
        if (table[i].leader == nil && table[i].group == group && table[i].state != FREE && table[i].state != ZOMBIE) {
            send(?table[i], sig);
            n = n + 1;
        }
        i = i + 1;
    }
    ret n;
}

# stop the current process until SIGCONT (or SIGKILL); its parent hears of it
pub fun stop_self(sig: u64) {
    val p: *Proc = cur;
    p.state = STOPPED;
    p.stop_sig = sig;
    p.report_stop = 1;
    val parent: *Proc = find(p.ppid);
    if (parent != nil) {
        send(parent, abi.SIGCHLD);
        wakeup(parent::u64);
    }
    sched();
}

# free everything a zombie still holds and its slot
pub fun reap(p: *Proc) {
    heap.free(p.kstack);
    if (p.leader == nil) { heap.free(p.maps::u64); }
    p.maps = nil;
    p.maps_cap = 0;
    p.state = FREE;
    p.pid = 0;
}

# called by the exiting process after it released its handles. drops the
# address space, orphans its children, wakes its parent, never returns
pub fun exit(code: u64) {
    end_other_threads();
    val p: *Proc = current();
    val t: *Proc = cur;
    p.on_cpu = 0;
    if (t != p) {
        # a thread ends the process: the process's slot becomes the zombie
        # its parent waits for; this thread's goes once it is off its stack
        t.state = ZOMBIE;
        t.ppid = 0;
        t.leader = nil;
    }
    cpu.set_cr3(vmm.kernel_space());
    vmm.free_space(p.pml4);
    p.pml4 = 0;
    p.pages = 0;
    p.exit_code = code;

    var i: u64 = 0;
    for (i < MAX) {
        val c: *Proc = ?table[i];
        if (c.state != FREE && c.ppid == p.pid) {
            c.ppid = 0;
            if (c.state == ZOMBIE) { reap(c); }
        }
        i = i + 1;
    }
    p.state = ZOMBIE;
    if (p.ppid != 0) {
        val parent: *Proc = find(p.ppid);
        if (parent != nil) {
            send(parent, abi.SIGCHLD);
            wakeup(parent::u64);
        }
    }
    sched();
}

# run processes forever on cpu `me` (holding the big lock); idles in
# cpu.wait, without the lock, when none can run
pub fun scheduler(me: u64) {
    for {
        var picked: *Proc = nil;
        var n: u64 = 0;
        for (n < MAX && picked == nil) {
            last = (last + 1) % MAX;
            # one thread of a process at a time: its siblings wait their turn
            if (table[last].state == RUNNABLE && process_of(?table[last]).on_cpu == 0) { picked = ?table[last]; }
            n = n + 1;
        }
        if (picked == nil) {
            # nothing to run: a good moment to put dirty disk blocks on the disk
            if (me == 0 && have_idle != 0) { idle_work(); }
            smp.set_idle(me, 1);
            smp.unlock();
            cpu.wait();
            smp.lock();
            smp.set_idle(me, 0);
            cur = nil;
            cnt;
        }
        cur = picked;
        running[me] = picked;
        picked.state = RUNNING;
        val owner: *Proc = process_of(picked);
        owner.on_cpu = 1;
        cpu.wrmsr(0xC0000100, picked.fsbase); # FS base: the thread's own block
        gdt.set_rsp0(me, kstack_top(picked));
        syscall.set_kstack(me, kstack_top(picked));
        cpu.set_cr3(picked.pml4);
        switch_to(?sched_ksp[me], picked.ksp);
        # back on this cpu's loop: leave its address space, which may be
        # freed while this cpu idles
        cpu.set_cr3(vmm.kernel_space());
        running[me] = nil;
        cur = nil;
        owner.on_cpu = 0;
        if (picked.state == ZOMBIE && picked.ppid == 0) { reap(picked); }
    }
}
