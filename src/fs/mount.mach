# what is mounted where. a disk with a mounted filesystem cannot be written
# raw (through /dev/diskN), and every mount has its own Part and ext2.Fs

use abi:  machos.abi.sys;
use ahci: machos.dev.ahci;
use heap: machos.mm.heap;
use blk:  machos.fs.blk;
use gpt:  machos.fs.gpt;
use ext2: machos.fs.ext2;
use vfs:  machos.fs.vfs;

pub val MAX: u64 = 8;

rec Mount {
    disk: *ahci.Disk;
    part: *blk.Part;
    fs:   *ext2.Fs;
    root: *vfs.Node; # the mounted root (nil for the boot root)
}

var mounts: [8]Mount;

fun free_slot() *Mount {
    var i: u64 = 0;
    for (i < MAX) {
        if (mounts[i].disk == nil) { ret ?mounts[i]; }
        i = i + 1;
    }
    ret nil;
}

# open the MachOS root partition of `d` as a filesystem; *err says why not
fun open_fs(d: *ahci.Disk, part: **blk.Part, fs: **ext2.Fs, err: **u8) u64 {
    @err = nil;
    blk.forget_disk(d); # the partition table may have just been rewritten
    val p: *blk.Part = heap.zalloc($size_of(blk.Part)::u64)::*blk.Part;
    if (p == nil) { ret abi.err(abi.E_NOMEM); }
    if (gpt.find_root(d, p) == 0) {
        heap.free(p::u64);
        ret abi.err(abi.E_NOENT);
    }
    val f: *ext2.Fs = heap.zalloc($size_of(ext2.Fs)::u64)::*ext2.Fs;
    if (f == nil) {
        heap.free(p::u64);
        ret abi.err(abi.E_NOMEM);
    }
    val why: *u8 = ext2.mount(f, p);
    if (why != nil) {
        @err = why;
        heap.free(f::u64);
        heap.free(p::u64);
        ret abi.err(abi.E_INVAL);
    }
    @part = p;
    @fs = f;
    ret 0;
}

# boot: make disk `d`'s MachOS partition the root; nil, or the reason not
pub fun mount_root(d: *ahci.Disk) *u8 {
    val m: *Mount = free_slot();
    var p: *blk.Part = nil;
    var f: *ext2.Fs = nil;
    var why: *u8 = nil;
    val r: u64 = open_fs(d, ?p, ?f, ?why);
    if (abi.is_err(r) != 0) {
        if (why != nil) { ret why; }
        ret "no MachOS partition\0";
    }
    if (vfs.init_ext2(f) == 0) { ret "out of memory\0"; }
    m.disk = d;
    m.part = p;
    m.fs = f;
    m.root = nil;
    ret nil;
}

# mount disk `d`'s MachOS partition on the directory `at`
pub fun mount_at(d: *ahci.Disk, at: *vfs.Node) u64 {
    if (disk_busy(d) != 0) { ret abi.err(abi.E_BUSY); }
    val m: *Mount = free_slot();
    if (m == nil) { ret abi.err(abi.E_BUSY); }
    var p: *blk.Part = nil;
    var f: *ext2.Fs = nil;
    var why: *u8 = nil;
    val r: u64 = open_fs(d, ?p, ?f, ?why);
    if (abi.is_err(r) != 0) { ret r; }
    val vr: u64 = vfs.mount(at, f);
    if (abi.is_err(vr) != 0) {
        heap.free(f::u64);
        heap.free(p::u64);
        ret vr;
    }
    m.disk = d;
    m.part = p;
    m.fs = f;
    m.root = at.mounted;
    ret 0;
}

# undo mount_at; `r` is the mounted root (what a path to the mountpoint finds)
pub fun unmount(r: *vfs.Node) u64 {
    var i: u64 = 0;
    for (i < MAX) {
        val m: *Mount = ?mounts[i];
        if (m.disk != nil && m.root == r) {
            val u: u64 = vfs.unmount(r);
            if (abi.is_err(u) != 0) { ret u; }
            blk.forget_disk(m.disk); # writes everything back first
            heap.free(m.fs::u64);
            heap.free(m.part::u64);
            m.disk = nil;
            m.root = nil;
            ret 0;
        }
        i = i + 1;
    }
    ret abi.err(abi.E_INVAL);
}

pub fun disk_busy(d: *ahci.Disk) u8 {
    var i: u64 = 0;
    for (i < MAX) {
        if (mounts[i].disk == d) { ret 1; }
        i = i + 1;
    }
    ret 0;
}
