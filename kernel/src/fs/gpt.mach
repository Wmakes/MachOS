# GPT partition tables: read the partition entries of a disk

use dsk:  machos.dev.disk;
use heap: machos.mm.heap;
use mem:  machos.kern.mem;

pub val MAX: u64 = 32;

pub rec Entry {
    index: u64; # 1-based position in the table: sdX<index>
    kind:  [16]u8;
    first: u64;
    count: u64;
}

# A9056588-C0B9-470F-AC01-A8528DCA9461 as stored on disk (first three fields
# little endian); the userland gpt tool writes the same type
pub val ROOT_TYPE: [16]u8 = [16]u8{0x88, 0x65, 0x05, 0xa9, 0xb9, 0xc0, 0x0f, 0x47,
                                   0xac, 0x01, 0xa8, 0x52, 0x8d, 0xca, 0x94, 0x61};

fun zero_guid(g: *u8) u8 {
    var i: u64 = 0;
    for (i < 16) {
        if (g[i] != 0) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

# the used entries of `d`'s GPT into out (up to MAX); returns how many.
# 0 for a disk without a valid GPT
pub fun scan(d: *dsk.Disk, out: *Entry) u64 {
    val buf: u64 = heap.alloc(512);
    if (buf == 0) { ret 0; }
    var n: u64 = 0;
    if (dsk.read(d, 1, 1, buf) != 0 && mem.equal(buf::*u8, "EFI PART\0", 8) != 0) {
        val entries: u64 = @((buf + 72)::*u64);
        val count: u64 = (@((buf + 80)::*u32))::u64;
        val size: u64 = (@((buf + 84)::*u32))::u64;
        if (size >= 128 && size <= 512 && 512 % size == 0 && count <= 1024) {
            var i: u64 = 0;
            for (i < count && n < MAX) {
                val off: u64 = i * size;
                if (dsk.read(d, entries + off / 512, 1, buf) == 0) { brk; }
                val e: u64 = buf + off % 512;
                val first: u64 = @((e + 32)::*u64);
                val last: u64 = @((e + 40)::*u64);
                if (zero_guid(e::*u8) == 0 && last >= first && last < d.sectors) {
                    val o: *Entry = ?out[n];
                    o.index = i + 1;
                    mem.copy((?o.kind[0])::u64, e, 16);
                    o.first = first;
                    o.count = last - first + 1;
                    n = n + 1;
                }
                i = i + 1;
            }
        }
    }
    heap.free(buf);
    ret n;
}
