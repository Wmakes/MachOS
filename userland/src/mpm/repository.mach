# signed stable catalogue, bounded HTTPS downloads and repository package selection

use sha: crypto.hash.sha256;
use sdk.abi;
use sdk.sys;
use A: std.allocator;
use std.allocator.arena;
use std.data.toml;
use std.system.os;
use std.types.error.err;
use std.types.option.opt;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use io: userland.lib.cli;
use userland.lib.conf;
use clock: userland.lib.time;
use userland.mpm.fs;
use pkg:    userland.mpm.package;
use signed: userland.mpm.signature;
use tx:     userland.mpm.transaction;

val CACHE: *u8 = "/var/lib/mpm/repository";
val KEY:   *u8 = "/etc/mpm/keys/machos.pub";
val LIMIT: u64 = 1048576;

pub rec Entry {
    name:           [64]u8;
    version:        [128]u8;
    description:    [241]u8;
    url:            [512]u8;
    signature_url:  [520]u8;
    filename:       [256]u8;
    digest:         [65]u8;
    size:           u64;
    installed_size: u64;
    protected:      u8;
    deps:           *pkg.Dependency;
    dep_count:      u64;
}

rec Release {
    version:       [128]u8;
    url:           [512]u8;
    signature_url: [520]u8;
    digest:        [65]u8;
    revision:      u64;
    size:          u64;
}

var     entries:        [400]Entry;
pub var count:          u64;
var     current:        Release;
var     newest:         Release;
var     revision:       u64;
var     expires:        u64;
var     published:      u64;
var     systems:        [16][64]u8;
pub var system_count:   u64;
pub var target_version: [128]u8;
var     local_version:  [128]u8;

fun fail(message: *u8) u8 {
    io.emsg("mpm: ");
    io.err(message);
    io.putc(10);
    ret 0;
}

pub fun text(table: *toml.Table, key: str, out: *u8, cap: u64) u8 {
    val value: opt[str] = toml.get_str(table, key);
    if (sel value.none) { ret 0; }
    val p: *u8 = value.some::*u8;
    val n: u64 = io.len(p);
    if (n >= cap) { ret 0; }
    var i: u64 = 0;
    for (i < n) {
        if (p[i] < 32 || p[i] > 126 || p[i] == 92 || p[i] == 34) { ret 0; }
        i = i + 1;
    }
    io.copy(out, p, n + 1);
    ret 1;
}

pub fun number(table: *toml.Table, key: str, out: *u64) u8 {
    val value: opt[i64] = toml.get_int(table, key);
    if (sel value.none) { ret 0; }
    if (value.some < 0) { ret 0; }
    @out = value.some::u64;
    ret 1;
}

fun parse(blob: *fs.Blob, storage: *arena.Arena, table: *toml.Table) u8 {
    if (blob.len == 0 || blob.len > LIMIT || pkg.allocator() == nil) { ret 0; }
    var i: u64 = 0;
    for (i < blob.len) {
        val c: u8 = blob.data[i];
        if (c == 0 || c == 92 || c > 126 || (c < 32 && c != 9 && c != 10 && c != 13)) { ret 0; }
        i = i + 1;
    }
    val initialized: err[A.Error] = arena.init(storage, pkg.allocator(), 65536);
    if (sel initialized.err) { ret 0; }
    var scratch: A.Allocator;
    val made:    err[A.Error] = arena.make(?scratch, storage);
    if (sel made.err) { ret 0; }
    val parsed: res[toml.Table, toml.TomlError] = toml.parse(?scratch, blob.data::str);
    if (sel parsed.err) { ret 0; }
    @table = parsed.ok;
    ret 1;
}

fun hash_ok(data: *u8, len: u64, expected: *u8) u8 {
    if (io.len(expected) != 64) { ret 0; }
    var state: sha.State = sha.init();
    sha.update(?state, data, len::usize);
    var digest: [32]u8;
    sha.final(?state, ?digest[0]);
    val hex: *u8 = "0123456789abcdef";
    var i:   u64 = 0;
    for (i < 32) {
        if (expected[i * 2] != hex[digest[i] >> 4] || expected[i * 2 + 1] != hex[digest[i] & 15]) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

fun hex_ok(value: *u8) u8 {
    if (io.len(value) != 64) { ret 0; }
    var i: u64 = 0;
    for (i < 64) {
        if (!((value[i] >= 48 && value[i] <= 57) || (value[i] >= 97 && value[i] <= 102))) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

fun https(url: *u8) u8 {
    val n: u64 = io.len(url);
    if (n < 9 || n > 511 || io.eq(url, 8, "https://", 8) == 0) { ret 0; }
    var i: u64 = 8;
    for (i < n) {
        if (url[i] <= 32 || url[i] >= 127 || url[i] == 64 || url[i] == 35) { ret 0; }
        i = i + 1;
    }
    ret 1;
}

fun timestamp(value: *u8, out: *u64) u8 {
    if (io.len(value) != 20 || value[4] != 45 || value[7] != 45 || value[10] != 84 || value[13] != 58 || value[16] != 58 || value[19] != 90) { ret 0; }
    val starts:  [6]u64 = [6]u64{0, 5, 8, 11, 14, 17};
    var numbers: [6]u64;
    var i:       u64    = 0;
    for (i < 6) {
        var good: u8  = 0;
        var n:    u64 = 2;
        if (i == 0) { n = 4; }
        numbers[i] = io.parse_dec(?value[starts[i]], n, ?good);
        if (good == 0) { ret 0; }
        i = i + 1;
    }
    if (numbers[0] < 1970 || numbers[0] > 9999 || numbers[1] < 1 || numbers[1] > 12 || numbers[2] < 1 || numbers[3] > 23 || numbers[4] > 59 || numbers[5] > 59) { ret 0; }
    val days:    [12]u64 = [12]u64{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    var maximum: u64     = days[numbers[1] - 1];
    val year:    u64     = numbers[0];
    if (numbers[1] == 2 && year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)) { maximum = 29; }
    if (numbers[2] > maximum)                                                     { ret 0; }
    var tm: clock.Tm;
    tm.year  = year::i64;
    tm.month = numbers[1]::i64;
    tm.day   = numbers[2]::i64;
    tm.hour  = numbers[3]::i64;
    tm.min   = numbers[4]::i64;
    tm.sec   = numbers[5]::i64;
    @out     = clock.seconds(?tm)::u64;
    ret 1;
}

fun common(table: *toml.Table, expiry: u8) u8 {
    var format:  u64 = 0;
    var channel: [16]u8;
    var time:    [32]u8;
    var start:   u64 = 0;
    if (number(table, "format", ?format) == 0 || format != 1 || text(table, "channel", ?channel[0], 16) == 0 || io.streq(?channel[0], "stable") == 0 || text(table, "published", ?time[0], 32) == 0 || timestamp(?time[0], ?start) == 0) { ret 0; }
    var now: abi.Timespec;
    if (abi.is_err(sys.raw(abi.CLOCK, abi.CLOCK_REALTIME, (?now)::u64, 0, 0, 0)) != 0 || start > now.sec + 300) { ret fail("repository timestamp is invalid; check the UTC clock"); }
    if (expiry != 0) {
        var end: u64 = 0;
        if (text(table, "expires", ?time[0], 32) == 0 || timestamp(?time[0], ?end) == 0 || end <= start || end - start > 30 * 86400 || end <= now.sec) { ret fail("repository metadata has expired or has an invalid lifetime"); }
        published = start;
        expires   = end;
    }
    ret 1;
}

pub fun version(out: *u8) u8 {
    var st: os.stat_t;
    if (fs.parents("/etc/mpm/os-version", 0) == 0 || io.lstat("/etc/mpm/os-version", ?st) < 0 || st.st_uid != 0 || (io.perms(?st) & 0o022) != 0) { ret 0; }
    var blob: fs.Blob;
    if (fs.read("/etc/mpm/os-version", 128, ?blob) == 0) { ret 0; }
    var n: u64 = blob.len;
    if (n > 0 && blob.data[n - 1] == 10) { n = n - 1; }
    if (n == 0 || n >= 128) {
        fs.release(?blob);
        ret 0;
    }
    io.copy(out, blob.data, n);
    out[n] = 0;
    fs.release(?blob);
    ret (pkg.compare(out, out) == 0)::u8;
}

fun catalogue(blob: *fs.Blob) u8 {
    var storage: arena.Arena;
    fin { arena.dnit(?storage); }
    var table: toml.Table;
    if (parse(blob, ?storage, ?table) == 0 || common(?table, 1) == 0 || number(?table, "revision", ?revision) == 0 || revision == 0 || version(?local_version[0]) == 0) { ret 0; }
    var latest: [128]u8;
    var parent: [65]u8;
    if (text(?table, "latest_os", ?latest[0], 128) == 0 || pkg.compare(?latest[0], ?latest[0]) != 0 || text(?table, "previous_sha256", ?parent[0], 65) == 0 || hex_ok(?parent[0]) == 0) { ret 0; }
    val list: opt[*toml.Array] = toml.get_array(?table, "releases");
    if (sel list.none)                             { ret 0; }
    if (list.some.len == 0 || list.some.len > 256) { ret 0; }
    var found_current: u8    = 0;
    var found_latest:  u8    = 0;
    var seen:          [256][128]u8;
    var i:             usize = 0;
    for (i < list.some.len) {
        val value: opt[*toml.Value] = toml.array_get(list.some, i);
        if (sel value.none)                    { ret 0; }
        if (value.some.tag != toml.TYPE_TABLE) { ret 0; }
        val t: *toml.Table = ?value.some.data.table;
        var r: Release;
        if (text(t, "os_version", ?r.version[0], 128) == 0 || pkg.compare(?r.version[0], ?r.version[0]) != 0 || text(t, "url", ?r.url[0], 512) == 0 || https(?r.url[0]) == 0 || text(t, "signature_url", ?r.signature_url[0], 520) == 0 || https(?r.signature_url[0]) == 0 || text(t, "sha256", ?r.digest[0], 65) == 0 || hex_ok(?r.digest[0]) == 0 || number(t, "revision", ?r.revision) == 0 || r.revision == 0 || number(t, "size", ?r.size) == 0 || r.size == 0 || r.size > LIMIT) { ret 0; }
        var j: usize = 0;
        for (j < i) {
            if (io.streq(?seen[j][0], ?r.version[0]) != 0) { ret 0; }
            j = j + 1;
        }
        io.copy(?seen[i][0], ?r.version[0], io.len(?r.version[0]) + 1);
        if (pkg.compare(?r.version[0], ?latest[0]) > 0) { ret 0; }
        if (io.streq(?r.version[0], ?local_version[0]) != 0) {
            current       = r;
            found_current = 1;
        }
        if (io.streq(?r.version[0], ?latest[0]) != 0) {
            newest       = r;
            found_latest = 1;
        }
        i = i + 1;
    }
    ret (found_current != 0 && found_latest != 0)::u8;
}

fun official(data: *fs.Blob, signature_path: *u8) u8 {
    if (fs.parents(KEY, 0) == 0) { ret 0; }
    var st: os.stat_t;
    if (io.lstat(KEY, ?st) < 0 || st.st_uid != 0 || (io.perms(?st) & 0o022) != 0) { ret 0; }
    var key:       fs.Blob;
    var signature: fs.Blob;
    if (fs.read(KEY, 512, ?key) == 0) { ret 0; }
    fin { fs.release(?key); }
    if (fs.read(signature_path, 1536, ?signature) == 0) { ret 0; }
    fin { fs.release(?signature); }
    var parsed: signed.Signature;
    if (signed.parse(signature.data, signature.len, ?parsed) == 0 || signed.verify(data.data, data.len, ?parsed, key.data, key.len) == 0) { ret fail("repository signature is invalid or is not from the official key"); }
    ret 1;
}

fun fetch(url: *u8, path: *u8, maximum: u64) u8 {
    if (https(url) == 0) { ret fail("repository downloads require HTTPS"); }
    var size: [24]u8;
    val n:    u64 = io.fmt_dec(maximum, ?size[0]);
    size[n] = 0;
    var args: [9]*u8;
    args[0] = "wget";
    args[1] = "-q";
    args[2] = "--https-only";
    args[3] = "--max-size";
    args[4] = ?size[0];
    args[5] = "-O";
    args[6] = path;
    args[7] = url;
    args[8] = nil;
    if (io.run_program("/bin/wget", ?args[0], nil) != 0) { ret fail("repository download failed"); }
    ret 1;
}

fun fetch_pair(url: *u8, signature_url: *u8, path: *u8, maximum: u64, out: *fs.Blob) u8 {
    var sigpath: [520]u8;
    val n:       u64 = io.len(path);
    io.copy(?sigpath[0], path, n);
    io.copy(?sigpath[n], ".sig", 5);
    var attempt: u64 = 0;
    for (attempt < 3) {
        io.remove(path);
        io.remove(?sigpath[0]);
        if (fetch(url, path, maximum) != 0 && fetch(signature_url, ?sigpath[0], 1536) != 0 && fs.read(path, maximum, out) != 0) {
            if (official(out, ?sigpath[0]) != 0) { ret 1; }
            fs.release(out);
        }
        attempt = attempt + 1;
    }
    ret 0;
}

fun index(blob: *fs.Blob, release: *Release) u8 {
    var storage: arena.Arena;
    fin { arena.dnit(?storage); }
    var table: toml.Table;
    if (blob.len != release.size || hash_ok(blob.data, blob.len, ?release.digest[0]) == 0 || parse(blob, ?storage, ?table) == 0 || common(?table, 0) == 0) { ret 0; }
    var os_version: [128]u8;
    var arch:       [32]u8;
    var rev:        u64 = 0;
    if (text(?table, "os_version", ?os_version[0], 128) == 0 || io.streq(?os_version[0], ?release.version[0]) == 0 || text(?table, "arch", ?arch[0], 32) == 0 || io.streq(?arch[0], "x86_64") == 0 || number(?table, "revision", ?rev) == 0 || rev != release.revision) { ret 0; }
    io.copy(?target_version[0], ?os_version[0], io.len(?os_version[0]) + 1);
    val required: opt[*toml.Array] = toml.get_array(?table, "system");
    if (sel required.none)                               { ret 0; }
    if (required.some.len < 3 || required.some.len > 16) { ret 0; }
    system_count = required.some.len::u64;
    var i: usize = 0;
    for (i < required.some.len) {
        val item: opt[*toml.Value] = toml.array_get(required.some, i);
        if (sel item.none)                     { ret 0; }
        if (item.some.tag != toml.TYPE_STRING) { ret 0; }
        val name: *u8 = item.some.data.string::*u8;
        if (pkg.name_ok(name) == 0) { ret 0; }
        var j: usize = 0;
        for (j < i) {
            if (io.streq(?systems[j][0], name) != 0) { ret 0; }
            j = j + 1;
        }
        io.copy(?systems[i][0], name, io.len(name) + 1);
        i = i + 1;
    }
    val list: opt[*toml.Array] = toml.get_array(?table, "packages");
    if (sel list.none)                             { ret 0; }
    if (list.some.len == 0 || list.some.len > 400) { ret 0; }
    # Re-parsing replaces process-local entries; their dependency arrays are owned.
    i = 0;
    for (i < count::usize) {
        if (entries[i].deps != nil) {
            os.deallocate(entries[i].deps::ptr, (entries[i].dep_count * $size_of(pkg.Dependency)::u64)::usize);
            entries[i].deps = nil;
        }
        i = i + 1;
    }
    count = list.some.len::u64;
    i     = 0;
    for (i < list.some.len) {
        val value: opt[*toml.Value] = toml.array_get(list.some, i);
        if (sel value.none)                    { ret 0; }
        if (value.some.tag != toml.TYPE_TABLE) { ret 0; }
        val t: *toml.Table = ?value.some.data.table;
        val p: *Entry      = ?entries[i];
        if (text(t, "name", ?p.name[0], 64) == 0 || pkg.name_ok(?p.name[0]) == 0 || text(t, "version", ?p.version[0], 128) == 0 || pkg.compare(?p.version[0], ?p.version[0]) != 0 || text(t, "description", ?p.description[0], 241) == 0 || text(t, "url", ?p.url[0], 512) == 0 || https(?p.url[0]) == 0 || text(t, "signature_url", ?p.signature_url[0], 520) == 0 || https(?p.signature_url[0]) == 0 || text(t, "sha256", ?p.digest[0], 65) == 0 || hex_ok(?p.digest[0]) == 0 || text(t, "filename", ?p.filename[0], 256) == 0 || number(t, "size", ?p.size) == 0 || p.size == 0 || p.size > 536870912 || number(t, "installed_size", ?p.installed_size) == 0) { ret 0; }
        if (text(t, "arch", ?arch[0], 32) == 0 || io.streq(?arch[0], "x86_64") == 0)                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                             { ret 0; }
        var k: u64 = 0;
        for (p.filename[k] != 0) {
            val c: u8 = p.filename[k];
            if (!((c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46 || c == 43)) { ret 0; }
            k = k + 1;
        }
        if (k < 5 || p.filename[0] == 46 || io.eq(?p.filename[k - 4], 4, ".mpa", 4) == 0) { ret 0; }
        val protected: opt[u8] = toml.get_bool(t, "protected");
        if (sel protected.none) { ret 0; }
        p.protected = protected.some;
        var j: usize = 0;
        for (j < i) {
            if (io.streq(?entries[j].filename[0], ?p.filename[0]) != 0 || (io.streq(?entries[j].name[0], ?p.name[0]) != 0 && pkg.compare(?entries[j].version[0], ?p.version[0]) == 0)) { ret 0; }
            j = j + 1;
        }
        val deps: opt[*toml.Array] = toml.get_array(t, "dependencies");
        if (sel deps.none)      { ret 0; }
        if (deps.some.len > 32) { ret 0; }
        p.dep_count = deps.some.len::u64;
        if (p.dep_count != 0) {
            p.deps = os.allocate((p.dep_count * $size_of(pkg.Dependency)::u64)::usize)::*pkg.Dependency;
            if (p.deps == nil) { ret 0; }
        }
        j = 0;
        for (j < deps.some.len) {
            val dep: opt[*toml.Value] = toml.array_get(deps.some, j);
            if (sel dep.none)                     { ret 0; }
            if (dep.some.tag != toml.TYPE_STRING) { ret 0; }
            val raw:   *u8 = dep.some.data.string::*u8;
            val len:   u64 = io.len(raw);
            var space: u64 = 0;
            for (space < len && raw[space] != 32) { space = space + 1; }
            if (space == 0 || space >= 64 || space + 1 >= len || len - space - 1 >= 128) { ret 0; }
            io.copy(?p.deps[j].name[0], raw, space);
            p.deps[j].name[space] = 0;
            io.copy(?p.deps[j].version[0], ?raw[space + 1], len - space);
            if (pkg.name_ok(?p.deps[j].name[0]) == 0) { ret 0; }
            var constraint: *u8 = ?p.deps[j].version[0];
            if (constraint[0] == 62 && constraint[1] == 61) { constraint = ?constraint[2]; }
            if (pkg.compare(constraint, constraint) != 0)   { ret 0; }
            j = j + 1;
        }
        i = i + 1;
    }
    i = 0;
    for (i < system_count::usize) {
        val selected: i64 = find(?systems[i][0], nil);
        if (selected < 0 || entries[selected::u64].protected == 0) { ret 0; }
        i = i + 1;
    }
    val essentials: [3]*u8 = [3]*u8{"machos-base", "machos-kernel", "machos-boot"};
    var e:          u64    = 0;
    for (e < 3) {
        var found: u8  = 0;
        var n:     u64 = 0;
        for (n < system_count) {
            if (io.streq(essentials[e], ?systems[n][0]) != 0) { found = 1; }
            n = n + 1;
        }
        if (found == 0) { ret 0; }
        e = e + 1;
    }
    ret 1;
}

pub fun find(name: *u8, constraint: *u8) i64 {
    var best: i64 = -1;
    var i:    u64 = 0;
    for (i < count) {
        if (io.streq(name, ?entries[i].name[0]) != 0 && (constraint == nil || pkg.satisfies(?entries[i].version[0], constraint) != 0)) {
            if (best < 0)                                                                { best = i::i64; }
            or (pkg.compare(?entries[i].version[0], ?entries[best::u64].version[0]) > 0) { best = i::i64; }
        }
        i = i + 1;
    }
    ret best;
}

pub fun get(n: u64) *Entry {
    if (n >= count) { ret nil; }
    ret ?entries[n];
}

pub fun system(n: u64) *u8 {
    if (n >= system_count) { ret nil; }
    ret ?systems[n][0];
}

fun cached(path: *u8, out: *fs.Blob) u8 {
    if (fs.directory(CACHE, 0o755, 0) == 0 || fs.parents(path, 0) == 0 || fs.read(path, LIMIT, out) == 0) { ret 0; }
    var sig: [256]u8;
    val n:   u64 = io.len(path);
    io.copy(?sig[0], path, n);
    io.copy(?sig[n], ".sig", 5);
    if (official(out, ?sig[0]) == 0) {
        fs.release(out);
        ret 0;
    }
    ret 1;
}

pub fun load(latest: u8) u8 {
    var blob: fs.Blob;
    if (cached("/var/lib/mpm/repository/stable.toml", ?blob) == 0) { ret fail("no verified repository cache; run mpm refresh"); }
    val good: u8 = catalogue(?blob);
    fs.release(?blob);
    if (good == 0) { ret fail("invalid or expired repository catalogue; run mpm refresh"); }
    var release: *Release = ?current;
    var path:    *u8      = "/var/lib/mpm/repository/current.toml";
    if (latest != 0) {
        release = ?newest;
        path    = "/var/lib/mpm/repository/latest.toml";
    }
    if (cached(path, ?blob) == 0) { ret 0; }
    val parsed: u8 = index(?blob, release);
    fs.release(?blob);
    if (parsed == 0) { ret fail("cached repository index is invalid"); }
    ret 1;
}

fun add_cache(path: *u8, source: *u8, data: *fs.Blob) u8 {
    var signature: [256]u8;
    val n:         u64 = io.len(source);
    io.copy(?signature[0], source, n);
    io.copy(?signature[n], ".sig", 5);
    var sig: fs.Blob;
    if (fs.read(?signature[0], 1536, ?sig) == 0) { ret 0; }
    # The transaction borrows these buffers until commit; keep them allocated.
    var destination: [256]u8;
    val k:           u64 = io.len(path);
    io.copy(?destination[0], path, k);
    io.copy(?destination[k], ".sig", 5);
    ret (tx.add(path, data.data, data.len, 0o644, 0) != 0 && tx.add(?destination[0], sig.data, sig.len, 0o644, 0) != 0)::u8;
}

pub fun refresh() u8 {
    var url: [512]u8;
    var n:   u64 = conf.get("mpm.repository", ?url[0], 512);
    if (n == 0) {
        val fallback: *u8 = "https://raw.githubusercontent.com/Wmakes/machos-repository/main/stable.toml";
        n = io.len(fallback);
        io.copy(?url[0], fallback, n + 1);
    }
    if (n == 0 || n > 480 || https(?url[0]) == 0 || fs.directory(CACHE, 0o755, 1) == 0) { ret fail("invalid repository configuration"); }
    var signature_url: [520]u8;
    io.copy(?signature_url[0], ?url[0], n);
    io.copy(?signature_url[n], ".sig", 5);
    var root: fs.Blob;
    if (fetch_pair(?url[0], ?signature_url[0], "/var/lib/mpm/transaction/stable.download", LIMIT, ?root) == 0) { ret 0; }
    if (catalogue(?root) == 0)                                                                                 { ret fail("invalid repository catalogue"); }
    val new_revision: u64 = revision;
    var old:          fs.Blob;
    if (fs.exists("/var/lib/mpm/repository/stable.toml") != 0) {
        if (cached("/var/lib/mpm/repository/stable.toml", ?old) == 0) { ret fail("existing repository cache is unsafe"); }
        var storage: arena.Arena;
        fin { arena.dnit(?storage); }
        var table: toml.Table;
        var prior: u64 = 0;
        if (parse(?old, ?storage, ?table) == 0 || number(?table, "revision", ?prior) == 0 || new_revision < prior || (new_revision == prior && io.eq(root.data, root.len, old.data, old.len) == 0)) {
            fs.release(?old);
            ret fail("refusing replayed or changed repository metadata");
        }
        if (new_revision == prior + 1) {
            var parent: [65]u8;
            if (text(?table, "previous_sha256", ?parent[0], 65) == 0) {
                fs.release(?old);
                ret 0;
            }
            # The new catalogue, not its predecessor, carries the parent's hash.
            var fresh_storage: arena.Arena;
            fin { arena.dnit(?fresh_storage); }
            var fresh: toml.Table;
            if (parse(?root, ?fresh_storage, ?fresh) == 0 || text(?fresh, "previous_sha256", ?parent[0], 65) == 0 || hash_ok(old.data, old.len, ?parent[0]) == 0) {
                fs.release(?old);
                ret fail("repository catalogue parent does not match cache");
            }
        }
        fs.release(?old);
    }
    var active: fs.Blob;
    var latest: fs.Blob;
    if (fetch_pair(?current.url[0], ?current.signature_url[0], "/var/lib/mpm/transaction/current.download", LIMIT, ?active) == 0 || index(?active, ?current) == 0)                                                                                                                                                                                                  { ret fail("invalid current-OS repository index"); }
    if (fetch_pair(?newest.url[0], ?newest.signature_url[0], "/var/lib/mpm/transaction/latest.download", LIMIT, ?latest) == 0 || index(?latest, ?newest) == 0)                                                                                                                                                                                                      { ret fail("invalid latest-OS repository index"); }
    if (add_cache("/var/lib/mpm/repository/stable.toml", "/var/lib/mpm/transaction/stable.download", ?root) == 0 || add_cache("/var/lib/mpm/repository/current.toml", "/var/lib/mpm/transaction/current.download", ?active) == 0 || add_cache("/var/lib/mpm/repository/latest.toml", "/var/lib/mpm/transaction/latest.download", ?latest) == 0 || tx.commit() == 0) { ret 0; }
    io.msg("mpm: refreshed verified stable repository\n");
    ret 1;
}

pub fun download(n: u64, out: *u8, maximum: u64) u8 {
    if (n >= count) { ret 0; }
    val p: *Entry = ?entries[n];
    if (p.size > maximum) { ret fail("repository archive exceeds configured download limit"); }
    val prefix: u64 = io.len(tx.STAGE);
    val name:   u64 = io.len(?p.filename[0]);
    if (prefix + 1 + name >= 512) { ret 0; }
    io.copy(out, tx.STAGE, prefix);
    out[prefix] = 47;
    io.copy(?out[prefix + 1], ?p.filename[0], name + 1);
    var blob: fs.Blob;
    if (fetch_pair(?p.url[0], ?p.signature_url[0], out, p.size, ?blob) == 0) { ret 0; }
    val good: u8 = (blob.len == p.size && hash_ok(blob.data, blob.len, ?p.digest[0]) != 0)::u8;
    fs.release(?blob);
    if (good == 0) { ret fail("downloaded package does not match signed index"); }
    ret 1;
}

pub fun search(query: *u8) u8 {
    var i: u64 = 0;
    for (i < count) {
        if (find(?entries[i].name[0], nil) == i::i64) {
            var match: u8  = (query == nil || query[0] == 0)::u8;
            val n:     u64 = io.len(?entries[i].name[0]);
            var at:    u64 = 0;
            if (query != nil) {
                val q: u64 = io.len(query);
                for (at + q <= n) {
                    if (io.eq(?entries[i].name[at], q, query, q) != 0) { match = 1; }
                    at = at + 1;
                }
            }
            if (match != 0) {
                io.out(?entries[i].name[0]);
                io.putc(32);
                io.out(?entries[i].version[0]);
                io.msg(" - ");
                io.out(?entries[i].description[0]);
                io.putc(10);
            }
        }
        i = i + 1;
    }
    ret 1;
}
