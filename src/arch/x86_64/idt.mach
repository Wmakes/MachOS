# save every gpr, hand the frame to isr_dispatch, restore, drop vector+error, iretq
#[naked]
#[symbol("isr_common")]
fun isr_common() {
    asm x86_64 {
        push rax
        push rbx
        push rcx
        push rdx
        push rsi
        push rdi
        push rbp
        push r8
        push r9
        push r10
        push r11
        push r12
        push r13
        push r14
        push r15
        cld
        mov rdi, rsp
        call isr_dispatch
        pop r15
        pop r14
        pop r13
        pop r12
        pop r11
        pop r10
        pop r9
        pop r8
        pop rbp
        pop rdi
        pop rsi
        pop rdx
        pop rcx
        pop rbx
        pop rax
        add rsp, 16
        iretq
    }
}

#[naked]
#[symbol("idt_load")]
fun idt_load(p: *Pointer) {
    asm x86_64 {
        lidt [rdi]
        ret
    }
}

pub fun set_gate(v: u64, handler: u64, ist: u8) {
    gates[v].off_lo  = (handler & 0xFFFF)::u16;
    gates[v].sel     = gdt.KCODE;
    gates[v].ist     = ist;
    gates[v].attr    = 0x8E; # present, dpl 0, interrupt gate
    gates[v].off_mid = ((handler >> 16) & 0xFFFF)::u16;
    gates[v].off_hi  = (handler >> 32)::u32;
    gates[v].zero    = 0;
}

pub val VECTORS: u64 = 64;

pub fun init() {
    val base: u64 = isr_stubs::u64;
    var v: u64 = 0;
    for (v < VECTORS) {
        var ist: u8 = 0;
        if (v == 8) { ist = 1; }
        set_gate(v, base + v * STUB_SIZE, ist);
        v = v + 1;
    }
    ptr.limit = ($size_of([256]Gate) - 1)::u16;
    ptr.base  = (?gates[0])::u64;
    idt_load(?ptr);
}
