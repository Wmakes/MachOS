# head [-N] [FILE]: the first N (default 10) lines

use abi: machos.abi.sys;
use sys: machos.user.sys;
use io:  machos.user.io;
use rt:  machos.user.rt;

var buf: [4096]u8;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var want: u64 = 10;
    var i: u64 = 1;
    if (i < argc && argv[i][0] == 45) {
        var ok: u8 = 0;
        want = io.parse_dec(?argv[i][1], io.len(argv[i]) - 1, ?ok);
        if (ok == 0) {
            io.err("usage: head [-N] [FILE]\n\0");
            ret 2;
        }
        i = i + 1;
    }
    var h: u64 = abi.STDIN;
    if (i < argc) {
        h = sys.open(argv[i], io.len(argv[i]), abi.O_READ);
        if (abi.is_err(h) != 0) {
            io.fail("head\0", argv[i], h);
            ret 1;
        }
    }
    var seen: u64 = 0;
    for (seen < want) {
        val r: u64 = sys.read(h, ?buf[0], 4096);
        if (abi.is_err(r) != 0 || r == 0) { brk; }
        var k: u64 = 0;
        for (k < r && seen < want) {
            if (buf[k] == 10) { seen = seen + 1; }
            k = k + 1;
        }
        io.outn(?buf[0], k);
    }
    ret 0;
}
