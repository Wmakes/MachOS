# tty: the name of the terminal on standard input (/dev/tty1 ... /dev/tty6)

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    val n: u64 = sys.tty_number(abi.STDIN);
    if (n != 0) {
        io.out("/dev/tty\0");
        io.dec(n);
        io.putc(10);
        ret 0;
    }
    io.out("not a tty\n\0");
    ret 1;
}
