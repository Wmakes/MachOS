# runtime settings shared by standard-library programs and SDK utilities

use sdk.settings;

pub fun get(key: *u8, out: *u8, cap: u64) u64 {
    ret settings.get(key, out, cap);
}

pub fun yes(key: *u8, fallback: u8) u8 {
    ret settings.yes(key, fallback);
}

pub fun number(key: *u8, fallback: u64) u64 {
    ret settings.number(key, fallback);
}

pub fun path(key: *u8) *u8 {
    ret settings.path(key);
}
