# confirm PROMPT: print PROMPT, read a line; succeed only if it is "yes"

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    if (argc > 1) { io.out(argv[1]); }
    var line: [64]u8;
    val n: i64 = io.read(io.STDIN, ?line[0], 64);
    if (n < 0 || n < 3) { ret 1; }
    var k: u64 = n::u64;
    if (line[k - 1] == 10) { k = k - 1; }
    if (io.eq(?line[0], k, "yes\0", 3) != 0) { ret 0; }
    ret 1;
}
