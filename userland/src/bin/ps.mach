# ps: list processes (from /proc)

use std.runtime;
use io:     userland.lib.cli;
use system: userland.lib.system;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun show(p: *system.Proc) {
    io.dec_pad(p.pid, 5);
    io.dec_pad(p.ppid, 6);
    io.dec_pad(p.group, 7);
    if (p.state == 82)      { io.out(" running "); }
    or (p.state == 83)      { io.out(" waiting "); }
    or (p.state == 84)      { io.out(" stopped "); }
    or                      { io.out(" zombie  "); }
    io.dec_pad(p.pages * 4, 5);
    io.out("K  ");
    io.outn(?p.name[0], p.name_len);
    io.putc(10);
}

fun run(argc: u64, argv: **u8) u64 {
    io.out("  PID  PPID  GROUP STATE     MEM  NAME\n");
    system.processes(show);
    ret 0;
}
