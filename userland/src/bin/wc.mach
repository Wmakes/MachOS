# wc [-l] [-w] [-c] [FILE...]: count lines, words and bytes (all three
# unless some are asked for)

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

var buf: [4096]u8;
var tl: u64 = 0;
var tw: u64 = 0;
var tb: u64 = 0;
var show_l: u8 = 1;
var show_w: u8 = 1;
var show_c: u8 = 1;

fun report(lines: u64, words: u64, bytes: u64, name: *u8) {
    if (show_l != 0) { io.dec_pad(lines, 7); }
    if (show_w != 0) { io.dec_pad(words, 8); }
    if (show_c != 0) { io.dec_pad(bytes, 8); }
    if (name != nil) {
        io.putc(32);
        io.out(name);
    }
    io.putc(10);
}

fun count(h: u64, name: *u8) u8 {
    var lines: u64 = 0;
    var words: u64 = 0;
    var bytes: u64 = 0;
    var inword: u8 = 0;
    for {
        val r: u64 = sys.read(h, ?buf[0], 4096);
        if (abi.is_err(r) != 0) {
            io.fail("wc\0", name, r);
            ret 0;
        }
        if (r == 0) { brk; }
        var i: u64 = 0;
        for (i < r) {
            val c: u8 = buf[i];
            if (c == 10) { lines = lines + 1; }
            if (c == 32 || c == 10 || c == 9 || c == 13) {
                inword = 0;
            } or (inword == 0) {
                inword = 1;
                words = words + 1;
            }
            i = i + 1;
        }
        bytes = bytes + r;
    }
    report(lines, words, bytes, name);
    tl = tl + lines;
    tw = tw + words;
    tb = tb + bytes;
    ret 1;
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var first: u64 = 1;
    var picked: u8 = 0;
    for (first < argc && argv[first][0] == 45 && argv[first][1] != 0) {
        if (picked == 0) {
            show_l = 0;
            show_w = 0;
            show_c = 0;
            picked = 1;
        }
        var k: u64 = 1;
        for (argv[first][k] != 0) {
            if (argv[first][k] == 108) { show_l = 1; }
            or (argv[first][k] == 119) { show_w = 1; }
            or (argv[first][k] == 99) { show_c = 1; }
            or {
                io.err("usage: wc [-l] [-w] [-c] [FILE...]\n\0");
                ret 2;
            }
            k = k + 1;
        }
        first = first + 1;
    }
    if (argc - first == 0) {
        if (count(abi.STDIN, nil) == 0) { ret 1; }
        ret 0;
    }
    var status: u64 = 0;
    var i: u64 = first;
    for (i < argc) {
        val h: u64 = sys.open(argv[i], io.len(argv[i]), abi.O_READ);
        if (abi.is_err(h) != 0) {
            io.fail("wc\0", argv[i], h);
            status = 1;
        } or {
            if (count(h, argv[i]) == 0) { status = 1; }
            sys.close(h);
        }
        i = i + 1;
    }
    if (argc - first > 1) { report(tl, tw, tb, "total\0"); }
    ret status;
}
