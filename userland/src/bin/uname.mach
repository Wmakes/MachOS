# uname [-a] [-n]: name the system (as the running kernel reports it in
# /proc); -n: the machine's name

use std.runtime;
use io:     userland.lib.cli;
use system: userland.lib.system;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    if (argc > 1 && io.streq(argv[1], "-n") != 0) {
        var h: [64]u8;
        system.line("/proc/sys/kernel/hostname", ?h[0], 64);
        io.out(?h[0]);
        io.putc(10);
        ret 0;
    }
    var name: [32]u8;
    system.line("/proc/sys/kernel/ostype", ?name[0], 32);
    io.out(?name[0]);
    if (argc > 1 && io.streq(argv[1], "-a") != 0) {
        var host: [64]u8;
        var rel: [32]u8;
        system.line("/proc/sys/kernel/hostname", ?host[0], 64);
        system.release(?rel[0], 32);
        io.out(" ");
        io.out(?rel[0]);
        io.out(" x86_64 on ");
        io.out(?host[0]);
        io.out(" (kernel and userland written in mach)");
    }
    io.putc(10);
    ret 0;
}
