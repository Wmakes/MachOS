# ls [-l] [PATH...]: list directories (directories end in /)

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;
use text: userland.lib.text;
use users: sdk.users;

var long: u8 = 0;
var color: u8 = 0; # only on a terminal: pipes get plain names

# names of the last uid and gid looked up (ls lists many of the same)
var last_uid: u64 = 0xFFFFFFFFFFFFFFFF;
var last_gid: u64 = 0xFFFFFFFFFFFFFFFF;
var uname: [32]u8;
var uname_len: u64 = 0;
var gname: [32]u8;
var gname_len: u64 = 0;

fun pad_out(s: *u8, n: u64, width: u64) {
    io.outn(s, n);
    var k: u64 = n;
    for (k < width) {
        io.putc(32);
        k = k + 1;
    }
}

fun mode_string(kind: u64, mode: u64) {
    var m: [10]u8;
    m[0] = 45;
    if (kind == abi.KIND_DIR) { m[0] = 100; }
    or (kind == abi.KIND_DEV) { m[0] = 99; }
    val rwx: *u8 = "rwxrwxrwx\0";
    var i: u64 = 0;
    for (i < 9) {
        if ((mode & (0x100 >> i::u64)) != 0) { m[1 + i] = rwx[i]; }
        or                                    { m[1 + i] = 45; }
        i = i + 1;
    }
    if ((mode & abi.S_ISUID) != 0) {
        if (m[3] == 120) { m[3] = 115; } or { m[3] = 83; }
    }
    if ((mode & abi.S_ISGID) != 0) {
        if (m[6] == 120) { m[6] = 115; } or { m[6] = 83; }
    }
    if ((mode & abi.S_ISVTX) != 0) {
        if (m[9] == 120) { m[9] = 116; } or { m[9] = 84; }
    }
    io.outn(?m[0], 10);
}

fun show(e: *abi.Entry) {
    if (long != 0) {
        mode_string(e.kind, e.mode);
        io.putc(32);
        if (e.uid != last_uid) {
            uname_len = users.user_name(e.uid, ?uname[0]);
            last_uid = e.uid;
        }
        if (e.gid != last_gid) {
            gname_len = users.group_name(e.gid, ?gname[0]);
            last_gid = e.gid;
        }
        pad_out(?uname[0], uname_len, 8);
        io.putc(32);
        pad_out(?gname[0], gname_len, 8);
        io.dec_pad(e.size, 8);
        io.out("  \0");
        var t: [16]u8;
        io.outn(?t[0], text.fmt_time(e.mtime, ?t[0]));
        io.out("  \0");
    }
    # directories blue, devices yellow, programs green
    var paint: *u8 = nil;
    if (e.kind == abi.KIND_DIR) { paint = "\x1b[1;34m\0"; }
    or (e.kind == abi.KIND_DEV) { paint = "\x1b[1;33m\0"; }
    or ((e.mode & 0x49) != 0)   { paint = "\x1b[1;32m\0"; }
    if (color != 0 && paint != nil) { io.out(paint); }
    io.outn(?e.name[0], e.name_len);
    if (color != 0 && paint != nil) { io.out("\x1b[0m\0"); }
    if (e.kind == abi.KIND_DIR) { io.putc(47); }
    io.putc(10);
}

fun list(p: *u8) u8 {
    val n: u64 = io.len(p);
    var st: abi.Stat;
    val r: u64 = sys.stat(p, n, ?st);
    if (abi.is_err(r) != 0) {
        io.fail("ls\0", p, r);
        ret 0;
    }
    if (st.kind != abi.KIND_DIR) {
        var e: abi.Entry;
        e.kind = st.kind;
        e.size = st.size;
        e.mtime = st.mtime;
        e.mode = st.mode;
        e.uid = st.uid;
        e.gid = st.gid;
        var k: u64 = n;
        if (k > 59) { k = 59; }
        e.name_len = k;
        io.copy(?e.name[0], p, k);
        show(?e);
        ret 1;
    }
    val h: u64 = sys.open(p, n, abi.O_READ);
    if (abi.is_err(h) != 0) {
        io.fail("ls\0", p, h);
        ret 0;
    }
    var i: u64 = 0;
    for {
        var e: abi.Entry;
        val got: u64 = sys.readdir(h, i, ?e);
        if (abi.is_err(got) != 0 || got == 0) { brk; }
        show(?e);
        i = i + 1;
    }
    sys.close(h);
    ret 1;
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    color = sys.isatty(abi.STDOUT);
    var i: u64 = 1;
    if (argc > 1 && io.streq(argv[1], "-l\0") != 0) {
        long = 1;
        i = 2;
    }
    if (i == argc) {
        if (list(".\0") == 0) { ret 1; }
        ret 0;
    }
    var status: u64 = 0;
    val many: u8 = (argc - i > 1)::u8;
    for (i < argc) {
        if (many != 0) {
            io.out(argv[i]);
            io.out(":\n\0");
        }
        if (list(argv[i]) == 0) { status = 1; }
        i = i + 1;
    }
    ret status;
}
