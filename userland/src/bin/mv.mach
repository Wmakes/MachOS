# mv FROM TO: rename or move a file or directory

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    if (argc != 3) {
        io.err("usage: mv FROM TO\n\0");
        ret 2;
    }
    # moving into an existing directory keeps the name
    var to: [256]u8;
    var tn: u64 = io.len(argv[2]);
    if (tn >= 256) { tn = 255; }
    io.copy(?to[0], argv[2], tn);
    var st: os.stat_t;
    if (io.stat(argv[2], ?st) >= 0 && io.kind_of(st.st_mode) == io.KIND_DIR) {
        val from: *u8 = argv[1];
        val fl: u64 = io.len(from);
        var b: u64 = fl;
        for (b > 0 && from[b - 1] != 47) { b = b - 1; }
        if (tn + 1 + fl - b < 256) {
            to[tn] = 47;
            io.copy(?to[tn + 1], ?from[b], fl - b);
            tn = tn + 1 + fl - b;
        }
    }
    to[tn] = 0;
    val r: i64 = io.rename(argv[1], ?to[0]);
    if (r < 0) {
        io.fail("mv\0", argv[1], r);
        ret 1;
    }
    ret 0;
}
