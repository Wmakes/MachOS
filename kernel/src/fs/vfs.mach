# the file tree every path resolves through. a Node is either kept in memory
# (FS_RAM: /dev, /tmp, or everything when booted from the initrd) or stands
# for an ext2 inode (FS_EXT2). ext2 directories are read into the tree the
# first time they are looked at, so the tree doubles as a lookup cache.
# a memory node may hang under a disk directory: that is how /dev and /tmp
# sit on top of the root filesystem without existing on the disk

use abi:  sdk.abi;
use heap: machos.mm.heap;
use mem:  machos.kern.mem;
use path: machos.fs.path;
use ext2: machos.fs.ext2;
use fat:  machos.fs.fat;
use exfat: machos.fs.exfat;
use clock: machos.kern.clock;

pub val FS_RAM:  u64 = 0;
pub val FS_EXT2: u64 = 1;
pub val FS_FAT:  u64 = 2;   # FAT16/32 (fs/fat.mach)
pub val FS_EXFAT: u64 = 3;  # exFAT (fs/exfat.mach)
pub val FS_PROC: u64 = 4;   # /proc: made up when read (kern/procfs.mach)

pub val DEV_CONSOLE: u64 = 1;

# which terminal a device is (0 = tty1), or 0xFF when it is not one
pub fun tty_of(dev: u64) u64 {
    if (dev == DEV_CONSOLE) { ret 0; }
    if (dev >= DEV_TTY && dev < DEV_TTY + 6) { ret dev - DEV_TTY; }
    ret 0xFF;
}
pub val DEV_NULL:    u64 = 2;
pub val DEV_ZERO:    u64 = 3;
pub val DEV_TTY:     u64 = 4;  # + 0..5: tty1..tty6 (the console is tty1)
pub val DEV_EVENTS:  u64 = 12; # /dev/events (kern/events.mach)
pub val DEV_DISK:    u64 = 16; # + the AHCI disk index

pub rec Node {
    kind:     u64; # abi.KIND_*
    size:     u64;
    fs:       u64; # FS_*
    ino:      u64; # FS_EXT2: inode number
    fsi:      *ext2.Fs; # FS_EXT2: the filesystem it is on
    mounted:  *Node;    # a directory with a filesystem mounted on it: that root
    mount_of: *Node;    # the root of a mounted filesystem: where it is mounted
    loaded:   u8;  # FS_EXT2 directory: entries are in the tree
    cap:      u64; # FS_RAM file: heap buffer `data` of `cap` bytes
    data:     u64;
    dev:      u64; # KIND_DEV: DEV_*
    mtime:    u64; # FS_RAM: last change (ext2 keeps its own in the inode)
    mode:     u64; # permission bits, 07777
    uid:      u64;
    gid:      u64;
    parent:   *Node;
    child:    *Node; # first entry of a directory
    next:     *Node; # next entry in the parent
    opens:    u64;   # handles open on it
    unlinked: u8;    # out of the tree; freed at the last close
    dead:     u8;    # FS_EXT2: no links left, release the inode at the last close
    name_len: u64;
    name:     [256]u8;
    fatfs:    *fat.Fs;    # FS_FAT: the filesystem (ino = the first cluster)
    exfs:     *exfat.Fs;  # FS_EXFAT: the filesystem (ino = the first cluster)
    fidx:     u64;        # FAT/exFAT: its entry's index in the parent directory
    fcount:   u64;        # FAT: long-name entries before it; exFAT: entries in its set
    xnochain: u8;         # exFAT: the data is one contiguous run
    pid:      u64;        # FS_PROC: the process a file is about (0: the reader)
}

var root: *Node = nil;

# /proc's contents come from kern/procfs.mach, which sits above the vfs:
# it hands over its readers here at boot
var proc_ready: u8 = 0;
var proc_read: fun(*Node, u64, u64, u64) u64;
var proc_write: fun(*Node, u64, u64) u64;
var proc_refresh: fun(*Node);

pub fun set_proc(r: fun(*Node, u64, u64, u64) u64, w: fun(*Node, u64, u64) u64, f: fun(*Node)) {
    proc_read = r;
    proc_write = w;
    proc_refresh = f;
    proc_ready = 1;
}

# a /proc entry: file `id` (procfs's numbering) about process `pid`
pub fun make_proc(dir: *Node, name: *u8, n: u64, kind: u64, id: u64, pid: u64, mode: u64) *Node {
    val nd: *Node = new_node(kind, FS_PROC, name, n);
    if (nd == nil) { ret nil; }
    nd.ino = id;
    nd.pid = pid;
    nd.mode = mode;
    nd.loaded = 1;
    attach(dir, nd);
    ret nd;
}

# take a /proc entry (and what is in it) away: a process that ended
pub fun drop_proc(nd: *Node) {
    var c: *Node = nd.child;
    for (c != nil) {
        val next: *Node = c.next;
        drop_proc(c);
        c = next;
    }
    detach(nd);
    nd.unlinked = 1;
    if (nd.opens == 0) { destroy(nd); }
}

fun e(code: u64) u64 { ret abi.err(code); }

fun new_node(kind: u64, fs: u64, name: *u8, n: u64) *Node {
    if (n > abi.NAME_MAX) { ret nil; }
    val nd: *Node = heap.zalloc($size_of(Node)::u64)::*Node;
    if (nd == nil) { ret nil; }
    nd.kind = kind;
    nd.fs = fs;
    nd.name_len = n;
    mem.copy((?nd.name[0])::u64, name::u64, n);
    nd.mtime = clock.now();
    nd.mode = 0x1A4; # 0644
    if (kind == abi.KIND_DIR) { nd.mode = 0x1ED; } # 0755
    ret nd;
}

# --- credentials and permissions --------------------------------------------
# the credentials path lookups and checks run with: the effective ids of the
# process whose system call is being served (root while the kernel boots)

var cred_uid: u64 = 0;
var cred_gid: u64 = 0;
var denied: u8 = 0; # the last lookup stopped at a directory it may not search

pub fun set_cred(uid: u64, gid: u64) {
    cred_uid = uid;
    cred_gid = gid;
    denied = 0;
}

pub fun was_denied() u8 { ret denied; }

# whether uid/gid may `want` (R_OK|W_OK|X_OK) on nd. root may read and
# write anything, and execute anything with an x bit (or a directory)
pub fun allowed_as(nd: *Node, want: u64, uid: u64, gid: u64) u8 {
    if (uid == 0) {
        if ((want & abi.X_OK) == 0 || nd.kind == abi.KIND_DIR || (nd.mode & 0x49) != 0) { ret 1; }
        ret 0;
    }
    var bits: u64 = nd.mode & 7;
    if (nd.uid == uid) { bits = (nd.mode >> 6) & 7; }
    or (nd.gid == gid) { bits = (nd.mode >> 3) & 7; }
    if ((bits & want) == want) { ret 1; }
    ret 0;
}

pub fun allowed(nd: *Node, want: u64) u8 { ret allowed_as(nd, want, cred_uid, cred_gid); }

pub fun set_attr(nd: *Node, mode: u64, uid: u64, gid: u64) {
    nd.mode = mode & 0xFFF;
    nd.uid = uid;
    nd.gid = gid;
    if (nd.fs == FS_EXT2) { ext2.set_attr(nd.fsi, nd.ino, nd.mode, uid, gid); }
    or (nd.fs == FS_RAM) { nd.mtime = clock.now(); }
    # FAT and exFAT have no owners or modes: kept in memory only
}

fun attr_from(nd: *Node, i: *ext2.Inode) {
    nd.size = ext2.size_of(i);
    nd.mode = (i.mode & 0xFFF)::u64;
    nd.uid = i.uid::u64;
    nd.gid = i.gid::u64;
}

# when `nd` last changed
pub fun mtime_of(nd: *Node) u64 {
    if (nd.fs == FS_EXT2) {
        var i: ext2.Inode;
        if (ext2.read_inode(nd.fsi, nd.ino, ?i) != 0) { ret i.mtime::u64; }
        ret 0;
    }
    ret nd.mtime;
}

# the absolute path of a node (through mountpoints) into out (path MAX
# bytes); its length, or 0 if it does not fit
pub fun path_of(nd: *Node, out: *u8) u64 {
    var parts: [64]*Node;
    var n: u64 = 0;
    var c: *Node = nd;
    for (c != root && n < 64) {
        if (c.mount_of != nil) { c = c.mount_of; }
        if (c == root) { brk; }
        parts[n] = c;
        n = n + 1;
        c = c.parent;
    }
    var len: u64 = 0;
    if (n == 0) {
        out[0] = 47;
        ret 1;
    }
    for (n > 0) {
        n = n - 1;
        val p: *Node = parts[n];
        if (len + 1 + p.name_len >= path.MAX) { ret 0; }
        out[len] = 47;
        mem.copy((?out[len + 1])::u64, (?p.name[0])::u64, p.name_len);
        len = len + 1 + p.name_len;
    }
    ret len;
}

fun attach(dir: *Node, nd: *Node) {
    nd.parent = dir;
    nd.next = nil;
    # keep entries in the order they came, so `ls` is stable
    if (dir.child == nil) {
        dir.child = nd;
        ret;
    }
    var c: *Node = dir.child;
    for (c.next != nil) { c = c.next; }
    c.next = nd;
}

fun detach(nd: *Node) {
    val dir: *Node = nd.parent;
    if (dir.child == nd) {
        dir.child = nd.next;
    } or {
        var c: *Node = dir.child;
        for (c != nil && c.next != nd) { c = c.next; }
        if (c != nil) { c.next = nd.next; }
    }
    nd.next = nil;
}

# an empty in-memory root (booting from the initrd)
pub fun init_ram() u8 {
    root = new_node(abi.KIND_DIR, FS_RAM, "\0", 0);
    if (root == nil) { ret 0; }
    root.parent = root;
    ret 1;
}

# a mounted ext2 filesystem as the root
pub fun init_ext2(fs: *ext2.Fs) u8 {
    root = ext2_root(fs);
    if (root == nil) { ret 0; }
    root.parent = root;
    ret 1;
}

fun ext2_root(fs: *ext2.Fs) *Node {
    val nd: *Node = new_node(abi.KIND_DIR, FS_EXT2, "\0", 0);
    if (nd == nil) { ret nil; }
    nd.ino = ext2.ROOT_INO;
    nd.fsi = fs;
    var i: ext2.Inode;
    if (ext2.read_inode(fs, ext2.ROOT_INO, ?i) != 0) { attr_from(nd, ?i); }
    ret nd;
}

pub fun get_root() *Node { ret root; }

fun fat_root(fs: *fat.Fs) *Node {
    val nd: *Node = new_node(abi.KIND_DIR, FS_FAT, "\0", 0);
    if (nd == nil) { ret nil; }
    nd.fatfs = fs;
    nd.ino = fs.root;
    nd.mode = 0x1ED;
    ret nd;
}

fun exfat_root(fs: *exfat.Fs) *Node {
    val nd: *Node = new_node(abi.KIND_DIR, FS_EXFAT, "\0", 0);
    if (nd == nil) { ret nil; }
    nd.exfs = fs;
    nd.ino = fs.root;
    nd.mode = 0x1ED;
    ret nd;
}

# an exFAT directory node as exfat.Dir (where it is, and where its parent is)
fun exdir(nd: *Node, d: *exfat.Dir) {
    d.first = nd.ino;
    d.nochain = nd.xnochain;
    d.size = nd.size;
    d.root = (nd.mount_of != nil || nd == root)::u8;
    if (d.root != 0) { d.size = 0; }
    d.idx = nd.fidx;
    if (d.root == 0) {
        val p: *Node = nd.parent;
        d.up_first = p.ino;
        d.up_nochain = p.xnochain;
        d.up_size = p.size;
        if (p.mount_of != nil || p == root) { d.up_size = 0; }
    }
}

fun exback(nd: *Node, d: *exfat.Dir) {
    if (d.root == 0) { nd.size = d.size; }
    nd.xnochain = d.nochain;
}

# read an ext2 directory's entries into the tree, once
fun load(dir: *Node) {
    if (dir.kind != abi.KIND_DIR || dir.loaded != 0) { ret; }
    if (dir.fs == FS_FAT) {
        dir.loaded = 1;
        var pos: u64 = 0;
        var f: fat.Found;
        for (fat.dir_next(dir.fatfs, dir.ino, ?pos, ?f) != 0) {
            var kind: u64 = abi.KIND_FILE;
            if (f.dir != 0) { kind = abi.KIND_DIR; }
            val nd: *Node = new_node(kind, FS_FAT, ?f.name[0], f.nlen);
            if (nd == nil) { brk; }
            nd.fatfs = dir.fatfs;
            nd.ino = f.first;
            nd.size = f.size;
            if (f.dir != 0) { nd.size = 0; }
            nd.fidx = f.idx;
            nd.fcount = f.lfn;
            nd.mtime = f.mtime;
            nd.mode = 0x1ED;
            nd.loaded = 0;
            attach(dir, nd);
        }
        ret;
    }
    if (dir.fs == FS_EXFAT) {
        dir.loaded = 1;
        var pos: u64 = 0;
        var f: exfat.Found;
        var dsize: u64 = dir.size;
        if (dir.mount_of != nil || dir == root) { dsize = 0; }
        for (exfat.dir_next(dir.exfs, dir.ino, dir.xnochain, dsize, ?pos, ?f) != 0) {
            var kind: u64 = abi.KIND_FILE;
            if (f.dir != 0) { kind = abi.KIND_DIR; }
            val nd: *Node = new_node(kind, FS_EXFAT, ?f.name[0], f.nlen);
            if (nd == nil) { brk; }
            nd.exfs = dir.exfs;
            nd.ino = f.first;
            nd.size = f.size;
            nd.xnochain = f.nochain;
            nd.fidx = f.idx;
            nd.fcount = f.count;
            nd.mtime = f.mtime;
            nd.mode = 0x1ED;
            attach(dir, nd);
        }
        ret;
    }
    if (dir.fs != FS_EXT2) { ret; }
    dir.loaded = 1;
    var pos: u64 = 0;
    var name: [256]u8;
    var nl: u64 = 0;
    var ino: u64 = 0;
    var kind: u64 = 0;
    for (ext2.dir_next(dir.fsi, dir.ino, ?pos, ?name[0], ?nl, ?ino, ?kind) != 0) {
        val nd: *Node = new_node(kind, FS_EXT2, ?name[0], nl);
        if (nd == nil) { brk; }
        nd.ino = ino;
        nd.fsi = dir.fsi;
        var i: ext2.Inode;
        if (ext2.read_inode(dir.fsi, ino, ?i) != 0) { attr_from(nd, ?i); }
        attach(dir, nd);
    }
}

pub fun child(dir: *Node, name: *u8, n: u64) *Node {
    if (dir.kind != abi.KIND_DIR) { ret nil; }
    val d: *Node = through(dir);
    if (d.fs == FS_PROC && proc_ready != 0) { proc_refresh(d); }
    load(d);
    var c: *Node = d.child;
    for (c != nil) {
        if (c.name_len == n && mem.equal(?c.name[0], name, n) != 0) { ret through(c); }
        c = c.next;
    }
    ret nil;
}

# what is visible at `nd`: the root mounted there, if any
pub fun through(nd: *Node) *Node {
    if (nd.mounted != nil) { ret nd.mounted; }
    ret nd;
}

pub fun nth_child(dir: *Node, idx: u64) *Node {
    val d: *Node = through(dir);
    if (d.fs == FS_PROC && proc_ready != 0 && idx == 0) { proc_refresh(d); }
    load(d);
    var c: *Node = d.child;
    var i: u64 = 0;
    for (c != nil && i < idx) {
        c = c.next;
        i = i + 1;
    }
    if (c == nil) { ret nil; }
    ret through(c);
}

pub fun is_empty(dir: *Node) u8 {
    load(dir);
    if (dir.child == nil) { ret 1; }
    ret 0;
}

# the node at a normalized absolute path, or nil
pub fun lookup(p: *u8, n: u64) *Node { ret lookup_mode(p, n, 1); }

var looped: u8;
pub fun was_looped() u8 { ret looped; }

# follow intermediate links, optionally retaining the final link itself
pub fun lookup_mode(p: *u8, n: u64, follow: u8) *Node {
    looped = 0;
    var current: [512]u8;
    var target: [512]u8;
    var base: [512]u8;
    if (n >= path.MAX) { ret nil; }
    mem.copy((?current[0])::u64, p::u64, n);
    var length: u64 = n;
    var hops: u64 = 0;
    for (hops < 40) {
        var nd: *Node = root;
        var i: u64 = 1;
        var redirected: u8 = 0;
        for (i < length) {
            val start: u64 = i;
            for (i < length && current[i] != 47) { i = i + 1; }
            if (nd.kind != abi.KIND_DIR) { ret nil; }
            if (allowed(nd, abi.X_OK) == 0) { denied = 1; ret nil; }
            nd = child(nd, ?current[start], i - start);
            if (nd == nil) { ret nil; }
            if (nd.kind == abi.KIND_LINK && (follow != 0 || i < length)) {
                val got: u64 = read(nd, 0, (?target[0])::u64, 511);
                if (abi.is_err(got) != 0 || got == 0 || got + length - i >= path.MAX) { ret nil; }
                mem.copy((?target[got])::u64, (?current[i])::u64, length - i);
                val bn: u64 = path_of(nd.parent, ?base[0]);
                if (bn == 0) { ret nil; }
                length = path.resolve(?base[0], bn, ?target[0], got + length - i, ?current[0]);
                if (length == 0) { ret nil; }
                redirected = 1;
                brk;
            }
            i = i + 1;
        }
        if (redirected == 0) { ret nd; }
        hops = hops + 1;
    }
    looped = 1;
    ret nil;
}

# the directory that would hold a normalized absolute path, or nil
pub fun parent_dir(p: *u8, n: u64) *Node {
    val b: u64 = path.base_index(p, n);
    var dl: u64 = 1;
    if (b > 1) { dl = b - 1; }
    val d: *Node = lookup(p, dl);
    if (d == nil || d.kind != abi.KIND_DIR) { ret nil; }
    ret d;
}

# a memory-only node, wherever `dir` lives (devices, /tmp, the initrd)
pub fun create_ram(dir: *Node, name: *u8, n: u64, kind: u64) *Node {
    load(dir);
    val nd: *Node = new_node(kind, FS_RAM, name, n);
    if (nd == nil) { ret nil; }
    attach(dir, nd);
    ret nd;
}

# a new file or directory in `dir`, on whatever filesystem `dir` is on.
# returns 0 and sets *out, or an error
pub fun create(dir: *Node, name: *u8, n: u64, kind: u64, mode: u64, out: **Node) u64 {
    if (n > abi.NAME_MAX) { ret e(abi.E_NAMETOOLONG); }
    if (dir.fs == FS_PROC) { ret e(abi.E_PERM); }
    if (dir.fs == FS_RAM) {
        val nd: *Node = create_ram(dir, name, n, kind);
        if (nd == nil) { ret e(abi.E_NOMEM); }
        nd.mode = mode & 0xFFF;
        nd.uid = cred_uid;
        nd.gid = cred_gid;
        @out = nd;
        ret 0;
    }
    if (kind == abi.KIND_LINK && dir.fs != FS_EXT2) { ret e(abi.E_NOTSUP); }
    if (dir.fs == FS_FAT || dir.fs == FS_EXFAT) { ret create_fat(dir, name, n, kind, out); }
    load(dir);
    val nd: *Node = new_node(kind, FS_EXT2, name, n);
    if (nd == nil) { ret e(abi.E_NOMEM); }
    val ino: u64 = ext2.create(dir.fsi, dir.ino, name, n, kind, mode, cred_uid, cred_gid);
    if (abi.is_err(ino) != 0) {
        heap.free(nd::u64);
        ret ino;
    }
    nd.ino = ino;
    nd.fsi = dir.fsi;
    nd.mode = mode & 0xFFF;
    nd.uid = cred_uid;
    nd.gid = cred_gid;
    nd.loaded = 1; # brand new: nothing on disk to read
    if (kind == abi.KIND_DIR) { nd.size = 4096; }
    attach(dir, nd);
    @out = nd;
    ret 0;
}

# a new file or directory on FAT or exFAT
fun create_fat(dir: *Node, name: *u8, n: u64, kind: u64, out: **Node) u64 {
    load(dir);
    val nd: *Node = new_node(kind, dir.fs, name, n);
    if (nd == nil) { ret e(abi.E_NOMEM); }
    val is_dir: u8 = (kind == abi.KIND_DIR)::u8;
    var idx: u64 = 0;
    var cnt_: u64 = 0;
    var first: u64 = 0;
    var r: u64 = 0;
    if (dir.fs == FS_FAT) {
        r = fat.create(dir.fatfs, dir.ino, name, n, is_dir, 0, 0, ?idx, ?cnt_, ?first);
        nd.fatfs = dir.fatfs;
    } or {
        var d: exfat.Dir;
        exdir(dir, ?d);
        var size: u64 = 0;
        r = exfat.create(dir.exfs, ?d, name, n, is_dir, 0, 0, 0, 0, ?idx, ?cnt_, ?first, ?size);
        exback(dir, ?d);
        nd.exfs = dir.exfs;
        nd.size = size;
    }
    if (abi.is_err(r) != 0) {
        heap.free(nd::u64);
        ret r;
    }
    nd.ino = first;
    nd.fidx = idx;
    nd.fcount = cnt_;
    nd.mode = 0x1ED;
    nd.loaded = 1; # brand new: nothing to read
    attach(dir, nd);
    @out = nd;
    ret 0;
}

fun destroy(nd: *Node) {
    if (nd.fs == FS_EXT2 && nd.dead != 0) { ext2.release(nd.fsi, nd.ino); }
    if (nd.fs == FS_FAT && nd.dead != 0) { fat.free_data(nd.fatfs, nd.ino); }
    if (nd.fs == FS_EXFAT && nd.dead != 0) { exfat.free_data(nd.exfs, nd.ino, nd.xnochain, nd.size); }
    heap.free(nd.data);
    heap.free(nd::u64);
}

# take a file or empty directory out of the tree (and off the disk)
pub fun unlink(nd: *Node) u64 {
    if (nd.fs == FS_PROC) { ret e(abi.E_PERM); }
    if (nd == root || nd.mount_of != nil) { ret e(abi.E_BUSY); }
    if (nd.mounted != nil) { ret e(abi.E_BUSY); }
    if (nd.kind == abi.KIND_DIR && is_empty(nd) == 0) { ret e(abi.E_NOTEMPTY); }
    if (nd.fs == FS_EXT2) {
        var is_dir: u8 = 0;
        if (nd.kind == abi.KIND_DIR) { is_dir = 1; }
        val left: u64 = ext2.unlink(nd.fsi, nd.parent.ino, ?nd.name[0], nd.name_len, nd.ino, is_dir);
        if (left == 0) { nd.dead = 1; }
    }
    # FAT and exFAT: the entry goes now, the clusters with the last close
    if (nd.fs == FS_FAT) {
        fat.remove(nd.fatfs, nd.parent.ino, nd.fidx, nd.fcount, nd.ino, 1);
        nd.dead = 1;
    }
    if (nd.fs == FS_EXFAT) {
        var d: exfat.Dir;
        exdir(nd.parent, ?d);
        exfat.remove(nd.exfs, ?d, nd.fidx, nd.fcount, nd.ino, nd.xnochain, nd.size, 1);
        nd.dead = 1;
    }
    detach(nd);
    nd.unlinked = 1;
    if (nd.opens == 0) { destroy(nd); }
    ret 0;
}

pub fun release(nd: *Node) {
    nd.opens = nd.opens - 1;
    if (nd.unlinked != 0 && nd.opens == 0) { destroy(nd); }
}

# whether `a` is `b` or inside it
pub fun within(a: *Node, b: *Node) u8 {
    var n: *Node = a;
    for {
        if (n == b) { ret 1; }
        if (n == root) { ret 0; }
        if (n.mount_of != nil) { n = n.mount_of; }
        n = n.parent;
    }
    ret 0;
}

# mount `fs` on the directory `at`; fails if something is already there
pub fun mount(at: *Node, fs: *ext2.Fs) u64 { ret mount_node(at, ext2_root(fs)); }
pub fun mount_fat(at: *Node, fs: *fat.Fs) u64 { ret mount_node(at, fat_root(fs)); }
pub fun mount_exfat(at: *Node, fs: *exfat.Fs) u64 { ret mount_node(at, exfat_root(fs)); }

fun mount_node(at: *Node, r: *Node) u64 {
    if (r == nil) { ret e(abi.E_NOMEM); }
    if (at.kind != abi.KIND_DIR) {
        heap.free(r::u64);
        ret e(abi.E_NOTDIR);
    }
    if (at.mounted != nil || at == root) {
        heap.free(r::u64);
        ret e(abi.E_BUSY);
    }
    # listed under its mountpoint's name (an empty one would read as "/")
    mem.copy((?r.name[0])::u64, (?at.name[0])::u64, at.name_len);
    r.name_len = at.name_len;
    r.parent = at.parent;
    r.mount_of = at;
    at.mounted = r;
    ret 0;
}

# the filesystem mounted at `at` (the mounted root itself); its cached nodes
# are dropped. fails while anything on it is open
pub fun unmount(r: *Node) u64 {
    if (r.mount_of == nil) { ret e(abi.E_INVAL); }
    if (busy(r) != 0) { ret e(abi.E_BUSY); }
    drop_children(r);
    r.mount_of.mounted = nil;
    heap.free(r::u64);
    ret 0;
}

# whether anything at or under `nd` is open or has something mounted on it
fun busy(nd: *Node) u8 {
    if (nd.opens > 0 || nd.mounted != nil) { ret 1; }
    var c: *Node = nd.child;
    for (c != nil) {
        if (busy(c) != 0) { ret 1; }
        c = c.next;
    }
    ret 0;
}

fun drop_children(nd: *Node) {
    var c: *Node = nd.child;
    for (c != nil) {
        val next: *Node = c.next;
        drop_children(c);
        heap.free(c.data);
        heap.free(c::u64);
        c = next;
    }
    nd.child = nil;
}

# Atomically replace a regular file in the mounted root or a RAM filesystem.
# Other filesystems retain their existing refusal until they implement this.
pub fun replace(nd: *Node, old: *Node) u64 {
    if (nd == old) { ret 0; }
    if ((nd.kind != abi.KIND_FILE && nd.kind != abi.KIND_LINK) || (old.kind != abi.KIND_FILE && old.kind != abi.KIND_LINK)) { ret e(abi.E_NOTSUP); }
    if (nd.fs != old.fs || nd.fsi != old.fsi) { ret e(abi.E_XDEV); }
    if (nd.fs != FS_RAM && nd.fs != FS_EXT2) { ret e(abi.E_NOTSUP); }
    if (nd.mount_of != nil || old.mount_of != nil || nd.mounted != nil || old.mounted != nil) {
        ret e(abi.E_BUSY);
    }
    if (nd.fs == FS_EXT2) {
        val left: u64 = ext2.replace(nd.fsi, nd.parent.ino, ?nd.name[0], nd.name_len,
            old.parent.ino, ?old.name[0], old.name_len, nd.ino, old.ino);
        if (abi.is_err(left) != 0) { ret left; }
        if (left == 0) { old.dead = 1; }
    }
    val dir: *Node = old.parent;
    detach(nd);
    mem.copy((?nd.name[0])::u64, (?old.name[0])::u64, old.name_len);
    nd.name_len = old.name_len;
    detach(old);
    old.unlinked = 1;
    attach(dir, nd);
    if (old.opens == 0) { destroy(old); }
    ret 0;
}

# move `nd` into `dir` as `name` (which must not exist there yet)
pub fun rename(nd: *Node, dir: *Node, name: *u8, n: u64) u64 {
    if (n > abi.NAME_MAX) { ret e(abi.E_NAMETOOLONG); }
    if (nd.fs == FS_PROC || dir.fs == FS_PROC) { ret e(abi.E_PERM); }
    if (nd == root || nd.mount_of != nil || nd.mounted != nil) { ret e(abi.E_BUSY); }
    if (nd.kind == abi.KIND_DIR && within(dir, nd) != 0) { ret e(abi.E_INVAL); }
    if (nd.fs != dir.fs || nd.fsi != dir.fsi) { ret e(abi.E_XDEV); }
    if (nd.fs == FS_EXT2) {
        load(dir);
        var is_dir: u8 = 0;
        if (nd.kind == abi.KIND_DIR) { is_dir = 1; }
        val r: u64 = ext2.rename(nd.fsi, nd.parent.ino, ?nd.name[0], nd.name_len, dir.ino, name, n, nd.ino, is_dir);
        if (abi.is_err(r) != 0) { ret r; }
    }
    if (nd.fs == FS_FAT) {
        load(dir);
        if (nd.fatfs != dir.fatfs) { ret e(abi.E_XDEV); }
        val is_dir: u8 = (nd.kind == abi.KIND_DIR)::u8;
        var idx: u64 = 0;
        var cnt_: u64 = 0;
        var first: u64 = 0;
        val r: u64 = fat.create(dir.fatfs, dir.ino, name, n, is_dir, nd.ino, nd.size, ?idx, ?cnt_, ?first);
        if (abi.is_err(r) != 0) { ret r; }
        fat.remove(nd.fatfs, nd.parent.ino, nd.fidx, nd.fcount, nd.ino, 1);
        if (is_dir != 0 && dir != nd.parent) { fat.set_dotdot(nd.fatfs, nd.ino, dir.ino); }
        nd.fidx = idx;
        nd.fcount = cnt_;
    }
    if (nd.fs == FS_EXFAT) {
        load(dir);
        if (nd.exfs != dir.exfs) { ret e(abi.E_XDEV); }
        val is_dir: u8 = (nd.kind == abi.KIND_DIR)::u8;
        var to: exfat.Dir;
        exdir(dir, ?to);
        var idx: u64 = 0;
        var cnt_: u64 = 0;
        var first: u64 = 0;
        var size: u64 = 0;
        val r: u64 = exfat.create(dir.exfs, ?to, name, n, is_dir, 1, nd.ino, nd.xnochain, nd.size, ?idx, ?cnt_, ?first, ?size);
        exback(dir, ?to);
        if (abi.is_err(r) != 0) { ret r; }
        var from: exfat.Dir;
        exdir(nd.parent, ?from);
        exfat.remove(nd.exfs, ?from, nd.fidx, nd.fcount, nd.ino, nd.xnochain, nd.size, 1);
        nd.fidx = idx;
        nd.fcount = cnt_;
    }
    detach(nd);
    mem.copy((?nd.name[0])::u64, name::u64, n);
    nd.name_len = n;
    attach(dir, nd);
    ret 0;
}

pub fun read(nd: *Node, off: u64, buf: u64, n: u64) u64 {
    if (nd.fs == FS_PROC) {
        if (proc_ready == 0) { ret 0; }
        ret proc_read(nd, off, buf, n);
    }
    if (nd.fs == FS_EXT2) { ret ext2.read(nd.fsi, nd.ino, off, buf, n); }
    if (nd.fs == FS_FAT) { ret fat.read(nd.fatfs, nd.ino, nd.size, off, buf, n); }
    if (nd.fs == FS_EXFAT) { ret exfat.read(nd.exfs, nd.ino, nd.xnochain, nd.size, off, buf, n); }
    if (off >= nd.size) { ret 0; }
    var k: u64 = nd.size - off;
    if (k > n) { k = n; }
    mem.copy(buf, nd.data + off, k);
    ret k;
}

fun reserve(nd: *Node, need: u64) u8 {
    if (need <= nd.cap) { ret 1; }
    var cap: u64 = nd.cap * 2;
    if (cap < 256) { cap = 256; }
    if (cap < need) { cap = need; }
    val d: u64 = heap.alloc(cap);
    if (d == 0) { ret 0; }
    if (nd.data != 0) {
        mem.copy(d, nd.data, nd.size);
        heap.free(nd.data);
    }
    nd.data = d;
    nd.cap = cap;
    ret 1;
}

# write at `off`, growing the file; returns bytes written or an error
pub fun write(nd: *Node, off: u64, buf: u64, n: u64) u64 {
    if (off + n < off) { ret e(abi.E_INVAL); }
    if (nd.fs == FS_PROC) {
        if (proc_ready == 0) { ret e(abi.E_PERM); }
        ret proc_write(nd, buf, n);
    }
    if (nd.fs == FS_EXT2) {
        val k: u64 = ext2.write(nd.fsi, nd.ino, off, buf, n);
        if (abi.is_err(k) == 0 && off + k > nd.size) { nd.size = off + k; }
        ret k;
    }
    if (nd.fs == FS_FAT) {
        val k: u64 = fat.write(nd.fatfs, nd.parent.ino, nd.fidx, ?nd.ino, ?nd.size, off, buf, n);
        nd.mtime = clock.now();
        ret k;
    }
    if (nd.fs == FS_EXFAT) {
        var d: exfat.Dir;
        exdir(nd.parent, ?d);
        val k: u64 = exfat.write(nd.exfs, ?d, nd.fidx, ?nd.ino, ?nd.xnochain, ?nd.size, off, buf, n);
        nd.mtime = clock.now();
        ret k;
    }
    if (reserve(nd, off + n) == 0) { ret e(abi.E_NOMEM); }
    if (off > nd.size) { mem.fill(nd.data + nd.size, 0, off - nd.size); }
    mem.copy(nd.data + off, buf, n);
    if (off + n > nd.size) { nd.size = off + n; }
    nd.mtime = clock.now();
    ret n;
}

pub fun truncate(nd: *Node) {
    if (nd.fs == FS_PROC) { ret; }
    if (nd.fs == FS_EXT2) { ext2.truncate(nd.fsi, nd.ino); }
    if (nd.fs == FS_FAT) { fat.truncate(nd.fatfs, nd.parent.ino, nd.fidx, ?nd.ino, ?nd.size); }
    if (nd.fs == FS_EXFAT) {
        var d: exfat.Dir;
        exdir(nd.parent, ?d);
        exfat.truncate(nd.exfs, ?d, nd.fidx, ?nd.ino, ?nd.xnochain, ?nd.size);
    }
    nd.size = 0;
}
