# load an ELF executable from the ramfs into a fresh process: map its
# segments, a stack with the arguments on it, and say where to start

use abi:   machos.abi.sys;
use elf:   machos.kern.elf;
use mem:   machos.kern.mem;
use proc:  machos.kern.proc;
use ramfs: machos.fs.ramfs;
use vmm:   machos.mm.vmm;
use pmm:   machos.mm.pmm;

pub val STACK_TOP:   u64 = 0x00007FFFFFFFF000;
pub val STACK_PAGES: u64 = 32; # 128 KiB
pub val LOAD_MIN:    u64 = 0x1000;
val PAGE: u64 = 4096;

# the kernel-visible address of user address `va` in `p`, or 0
fun user_ptr(p: *proc.Proc, va: u64) u64 {
    val e: u64 = vmm.lookup(p.pml4, va);
    if ((e & vmm.P) == 0) { ret 0; }
    ret vmm.phys_to_virt(e & 0x000FFFFFFFFFF000) + (va & (PAGE - 1));
}

# copy kernel bytes into p's (not current) address space
fun poke(p: *proc.Proc, va: u64, src: u64, n: u64) u8 {
    var done: u64 = 0;
    for (done < n) {
        val at: u64 = va + done;
        var chunk: u64 = PAGE - (at & (PAGE - 1));
        if (chunk > n - done) { chunk = n - done; }
        val dst: u64 = user_ptr(p, at);
        if (dst == 0) { ret 0; }
        mem.copy(dst, src + done, chunk);
        done = done + chunk;
    }
    ret 1;
}

# map a zeroed page at `va`, or widen the flags of the one already there
pub fun map_user_page(p: *proc.Proc, va: u64, flags: u64) u8 {
    val e: u64 = vmm.lookup(p.pml4, va);
    if ((e & vmm.P) != 0) {
        # two segments share this page: writable if either is, no-execute
        # only if both are
        var merged: u64 = vmm.U | (e & vmm.W) | (flags & vmm.W);
        if ((e & vmm.NX) != 0 && (flags & vmm.NX) != 0) { merged = merged | vmm.NX; }
        vmm.map(p.pml4, va, e & 0x000FFFFFFFFFF000, merged);
        ret 1;
    }
    val pa: u64 = pmm.alloc();
    if (pa == 0) { ret 0; }
    if (vmm.map(p.pml4, va, pa, flags | vmm.U) == 0) {
        pmm.free(pa);
        ret 0;
    }
    p.pages = p.pages + 1;
    ret 1;
}

fun load_segment(p: *proc.Proc, img: u64, len: u64, ph: *elf.Phdr) u64 {
    if (ph.memsz == 0) { ret 0; }
    if (ph.filesz > ph.memsz) { ret abi.err(abi.E_NOEXEC); }
    if (ph.offset > len || ph.filesz > len - ph.offset) { ret abi.err(abi.E_NOEXEC); }
    val stack_bottom: u64 = STACK_TOP - STACK_PAGES * PAGE;
    if (ph.vaddr < LOAD_MIN || ph.vaddr >= stack_bottom || ph.memsz > stack_bottom - ph.vaddr) {
        ret abi.err(abi.E_NOEXEC);
    }
    var flags: u64 = 0;
    if ((ph.flags & elf.PF_W) != 0) { flags = flags | vmm.W; }
    if ((ph.flags & elf.PF_X) == 0) { flags = flags | vmm.NX; }
    var va: u64 = ph.vaddr & ~(PAGE - 1);
    val end: u64 = ph.vaddr + ph.memsz;
    for (va < end) {
        if (map_user_page(p, va, flags) == 0) { ret abi.err(abi.E_NOMEM); }
        va = va + PAGE;
    }
    if (poke(p, ph.vaddr, img + ph.offset, ph.filesz) == 0) { ret abi.err(abi.E_NOMEM); }
    ret 0;
}

# load `nd` into `p` and start it with the NUL-separated `args`
# (args_len bytes, kernel memory). returns 0 or an error
pub fun load(p: *proc.Proc, nd: *ramfs.Node, args: u64, args_len: u64) u64 {
    if (nd.kind != abi.KIND_FILE) { ret abi.err(abi.E_NOEXEC); }
    val img: u64 = nd.data;
    val len: u64 = nd.size;
    if (img == 0 || elf.valid(img, len) == 0) { ret abi.err(abi.E_NOEXEC); }

    var top: u64 = 0;
    var i: u64 = 0;
    for (i < elf.phnum(img)) {
        val ph: *elf.Phdr = elf.phdr(img, i);
        if (ph.kind == elf.PT_LOAD) {
            val r: u64 = load_segment(p, img, len, ph);
            if (abi.is_err(r) != 0) { ret r; }
            if (ph.vaddr + ph.memsz > top) { top = ph.vaddr + ph.memsz; }
        }
        i = i + 1;
    }
    val entry: u64 = elf.entry(img);
    if (entry < LOAD_MIN || entry >= top) { ret abi.err(abi.E_NOEXEC); }
    p.brk_base = (top + PAGE - 1) & ~(PAGE - 1);
    p.brk = p.brk_base;

    var va: u64 = STACK_TOP - STACK_PAGES * PAGE;
    for (va < STACK_TOP) {
        if (map_user_page(p, va, vmm.W | vmm.NX) == 0) { ret abi.err(abi.E_NOMEM); }
        va = va + PAGE;
    }

    # [ strings ][ pad ][ argv[0..argc] , nil ] <- rsi; rdi = argc
    var argc: u64 = 0;
    i = 0;
    for (i < args_len) {
        if (@((args + i)::*u8) == 0) { argc = argc + 1; }
        i = i + 1;
    }
    if (args_len > 16 * PAGE || argc > 1024) { ret abi.err(abi.E_INVAL); }
    val strings: u64 = (STACK_TOP - args_len) & ~15::u64;
    if (poke(p, strings, args, args_len) == 0) { ret abi.err(abi.E_NOMEM); }
    val argv: u64 = (strings - (argc + 1) * 8) & ~15::u64;
    var at: u64 = strings;
    var k: u64 = 0;
    i = 0;
    for (k < argc) {
        val slot: u64 = at;
        if (poke(p, argv + k * 8, (?slot)::u64, 8) == 0) { ret abi.err(abi.E_NOMEM); }
        for (@((args + i)::*u8) != 0) { i = i + 1; }
        i = i + 1;
        at = strings + i;
        k = k + 1;
    }
    val zero: u64 = 0;
    poke(p, argv + argc * 8, (?zero)::u64, 8);

    proc.start(p, entry, argv - 16, argc, argv);
    ret 0;
}
