# tar -c|-x|-t [-v] -f ARCHIVE [PATH...]: ustar archives.
#   -c  create ARCHIVE from the PATHs (directories with all inside)
#   -x  extract it here (leading / is dropped from names)
#   -t  list what is in it
#   -v  name each file on the way
# ARCHIVE `-` is standard input / output, so `tar -cf - dir | gzip > d.tgz`
# and `gunzip -c d.tgz | tar -xf -` work. options may be joined: -cvf

use os:  std.system.os;
use io:  userland.lib.cli;
use opt: userland.lib.options;
use std.runtime;
use sdk.abi;

var mode: u8 = 0;      # 99 c, 120 x, 116 t
var verbose: u8 = 0;
var arch: i64 = 0;     # the archive's handle
var failures: u64 = 0;

var hdr: [512]u8;
var blockbuf: [65536]u8;

fun complain(what: *u8, path: *u8, e: i64) {
    io.emsg("tar: \0");
    io.err(path);
    io.emsg(": \0");
    if (e != 0) { io.err(io.reason(e)); }
    or          { io.err(what); }
    io.emsg("\n\0");
    failures = failures + 1;
}

# --- writing --------------------------------------------------------------

fun write_all(buf: *u8, n: u64) u8 {
    val good: u8 = io.write_all(arch, buf, n);
    if (good == 0) { failures = failures + 1; }
    ret good;
}

fun octal(at: *u8, width: u64, v: u64) {
    # width-1 digits, then NUL
    var k: u64 = width - 1;
    var x: u64 = v;
    at[k] = 0;
    for (k > 0) {
        k = k - 1;
        at[k] = 48 + (x & 7)::u8;
        x = x >> 3;
    }
}

fun header(name: *u8, nlen: u64, kind: u8, size: u64, st: *os.stat_t) u8 {
    var i: u64 = 0;
    for (i < 512) {
        hdr[i] = 0;
        i = i + 1;
    }
    # names up to 100 bytes go in name; longer ones split at a / into prefix
    if (nlen <= 100) {
        io.copy(?hdr[0], name, nlen);
    } or {
        var cut: u64 = nlen;
        for (cut > 0 && (name[cut - 1] != 47 || nlen - cut > 100 || cut - 1 > 155)) { cut = cut - 1; }
        if (cut == 0) { ret 0; }
        io.copy(?hdr[345], name, cut - 1);
        io.copy(?hdr[0], ?name[cut], nlen - cut);
    }
    octal(?hdr[100], 8, (st.st_mode & 0o7777)::u64 & 0xFFF);
    octal(?hdr[108], 8, st.st_uid::u64);
    octal(?hdr[116], 8, st.st_gid::u64);
    octal(?hdr[124], 12, size);
    octal(?hdr[136], 12, st.st_mtime::u64);
    hdr[156] = kind;
    io.copy(?hdr[257], "ustar\0", 6);
    hdr[263] = 48;
    hdr[264] = 48;
    # the checksum counts its own field as spaces
    i = 148;
    for (i < 156) {
        hdr[i] = 32;
        i = i + 1;
    }
    var sum: u64 = 0;
    i = 0;
    for (i < 512) {
        sum = sum + hdr[i]::u64;
        i = i + 1;
    }
    octal(?hdr[148], 7, sum);
    hdr[155] = 32;
    ret write_all(?hdr[0], 512);
}

fun add(path: *u8, plen: u64) {
    var st: os.stat_t;
    val r: i64 = io.stat(path, ?st);
    if (r < 0) {
        complain("\0", path, r);
        ret;
    }
    # names in the archive never start with /
    var name: *u8 = path;
    var nlen: u64 = plen;
    for (nlen > 1 && name[0] == 47) {
        name = ?name[1];
        nlen = nlen - 1;
    }
    if (io.kind_of(st.st_mode) == io.KIND_DIR) {
        var dn: [256]u8;
        io.copy(?dn[0], name, nlen);
        var dl: u64 = nlen;
        if (dl > 0 && dn[dl - 1] != 47) {
            dn[dl] = 47;
            dl = dl + 1;
        }
        if (dl != 1 || dn[0] != 47) {
            if (header(?dn[0], dl, 53, 0, ?st) == 0) { complain("name too long\0", path, 0); ret; }
            if (verbose != 0) { io.errn(?dn[0], dl); io.emsg("\n\0"); }
        }
        var dir: io.Dir;
        val o: i64 = io.dir_open(?dir, path);
        if (o < 0) {
            complain("\0", path, o);
            ret;
        }
        for (io.dir_next(?dir) > 0) {
            var child: [256]u8;
            var cl: u64 = plen;
            if (cl + dir.len + 2 > 255) {
                complain("path too long\0", path, 0);
                cnt;
            }
            io.copy(?child[0], path, plen);
            if (cl > 0 && child[cl - 1] != 47) {
                child[cl] = 47;
                cl = cl + 1;
            }
            io.copy(?child[cl], dir.name, dir.len);
            cl = cl + dir.len;
            child[cl] = 0;
            add(?child[0], cl);
        }
        io.dir_close(?dir);
        ret;
    }
    if (io.kind_of(st.st_mode) != io.KIND_FILE) { ret; } # devices are not archived
    val h: i64 = io.open_read(path);
    if (h < 0) {
        complain("\0", path, h);
        ret;
    }
    if (header(name, nlen, 48, st.st_size::u64, ?st) == 0) {
        complain("name too long\0", path, 0);
        io.close(h);
        ret;
    }
    if (verbose != 0) { io.errn(name, nlen); io.emsg("\n\0"); }
    var left: u64 = st.st_size::u64;
    for (left > 0) {
        var want: u64 = 65536;
        if (want > left) { want = left; }
        val got: i64 = io.read(h, ?blockbuf[0], want);
        if (got <= 0) { brk; }
        write_all(?blockbuf[0], got::u64);
        left = left - got::u64;
    }
    # a file that shrank meanwhile is padded with zeros to its stated size
    var k: u64 = 0;
    for (k < 65536) {
        blockbuf[k] = 0;
        k = k + 1;
    }
    for (left > 0) {
        var n: u64 = 65536;
        if (n > left) { n = left; }
        write_all(?blockbuf[0], n);
        left = left - n;
    }
    val pad: u64 = (512 - st.st_size::u64 % 512) % 512;
    write_all(?blockbuf[0], pad);
    io.close(h);
}

# --- reading --------------------------------------------------------------

# exactly n bytes from the archive (pipes come in pieces); whether all came
fun read_exact(buf: *u8, n: u64) u8 {
    var got: u64 = 0;
    for (got < n) {
        val r: i64 = io.read(arch, ?buf[got], n - got);
        if (r <= 0) { io.emsg("tar: archive read failed or ended too early\n\0"); failures = failures + 1; ret 0; }
        got = got + r::u64;
    }
    ret 1;
}

fun parse_octal(at: *u8, width: u64) u64 {
    var v: u64 = 0;
    var i: u64 = 0;
    for (i < width && (at[i] == 32 || at[i] == 0)) { i = i + 1; }
    for (i < width && at[i] >= 48 && at[i] <= 55) {
        v = v * 8 + (at[i] - 48)::u64;
        i = i + 1;
    }
    ret v;
}

fun cstr_len(at: *u8, max: u64) u64 {
    var n: u64 = 0;
    for (n < max && at[n] != 0) { n = n + 1; }
    ret n;
}

# the first n bytes of p as a NUL-terminated path (at most 255)
fun zcopy(p: *u8, n: u64, out: *u8) {
    var k: u64 = n;
    if (k > 255) { k = 255; }
    io.copy(out, p, k);
    out[k] = 0;
}

fun mkdir_n(p: *u8, n: u64, mode: u64) {
    var zp: [256]u8;
    zcopy(p, n, ?zp[0]);
    io.mkdir(?zp[0], mode);
}

# make the directories leading to `p` (all but its last part)
fun make_parents(p: *u8, n: u64) {
    var i: u64 = 1;
    for (i < n) {
        if (p[i] == 47) { mkdir_n(p, i, 0o777); }
        i = i + 1;
    }
}

fun skip_bytes(n: u64) u8 {
    var left: u64 = n;
    for (left > 0) {
        var k: u64 = 65536;
        if (k > left) { k = left; }
        if (read_exact(?blockbuf[0], k) == 0) { ret 0; }
        left = left - k;
    }
    ret 1;
}

# Refuse existing links in any destination component, including the leaf.
fun safe_destination(p: *u8, n: u64) u8 {
    if (n > 255) { ret 0; }
    var part: [256]u8;
    io.copy(?part[0], p, n);
    part[n] = 0;
    var i: u64 = 0;
    for (i <= n) {
        if (i == n || part[i] == 47) {
            val saved: u8 = part[i];
            part[i] = 0;
            var st: os.stat_t;
            if (i != 0 && io.lstat(?part[0], ?st) >= 0 && (st.st_mode & os.S_IFMT) == os.S_IFLNK) { ret 0; }
            part[i] = saved;
        }
        i = i + 1;
    }
    ret 1;
}

# Consume padding through EOF so a piped decompressor can finish and report
# trailer/CRC errors instead of receiving SIGPIPE after the end markers.
fun drain_tail() {
    for {
        val got: i64 = io.read(arch, ?blockbuf[0], 65536);
        if (got == 0) { ret; }
        if (got < 0) { complain("archive read failed\0", "archive\0", got); ret; }
        var i: u64 = 0;
        for (i < got::u64) {
            if (blockbuf[i] != 0) { complain("nonzero data after archive end\0", "archive\0", 0); ret; }
            i = i + 1;
        }
    }
}

fun extract() {
    var zeros: u64 = 0;
    for {
        if (read_exact(?hdr[0], 512) == 0) { brk; }
        var empty: u8 = 1;
        var i: u64 = 0;
        for (i < 512) {
            if (hdr[i] != 0) { empty = 0; brk; }
            i = i + 1;
        }
        if (empty != 0) {
            zeros = zeros + 1;
            if (zeros == 2) { drain_tail(); brk; }
            cnt;
        }
        zeros = 0;
        # check the header's sum before trusting it
        var sum: u64 = 0;
        i = 0;
        for (i < 512) {
            if (i >= 148 && i < 156) { sum = sum + 32; }
            or { sum = sum + hdr[i]::u64; }
            i = i + 1;
        }
        if (sum != parse_octal(?hdr[148], 8)) {
            io.emsg("tar: this is not a tar archive (or it is damaged)\n\0");
            failures = failures + 1;
            brk;
        }
        var name: [260]u8;
        var nl: u64 = 0;
        val pl: u64 = cstr_len(?hdr[345], 155);
        if (pl > 0 && io.eq(?hdr[257], 5, "ustar\0", 5) != 0) {
            io.copy(?name[0], ?hdr[345], pl);
            name[pl] = 47;
            nl = pl + 1;
        }
        val bl: u64 = cstr_len(?hdr[0], 100);
        io.copy(?name[nl], ?hdr[0], bl);
        nl = nl + bl;
        # no absolute paths, no climbing out with ..
        var start: u64 = 0;
        for (start < nl && name[start] == 47) { start = start + 1; }
        var unsafe: u8 = 0;
        i = start;
        for (i + 1 < nl) {
            if (name[i] == 46 && name[i + 1] == 46 && (i == start || name[i - 1] == 47) && (i + 2 == nl || name[i + 2] == 47)) { unsafe = 1; }
            i = i + 1;
        }
        val p: *u8 = ?name[start];
        var pn: u64 = nl - start;
        name[nl] = 0;
        val size: u64 = parse_octal(?hdr[124], 12);
        val fmode: u64 = parse_octal(?hdr[100], 8) & 0xFFF;
        val kind: u8 = hdr[156];
        val padded: u64 = (size + 511) & ~511::u64;

        if (mode == 116) { # list
            if (verbose != 0) {
                io.dec_pad(size, 10);
                io.msg("  \0");
            }
            io.outn(p, pn);
            io.putc(10);
            if (skip_bytes(padded) == 0) { brk; }
            cnt;
        }
        if (unsafe != 0 || pn == 0 || safe_destination(p, pn) == 0) {
            io.emsg("tar: skipping unsafe name \0");
            io.errn(?name[0], nl);
            io.emsg("\n\0");
            failures = failures + 1;
            if (skip_bytes(padded) == 0) { brk; }
            cnt;
        }
        if (verbose != 0) {
            io.outn(p, pn);
            io.putc(10);
        }
        if (kind == 53) { # directory
            for (pn > 1 && p[pn - 1] == 47) { pn = pn - 1; }
            make_parents(p, pn);
            mkdir_n(p, pn, fmode);
            if (skip_bytes(padded) == 0) { brk; }
            cnt;
        }
        if (kind != 48 && kind != 0) { # links and the like: not supported
            if (skip_bytes(padded) == 0) { brk; }
            cnt;
        }
        make_parents(p, pn);
        var zp: [256]u8;
        zcopy(p, pn, ?zp[0]);
        val h: i64 = io.open_mode(?zp[0], os.O_WRONLY | os.O_CREAT | os.O_TRUNC | abi.O_NOFOLLOW::i32, fmode);
        if (h < 0) {
            complain("\0", p, h);
            if (skip_bytes(padded) == 0) { brk; }
            cnt;
        }
        var left: u64 = padded;
        var data: u64 = size;
        var broken: u8 = 0;
        for (left > 0) {
            var k: u64 = 65536;
            if (k > left) { k = left; }
            if (read_exact(?blockbuf[0], k) == 0) { broken = 1; brk; }
            var w: u64 = k;
            if (w > data) { w = data; }
            if (io.write_all(h, ?blockbuf[0], w) == 0) { broken = 1; brk; }
            data = data - w;
            left = left - k;
        }
        io.close(h);
        io.chmod(?zp[0], fmode);
        if (broken != 0) {
            io.emsg("tar: the archive ends too early\n\0");
            failures = failures + 1;
            brk;
        }
    }
}

fun usage() u64 {
    io.emsg("usage: tar -c|-x|-t [-v] -f ARCHIVE [PATH...]\n\0");
    ret 2;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    if (opt.standard(argc, argv, "tar", "usage: tar -c|-x|-t [-v] -f ARCHIVE [PATH...]\n  -c, --create   create archive\n  -x, --extract  extract archive\n  -t, --list     list contents\n  -v, --verbose  print processed names\n  -f, --file     archive path (- for standard input/output)") != 0) { ret 0; }
    var file: *u8 = nil;
    var i: u64 = 1;
    var want_file: u8 = 0;
    for (i < argc && argv[i][0] == 45 && argv[i][1] != 0) {
        val a: *u8 = argv[i];
        if (io.streq(a, "--") != 0) { i = i + 1; brk; }
        if (a[1] == 45) {
            if (io.streq(a, "--create") != 0) { if (mode != 0 && mode != 99) { ret usage(); } mode = 99; }
            or (io.streq(a, "--extract") != 0) { if (mode != 0 && mode != 120) { ret usage(); } mode = 120; }
            or (io.streq(a, "--list") != 0) { if (mode != 0 && mode != 116) { ret usage(); } mode = 116; }
            or (io.streq(a, "--verbose") != 0) { verbose = 1; }
            or (io.streq(a, "--file") != 0) { want_file = 1; }
            or (io.eq(a, 7, "--file=", 7) != 0 && a[7] != 0) { file = ?a[7]; }
            or { ret usage(); }
            i = i + 1;
            if (want_file != 0) {
                if (i >= argc) { ret usage(); }
                file = argv[i]; want_file = 0; i = i + 1;
            }
            cnt;
        }
        var k: u64 = 1;
        for (a[k] != 0) {
            val c: u8 = a[k];
            if (c == 99 || c == 120 || c == 116) {
                if (mode != 0 && mode != c) { ret usage(); }
                mode = c;
            } or (c == 118) { verbose = 1; }
            or (c == 102) {
                if (a[k + 1] != 0) { file = ?a[k + 1]; brk; }
                want_file = 1;
            }
            or (c == 122) {
                io.emsg("tar: no -z: pipe through gzip / gunzip instead\n\0");
                ret 2;
            } or { ret usage(); }
            k = k + 1;
        }
        i = i + 1;
        if (want_file != 0) {
            if (i >= argc) { ret usage(); }
            file = argv[i];
            want_file = 0;
            i = i + 1;
        }
    }
    if (mode == 0 || file == nil) { ret usage(); }
    val stdio: u8 = io.streq(file, "-\0");
    if (mode == 99) {
        if (i >= argc) { ret usage(); }
        arch = io.STDOUT;
        if (stdio == 0) {
            arch = io.open_mode(file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o666);
            if (arch < 0) {
                complain("\0", file, arch);
                ret 1;
            }
        }
        for (i < argc) {
            add(argv[i], io.len(argv[i]));
            i = i + 1;
        }
        # the end: two zero blocks, padded to 10 KiB records
        var z: u64 = 0;
        for (z < 1024) {
            blockbuf[z] = 0;
            z = z + 1;
        }
        write_all(?blockbuf[0], 1024);
        if (stdio == 0) { io.close(arch); }
    } or {
        arch = io.STDIN;
        if (stdio == 0) {
            arch = io.open_mode(file, os.O_RDONLY, 0o666);
            if (arch < 0) {
                complain("\0", file, arch);
                ret 1;
            }
        }
        extract();
        if (stdio == 0) { io.close(arch); }
    }
    if (failures > 0) { ret 1; }
    ret 0;
}
