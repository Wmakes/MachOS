# mkfat PART [SRC:DEST ...]: format the partition PART (e.g. /dev/sdb1) as
# FAT32 and copy each file SRC into it as DEST (/boot/kernel.elf:boot/kernel.elf).
# directories along DEST are made as needed. ?SRC:DEST copies SRC only if
# it exists. names that are not plain 8.3
# get long-name entries, so `machboot.conf` stays `machboot.conf`.
#
# one sector per cluster; every directory is one cluster (16 entries), which
# is plenty for a boot partition

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use bd:  sdk.blkdev;
use rt:  sdk.rt;

val RESERVED: u64 = 32;
val MAX_CLUSTERS: u64 = 262144; # partitions up to 128 MiB
val EOC: u32 = 0x0FFFFFFF;

var disk: u64 = 0;
var base: u64 = 0;     # partition start, bytes
var fat_sectors: u64 = 0;
var data_start: u64 = 0; # sector of cluster 2, from the partition start
var clusters: u64 = 0;
var next_free: u64 = 3;  # cluster 2 is the root directory
var fat: [262144]u32;
var date: u64 = 0;
var time: u64 = 0;

# a directory being filled: its cluster and a copy of its sector
rec Dir {
    cluster: u64;
    used:    u64; # entries taken
    sec:     [512]u8;
}

var dirs: [16]Dir;
var ndirs: u64 = 0;
var dir_names: [16][64]u8; # full path of each dir ("" for the root)
var dir_name_len: [16]u64;
var aliases: u64 = 0;

fun cluster_off(c: u64) u64 { ret base + (data_start + c - 2) * bd.SECTOR; }

fun alloc_clusters(n: u64) u64 {
    if (next_free + n > clusters + 2) { ret 0; }
    val first: u64 = next_free;
    var i: u64 = 0;
    for (i < n) {
        if (i + 1 < n) { fat[first + i] = (first + i + 1)::u32; }
        or             { fat[first + i] = EOC; }
        i = i + 1;
    }
    next_free = next_free + n;
    ret first;
}

fun upper(c: u8) u8 {
    if (c >= 97 && c <= 122) { ret c - 32; }
    ret c;
}

# whether name[0..n] is a valid all-uppercase 8.3 name as is
fun plain83(name: *u8, n: u64) u8 {
    var dot: u64 = n;
    var i: u64 = 0;
    for (i < n) {
        val c: u8 = name[i];
        if (c == 46) {
            if (dot != n) { ret 0; }
            dot = i;
        } or (c >= 97 && c <= 122) {
            ret 0;
        } or (c == 32) {
            ret 0;
        }
        i = i + 1;
    }
    if (dot == 0 || dot > 8 || n - dot > 4) { ret 0; }
    ret 1;
}

# the 11-byte short name: as is if plain 8.3, else a NAME~N alias
fun short_name(name: *u8, n: u64, out: *u8) {
    var i: u64 = 0;
    for (i < 11) {
        out[i] = 32;
        i = i + 1;
    }
    var dot: u64 = n;
    i = 0;
    for (i < n) {
        if (name[i] == 46) { dot = i; }
        i = i + 1;
    }
    if (plain83(name, n) != 0) {
        io.copy(out, name, dot);
        if (dot < n) { io.copy(?out[8], ?name[dot + 1], n - dot - 1); }
        ret;
    }
    var k: u64 = 0;
    i = 0;
    for (i < dot && k < 6) {
        val c: u8 = upper(name[i]);
        if (c != 32 && c != 46) {
            out[k] = c;
            k = k + 1;
        }
        i = i + 1;
    }
    aliases = aliases + 1;
    out[k] = 126; # ~
    out[k + 1] = 48 + (aliases % 10)::u8;
    var e: u64 = 0;
    i = dot + 1;
    for (i < n && e < 3) {
        out[8 + e] = upper(name[i]);
        e = e + 1;
        i = i + 1;
    }
}

fun checksum(s: *u8) u8 {
    var sum: u64 = 0;
    var i: u64 = 0;
    for (i < 11) {
        sum = (((sum & 1) << 7) + (sum >> 1) + s[i]::u64) & 0xFF;
        i = i + 1;
    }
    ret sum::u8;
}

fun take(d: *Dir) *u8 {
    if (d.used == 16) { ret nil; }
    val e: *u8 = ?d.sec[d.used * 32];
    d.used = d.used + 1;
    ret e;
}

fun put_short(e: *u8, s: *u8, attr: u8, cluster: u64, size: u64) {
    bd.clear(e, 32);
    io.copy(e, s, 11);
    e[11] = attr;
    bd.put16(e, 14, time);
    bd.put16(e, 16, date);
    bd.put16(e, 18, date);
    bd.put16(e, 20, cluster >> 16);
    bd.put16(e, 22, time);
    bd.put16(e, 24, date);
    bd.put16(e, 26, cluster & 0xFFFF);
    bd.put32(e, 28, size);
}

# one entry (with long-name entries when needed) in directory `d`
fun add_entry(d: *Dir, name: *u8, n: u64, attr: u8, cluster: u64, size: u64) u8 {
    var s: [11]u8;
    short_name(name, n, ?s[0]);
    if (plain83(name, n) == 0) {
        val parts: u64 = (n + 12) / 13;
        if (d.used + parts + 1 > 16) { ret 0; }
        val sum: u8 = checksum(?s[0]);
        var p: u64 = parts;
        for (p > 0) {
            val e: *u8 = take(d);
            bd.clear(e, 32);
            e[0] = p::u8;
            if (p == parts) { e[0] = e[0] | 0x40; }
            e[11] = 0x0F;
            e[13] = sum;
            # 13 UTF-16 characters at these offsets
            var slots: [13]u8 = [13]u8{1, 3, 5, 7, 9, 14, 16, 18, 20, 22, 24, 28, 30};
            var j: u64 = 0;
            for (j < 13) {
                val at: u64 = (p - 1) * 13 + j;
                var ch: u64 = 0xFFFF;
                if (at < n) { ch = name[at]::u64; }
                or (at == n) { ch = 0; }
                bd.put16(e, slots[j]::u64, ch);
                j = j + 1;
            }
            p = p - 1;
        }
    }
    val e: *u8 = take(d);
    if (e == nil) { ret 0; }
    put_short(e, ?s[0], attr, cluster, size);
    ret 1;
}

# the directory at path p[0..n] ("" = root), made with its parents if needed
fun dir(p: *u8, n: u64) *Dir {
    var i: u64 = 0;
    for (i < ndirs) {
        if (io.eq(?dir_names[i][0], dir_name_len[i], p, n) != 0) { ret ?dirs[i]; }
        i = i + 1;
    }
    if (ndirs == 16 || n > 63) { ret nil; }
    var cut: u64 = n;
    for (cut > 0 && p[cut - 1] != 47) { cut = cut - 1; }
    var parent_len: u64 = 0;
    if (cut > 0) { parent_len = cut - 1; }
    val parent: *Dir = dir(p, parent_len);
    if (parent == nil) { ret nil; }
    val c: u64 = alloc_clusters(1);
    if (c == 0) { ret nil; }
    val d: *Dir = ?dirs[ndirs];
    io.copy(?dir_names[ndirs][0], p, n);
    dir_name_len[ndirs] = n;
    ndirs = ndirs + 1;
    d.cluster = c;
    d.used = 0;
    bd.clear(?d.sec[0], 512);
    var dot: [11]u8 = [11]u8{46, 32, 32, 32, 32, 32, 32, 32, 32, 32, 32};
    put_short(take(d), ?dot[0], 0x10, c, 0);
    dot[1] = 46;
    var up: u64 = parent.cluster;
    if (up == 2) { up = 0; } # ".." of a top-level directory names the root as 0
    put_short(take(d), ?dot[0], 0x10, up, 0);
    if (add_entry(parent, ?p[cut], n - cut, 0x10, c, 0) == 0) { ret nil; }
    ret d;
}

var buf: [4096]u8;

fun copy_file(src: *u8, dest: *u8) u8 {
    var st: abi.Stat;
    val r: u64 = sys.stat(src, io.len(src), ?st);
    if (abi.is_err(r) != 0) {
        io.fail("mkfat\0", src, r);
        ret 0;
    }
    val n: u64 = io.len(dest);
    var cut: u64 = n;
    for (cut > 0 && dest[cut - 1] != 47) { cut = cut - 1; }
    var dl: u64 = 0;
    if (cut > 0) { dl = cut - 1; }
    val d: *Dir = dir(dest, dl);
    if (d == nil) {
        io.err("mkfat: too many directories or entries\n\0");
        ret 0;
    }
    var first: u64 = 0;
    if (st.size > 0) {
        first = alloc_clusters((st.size + bd.SECTOR - 1) / bd.SECTOR);
        if (first == 0) {
            io.err("mkfat: the partition is full\n\0");
            ret 0;
        }
        val h: u64 = sys.open(src, io.len(src), abi.O_READ);
        if (abi.is_err(h) != 0) {
            io.fail("mkfat\0", src, h);
            ret 0;
        }
        var done: u64 = 0;
        for (done < st.size) {
            val got: u64 = sys.read(h, ?buf[0], 4096);
            if (abi.is_err(got) != 0 || got == 0) { brk; }
            # clusters are contiguous, so the file is one run of sectors
            if (bd.pwrite(disk, cluster_off(first) + done, ?buf[0], got) == 0) {
                sys.close(h);
                ret 0;
            }
            done = done + got;
        }
        sys.close(h);
    }
    if (add_entry(d, ?dest[cut], n - cut, 0x20, first, st.size) == 0) {
        io.err("mkfat: too many entries in one directory\n\0");
        ret 0;
    }
    ret 1;
}

fun fat_datetime() {
    val t: u64 = sys.time();
    val secs: u64 = t % 86400;
    var days: u64 = t / 86400;
    var year: u64 = 1970;
    for {
        var len: u64 = 365;
        if ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0) { len = 366; }
        if (days < len) { brk; }
        days = days - len;
        year = year + 1;
    }
    var mdays: [12]u64 = [12]u64{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};
    if ((year % 4 == 0 && year % 100 != 0) || year % 400 == 0) { mdays[1] = 29; }
    var month: u64 = 0;
    for (month < 11 && days >= mdays[month]) {
        days = days - mdays[month];
        month = month + 1;
    }
    if (year < 1980) { year = 1980; }
    date = ((year - 1980) << 9) | ((month + 1) << 5) | (days + 1);
    time = ((secs / 3600) << 11) | (((secs / 60) % 60) << 5) | ((secs % 60) / 2);
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc < 2) {
        io.err("usage: mkfat PART [SRC:DEST ...]\n\0");
        ret 2;
    }
    disk = bd.open_disk("mkfat\0", argv[1], 1);
    if (abi.is_err(disk) != 0) { ret 1; }
    val start: u64 = 0; # sectors before the volume; 0 when it is a partition device
    val count: u64 = bd.disk_size(argv[1]) / bd.SECTOR;
    base = 0;
    fat_sectors = ((count - RESERVED) + 2) * 4 / bd.SECTOR + 1;
    data_start = RESERVED + 2 * fat_sectors;
    clusters = count - data_start;
    if (clusters < 65525 || clusters > MAX_CLUSTERS - 2) {
        io.err("mkfat: the partition must be 33 to 128 MiB\n\0");
        ret 1;
    }
    fat_datetime();
    fat[0] = 0x0FFFFFF8;
    fat[1] = EOC;
    fat[2] = EOC;
    dirs[0].cluster = 2;
    dirs[0].used = 0;
    dir_name_len[0] = 0;
    ndirs = 1;
    # the volume label sits in the root directory
    put_short(take(?dirs[0]), "MACHOS     \0", 0x08, 0, 0);

    var i: u64 = 2;
    for (i < argc) {
        var a: *u8 = argv[i];
        var optional: u8 = 0;
        if (a[0] == 63) {
            optional = 1;
            a = ?a[1];
        }
        val n: u64 = io.len(a);
        var colon: u64 = 0;
        for (colon < n && a[colon] != 58) { colon = colon + 1; }
        if (colon == n || colon == 0 || colon + 1 == n) {
            io.err("mkfat: expected SRC:DEST, got \0");
            io.err(a);
            io.err("\n\0");
            ret 2;
        }
        a[colon] = 0;
        var st: abi.Stat;
        if (optional != 0 && abi.is_err(sys.stat(a, colon, ?st)) != 0) {
            i = i + 1;
            cnt;
        }
        if (copy_file(a, ?a[colon + 1]) == 0) { ret 1; }
        i = i + 1;
    }

    # boot sector, FSInfo, their backups at 6 and 7
    var s: [512]u8;
    bd.clear(?s[0], 512);
    s[0] = 0xEB;
    s[1] = 0x58;
    s[2] = 0x90;
    io.copy(?s[3], "MACHOS  \0", 8);
    bd.put16(?s[0], 11, 512);
    s[13] = 1;
    bd.put16(?s[0], 14, RESERVED);
    s[16] = 2;
    s[21] = 0xF8;
    bd.put16(?s[0], 24, 32);
    bd.put16(?s[0], 26, 64);
    bd.put32(?s[0], 28, start);
    bd.put32(?s[0], 32, count);
    bd.put32(?s[0], 36, fat_sectors);
    bd.put32(?s[0], 44, 2);
    bd.put16(?s[0], 48, 1);
    bd.put16(?s[0], 50, 6);
    s[64] = 0x80;
    s[66] = 0x29;
    bd.put32(?s[0], 67, bd.random());
    io.copy(?s[71], "MACHOS     \0", 11);
    io.copy(?s[82], "FAT32   \0", 8);
    s[510] = 0x55;
    s[511] = 0xAA;
    var ok: u8 = bd.zero(disk, base, RESERVED * bd.SECTOR);
    if (ok != 0) { ok = bd.pwrite(disk, base, ?s[0], 512); }
    if (ok != 0) { ok = bd.pwrite(disk, base + 6 * bd.SECTOR, ?s[0], 512); }
    bd.clear(?s[0], 512);
    bd.put32(?s[0], 0, 0x41615252);
    bd.put32(?s[0], 484, 0x61417272);
    bd.put32(?s[0], 488, clusters + 2 - next_free);
    bd.put32(?s[0], 492, next_free);
    bd.put32(?s[0], 508, 0xAA550000);
    if (ok != 0) { ok = bd.pwrite(disk, base + bd.SECTOR, ?s[0], 512); }
    if (ok != 0) { ok = bd.pwrite(disk, base + 7 * bd.SECTOR, ?s[0], 512); }

    # both FATs
    val fat_bytes: u64 = fat_sectors * bd.SECTOR;
    var f: u64 = 0;
    for (f < 2 && ok != 0) {
        val at: u64 = base + (RESERVED + f * fat_sectors) * bd.SECTOR;
        ok = bd.zero(disk, at, fat_bytes);
        if (ok != 0) { ok = bd.pwrite(disk, at, (?fat[0])::*u8, next_free * 4); }
        f = f + 1;
    }

    # directories
    i = 0;
    for (i < ndirs && ok != 0) {
        ok = bd.pwrite(disk, cluster_off(dirs[i].cluster), ?dirs[i].sec[0], 512);
        i = i + 1;
    }
    sys.close(disk);
    if (ok == 0) {
        io.err("mkfat: writing the disk failed\n\0");
        ret 1;
    }
    io.out("mkfat: FAT32, \0");
    io.dec(count / 2048);
    io.out(" MiB, \0");
    io.dec(argc - 2);
    io.out(" files\n\0");
    ret 0;
}
