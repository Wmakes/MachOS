# wc [FILE...]: count lines, words and bytes

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

var buf: [4096]u8;
var tl: u64 = 0;
var tw: u64 = 0;
var tb: u64 = 0;

fun count(h: u64, name: *u8) u8 {
    var lines: u64 = 0;
    var words: u64 = 0;
    var bytes: u64 = 0;
    var inword: u8 = 0;
    for {
        val r: u64 = sys.read(h, ?buf[0], 4096);
        if (abi.is_err(r) != 0) {
            io.fail("wc\0", name, r);
            ret 0;
        }
        if (r == 0) { brk; }
        var i: u64 = 0;
        for (i < r) {
            val c: u8 = buf[i];
            if (c == 10) { lines = lines + 1; }
            if (c == 32 || c == 10 || c == 9 || c == 13) {
                inword = 0;
            } or (inword == 0) {
                inword = 1;
                words = words + 1;
            }
            i = i + 1;
        }
        bytes = bytes + r;
    }
    io.dec_pad(lines, 7);
    io.dec_pad(words, 8);
    io.dec_pad(bytes, 8);
    if (name != nil) {
        io.putc(32);
        io.out(name);
    }
    io.putc(10);
    tl = tl + lines;
    tw = tw + words;
    tb = tb + bytes;
    ret 1;
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc < 2) {
        if (count(abi.STDIN, nil) == 0) { ret 1; }
        ret 0;
    }
    var status: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        val h: u64 = sys.open(argv[i], io.len(argv[i]), abi.O_READ);
        if (abi.is_err(h) != 0) {
            io.fail("wc\0", argv[i], h);
            status = 1;
        } or {
            if (count(h, argv[i]) == 0) { status = 1; }
            sys.close(h);
        }
        i = i + 1;
    }
    if (argc > 2) {
        io.dec_pad(tl, 7);
        io.dec_pad(tw, 8);
        io.dec_pad(tb, 8);
        io.out(" total\n\0");
    }
    ret status;
}
