# uptime: time since boot and how many processes exist

use abi: machos.abi.sys;
use sys: machos.user.sys;
use io:  machos.user.io;
use rt:  machos.user.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var i: abi.Info;
    sys.info(?i);
    val s: u64 = i.uptime_ms / 1000;
    io.out("up \0");
    if (s >= 3600) {
        io.dec(s / 3600);
        io.out("h \0");
    }
    if (s >= 60) {
        io.dec((s / 60) % 60);
        io.out("m \0");
    }
    io.dec(s % 60);
    io.out(".\0");
    io.dec((i.uptime_ms % 1000) / 100);
    io.out("s, \0");
    io.dec(i.procs);
    io.out(" processes\n\0");
    ret 0;
}
