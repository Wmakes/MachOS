# Count newlines, words and bytes from files or standard input.

use os:  std.system.os;
use io:  userland.lib.cli;
use opt: userland.lib.options;
use std.runtime;

var buf: [4096]u8;
var tl: u64 = 0;
var tw: u64 = 0;
var tb: u64 = 0;
var show_l: u8 = 1;
var show_w: u8 = 1;
var show_c: u8 = 1;

fun report(lines: u64, words: u64, bytes: u64, name: *u8) {
    if (show_l != 0) { io.dec_pad(lines, 7); }
    if (show_w != 0) { io.dec_pad(words, 8); }
    if (show_c != 0) { io.dec_pad(bytes, 8); }
    if (name != nil) {
        io.putc(32);
        io.out(name);
    }
    io.putc(10);
}

fun count(h: i64, name: *u8) u8 {
    var lines: u64 = 0;
    var words: u64 = 0;
    var bytes: u64 = 0;
    var inword: u8 = 0;
    for {
        val r: i64 = io.read(h, ?buf[0], 4096);
        if (r < 0) {
            io.fail("wc\0", name, r);
            ret 0;
        }
        if (r == 0) { brk; }
        var i: u64 = 0;
        for (i < r::u64) {
            val c: u8 = buf[i];
            if (c == 10) { lines = lines + 1; }
            if (c == 32 || c == 10 || c == 9 || c == 13 || c == 11 || c == 12) {
                inword = 0;
            } or (inword == 0) {
                inword = 1;
                words = words + 1;
            }
            i = i + 1;
        }
        bytes = bytes + r::u64;
    }
    report(lines, words, bytes, name);
    tl = tl + lines;
    tw = tw + words;
    tb = tb + bytes;
    ret 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    if (opt.standard(argc, argv, "wc", "usage: wc [-lwc] [--] [FILE...]\n  -l, --lines  count newlines\n  -w, --words  count words\n  -c, --bytes  count bytes\n  -            read standard input") != 0) { ret 0; }
    var p: opt.Parser; opt.init(?p, argc, argv); var picked: u8 = 0;
    for {
        val c: u8 = opt.next(?p, "lines=l,words=w,bytes=c"); if (c == 0) { brk; }
        if (picked == 0) { show_l = 0; show_w = 0; show_c = 0; picked = 1; }
        if (c == 108) { show_l = 1; } or (c == 119) { show_w = 1; }
        or (c == 99) { show_c = 1; } or { p.bad = 1; }
    }
    if (p.bad != 0) { ret opt.error("wc"); }
    val first: u64 = p.at;
    if (argc - first == 0) {
        if (count(io.STDIN, nil) == 0) { ret 1; }
        ret 0;
    }
    var status: u64 = 0;
    var i: u64 = first;
    for (i < argc) {
        var h: i64 = io.STDIN;
        if (io.streq(argv[i], "-") == 0) { h = io.open_mode(argv[i], os.O_RDONLY, 0o666); }
        if (h < 0) {
            io.fail("wc\0", argv[i], h);
            status = 1;
        } or {
            if (count(h, argv[i]) == 0) { status = 1; }
            if (h != io.STDIN) { io.close(h); }
        }
        i = i + 1;
    }
    if (argc - first > 1) { report(tl, tw, tb, "total\0"); }
    ret status;
}
