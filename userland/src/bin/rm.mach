# rm [-r] PATH...: remove files and empty directories (-r: and everything in them)

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;
use std.types.bool.bool;
use std.types.bool.true;
use std.types.bool.false;

var recursive: u8 = 0;

fun remove(p: *u8, n: u64) u8 {
    if (recursive != 0) {
        var st: os.stat_t;
        if (io.stat(p, ?st) >= 0 && io.is_dir(?st)) {
            # read it afresh after each removal: the entries move up
            var more: bool = true;
            for (more) {
                more = false;
                var d: io.Dir;
                if (io.dir_open(?d, p) < 0) { brk; }
                if (io.dir_next(?d) > 0 && n + 1 + d.len < 256) {
                    var child: [256]u8;
                    io.copy(?child[0], p, n);
                    child[n] = 47;
                    io.copy(?child[n + 1], d.name, d.len);
                    child[n + 1 + d.len] = 0;
                    io.dir_close(?d);
                    if (remove(?child[0], n + 1 + d.len) == 0) { brk; }
                    more = true;
                } or {
                    io.dir_close(?d);
                }
            }
        }
    }
    val r: i64 = io.remove(p);
    if (r < 0) {
        io.err("rm: \0");
        io.errn(p, n);
        io.err(": \0");
        io.err(io.reason(r));
        io.err("\n\0");
        ret 0;
    }
    ret 1;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    var i: u64 = 1;
    if (argc > 1 && io.streq(argv[1], "-r\0") != 0) {
        recursive = 1;
        i = 2;
    }
    if (i == argc) {
        io.err("usage: rm [-r] PATH...\n\0");
        ret 2;
    }
    var status: u64 = 0;
    for (i < argc) {
        if (remove(argv[i], io.len(argv[i])) == 0) { status = 1; }
        i = i + 1;
    }
    ret status;
}
