# Realtek RTL8125B (10ec:8125, MAC XID 641). One polled RX/TX queue,
# standard Ethernet frames and autonegotiation; no offloads or interrupts.
# Initialization and descriptor definitions adapted from OpenBSD:
# https://github.com/openbsd/src/blob/master/sys/dev/pci/if_rge.c
#   revision 1.47, 2026-10-13, and if_rgereg.h revision 1.19.
# Firmware data comes from sys/dev/microcode/rge/rgemcode.h revision 1.1;
# its separate Realtek distribution notice accompanies the tables below.
# Other RTL8125 revisions and the RTL8168 family are deliberately not claimed.
#
# Copyright (c) 2019, 2020, 2023-2026 Kevin Lo <kevlo@openbsd.org>
# Permission to use, copy, modify, and distribute this software for any
# purpose with or without fee is hereby granted, provided that the above
# copyright notice and this permission notice appear in all copies.
# THE SOFTWARE IS PROVIDED "AS IS" AND THE AUTHOR DISCLAIMS ALL WARRANTIES
# WITH REGARD TO THIS SOFTWARE INCLUDING ALL IMPLIED WARRANTIES OF
# MERCHANTABILITY AND FITNESS. IN NO EVENT SHALL THE AUTHOR BE LIABLE FOR
# ANY SPECIAL, DIRECT, INDIRECT, OR CONSEQUENTIAL DAMAGES OR ANY DAMAGES
# WHATSOEVER RESULTING FROM LOSS OF USE, DATA OR PROFITS, WHETHER IN AN
# ACTION OF CONTRACT, NEGLIGENCE OR OTHER TORTIOUS ACTION, ARISING OUT OF
# OR IN CONNECTION WITH THE USE OR PERFORMANCE OF THIS SOFTWARE.

use machos.arch.x86_64.cpu;
use machos.dev.ethernet;
use machos.dev.pci;
use machos.kern.kprint;
use machos.kern.mem;
use machos.mm.pmm;
use machos.mm.vmm;

val RING:     u64 = 32;
val BUF:      u64 = 2048;
val OWN:      u32 = 0x80000000;
val EOR:      u32 = 0x40000000;
val TX_WHOLE: u32 = 0x30000000;
val RX_WHOLE: u32 = 0x03000000;
val RX_ERROR: u32 = 0x00100000;

#[volatile]
rec Reg8  { v: u8; }
#[volatile]
rec Reg16 { v: u16; }
#[volatile]
rec Reg32 { v: u32; }

# RTL8125B uses the 32-byte descriptor format, not RTL8127's 16-byte V2.
#[volatile]
rec Tx { status: u32; extra: u32; addr: u64; reserved: [2]u64; }
#[volatile]
rec Rx { reserved: [2]u64; addr: u64; extra: u32; status: u32; }

rec Nic {
    regs:       u64;
    rx:         u64;
    tx:         u64;
    rx_buf:     [32]u64;
    rx_pa:      [32]u64;
    tx_buf:     [32]u64;
    rx_next:    u64;
    tx_next:    u64;
    mac:        [6]u8;
    failed:     u8;
    running:    u8;
    stage:      u64;
    failed_reg: u64;
}

var nics:  [4]Nic;
var count: u64 = 0;

fun rd8(n: *Nic, off: u64) u8 {
    ret (@((n.regs + off)::*Reg8)).v;
}

fun rd16(n: *Nic, off: u64) u16 {
    ret (@((n.regs + off)::*Reg16)).v;
}

fun rd32(n: *Nic, off: u64) u32 {
    ret (@((n.regs + off)::*Reg32)).v;
}

fun wr8(n: *Nic, off: u64, v: u8) {
    (@((n.regs + off)::*Reg8)).v = v;
}

fun wr16(n: *Nic, off: u64, v: u16) {
    (@((n.regs + off)::*Reg16)).v = v;
}

fun wr32(n: *Nic, off: u64, v: u32) {
    (@((n.regs + off)::*Reg32)).v = v;
}

fun bits8(n: *Nic, off: u64, clear: u8, set: u8) {
    wr8(n, off, (rd8(n, off) & ~clear) | set);
}

# x86 coherent DMA still needs ordering before transferring ownership or
# ringing a doorbell, and after observing device completion.
fun barrier() {
    asm x86_64 { mfence }
}

fun wait32(n: *Nic, off: u64, mask: u32, want: u32) u8 {
    var i: u64 = 0;
    for (i < 20000) {
        if ((rd32(n, off) & mask) == want) { ret 1; }
        cpu.delay_us(1);
        i = i + 1;
    }
    n.failed     = 1;
    n.failed_reg = off;
    ret 0;
}

fun mac_read(n: *Nic, reg: u16) u16 {
    if (n.failed != 0) { ret 0; }
    wr32(n, 0xb0, (reg::u32 >> 1) << 16);
    ret rd32(n, 0xb0)::u16;
}

fun mac_write(n: *Nic, reg: u16, value: u16) {
    if (n.failed != 0) { ret; }
    wr32(n, 0xb0, OWN | ((reg::u32 >> 1) << 16) | value::u32);
}

fun mac_bits(n: *Nic, reg: u16, clear: u16, set: u16) {
    mac_write(n, reg, (mac_read(n, reg) & ~clear) | set);
}

fun phy_read(n: *Nic, reg: u16) u16 {
    if (n.failed != 0) { ret 0; }
    wr32(n, 0xb8, (reg::u32 >> 1) << 16);
    if (wait32(n, 0xb8, OWN, OWN) == 0) { ret 0; }
    ret rd32(n, 0xb8)::u16;
}

fun phy_write(n: *Nic, reg: u16, value: u16) {
    if (n.failed != 0) { ret; }
    wr32(n, 0xb8, OWN | ((reg::u32 >> 1) << 16) | value::u32);
    wait32(n, 0xb8, OWN, 0);
}

fun phy_bits(n: *Nic, reg: u16, clear: u16, set: u16) {
    phy_write(n, reg, (phy_read(n, reg) & ~clear) | set);
}

fun csi_read(n: *Nic, reg: u32) u32 {
    if (n.failed != 0) { ret 0; }
    wr32(n, 0x68, (reg & 0xfff) | 0xf000);
    if (wait32(n, 0x68, OWN, OWN) == 0) { ret 0; }
    cpu.delay_us(20);
    ret rd32(n, 0x64);
}

fun csi_write(n: *Nic, reg: u32, value: u32) {
    if (n.failed != 0) { ret; }
    wr32(n, 0x64, value);
    wr32(n, 0x68, OWN | (reg & 0xfff) | 0xf000);
    wait32(n, 0x68, OWN, 0);
    cpu.delay_us(20);
}

fun ephy_write(n: *Nic, reg: u16, value: u16) {
    if (n.failed != 0) { ret; }
    wr32(n, 0x80, OWN | ((reg::u32 & 0x7f) << 16) | value::u32);
    wait32(n, 0x80, OWN, 0);
    cpu.delay_us(20);
}

fun wait_phy(n: *Nic, reg: u16, mask: u16, want: u16, tries: u64, us: u64) u8 {
    var i: u64 = 0;
    for (i < tries && n.failed == 0) {
        if ((phy_read(n, reg) & mask) == want && n.failed == 0) { ret 1; }
        cpu.delay_us(us);
        i = i + 1;
    }
    n.failed     = 1;
    n.failed_reg = reg::u64;
    ret 0;
}

fun disable_aspm(n: *Nic) {
    bits8(n, 0x50, 0, 0xc0);
    bits8(n, 0x53, 0x80, 0);
    bits8(n, 0x56, 0x01, 0);
    bits8(n, 0x50, 0xc0, 0);
}

fun reset(n: *Nic) u8 {
    wr32(n, 0x38, 0);
    wr32(n, 0x44, rd32(n, 0x44) & ~0x3f::u32);
    bits8(n, 0xf2, 0, 0x08);
    bits8(n, 0x37, 0, 0x80);
    cpu.delay_us(200);
    var i: u64 = 0;
    for (i < 3000 && (rd8(n, 0xd3) & 0x30) != 0x30) {
        cpu.delay_us(50);
        i = i + 1;
    }
    i = 0;
    for (i < 3000 && (rd16(n, 0xe2) & 0x103) != 0x103) {
        cpu.delay_us(50);
        i = i + 1;
    }
    wr8(n, 0x37, rd8(n, 0x37) & 0x0c);
    wr8(n, 0x37, 0x10);
    i = 0;
    for (i < 100) {
        cpu.delay_us(100);
        if ((rd8(n, 0x37) & 0x10) == 0) { ret 1; }
        i = i + 1;
    }
    n.failed     = 1;
    n.failed_reg = 0x37;
    ret 0;
}

# Exit firmware-managed OOB mode before touching PHY or DMA configuration.
fun chip_init(n: *Nic) u8 {
    mac_write(n, 0xc0bc, 0x00ff);
    if (reset(n) == 0) { ret 0; }
    bits8(n, 0xd3, 0x80, 0);
    mac_bits(n, 0xe8de, 0x4000, 0);
    var i: u64 = 0;
    for (i < 10 && (rd16(n, 0xd2) & 0x200) == 0) {
        cpu.delay_us(100);
        i = i + 1;
    }
    mac_write(n, 0xc0aa, 0x07d0);
    mac_write(n, 0xc0a6, 0x01b5);
    mac_write(n, 0xc01e, 0x5555);
    i = 0;
    for (i < 10 && (rd16(n, 0xd2) & 0x200) == 0) {
        cpu.delay_us(100);
        i = i + 1;
    }
    if ((mac_read(n, 0xd42c) & 0x100) != 0) {
        if (wait_phy(n, 0xa420, 7, 2, 100, 1000) == 0) { ret 0; }
        mac_bits(n, 0xd42c, 0x100, 0);
        phy_bits(n, 0xa466, 1, 0);
        phy_bits(n, 0xa468, 0x0a, 0);
    }
    bits8(n, 0x6f, 0, 0xc0);
    phy_write(n, 0xa400, 0x1000);
    if (wait_phy(n, 0xa420, 7, 3, 100, 1000) == 0) { ret 0; }
    disable_aspm(n);
    bits8(n, 0xf1, 0x80, 0);
    mac_bits(n, 0xd40a, 0x10, 0);
    mac_write(n, 0xfc48, 0);
    var reg: u16 = 0xfc28;
    for (reg < 0xfc48) {
        mac_write(n, reg, 0);
        reg = reg + 2;
    }
    cpu.delay_us(3000);
    mac_write(n, 0xfc26, 0);
    mac_bits(n, 0xe446, 3, 0);
    i = 0;
    for (i < 138 && n.failed == 0) {
        val pair: u32 = RTL8125B_MAC_BPS[i];
        mac_write(n, (pair >> 16)::u16, pair::u16);
        i = i + 1;
    }
    csi_write(n, 0x108, csi_read(n, 0x108) | 0x100000);
    wr32(n, 0x3c, rd32(n, 0x3c));
    wr32(n, 0x58, 0);
    wr32(n, 0x5c, 0);
    wr32(n, 0x8c, 0);
    wr32(n, 0xf4, 0);
    if (n.failed != 0) { ret 0; }
    ret reset(n);
}

fun phy_init(n: *Nic) u8 {
    var i: u64 = 0;
    for (i < 10 && n.failed == 0) {
        val pair: u32 = MAC_R25B_EPHY[i];
        ephy_write(n, (pair >> 16)::u16, pair::u16);
        i = i + 1;
    }
    # MII registers 0, 4 and 9 map to OCP a400, a408 and a412.
    phy_bits(n, 0xa408, 0x01e0, 0);
    phy_bits(n, 0xa412, 0x0300, 0);
    phy_bits(n, 0xa5d4, 0x0080, 0);
    phy_write(n, 0xa400, 0x9200);
    if (wait_phy(n, 0xa400, 0x8000, 0, 2500, 1000) == 0) { ret 0; }
    phy_write(n, 0xa436, 0x801e);
    if (phy_read(n, 0xa438) != 0x0b99 && n.failed == 0) {
        phy_bits(n, 0xb820, 0, 0x10);
        if (wait_phy(n, 0xb800, 0x40, 0x40, 1000, 100) == 0) { ret 0; }
        i = 0;
        for (i < 1447 && n.failed == 0) {
            val pair: u32 = MAC_R25B_MCU[i];
            phy_write(n, (pair >> 16)::u16, pair::u16);
            i = i + 1;
        }
        phy_bits(n, 0xb820, 0x10, 0);
        if (wait_phy(n, 0xb800, 0x40, 0, 1000, 100) == 0) { ret 0; }
        phy_write(n, 0xa436, 0x801e);
        phy_write(n, 0xa438, 0x0b99);
    }
    phy_bits(n, 0xa442, 0, 0x0800);
    phy_bits(n, 0xac46, 0x00f0, 0x0090);
    phy_bits(n, 0xad30, 3, 1);
    phy_write(n, 0xb87c, 0x80f5);
    phy_write(n, 0xb87e, 0x760e);
    phy_write(n, 0xb87c, 0x8107);
    phy_write(n, 0xb87e, 0x360e);
    phy_write(n, 0xb87c, 0x8551);
    phy_bits(n, 0xb87e, 0xff00, 0x0800);
    phy_bits(n, 0xbf00, 0xe000, 0xa000);
    phy_bits(n, 0xbf46, 0x0f00, 0x0300);
    i = 0;
    for (i < 10) {
        phy_write(n, 0xa436, (0x8044 + i * 6)::u16);
        phy_write(n, 0xa438, 0x2417);
        i = i + 1;
    }
    phy_bits(n, 0xa4ca, 0, 0x0040);
    phy_bits(n, 0xbf84, 0xe000, 0xa000);
    phy_write(n, 0xa436, 0x8170);
    phy_bits(n, 0xa438, 0x2700, 0xd800);
    phy_bits(n, 0xa424, 0, 8);
    phy_bits(n, 0xa5b4, 0x8000, 0);
    # Keep EEE and advanced power saving disabled in the first implementation.
    mac_bits(n, 0xe040, 3, 0);
    phy_bits(n, 0xa432, 0, 0x0010);
    phy_bits(n, 0xa5d0, 6, 0);
    phy_bits(n, 0xa6d4, 1, 0);
    phy_bits(n, 0xa6d8, 0x10, 0);
    phy_bits(n, 0xa428, 0x80, 0);
    phy_bits(n, 0xa4a2, 0x0200, 0);
    mac_bits(n, 0xe052, 1, 0);
    phy_bits(n, 0xa442, 0x3000, 0);
    phy_bits(n, 0xa430, 0x8000, 0);
    ret (n.failed == 0)::u8;
}

fun configure(n: *Nic) u8 {
    bits8(n, 0x50, 0, 0xc0);
    bits8(n, 0xf1, 0x80, 0);
    disable_aspm(n);
    bits8(n, 0x50, 0, 0xc0);
    wr16(n, 0x6048, 1564);
    wr32(n, 0x44, 0x41000c00);
    wr32(n, 0x40, 0x03000700);
    csi_write(n, 0x70c, (csi_read(n, 0x70c) & ~0x3f000000::u32) | 0x27000000);
    wr16(n, 0x382, 0x221b);
    wr32(n, 0x4500, 0);
    wr16(n, 0x4800, rd16(n, 0x4800) & ~0x1c::u16);
    bits8(n, 0x52, 0x10, 0);
    mac_write(n, 0xc140, 0xffff);
    mac_write(n, 0xc142, 0xffff);
    mac_bits(n, 0xeb58, 0, 1);
    mac_bits(n, 0xe614, 0x0700, 0x0200);
    mac_bits(n, 0xe63e, 0x0c30, 0x0020);
    mac_bits(n, 0xc0b4, 1, 0);
    mac_bits(n, 0xc0b4, 0, 0x0d);
    mac_bits(n, 0xeb6a, 0x00ff, 0x0033);
    mac_bits(n, 0xeb50, 0x03e0, 0x0040);
    mac_bits(n, 0xe056, 0x00f0, 0);
    wr8(n, 0x57, 0x10);
    mac_bits(n, 0xe040, 0x1000, 0);
    mac_bits(n, 0xea1c, 3, 1);
    mac_write(n, 0xe0c0, 0x4000);
    mac_bits(n, 0xe052, 0x0088, 0x0060);
    mac_bits(n, 0xd430, 0x0fff, 0x045f);
    bits8(n, 0xd0, 0, 0xc0);
    bits8(n, 0xf2, 0, 0x40);
    mac_bits(n, 0xe080, 2, 0);
    mac_bits(n, 0xea1c, 4, 0);
    mac_bits(n, 0xeb54, 0, 1);
    cpu.delay_us(1);
    mac_bits(n, 0xeb54, 1, 0);
    wr16(n, 0x1880, rd16(n, 0x1880) & ~0x30::u16);
    bits8(n, 0x34, 1, 0);
    var i: u64 = 0;
    for (i < 32) {
        wr32(n, 0xa00 + i * 4, 0);
        i = i + 1;
    }
    mac_bits(n, 0xc0ac, 0, 0x1f80);
    mac_write(n, 0xe098, 0xc302);
    mac_bits(n, 0xe032, 3, 0);
    csi_write(n, 0x98, csi_read(n, 0x98) & ~0x0000ff00::u32);
    cpu.delay_us(20);
    mac_bits(n, 0xe092, 0x00ff, 0);
    # No VLAN stripping or checksum offload; the protocol stack sees raw frames.
    wr16(n, 0xe0, rd16(n, 0xe0) & ~0x20::u16);
    wr16(n, 0xda, 1518);
    bits8(n, 0xf2, 8, 0);
    wr32(n, 0x44, (rd32(n, 0x44) & ~0x00c0003f::u32) | 0x0a);
    wr32(n, 0x08, 0);
    wr32(n, 0x0c, 0);
    disable_aspm(n);
    bits8(n, 0x50, 0xc0, 0);
    cpu.delay_us(10);
    # Advertise full-duplex 10/100/1000/2500 with ordinary autonegotiation.
    phy_bits(n, 0xa428, 0x0200, 0);
    phy_bits(n, 0xa5ea, 1, 0);
    phy_write(n, 0xa408, 0x0141);
    phy_write(n, 0xa412, 0x0200);
    phy_bits(n, 0xa5d4, 0, 0x0080);
    phy_write(n, 0xa400, 0x9200);
    if (wait_phy(n, 0xa400, 0x8000, 0, 2500, 1000) == 0) { ret 0; }
    ret (n.failed == 0)::u8;
}

fun dma_page(out: *u64) u64 {
    val pa: u64 = pmm.alloc();
    if (pa != 0) { @out = vmm.phys_to_virt(pa); }
    ret pa;
}

fun end_flag(index: u64) u32 {
    if (index == RING - 1) { ret EOR; }
    ret 0;
}

fun arm_rx(n: *Nic, index: u64) {
    val r: *Rx = (n.rx + index * 32)::*Rx;
    r.reserved[0] = 0;
    r.reserved[1] = 0;
    r.addr        = n.rx_pa[index];
    r.extra       = 0;
    barrier();
    r.status = OWN | end_flag(index) | BUF::u32;
}

fun allocate_rings(n: *Nic) u8 {
    var rva: u64 = 0;
    var tva: u64 = 0;
    val rpa: u64 = dma_page(?rva);
    n.rx = rva;
    val tpa: u64 = dma_page(?tva);
    n.tx = tva;
    if (rpa == 0 || tpa == 0) { ret 0; }
    var i: u64 = 0;
    for (i < RING) {
        n.rx_pa[i] = dma_page(?n.rx_buf[i]);
        if (n.rx_pa[i] == 0 || dma_page(?n.tx_buf[i]) == 0) { ret 0; }
        arm_rx(n, i);
        val t: *Tx = (n.tx + i * 32)::*Tx;
        t.addr   = vmm.kernel_phys(n.tx_buf[i]);
        t.status = end_flag(i);
        i        = i + 1;
    }
    barrier();
    wr32(n, 0xe4, rpa::u32);
    wr32(n, 0xe8, (rpa >> 32)::u32);
    wr32(n, 0x20, tpa::u32);
    wr32(n, 0x24, (tpa >> 32)::u32);
    ret 1;
}

# Failed setup has not enabled TX/RX or published ring addresses unless all
# allocations succeeded. Stop bus mastering before releasing any DMA pages.
fun release_pages(n: *Nic) {
    var i: u64 = 0;
    for (i < RING) {
        if (n.rx_buf[i] != 0) {
            pmm.free(vmm.kernel_phys(n.rx_buf[i]));
            n.rx_buf[i] = 0;
        }
        if (n.tx_buf[i] != 0) {
            pmm.free(vmm.kernel_phys(n.tx_buf[i]));
            n.tx_buf[i] = 0;
        }
        i = i + 1;
    }
    if (n.rx != 0) {
        pmm.free(vmm.kernel_phys(n.rx));
        n.rx = 0;
    }
    if (n.tx != 0) {
        pmm.free(vmm.kernel_phys(n.tx));
        n.tx = 0;
    }
}

fun supports(d: *pci.Device) u8 {
    ret (d != nil && d.class == 2 && d.subclass == 0 &&
        d.vendor == 0x10ec && d.device == 0x8125)::u8;
}

fun supported_revision(txconfig: u32) u8 {
    ret ((txconfig & 0x7cf00000) == 0x64100000)::u8;
}

# Disable stale Linux/firmware MSI state and put the device in D0. Only the
# low command/control words are written; PCI status bits are write-one-clear.
fun prepare_pci(d: *pci.Device) {
    pci.write32(d, 4, ((pci.read32(d, 4) & 0xffff) & ~4::u32) | 0x402);
    var off:    u8  = (pci.read32(d, 0x34) & 0xfc)::u8;
    var visits: u64 = 0;
    for (off >= 0x40 && off <= 0xfc && visits < 48) {
        val cap:  u32 = pci.read32(d, off);
        val kind: u8  = cap::u8;
        if (kind == 1 && off <= 0xf8) {
            pci.write32(d, off + 4, (pci.read32(d, off + 4) & 0xffff) & ~3::u32);
            cpu.delay_us(10000);
        }
        if (kind == 5)    { pci.write32(d, off, cap & ~0x00010000::u32); }
        if (kind == 0x11) { pci.write32(d, off, cap & ~0x80000000::u32); }
        if (kind == 0x10 && off <= 0xec) {
            pci.write32(d, off + 0x10, (pci.read32(d, off + 0x10) & 0xffff) & ~3::u32);
        }
        off    = ((cap >> 8) & 0xfc)::u8;
        visits = visits + 1;
    }
}

pub fun probe(d: *pci.Device, out: *ethernet.Device) u8 {
    if (supports(d) == 0 || out == nil || count == 4) { ret 0; }
    # Check BAR2 before enabling MMIO. RTL8125B exposes its 64-bit register BAR here.
    val raw: u32 = pci.read32(d, 0x18);
    if (raw == 0 || raw == 0xffffffff || (raw & 7) != 4) { ret 0; }
    val base: u64 = pci.bar(d, 2);
    if (base == 0) { ret 0; }
    val n: *Nic = ?nics[count];
    mem.fill(n::u64, 0, $size_of(Nic));
    prepare_pci(d);
    n.regs = vmm.map_phys(base, 0x7000, 1);
    if (supported_revision(rd32(n, 0x40)) == 0) {
        kprint.warn("rtl8125\0");
        kprint.puts("unsupported MAC revision\n\0");
        ret 0;
    }
    wr32(n, 0x38, 0);
    # Read the permanent address before chip initialization changes the filter.
    val low:  u32 = rd32(n, 0x19e0);
    val high: u16 = rd16(n, 0x19e4);
    var i:    u64 = 0;
    for (i < 4) {
        n.mac[i] = (low >> (i * 8))::u8;
        i        = i + 1;
    }
    n.mac[4] = high::u8;
    n.mac[5] = (high >> 8)::u8;
    if ((n.mac[0] & 1) != 0 || (low == 0 && high == 0)) { ret 0; }
    n.stage = 1;
    var okay: u8 = chip_init(n);
    if (okay != 0) {
        n.stage = 2;
        okay    = phy_init(n);
    }
    if (okay != 0) {
        n.stage = 3;
        okay    = configure(n);
    }
    if (okay != 0) {
        n.stage = 4;
        okay    = allocate_rings(n);
    }
    if (okay == 0) {
        wr32(n, 0x38, 0);
        wr8(n, 0x37, 0);
        pci.write32(d, 4, (pci.read32(d, 4) & 0xffff) & ~4::u32);
        release_pages(n);
        bits8(n, 0x50, 0xc0, 0);
        kprint.warn("rtl8125\0");
        kprint.puts("RTL8125B initialization failed, stage \0");
        kprint.dec(n.stage);
        kprint.puts(" register \0");
        kprint.hex(n.failed_reg);
        kprint.putc(10);
        ret 0;
    }
    bits8(n, 0x50, 0, 0xc0);
    wr32(n, 0, low);
    wr32(n, 4, high::u32);
    bits8(n, 0x50, 0xc0, 0);
    pci.write32(d, 4, (pci.read32(d, 4) & 0xffff) | 0x406);
    barrier();
    wr8(n, 0x37, 0x0c);
    n.running   = 1;
    out.context = n::u64;
    out.model   = "RTL8125B\0";
    mem.copy((?out.mac[0])::u64, (?n.mac[0])::u64, 6);
    out.send    = send_frame;
    out.receive = receive_frame;
    out.link_up = device_link;
    out.speed   = device_speed;
    count       = count + 1;
    kprint.info("rtl8125\0");
    kprint.puts("RTL8125B ready (polled)\n\0");
    ret 1;
}

fun send_frame(context: u64, frame: *u8, len: u64) u8 {
    val n: *Nic = context::*Nic;
    if (n == nil || n.running == 0 || frame == nil || len < 14 || len > ethernet.FRAME_MAX) { ret 0; }
    val t: *Tx = (n.tx + n.tx_next * 32)::*Tx;
    if ((t.status & OWN) != 0) { ret 0; }
    barrier();
    val slot: u64 = n.tx_next;
    mem.copy(n.tx_buf[slot], frame::u64, len);
    var wire: u64 = len;
    if (wire < 60) {
        mem.fill(n.tx_buf[slot] + wire, 0, 60 - wire);
        wire = 60;
    }
    t.extra       = 0;
    t.reserved[0] = 0;
    t.reserved[1] = 0;
    barrier();
    t.status = OWN | end_flag(slot) | TX_WHOLE | wire::u32;
    barrier();
    wr16(n, 0x90, 1);
    n.tx_next = (slot + 1) % RING;
    ret 1;
}

fun receive_frame(context: u64, out: *u8, capacity: u64) u64 {
    val n: *Nic = context::*Nic;
    if (n == nil || n.running == 0 || out == nil) { ret 0; }
    # Bounded work, even if hardware fills the ring while malformed frames arrive.
    var inspected: u64 = 0;
    for (inspected < RING) {
        val slot:   u64 = n.rx_next;
        val r:      *Rx = (n.rx + slot * 32)::*Rx;
        val status: u32 = r.status;
        if ((status & OWN) != 0) { ret 0; }
        barrier();
        val raw: u64 = (status & 0x3fff)::u64;
        var len: u64 = 0;
        if ((status & (RX_WHOLE | RX_ERROR)) == RX_WHOLE && raw >= 18 &&
            raw <= ethernet.FRAME_MAX + 4 && raw <= BUF) { len = raw - 4; }
        if (len != 0 && len <= capacity) { mem.copy(out::u64, n.rx_buf[slot], len); }
        or                               { len = 0; }
        arm_rx(n, slot);
        n.rx_next = (slot + 1) % RING;
        inspected = inspected + 1;
        if (len != 0) { ret len; }
    }
    ret 0;
}

fun device_link(context: u64) u8 {
    val n: *Nic = context::*Nic;
    if (n == nil || n.running == 0) { ret 0; }
    ret ((rd16(n, 0x6c) & 2) != 0)::u8;
}

fun device_speed(context: u64) u64 {
    val n: *Nic = context::*Nic;
    if (n == nil || n.running == 0) { ret 0; }
    val status: u16 = rd16(n, 0x6c);
    if ((status & 2) == 0)      { ret 0; }
    if ((status & 0x0400) != 0) { ret 2500; }
    if ((status & 0x10) != 0)   { ret 1000; }
    if ((status & 8) != 0)      { ret 100; }
    if ((status & 4) != 0)      { ret 10; }
    ret 0;
}

