# system call wrappers for user programs (the interface: abi/sys.mach)

use abi: sdk.abi;
use env: sdk.env;

# syscall(n, a, b, c, d, e): a plain function call, so the compiler already
# treats rcx and r11 (which `syscall` overwrites) as clobbered
#[naked]
#[symbol("sys_call")]
pub fun raw(n: u64, a: u64, b: u64, c: u64, d: u64, e: u64) u64 {
    asm x86_64 {
        mov rax, rdi
        mov rdi, rsi
        mov rsi, rdx
        mov rdx, rcx
        mov r10, r8
        mov r8, r9
        syscall
        ret
    }
}

pub fun exit(code: u64) { raw(abi.EXIT, code, 0, 0, 0, 0); }

pub fun read(h: u64, buf: *u8, n: u64) u64 { ret raw(abi.READ, h, buf::u64, n, 0, 0); }
pub fun write(h: u64, buf: *u8, n: u64) u64 { ret raw(abi.WRITE, h, buf::u64, n, 0, 0); }

pub fun open(p: *u8, n: u64, flags: u64) u64 { ret raw(abi.OPEN, p::u64, n, flags, 0, 0); }
pub fun close(h: u64) u64 { ret raw(abi.CLOSE, h, 0, 0, 0, 0); }

var env_buf: [16384]u8;

# start a program. `how` may be nil (inherit fds, same process group); its
# env, when nil, is this process's environment
pub fun spawn(p: *u8, n: u64, args: *u8, args_len: u64, how: *abi.Spawn) u64 {
    var dflt: abi.Spawn;
    var h: *abi.Spawn = how;
    if (h == nil) {
        dflt.map_fds = 0;
        dflt.group = 0;
        dflt.env = nil;
        h = ?dflt;
    }
    if (h.env == nil) {
        h.env_len = env.pack(?env_buf[0], 16384);
        h.env = ?env_buf[0];
    }
    ret raw(abi.SPAWN, p::u64, n, args::u64, args_len, h::u64);
}
pub fun waitpid(pid: u64, status: *u64, flags: u64) u64 { ret raw(abi.WAIT, pid, status::u64, flags, 0, 0); }

# the status as a shell shows it: the exit code, or 128 + the signal
fun shell_status(st: u64) u64 {
    if (abi.wifexited(st) != 0) { ret abi.wexitstatus(st); }
    ret 128 + abi.wtermsig(st);
}

# wait for `pid`; its exit code (128 + signal when killed) or an error
pub fun wait(pid: u64) u64 {
    var st: u64 = 0;
    val r: u64 = waitpid(pid, ?st, 0);
    if (abi.is_err(r) != 0) { ret r; }
    ret shell_status(st);
}

# like wait, but E_AGAIN while it still runs
pub fun poll(pid: u64) u64 {
    var st: u64 = 0;
    val r: u64 = waitpid(pid, ?st, abi.WNOHANG);
    if (abi.is_err(r) != 0) { ret r; }
    if (r == 0) { ret abi.err(abi.E_AGAIN); }
    ret shell_status(st);
}

pub fun fork() u64 { ret raw(abi.FORK, 0, 0, 0, 0, 0); }
pub fun getppid() u64 { ret raw(abi.GETPPID, 0, 0, 0, 0, 0); }

# replace this program with `p` (args: NUL-separated strings); returns only
# on failure. the environment is this process's
pub fun execve(p: *u8, n: u64, args: *u8, args_len: u64) u64 {
    # NUL-separated strings, then an empty one to end the list
    val el: u64 = env.pack(?env_buf[0], 16383);
    env_buf[el] = 0;
    ret raw(abi.EXECVE, p::u64, n, args::u64, args_len, (?env_buf[0])::u64);
}

pub fun readdir(h: u64, idx: u64, out: *abi.Entry) u64 { ret raw(abi.READDIR, h, idx, out::u64, 0, 0); }
pub fun stat(p: *u8, n: u64, out: *abi.Stat) u64 { ret raw(abi.STAT, p::u64, n, out::u64, 0, 0); }
pub fun mkdir(p: *u8, n: u64) u64 { ret raw(abi.MKDIR, p::u64, n, 0, 0, 0); }
pub fun remove(p: *u8, n: u64) u64 { ret raw(abi.REMOVE, p::u64, n, 0, 0, 0); }
pub fun rename(a: *u8, an: u64, b: *u8, bn: u64) u64 { ret raw(abi.RENAME, a::u64, an, b::u64, bn, 0); }
pub fun chdir(p: *u8, n: u64) u64 { ret raw(abi.CHDIR, p::u64, n, 0, 0, 0); }
pub fun getcwd(buf: *u8, n: u64) u64 { ret raw(abi.GETCWD, buf::u64, n, 0, 0, 0); }
pub fun lseek(h: u64, off: u64, whence: u64) u64 { ret raw(abi.SEEK, h, off, whence, 0, 0); }
pub fun seek(h: u64, off: u64) u64 { ret raw(abi.SEEK, h, off, abi.SEEK_SET, 0, 0); }
pub fun dup(h: u64) u64 { ret raw(abi.DUP, h, 0, 0, 0, 0); }
pub fun dup2(h: u64, to: u64) u64 { ret raw(abi.DUP2, h, to, 0, 0, 0); }
pub fun fcntl(h: u64, cmd: u64, arg: u64) u64 { ret raw(abi.FCNTL, h, cmd, arg, 0, 0); }
pub fun fstat(h: u64, out: *abi.Stat) u64 { ret raw(abi.FSTAT, h, out::u64, 0, 0, 0); }

pub fun pipe(ends: *[2]u64) u64 { ret raw(abi.PIPE, ends::u64, 0, 0, 0, 0); }
pub fun sleep(ms: u64) u64 { ret raw(abi.SLEEP, ms, 0, 0, 0, 0); }
pub fun info(out: *abi.Info) u64 { ret raw(abi.INFO, out::u64, 0, 0, 0, 0); }
pub fun getpid() u64 { ret raw(abi.GETPID, 0, 0, 0, 0, 0); }
pub fun procs(idx: u64, out: *abi.ProcInfo) u64 { ret raw(abi.PROCS, idx, out::u64, 0, 0, 0); }
pub fun kill(pid: u64) u64 { ret raw(abi.KILL, pid, 0, 0, 0, 0); }
pub fun sbrk(n: u64) u64 { ret raw(abi.SBRK, n, 0, 0, 0, 0); }
pub fun setfg(group: u64) u64 { ret raw(abi.SETFG, group, 0, 0, 0, 0); }
pub fun sync() u64 { ret raw(abi.SYNC, 0, 0, 0, 0, 0); }
pub fun time() u64 { ret raw(abi.TIME, 0, 0, 0, 0, 0); }
pub fun mount(disk: *u8, dn: u64, dir: *u8, n: u64) u64 { ret raw(abi.MOUNT, disk::u64, dn, dir::u64, n, 0); }
pub fun umount(dir: *u8, n: u64) u64 { ret raw(abi.UMOUNT, dir::u64, n, 0, 0, 0); }
pub fun uname(out: *abi.Uname) u64 { ret raw(abi.UNAME, out::u64, 0, 0, 0, 0); }
pub fun tcgetattr(h: u64, t: *abi.Termios) u64 { ret raw(abi.TCGETATTR, h, t::u64, 0, 0, 0); }
pub fun tcsetattr(h: u64, t: *abi.Termios) u64 { ret raw(abi.TCSETATTR, h, t::u64, 0, 0, 0); }
pub fun mounts(idx: u64, out: *abi.MountInfo) u64 { ret raw(abi.MOUNTS, idx, out::u64, 0, 0, 0); }

pub fun reboot(how: u64) u64 { ret raw(abi.REBOOT, how, 0, 0, 0, 0); }

pub fun isatty(h: u64) u8 {
    var t: abi.Termios;
    if (abi.is_err(tcgetattr(h, ?t)) != 0) { ret 0; }
    ret 1;
}
