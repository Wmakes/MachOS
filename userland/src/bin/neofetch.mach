# neofetch: the logo and a summary of the system beside it

use abi:  sdk.abi;
use sys:  sdk.sys;
use io:   sdk.io;
use env:  sdk.env;
use rt:   sdk.rt;
use logo: userland.lib.logo;

var lines: [16][160]u8;
var lens: [16]u64;
var nlines: u64 = 0;
var cur: u64 = 0;

fun add(s: *u8) {
    val n: u64 = io.len(s);
    io.copy(?lines[nlines][cur], s, n);
    cur = cur + n;
}

fun addn(s: *u8, n: u64) {
    io.copy(?lines[nlines][cur], s, n);
    cur = cur + n;
}

fun add_dec(v: u64) {
    var b: [20]u8;
    addn(?b[0], io.fmt_dec(v, ?b[0]));
}

# a "Title: " in the mach colour, then the value
fun title(t: *u8) {
    add(logo.COLOR);
    add("\x1b[1m\0");
    add(t);
    add(logo.RESET);
    add(": \0");
}

fun end_line() {
    lens[nlines] = cur;
    nlines = nlines + 1;
    cur = 0;
}

fun plural(n: u64, unit: *u8) {
    add_dec(n);
    add(" \0");
    add(unit);
    if (n != 1) { add("s\0"); }
}

fun uptime(ms: u64) {
    val mins: u64 = ms / 60000;
    val days: u64 = mins / 1440;
    val hours: u64 = (mins / 60) % 24;
    val m: u64 = mins % 60;
    var any: u8 = 0;
    if (days > 0) { plural(days, "day\0"); any = 1; }
    if (hours > 0) {
        if (any != 0) { add(", \0"); }
        plural(hours, "hour\0");
        any = 1;
    }
    if (any != 0) { add(", \0"); }
    plural(m, "min\0");
}

fun programs() u64 {
    val h: u64 = sys.open("/bin\0", 4, abi.O_READ);
    if (abi.is_err(h) != 0) { ret 0; }
    var n: u64 = 0;
    var i: u64 = 0;
    for {
        var e: abi.Entry;
        val got: u64 = sys.readdir(h, i, ?e);
        if (abi.is_err(got) != 0 || got == 0) { brk; }
        i = i + 1;
        if (e.kind == abi.KIND_FILE) { n = n + 1; }
    }
    sys.close(h);
    ret n;
}

# the last part of a path
fun base(p: *u8) *u8 {
    var s: *u8 = p;
    var i: u64 = 0;
    for (p[i] != 0) {
        if (p[i] == 47 && p[i + 1] != 0) { s = ?p[i + 1]; }
        i = i + 1;
    }
    ret s;
}

# the CPU's name with runs of spaces squeezed
fun cpu_name(name: *u8) {
    var i: u64 = 0;
    for (i < 48 && name[i] == 32) { i = i + 1; }
    var last: u8 = 0;
    for (i < 48 && name[i] != 0) {
        if (name[i] != 32 || last != 32) { addn(?name[i], 1); }
        last = name[i];
        i = i + 1;
    }
}

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var un: abi.Uname;
    sys.uname(?un);
    var inf: abi.Info;
    sys.info(?inf);

    var user: *u8 = env.get("USER\0");
    if (user == nil) { user = "root\0"; }
    add(logo.COLOR);
    add("\x1b[1m\0");
    add(user);
    add(logo.RESET);
    add("@\0");
    add(logo.COLOR);
    add("\x1b[1mmachos\0");
    add(logo.RESET);
    end_line();
    var k: u64 = io.len(user) + 7;
    for (k > 0) {
        add("-\0");
        k = k - 1;
    }
    end_line();

    title("OS\0");
    add("MachOS \0");
    add(?un.release[0]);
    add(" \0");
    add(?un.machine[0]);
    end_line();

    title("Kernel\0");
    add("machos \0");
    add(?un.release[0]);
    end_line();

    title("Uptime\0");
    uptime(inf.uptime_ms);
    end_line();

    title("Programs\0");
    add_dec(programs());
    add(" (/bin)\0");
    end_line();

    title("Shell\0");
    var sh: *u8 = env.get("SHELL\0");
    if (sh == nil) { sh = "/bin/sh\0"; }
    add(base(sh));
    end_line();

    if (inf.screen_w > 0) {
        title("Resolution\0");
        add_dec(inf.screen_w);
        add("x\0");
        add_dec(inf.screen_h);
        end_line();
    }

    val tn: u64 = sys.tty_number(abi.STDIN);
    if (tn != 0) {
        title("Terminal\0");
        add("tty\0");
        add_dec(tn);
        end_line();
    }

    title("CPU\0");
    if (inf.cpu_name[0] != 0) { cpu_name(?inf.cpu_name[0]); }
    or { add("x86_64\0"); }
    add(" (\0");
    add_dec(inf.cpus);
    add(")\0");
    end_line();

    title("Memory\0");
    add_dec((inf.mem_total - inf.mem_free) / 1048576);
    add("MiB / \0");
    add_dec(inf.mem_total / 1048576);
    add("MiB\0");
    end_line();

    end_line();
    # the colour blocks: normal and bright
    var c: u64 = 0;
    for (c < 8) {
        add("\x1b[4\0");
        add_dec(c);
        add("m   \0");
        c = c + 1;
    }
    add(logo.RESET);
    end_line();
    c = 0;
    for (c < 8) {
        add("\x1b[10\0");
        add_dec(c);
        add("m   \0");
        c = c + 1;
    }
    add(logo.RESET);
    end_line();

    # the logo on the left, the lines beside it
    io.putc(10);
    var i: u64 = 0;
    for (i < nlines || i < logo.LINES) {
        io.out("  \0");
        if (i < logo.LINES) {
            io.out(logo.COLOR);
            io.out(logo.line(i));
            io.out(logo.RESET);
            var w: u64 = io.len(logo.line(i));
            for (w < logo.WIDTH + 3) {
                io.putc(32);
                w = w + 1;
            }
        } or {
            var w: u64 = 0;
            for (w < logo.WIDTH + 3) {
                io.putc(32);
                w = w + 1;
            }
        }
        if (i < nlines) { io.outn(?lines[i][0], lens[i]); }
        io.putc(10);
        i = i + 1;
    }
    io.putc(10);
    ret 0;
}
