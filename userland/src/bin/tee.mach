# tee [-a] FILE...: copy stdin to stdout and to every FILE (-a appends)

use abi: sdk.abi;
use sys: sdk.sys;
use io:  sdk.io;
use rt:  sdk.rt;

var buf: [8192]u8;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    var flags: u64 = abi.O_WRITE | abi.O_CREATE | abi.O_TRUNC;
    var i: u64 = 1;
    if (i < argc && io.streq(argv[i], "-a\0") != 0) {
        flags = abi.O_WRITE | abi.O_CREATE | abi.O_APPEND;
        i = i + 1;
    }
    var outs: [14]u64;
    var nout: u64 = 0;
    var status: u64 = 0;
    for (i < argc && nout < 14) {
        val h: u64 = sys.open(argv[i], io.len(argv[i]), flags);
        if (abi.is_err(h) != 0) {
            io.fail("tee\0", argv[i], h);
            status = 1;
        } or {
            outs[nout] = h;
            nout = nout + 1;
        }
        i = i + 1;
    }
    for {
        val r: u64 = sys.read(abi.STDIN, ?buf[0], 8192);
        if (abi.is_err(r) != 0 || r == 0) { brk; }
        io.write_all(abi.STDOUT, ?buf[0], r);
        var k: u64 = 0;
        for (k < nout) {
            io.write_all(outs[k], ?buf[0], r);
            k = k + 1;
        }
    }
    ret status;
}
