# kernel entry

use net:  machos.net.net;
use dhcp: machos.net.dhcp;
use info:   machos.boot.info;
use mb:     machos.boot.machboot;
use cpu:    machos.arch.x86_64.cpu;
use gdt:    machos.arch.x86_64.gdt;
use idt:    machos.arch.x86_64.idt;
use serial: machos.dev.serial;
use fbcon:  machos.dev.fbcon;
use kprint: machos.kern.kprint;
use pmm:    machos.mm.pmm;
use vmm:    machos.mm.vmm;
use heap:   machos.mm.heap;
use apic:   machos.arch.x86_64.apic;
use kbd:    machos.dev.ps2kbd;
use tty:    machos.kern.tty;
use trap:   machos.kern.trap;
use syscall: machos.arch.x86_64.syscall;
use proc:   machos.kern.proc;
use sys:    machos.kern.sys;
use abi:    sdk.abi;
use procfs: machos.kern.procfs;
use events: machos.kern.events;
use vfs:    machos.fs.vfs;
use mount:  machos.fs.mount;
use blk:    machos.fs.blk;
use parts:  machos.fs.parts;
use acpi:   machos.acpi.acpi;
use mem:    machos.kern.mem;
use initrd: machos.fs.initrd;
use version: machos.abi.version;
use clock:  machos.kern.clock;
use pci:    machos.dev.pci;
use xhci:   machos.dev.xhci;
use dsk:    machos.dev.disk;
use smp:    machos.arch.x86_64.smp;

var boot: info.BootInfo;
# the boot stack, in the kernel image so it stays mapped once machboot's
# page tables and memory are no longer used
# memory is no longer trusted
#[align(16)]
#[symbol("boot_stack")]
var boot_stack: [65536]u8;

# rdi: the physical address of machboot's Handoff
#[symbol("kmain")]
fun kmain(handoff: u64) {
    cpu.tsc_begin();
    serial.init();
    cpu.pic_disable();
    cpu.init();
    val err: *u8 = mb.collect(handoff, ?boot);
    if (err != nil) { kprint.panic(err); }
    val have_fb: u8 = fbcon.init(?boot.fb);
    console_level_from_cmdline();

    kprint.level(kprint.NOTICE);
    kprint.puts("MachOS \0");
    kprint.puts(version.VERSION);
    kprint.puts(" (x86_64), kernel written in mach\n\0");
    kprint.info("boot\0");
    kprint.puts("loaded by \0");
    kprint.puts(?boot.loader[0]);
    kprint.putc(10);
    kprint.info("boot\0");
    kprint.puts("command line: '\0");
    if (boot.cmdline != nil) { kprint.puts(boot.cmdline); }
    kprint.puts("'\n\0");
    kprint.info("boot\0");
    kprint.puts("kernel at \0");
    kprint.hex(boot.kphys);
    kprint.puts(" (virtual \0");
    kprint.hex(boot.kvirt);
    kprint.puts("), image \0");
    kprint.dec(boot.kelf_len / 1024);
    kprint.puts(" KiB, initrd \0");
    kprint.dec(boot.initrd_len / 1024);
    kprint.puts(" KiB\n\0");
    if (have_fb != 0) {
        kprint.info("fb\0");
        kprint.dec(boot.fb.width);
        kprint.putc(120);
        kprint.dec(boot.fb.height);
        kprint.puts(" at \0");
        kprint.dec(boot.fb.bpp::u64);
        kprint.puts(" bpp, pitch \0");
        kprint.dec(boot.fb.pitch);
        kprint.puts(", \0");
        kprint.dec(fbcon.cols_of());
        kprint.putc(120);
        kprint.dec(fbcon.rows_of());
        kprint.puts(" text, 6 terminals\n\0");
    } or {
        kprint.warn("fb\0");
        kprint.puts("none, serial only\n\0");
    }
    memory_map();
    cpu_report();

    gdt.init();
    idt.init();
    kprint.info("cpu\0");
    kprint.puts("GDT, TSS and IDT loaded (double faults on their own stack)\n\0");

    pmm.init(?boot);
    val verr: *u8 = vmm.init(?boot);
    if (verr != nil) { kprint.panic(verr); }
    kprint.info("vmm\0");
    kprint.puts("own page tables live, hhdm at \0");
    kprint.hex(boot.hhdm);
    kprint.putc(10);
    kprint.info("cpu\0");
    kprint.puts("protection: \0");
    if (cpu.has_smep() != 0) { kprint.puts("smep \0"); }
    if (cpu.has_smap() != 0) { kprint.puts("smap \0"); }
    if (cpu.has_umip() != 0) { kprint.puts("umip \0"); }
    kprint.puts("nx wp\n\0");
    if (cpu.has_smep() == 0 && cpu.has_smap() == 0) {
        kprint.warn("cpu\0");
        kprint.puts("no SMEP/SMAP on this cpu: the kernel is less protected from user memory\n\0");
    }
    kprint.info("pmm\0");
    kprint.dec(pmm.free_pages() * pmm.PAGE / 1024 / 1024);
    kprint.puts(" MiB free of \0");
    kprint.dec(pmm.total_pages() * pmm.PAGE / 1024 / 1024);
    kprint.puts(" MiB usable\n\0");

    val a: u64 = pmm.alloc();
    val b: u64 = pmm.alloc();
    pmm.free(a);
    val c: u64 = pmm.alloc();
    if (a == 0 || b == 0 || c != a) { kprint.panic("pmm self-test failed\0"); }
    pmm.free(b);
    pmm.free(c);

    val h1: u64 = heap.alloc(100);
    val h2: u64 = heap.alloc(5000);
    val h3: u64 = heap.zalloc(40);
    if (h1 == 0 || h2 == 0 || h3 == 0 || (h1 & 15) != 0) { kprint.panic("heap self-test failed\0"); }
    heap.free(h2);
    heap.free(h1);
    val h4: u64 = heap.alloc(5100); # fits the merged h1+h2 hole
    if (h4 != h1) { kprint.panic("heap did not merge free blocks\0"); }
    heap.free(h4);
    heap.free(h3);
    if (heap.used() != 0) { kprint.panic("heap leaked\0"); }
    kprint.info("heap\0");
    kprint.puts("self-test passed, \0");
    kprint.dec(heap.mapped() / 1024);
    kprint.puts(" KiB mapped\n\0");

    acpi.report(boot.rsdp);
    val aerr: *u8 = apic.init(boot.rsdp);
    if (aerr != nil) { kprint.panic(aerr); }
    smp.set_first(apic.id());
    smp.lock(); # held by this cpu until it first runs a program
    if (kbd.init() != 0) { apic.route(1, apic.IRQ_BASE + 1); }
    serial.enable_rx();
    apic.route(4, apic.IRQ_BASE + 4);
    apic.report();
    kprint.info("input\0");
    if (kbd.present_now() != 0) { kprint.puts("PS/2 keyboard controller found, irq 1 routed\n\0"); }
    or { kprint.puts("no PS/2 controller (USB keyboards only)\n\0"); }
    kprint.info("serial\0");
    kprint.puts("COM1 at 115200 baud, irq 4 routed (mirrors tty1)\n\0");

    syscall.init();
    clock.init();
    acpi.init_power(boot.rsdp);

    kprint.info("pci\0");
    kprint.dec(pci.scan());
    kprint.puts(" functions found\n\0");
    pci.report();
    val nkbd: u64 = xhci.init();
    if (xhci.controllers() > 0) {
        kprint.puts("usb: \0");
        kprint.dec(xhci.controllers());
        kprint.puts(" xhci controller(s), \0");
        kprint.dec(nkbd);
        kprint.puts(" keyboard(s)\n\0");
    }
    if (net.init() != 0 && cmdline_has("nonet\0", 5) == nil) { dhcp.start(); }
    val ndisk: u64 = dsk.init();
    var di: u64 = 0;
    for (di < ndisk) {
        val d: *dsk.Disk = dsk.disk(di);
        kprint.puts("disk: \0");
        kprint.puts(?d.name[0]);
        kprint.puts(": \0");
        kprint.dec(d.sectors / 2048);
        kprint.puts(" MiB, \0");
        var mi: u64 = 0;
        for (mi < 40) {
            if (d.model[mi] != 32 || (mi + 1 < 40 && d.model[mi + 1] != 32)) { kprint.putc(d.model[mi]); }
            mi = mi + 1;
        }
        kprint.putc(10);
        di = di + 1;
    }

    parts.probe();
    mount_root();
    val dev: *vfs.Node = vfs.create_ram(vfs.get_root(), "dev\0", 3, abi.KIND_DIR);
    if (dev == nil) { kprint.panic("vfs: out of memory\0"); }
    make_dev(dev, "console\0", 7, vfs.DEV_CONSOLE);
    var tn: [5]u8;
    tn[0] = 116; tn[1] = 116; tn[2] = 121; tn[4] = 0; # "ttyN"
    var ti: u64 = 0;
    for (ti < 6) {
        tn[3] = 49 + ti::u8;
        make_dev(dev, ?tn[0], 4, vfs.DEV_TTY + ti);
        ti = ti + 1;
    }
    make_dev(dev, "null\0", 4, vfs.DEV_NULL);
    make_dev(dev, "zero\0", 4, vfs.DEV_ZERO);
    make_dev(dev, "events\0", 6, vfs.DEV_EVENTS);
    events.set_wake(wake_event_readers);
    parts.publish(dev);
    procfs.init(vfs.get_root());
    mount_esp();
    if (vfs.child(vfs.get_root(), "tmp\0", 3) == nil) {
        val tmp: *vfs.Node = vfs.create_ram(vfs.get_root(), "tmp\0", 3, abi.KIND_DIR);
        if (tmp == nil) { kprint.panic("vfs: out of memory\0"); }
        tmp.mode = 0x3FF; # 01777: everyone may make files, only owners remove them
    }

    proc.set_idle_work(blk.sync);
    start_cpus();
    kprint.info("boot\0");
    kprint.puts("kernel ready after \0");
    val us: u64 = cpu.us_since_boot(cpu.rdtsc());
    kprint.dec(us / 1000);
    kprint.puts(" ms, starting /bin/init\0");
    if (rescue() != 0) { kprint.puts(" (rescue mode)\0"); }
    kprint.putc(10);
    val pid: u64 = sys.spawn_init("/bin/init\0", rescue());
    if (abi.is_err(pid) != 0) {
        kprint.puts("/bin/init: \0");
        kprint.panic(abi.err_name(pid));
    }
    proc.scheduler(0);
}

#[symbol("ap_cr3")]
var ap_cr3: u64 = 0;

# the real-mode start of another cpu, hand-assembled (mach's assembler
# does not do 16- and 32-bit code). copied to the trampoline page T, where
# the startup IPI starts the cpu at T:0 in real mode:
#   0x00  16-bit: cli; cld; ds = cs; lgdt [0xF20]; cr0.PE = 1;
#         jmp far 0x08:T+0x40
#   0x40  32-bit: data segments 0x10; cr4.PAE; cr3 = [T+0xF30] (the low
#         page tables); EFER.LME|NXE; cr0.PG; jmp far 0x18:T+0x80
#   0x80  64-bit: rsp = [T+0xF40]; jmp [T+0xF38] (ap_entry64)
# data: 0xF00 GDT (null, 32-bit code, data, 64-bit code), 0xF20 its
# pointer, 0xF30 the low pml4, 0xF38 the entry, 0xF40 the stack
val TRAMP: [146]u8 = [146]u8{
    0xFA, 0xFC, 0x8C, 0xC8, 0x8E, 0xD8, 0x0F, 0x01, 0x16, 0x20, 0x0F, 0x0F, 0x20, 0xC0, 0x66, 0x83,
    0xC8, 0x01, 0x0F, 0x22, 0xC0, 0x66, 0xEA, 0x00, 0x00, 0x00, 0x00, 0x08, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0xB8, 0x10, 0x00, 0x00, 0x00, 0x8E, 0xD8, 0x8E, 0xC0, 0x8E, 0xD0, 0x0F, 0x20, 0xE0, 0x83, 0xC8,
    0x20, 0x0F, 0x22, 0xE0, 0xA1, 0x00, 0x00, 0x00, 0x00, 0x0F, 0x22, 0xD8, 0xB9, 0x80, 0x00, 0x00,
    0xC0, 0x0F, 0x32, 0x0D, 0x00, 0x09, 0x00, 0x00, 0x0F, 0x30, 0x0F, 0x20, 0xC0, 0x0D, 0x01, 0x00,
    0x00, 0x80, 0x0F, 0x22, 0xC0, 0xEA, 0x00, 0x00, 0x00, 0x00, 0x18, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x48, 0x8B, 0x24, 0x25, 0x00, 0x00, 0x00, 0x00, 0x48, 0x8B, 0x04, 0x25, 0x00, 0x00, 0x00, 0x00,
    0xFF, 0xE0};

fun put32(at: u64, v: u64) { @(at::*u32) = (v & 0xFFFFFFFF)::u32; }

# where the trampoline lands, in the kernel's own page tables: switch to
# them and go on in ap_main, on the stack the trampoline set
#[naked]
#[symbol("ap_entry64")]
fun ap_entry64() {
    asm x86_64 {
        mov rax, [ap_cr3]
        mov cr3, rax
        call ap_main
        cli
        hlt
    }
}

#[symbol("ap_main")]
fun ap_main() {
    cpu.init();
    val me: u64 = smp.here();
    gdt.init_cpu(me);
    idt.load();
    syscall.init_cpu(me);
    apic.init_ap();
    smp.came_up(me);
    smp.lock();
    kprint.info("smp\0");
    kprint.puts("cpu\0");
    kprint.dec(me);
    kprint.puts(" up (APIC id \0");
    kprint.dec(apic.id()::u64);
    kprint.puts(")\n\0");
    proc.scheduler(me);
}

# set up the trampoline at T (4 pages below 1 MiB: code, then a pml4,
# pdpt and pd that map the first 2 MiB one-to-one plus the kernel's half)
fun trampoline(t: u64) {
    val v: u64 = vmm.phys_to_virt(t);
    mem.fill(v, 0, 4 * 4096);
    var i: u64 = 0;
    for (i < 146) {
        @((v + i)::*u8) = TRAMP[i];
        i = i + 1;
    }
    put32(v + 0x17, t + 0x40);    # the far jump to 32-bit code
    put32(v + 0x55, t + 0xF30);   # mov eax, [low pml4]
    put32(v + 0x76, t + 0x80);    # the far jump to 64-bit code
    put32(v + 0x84, t + 0xF40);   # mov rsp, [stack]
    put32(v + 0x8C, t + 0xF38);   # mov rax, [entry]
    val gdt_v: *u64 = (v + 0xF00)::*u64;
    gdt_v[0] = 0;
    gdt_v[1] = 0x00CF9A000000FFFF; # 32-bit code
    gdt_v[2] = 0x00CF92000000FFFF; # data
    gdt_v[3] = 0x00AF9A000000FFFF; # 64-bit code
    @((v + 0xF20)::*u16) = 31;
    put32(v + 0xF22, t + 0xF00);
    put32(v + 0xF30, t + 0x1000);
    @((v + 0xF38)::*u64) = ap_entry64::u64;
    # the low tables
    val pml4: *u64 = (v + 0x1000)::*u64;
    val pdpt: *u64 = (v + 0x2000)::*u64;
    val pd: *u64 = (v + 0x3000)::*u64;
    pml4[0] = (t + 0x2000) | 3;
    pdpt[0] = (t + 0x3000) | 3;
    pd[0] = 0x83; # the first 2 MiB, one-to-one
    val kp: *u64 = vmm.phys_to_virt(vmm.kernel_space())::*u64;
    var k: u64 = 256;
    for (k < 512) {
        pml4[k] = kp[k];
        k = k + 1;
    }
}

# start the other processors the MADT lists, one at a time
fun start_cpus() {
    val n: u64 = apic.cpu_count();
    if (n <= 1) {
        kprint.info("smp\0");
        kprint.puts("1 cpu\n\0");
        ret;
    }
    if (boot.trampoline == 0 || boot.trampoline >= 0x100000) {
        kprint.warn("smp\0");
        kprint.puts("no low memory for starting cpus: running on one\n\0");
        ret;
    }
    val t: u64 = boot.trampoline;
    trampoline(t);
    ap_cr3 = vmm.kernel_space();
    val me: u32 = apic.id();
    var want: u64 = 1;
    var k: u64 = 0;
    for (k < n) {
        val id: u32 = apic.cpu_id(k);
        if (id != me) {
            val idx: u64 = smp.add(id);
            if (idx == smp.MAX) { brk; }
            val stack: u64 = heap.alloc(16384);
            if (stack == 0) { brk; }
            @((vmm.phys_to_virt(t) + 0xF40)::*u64) = stack + 16384;
            want = want + 1;
            apic.send_init(id);
            cpu.delay_us(10000);
            apic.send_sipi(id, t >> 12);
            cpu.delay_us(200);
            if (smp.is_up(idx) == 0) { apic.send_sipi(id, t >> 12); }
            var waited: u64 = 0;
            for (smp.is_up(idx) == 0 && waited < 1000) { # up to 100 ms
                cpu.delay_us(100);
                waited = waited + 1;
            }
            if (smp.is_up(idx) == 0) {
                kprint.warn("smp\0");
                kprint.puts("cpu with APIC id \0");
                kprint.dec(id::u64);
                kprint.puts(" did not start\n\0");
            }
        }
        k = k + 1;
    }
    kprint.info("smp\0");
    kprint.dec(smp.online());
    kprint.puts(" cpu(s) running\0");
    if (smp.online() < want) {
        kprint.puts(", \0");
        kprint.dec(want - smp.online());
        kprint.puts(" did not start\0");
    }
    kprint.putc(10);
}

fun wake_event_readers() { proc.wakeup(proc.CHAN_EVENTS); }

fun make_dev(dir: *vfs.Node, name: *u8, n: u64, id: u64) {
    val d: *vfs.Node = vfs.create_ram(dir, name, n, abi.KIND_DEV);
    if (d == nil) { kprint.panic("vfs: out of memory\0"); }
    d.dev = id;
    d.mode = 0x1B6; # 0666: anyone may use the console, null and zero
}

var root_disk: u64 = 0xFFFFFFFFFFFFFFFF;  # the disk the root is on, when it is a disk

# the EFI system partition next to the root, at /boot/efi (where machboot
# lives, so MachOS can update it)
fun mount_esp() {
    if (root_disk == 0xFFFFFFFFFFFFFFFF) { ret; }
    val esp: *parts.Bdev = parts.find_esp(root_disk);
    if (esp == nil) { ret; }
    val bootdir: *vfs.Node = vfs.lookup("/boot\0", 5);
    if (bootdir == nil) { ret; }
    var at: *vfs.Node = vfs.child(bootdir, "efi\0", 3);
    if (at == nil) {
        var made: *vfs.Node = nil;
        if (abi.is_err(vfs.create(bootdir, "efi\0", 3, abi.KIND_DIR, 0x1ED, ?made)) != 0) { ret; }
        at = made;
    }
    val r: u64 = mount.mount_at(esp, at);
    var dn: [32]u8;
    val dl: u64 = parts.dev_name(esp, ?dn[0]);
    dn[dl] = 0;
    if (abi.is_err(r) != 0) {
        kprint.warn("esp\0");
        kprint.puts(?dn[0]);
        kprint.puts(": cannot mount the EFI partition: \0");
        kprint.puts(abi.err_name(r));
        kprint.putc(10);
        ret;
    }
    kprint.info("esp\0");
    kprint.puts(?dn[0]);
    kprint.puts(" (the EFI partition, machboot's home) on /boot/efi\n\0");
}

# a word of the boot command line, or nil
fun cmdline_has(w: *u8, n: u64) *u8 {
    val c: *u8 = boot.cmdline;
    if (c == nil) { ret nil; }
    var i: u64 = 0;
    for (c[i] != 0) {
        if ((i == 0 || c[i - 1] == 32) && mem.equal(?c[i], w, n) != 0) { ret ?c[i + n]; }
        i = i + 1;
    }
    ret nil;
}

# quiet: only warnings and worse on the console; debug: everything;
# loglevel=N: up to level N (everything is always in the log, see dmesg)
fun console_level_from_cmdline() {
    if (cmdline_has("quiet\0", 5) != nil) { kprint.set_console_level(kprint.WARN); }
    if (cmdline_has("debug\0", 5) != nil) { kprint.set_console_level(kprint.DEBUG); }
    val l: *u8 = cmdline_has("loglevel=\0", 9);
    if (l != nil && l[0] >= 48 && l[0] <= 55) { kprint.set_console_level((l[0] - 48)::u64); }
}

fun kind_name(k: u8) *u8 {
    if (k == info.MEM_USABLE) { ret "usable\0"; }
    if (k == info.MEM_RECLAIMABLE) { ret "reclaimable\0"; }
    if (k == info.MEM_ACPI) { ret "ACPI\0"; }
    if (k == info.MEM_KERNEL) { ret "kernel and modules\0"; }
    if (k == info.MEM_FRAMEBUFFER) { ret "framebuffer\0"; }
    ret "reserved\0";
}

# every region of the memory map (debug), then the totals by kind
fun memory_map() {
    var totals: [6]u64;
    var k: u64 = 0;
    for (k < 6) {
        totals[k] = 0;
        k = k + 1;
    }
    var i: u64 = 0;
    for (i < boot.mem_len) {
        val r: *info.MemRegion = ?boot.mem[i];
        kprint.debug("mem\0");
        kprint.hex(r.base);
        kprint.putc(45);
        kprint.hex(r.base + r.len - 1);
        kprint.putc(32);
        kprint.puts(kind_name(r.kind));
        kprint.putc(10);
        if (r.kind::u64 < 6) { totals[r.kind::u64] = totals[r.kind::u64] + r.len; }
        i = i + 1;
    }
    kprint.info("mem\0");
    kprint.dec(boot.mem_len);
    kprint.puts(" regions: \0");
    kprint.dec(totals[info.MEM_USABLE::u64] / 1048576);
    kprint.puts(" MiB usable, \0");
    kprint.dec(totals[info.MEM_RECLAIMABLE::u64] / 1048576);
    kprint.puts(" MiB reclaimable, \0");
    kprint.dec(totals[info.MEM_KERNEL::u64] / 1024);
    kprint.puts(" KiB kernel and modules, \0");
    kprint.dec(totals[info.MEM_ACPI::u64] / 1024);
    kprint.puts(" KiB ACPI\n\0");
}

# the processor: who made it, its name, what it can do
fun cpu_report() {
    var v: [13]u8;
    cpu.vendor(?v[0]);
    v[12] = 0;
    var name: [49]u8;
    cpu.brand(?name[0]);
    name[48] = 0;
    var s: u64 = 0;
    for (s < 48 && name[s] == 32) { s = s + 1; }
    kprint.info("cpu\0");
    kprint.puts(?v[0]);
    kprint.puts(", \0");
    kprint.puts(?name[s]);
    kprint.putc(10);
    var f: [3]u32;
    cpu.features(?f[0]);
    kprint.info("cpu\0");
    kprint.puts("features:\0");
    if ((f[1] & (1 << 25)) != 0) { kprint.puts(" sse\0"); }
    if ((f[1] & (1 << 26)) != 0) { kprint.puts(" sse2\0"); }
    if ((f[0] & 1) != 0) { kprint.puts(" sse3\0"); }
    if ((f[0] & (1 << 9)) != 0) { kprint.puts(" ssse3\0"); }
    if ((f[0] & (1 << 19)) != 0) { kprint.puts(" sse4.1\0"); }
    if ((f[0] & (1 << 20)) != 0) { kprint.puts(" sse4.2\0"); }
    if ((f[0] & (1 << 23)) != 0) { kprint.puts(" popcnt\0"); }
    if ((f[0] & (1 << 25)) != 0) { kprint.puts(" aes\0"); }
    if ((f[0] & (1 << 28)) != 0) { kprint.puts(" avx\0"); }
    if ((f[2] & (1 << 5)) != 0) { kprint.puts(" avx2\0"); }
    if ((f[2] & (1 << 16)) != 0) { kprint.puts(" avx512f\0"); }
    if ((f[0] & (1 << 30)) != 0) { kprint.puts(" rdrand\0"); }
    if ((f[0] & (1 << 21)) != 0) { kprint.puts(" x2apic\0"); }
    if ((f[1] & (1 << 4)) != 0) { kprint.puts(" tsc\0"); }
    if ((f[0] & (1 << 31)) != 0) { kprint.puts(" hypervisor\0"); }
    kprint.putc(10);
}

fun rescue() u8 {
    val c: *u8 = boot.cmdline;
    if (c == nil) { ret 0; }
    var i: u64 = 0;
    for (c[i] != 0) {
        if (mem.equal(?c[i], "rescue\0", 6) != 0) { ret 1; }
        i = i + 1;
    }
    ret 0;
}

fun mount_root() {
    var b: *parts.Bdev = parts.find_root(?boot.root_guid[0]);
    if (rescue() != 0) {
        kprint.puts("rescue mode: running from memory, the disks stay unmounted\n\0");
        b = nil;
    } or (cmdline_has("live\0", 4) != nil) {
        kprint.info("root\0");
        kprint.puts("live system: running from memory, the disks stay unmounted\n\0");
        b = nil;
    }
    if (b != nil) {
        val err: *u8 = mount.mount_root(b);
        if (err == nil) { root_disk = b.disk; }
        kprint.puts("root: \0");
        if (err == nil) { kprint.puts("ext2 on \0"); }
        var dn: [32]u8;
        val dl: u64 = parts.dev_name(b, ?dn[0]);
        dn[dl] = 0;
        kprint.puts(?dn[0]);
        if (err == nil) {
            kprint.putc(10);
            if (mount.root_was_clean() == 0) {
                kprint.puts("root: \x1b[1;33mnot shut down cleanly last time\x1b[0m; to check it, boot\n\0");
                kprint.puts("      'MachOS (rescue)' and run fsck -y on it\n\0");
            }
            ret;
        }
        kprint.puts(": \0");
        kprint.puts(err);
        kprint.putc(10);
    }
    if (vfs.init_ram() == 0) { kprint.panic("vfs: out of memory\0"); }
    if (boot.initrd == 0) { kprint.panic("no root partition and no initrd\0"); }
    kprint.puts("root: initrd in memory (no disk root), \0");
    kprint.dec(initrd.unpack(boot.initrd, boot.initrd_len));
    kprint.puts(" files\n\0");
}

#[naked]
#[symbol("_start")]
fun start() {
    asm x86_64 {
        lea rsp, [boot_stack]
        add rsp, 65536
        call kmain
    }
}
