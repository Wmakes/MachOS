# SHA-256 (FIPS 180-4), for password hashes

val K: [64]u32 = [64]u32{
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2};

fun rotr(x: u32, n: u32) u32 { ret (x >> n) | (x << (32 - n)); }

pub rec Ctx {
    h:     [8]u32;
    block: [64]u8;
    used:  u64; # bytes in block
    total: u64; # bytes hashed
}

pub fun init(c: *Ctx) {
    c.h[0] = 0x6a09e667; c.h[1] = 0xbb67ae85; c.h[2] = 0x3c6ef372; c.h[3] = 0xa54ff53a;
    c.h[4] = 0x510e527f; c.h[5] = 0x9b05688c; c.h[6] = 0x1f83d9ab; c.h[7] = 0x5be0cd19;
    c.used = 0;
    c.total = 0;
}

fun compress(c: *Ctx) {
    var w: [64]u32;
    var i: u64 = 0;
    for (i < 16) {
        w[i] = (c.block[i * 4]::u32 << 24) | (c.block[i * 4 + 1]::u32 << 16)
             | (c.block[i * 4 + 2]::u32 << 8) | c.block[i * 4 + 3]::u32;
        i = i + 1;
    }
    for (i < 64) {
        val s0: u32 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
        val s1: u32 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
        w[i] = w[i - 16] + s0 + w[i - 7] + s1;
        i = i + 1;
    }
    var a: u32 = c.h[0];
    var b: u32 = c.h[1];
    var cc: u32 = c.h[2];
    var d: u32 = c.h[3];
    var e: u32 = c.h[4];
    var f: u32 = c.h[5];
    var g: u32 = c.h[6];
    var h: u32 = c.h[7];
    i = 0;
    for (i < 64) {
        val s1: u32 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        val ch: u32 = (e & f) ^ (~e & g);
        val t1: u32 = h + s1 + ch + K[i] + w[i];
        val s0: u32 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        val maj: u32 = (a & b) ^ (a & cc) ^ (b & cc);
        val t2: u32 = s0 + maj;
        h = g;
        g = f;
        f = e;
        e = d + t1;
        d = cc;
        cc = b;
        b = a;
        a = t1 + t2;
        i = i + 1;
    }
    c.h[0] = c.h[0] + a; c.h[1] = c.h[1] + b; c.h[2] = c.h[2] + cc; c.h[3] = c.h[3] + d;
    c.h[4] = c.h[4] + e; c.h[5] = c.h[5] + f; c.h[6] = c.h[6] + g; c.h[7] = c.h[7] + h;
}

pub fun update(c: *Ctx, data: *u8, n: u64) {
    var i: u64 = 0;
    for (i < n) {
        c.block[c.used] = data[i];
        c.used = c.used + 1;
        if (c.used == 64) {
            compress(c);
            c.used = 0;
        }
        i = i + 1;
    }
    c.total = c.total + n;
}

# the 32-byte digest into out
pub fun finish(c: *Ctx, out: *u8) {
    val bits: u64 = c.total * 8;
    var one: u8 = 0x80;
    update(c, ?one, 1);
    var zero: u8 = 0;
    for (c.used != 56) { update(c, ?zero, 1); }
    var len: [8]u8;
    var k: u64 = 0;
    for (k < 8) {
        len[k] = ((bits >> ((7 - k) * 8)) & 0xFF)::u8;
        k = k + 1;
    }
    update(c, ?len[0], 8);
    k = 0;
    for (k < 8) {
        out[k * 4] = (c.h[k] >> 24)::u8;
        out[k * 4 + 1] = ((c.h[k] >> 16) & 0xFF)::u8;
        out[k * 4 + 2] = ((c.h[k] >> 8) & 0xFF)::u8;
        out[k * 4 + 3] = (c.h[k] & 0xFF)::u8;
        k = k + 1;
    }
}

pub fun digest(data: *u8, n: u64, out: *u8) {
    var c: Ctx;
    init(?c);
    update(?c, data, n);
    finish(?c, out);
}
