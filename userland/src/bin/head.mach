# head [-N] [FILE]: the first N (default 10) lines

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;

var buf: [4096]u8;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    var want: u64 = 10;
    var i: u64 = 1;
    if (i < argc && argv[i][0] == 45) {
        var ok: u8 = 0;
        want = io.parse_dec(?argv[i][1], io.len(argv[i]) - 1, ?ok);
        if (ok == 0) {
            io.err("usage: head [-N] [FILE]\n\0");
            ret 2;
        }
        i = i + 1;
    }
    var h: i64 = io.STDIN;
    if (i < argc) {
        h = io.open_mode(argv[i], os.O_RDONLY, 0o666);
        if (h < 0) {
            io.fail("head\0", argv[i], h);
            ret 1;
        }
    }
    var seen: u64 = 0;
    for (seen < want) {
        val r: i64 = io.read(h, ?buf[0], 4096);
        if (r <= 0) { brk; }
        var k: u64 = 0;
        for (k < r::u64 && seen < want) {
            if (buf[k] == 10) { seen = seen + 1; }
            k = k + 1;
        }
        io.outn(?buf[0], k);
    }
    ret 0;
}
