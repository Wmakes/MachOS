# handles: what a process's handle numbers point at. one Handle can be
# shared by several processes (spawn passes them down); `refs` counts them

use abi:    sdk.abi;
use heap:   machos.mm.heap;
use vfs:    machos.fs.vfs;
use pipe:   machos.kern.pipe;
use tty:    machos.kern.tty;
use proc:   machos.kern.proc;
use kprint: machos.kern.kprint;
use mem:    machos.kern.mem;
use dsk:  machos.dev.disk;
use blk:    machos.fs.blk;
use mount:  machos.fs.mount;
use parts:  machos.fs.parts;

pub val NODE:   u64 = 1;
pub val PIPE_R: u64 = 2;
pub val PIPE_W: u64 = 3;

pub rec Handle {
    kind:   u64;
    node:   *vfs.Node;
    pipe:   *pipe.Pipe;
    offset: u64;
    flags:  u64; # abi.O_*
    refs:   u64;
    wrote:  u8;  # a block device was written through it
}

fun new(kind: u64) *Handle {
    val h: *Handle = heap.zalloc($size_of(Handle)::u64)::*Handle;
    if (h == nil) { ret nil; }
    h.kind = kind;
    h.refs = 1;
    ret h;
}

pub fun open_node(nd: *vfs.Node, flags: u64) *Handle {
    val h: *Handle = new(NODE);
    if (h == nil) { ret nil; }
    h.node = nd;
    h.flags = flags;
    nd.opens = nd.opens + 1;
    ret h;
}

pub fun pipe_ends(p: *pipe.Pipe, r: **Handle, w: **Handle) u8 {
    val a: *Handle = new(PIPE_R);
    if (a == nil) { ret 0; }
    val b: *Handle = new(PIPE_W);
    if (b == nil) {
        heap.free(a::u64);
        ret 0;
    }
    a.pipe = p;
    a.flags = abi.O_READ;
    b.pipe = p;
    b.flags = abi.O_WRITE;
    @r = a;
    @w = b;
    ret 1;
}

pub fun dup(h: *Handle) *Handle {
    h.refs = h.refs + 1;
    ret h;
}

pub fun close(h: *Handle) {
    h.refs = h.refs - 1;
    if (h.refs > 0) { ret; }
    if (h.kind == NODE) {
        # like Linux's partition re-read: a whole disk written through this
        # handle gets its partitions read again
        if (h.wrote != 0 && h.node.kind == abi.KIND_DEV) {
            val b: *parts.Bdev = parts.get(h.node.dev);
            if (b != nil && b.part == 0 && mount.busy(b) == 0) { parts.rescan(b.disk); }
        }
        vfs.release(h.node);
    }
    or (h.kind == PIPE_R) { pipe.close_reader(h.pipe); }
    or (h.kind == PIPE_W) { pipe.close_writer(h.pipe); }
    heap.free(h::u64);
}

val BOUNCE: u64 = 65536;

# raw bytes of a block device (/dev/sdX, /dev/sdXN) at the handle's offset,
# through a kernel bounce buffer (the disk driver only reaches kernel memory).
# writes are refused while something on that device is mounted
fun disk_io(h: *Handle, buf: u64, n: u64, write: u8) u64 {
    val b: *parts.Bdev = parts.get(h.node.dev);
    if (b == nil) { ret abi.err(abi.E_IO); }
    val d: *dsk.Disk = parts.disk_of(b);
    val size: u64 = b.count * dsk.SECTOR;
    if (h.offset >= size) { ret 0; }
    var want: u64 = n;
    if (want > size - h.offset) { want = size - h.offset; }
    if (write != 0) {
        if (mount.busy(b) != 0) { ret abi.err(abi.E_BUSY); }
        blk.forget_disk(d);
        h.wrote = 1;
    } or {
        blk.sync();
    }
    val bounce: u64 = heap.alloc(BOUNCE);
    if (bounce == 0) { ret abi.err(abi.E_NOMEM); }
    var done: u64 = 0;
    for (done < want) {
        val at: u64 = h.offset + done;
        val within: u64 = at % dsk.SECTOR;
        var k: u64 = BOUNCE - within;
        if (k > want - done) { k = want - done; }
        val secs: u64 = (within + k + dsk.SECTOR - 1) / dsk.SECTOR;
        val lba: u64 = b.start + at / dsk.SECTOR;
        if (write == 0 || within != 0 || k % dsk.SECTOR != 0) {
            if (dsk.read(d, lba, secs, bounce) == 0) { brk; }
        }
        if (write == 0) {
            mem.copy(buf + done, bounce + within, k);
        } or {
            mem.copy(bounce + within, buf + done, k);
            if (dsk.write(d, lba, secs, bounce) == 0) { brk; }
        }
        done = done + k;
    }
    heap.free(bounce);
    h.offset = h.offset + done;
    if (done == 0) { ret abi.err(abi.E_IO); }
    ret done;
}

fun console_read(buf: u64, n: u64) u64 {
    for (tty.readable() == 0) {
        if (proc.interrupted(proc.current()) != 0) { ret abi.err(abi.E_INTR); }
        proc.sleep_on(proc.CHAN_TTY);
    }
    ret tty.read(buf::*u8, n);
}

# `buf` must already be checked to be writable user memory
pub fun read(h: *Handle, buf: u64, n: u64) u64 {
    if ((h.flags & abi.O_READ) == 0) { ret abi.err(abi.E_BADF); }
    if (h.kind == PIPE_R) { ret pipe.read(h.pipe, buf, n); }
    if (h.kind != NODE) { ret abi.err(abi.E_BADF); }
    val nd: *vfs.Node = h.node;
    if (nd.kind == abi.KIND_DIR) { ret abi.err(abi.E_ISDIR); }
    if (nd.kind == abi.KIND_DEV) {
        if (nd.dev == vfs.DEV_CONSOLE) { ret console_read(buf, n); }
        if (nd.dev >= vfs.DEV_DISK) { ret disk_io(h, buf, n, 0); }
        if (nd.dev == vfs.DEV_ZERO) {
            mem.fill(buf, 0, n);
            ret n;
        }
        ret 0;
    }
    val k: u64 = vfs.read(nd, h.offset, buf, n);
    h.offset = h.offset + k;
    ret k;
}

pub fun write(h: *Handle, buf: u64, n: u64) u64 {
    if ((h.flags & abi.O_WRITE) == 0) { ret abi.err(abi.E_BADF); }
    if (h.kind == PIPE_W) { ret pipe.write(h.pipe, buf, n); }
    if (h.kind != NODE) { ret abi.err(abi.E_BADF); }
    val nd: *vfs.Node = h.node;
    if (nd.kind == abi.KIND_DIR) { ret abi.err(abi.E_ISDIR); }
    if (nd.kind == abi.KIND_DEV) {
        if (nd.dev >= vfs.DEV_DISK) { ret disk_io(h, buf, n, 1); }
        if (nd.dev == vfs.DEV_CONSOLE) {
            val b: *u8 = buf::*u8;
            var i: u64 = 0;
            for (i < n) {
                kprint.putc(b[i]);
                i = i + 1;
            }
        }
        ret n;
    }
    if ((h.flags & abi.O_APPEND) != 0) { h.offset = nd.size; }
    val k: u64 = vfs.write(nd, h.offset, buf, n);
    if (abi.is_err(k) == 0) { h.offset = h.offset + k; }
    ret k;
}
