diff --git a/src/test/encoding.mach b/src/test/encoding.mach
index d2074e6..14223e0 100644
--- a/src/test/encoding.mach
+++ b/src/test/encoding.mach
@@ -931,3 +931,31 @@ test keys__private_pem_truncation_fails_before_allocation_at_every_boundary {
     }
     ret 0;
 }
+
+# Mozilla/curl bundles use 76 columns; output remains canonical 64-column PEM.
+test pem__mime_wrapped_input_preserves_public_and_secret_der {
+    val input: *u8 = "-----BEGIN TEST-----\nAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\nAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\nAAAA\n-----END TEST-----\n"::*u8;
+    val length: usize = 199;
+    var decoded: [128]u8;
+    var block: pem.Block;
+    if (pem.decode(contracts.Bytes{data: input, len: length},
+        contracts.Buffer{data: ?decoded[0], capacity: 128}, ?block) != contracts.OK ||
+        block.der.len != 117 || !filled(?decoded[0], 0, 117)) { ret 1; }
+    var secret_input: [256]^u8;
+    var secret_output: [128]^u8;
+    var i: usize = 0;
+    for (i < length) { secret_input[i] = input[i]; i = i + 1; }
+    var secret_block: pem.SecretBlock;
+    if (pem.decode_secret(contracts.SecretBytes{data: ?secret_input[0], len: length},
+        contracts.SecretBuffer{data: ?secret_output[0], capacity: 128}, ?secret_block) != contracts.OK ||
+        secret_block.der.len != 117) { ret 2; }
+    i = 0;
+    for (i < 117) { if (secret_output[i]:>u8 != 0) { ret 3; } i = i + 1; }
+    i = 0;
+    for (i + 1 < length) {
+        if (pem.decode(contracts.Bytes{data: input, len: i},
+            contracts.Buffer{data: ?decoded[0], capacity: 128}, ?block) == contracts.OK) { ret 4; }
+        i = i + 1;
+    }
+    ret 0;
+}
