# xargs COMMAND [ARGS...]: run COMMAND with ARGS and the words read from stdin

use os:  std.system.os;
use io:  userland.lib.cli;
use std.runtime;
use path: userland.lib.path;

val CAP: u64 = 65536;
var args: [65536]u8;
var input: [65536]u8;

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

fun run(argc: u64, argv: **u8) u64 {
    if (argc < 2) {
        io.err("usage: xargs COMMAND [ARGS...]\n\0");
        ret 2;
    }
    var full: [256]u8;
    val pn: u64 = path.lookup(argv[1], ?full[0]);
    if (pn == 0) {
        io.err("xargs: \0");
        io.err(argv[1]);
        io.err(": command not found\n\0");
        ret 127;
    }
    var n: u64 = 0;
    var i: u64 = 1;
    for (i < argc) {
        val l: u64 = io.len(argv[i]);
        if (n + l + 1 > CAP) { ret 2; }
        io.copy(?args[n], argv[i], l + 1);
        n = n + l + 1;
        i = i + 1;
    }
    var got: u64 = 0;
    for (got < CAP) {
        val r: i64 = io.read(io.STDIN, ?input[got], CAP - got);
        if (r <= 0) { brk; }
        got = got + r::u64;
    }
    i = 0;
    for (i < got::u64) {
        for (i < got && (input[i] == 32 || input[i] == 10 || input[i] == 9)) { i = i + 1; }
        val s: u64 = i;
        for (i < got && input[i] != 32 && input[i] != 10 && input[i] != 9) { i = i + 1; }
        if (i > s) {
            if (n + (i - s) + 1 > CAP) {
                io.err("xargs: too much input\n\0");
                ret 1;
            }
            io.copy(?args[n], ?input[s], i - s);
            n = n + (i - s);
            args[n] = 0;
            n = n + 1;
        }
    }
    var list: [4096]*u8;
    io.unpack(?args[0], n, ?list[0], 4096);
    val st: i64 = io.run_program(?full[0], ?list[0], nil);
    if (st < 0) {
        io.fail("xargs\0", argv[1], st);
        ret 127;
    }
    ret st::u64;
}
