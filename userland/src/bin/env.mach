# env [-i] [NAME=value...] [COMMAND [ARG...]]: print the environment, or run
# COMMAND with it changed (-i: starting from nothing)

use os:  std.system.os;
use io:  userland.lib.cli;
use path: userland.lib.path;
use std.runtime;


fun is_assignment(w: *u8) u64 {
    var i: u64 = 0;
    for (w[i] != 0) {
        if (w[i] == 61) { ret i; }
        i = i + 1;
    }
    ret 0;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 { ret run(argc::u64, argv)::i64; }

# the environment being built: "NAME=value" strings
var list: [512]*u8;
var count: u64 = 0;

# NAME=value, replacing an entry with the same NAME
fun set(entry: *u8, eq: u64) {
    var k: u64 = 0;
    for (k < count) {
        val e: *u8 = list[k];
        if (io.eq(e, eq, entry, eq) != 0 && e[eq] == 61) {
            list[k] = entry;
            ret;
        }
        k = k + 1;
    }
    if (count + 1 < 512) {
        list[count] = entry;
        count = count + 1;
    }
}

fun run(argc: u64, argv: **u8) u64 {
    var i: u64 = 1;
    var clean: u8 = 0;
    if (i < argc && io.streq(argv[i], "-i\0") != 0) {
        clean = 1;
        i = i + 1;
    }
    if (clean == 0) {
        val now: **u8 = os.environ();
        var k: u64 = 0;
        for (now != nil && now[k] != nil && count + 1 < 512) {
            list[count] = now[k];
            count = count + 1;
            k = k + 1;
        }
    }
    for (i < argc) {
        val eq: u64 = is_assignment(argv[i]);
        if (eq == 0) { brk; }
        set(argv[i], eq);
        i = i + 1;
    }
    list[count] = nil;
    if (i == argc) {
        var k: u64 = 0;
        for (k < count) {
            io.out(list[k]);
            io.putc(10);
            k = k + 1;
        }
        ret 0;
    }
    # COMMAND: through $PATH like the shell
    var full: [256]u8;
    val name: *u8 = argv[i];
    val fl: u64 = path.lookup(name, ?full[0]);
    if (fl == 0) {
        io.err("env: \0");
        io.err(name);
        io.err(": command not found\n\0");
        ret 127;
    }
    val st: i64 = io.run_program(?full[0], ?argv[i], ?list[0]);
    if (st < 0) {
        io.fail("env\0", name, st);
        ret 126;
    }
    ret st::u64;
}
