# mount DISK DIR: mount the MachOS partition of DISK (e.g. /dev/disk1) on DIR

use abi: machos.abi.sys;
use sys: machos.user.sys;
use io:  machos.user.io;
use rt:  machos.user.rt;

#[symbol("umain")]
fun main(argc: u64, argv: **u8) u64 {
    if (argc != 3) {
        io.err("usage: mount DISK DIR\n\0");
        ret 2;
    }
    val r: u64 = sys.mount(argv[1], io.len(argv[1]), argv[2], io.len(argv[2]));
    if (abi.is_err(r) != 0) {
        io.fail("mount\0", argv[1], r);
        ret 1;
    }
    ret 0;
}
