# handles: what a process's handle numbers point at. one Handle can be
# shared by several processes (spawn passes them down); `refs` counts them

use abi:    machos.abi.sys;
use heap:   machos.mm.heap;
use vfs:    machos.fs.vfs;
use pipe:   machos.kern.pipe;
use tty:    machos.kern.tty;
use proc:   machos.kern.proc;
use kprint: machos.kern.kprint;
use mem:    machos.kern.mem;

pub val NODE:   u64 = 1;
pub val PIPE_R: u64 = 2;
pub val PIPE_W: u64 = 3;

pub rec Handle {
    kind:   u64;
    node:   *vfs.Node;
    pipe:   *pipe.Pipe;
    offset: u64;
    flags:  u64; # abi.O_*
    refs:   u64;
}

fun new(kind: u64) *Handle {
    val h: *Handle = heap.zalloc($size_of(Handle)::u64)::*Handle;
    if (h == nil) { ret nil; }
    h.kind = kind;
    h.refs = 1;
    ret h;
}

pub fun open_node(nd: *vfs.Node, flags: u64) *Handle {
    val h: *Handle = new(NODE);
    if (h == nil) { ret nil; }
    h.node = nd;
    h.flags = flags;
    nd.opens = nd.opens + 1;
    ret h;
}

pub fun pipe_ends(p: *pipe.Pipe, r: **Handle, w: **Handle) u8 {
    val a: *Handle = new(PIPE_R);
    if (a == nil) { ret 0; }
    val b: *Handle = new(PIPE_W);
    if (b == nil) {
        heap.free(a::u64);
        ret 0;
    }
    a.pipe = p;
    a.flags = abi.O_READ;
    b.pipe = p;
    b.flags = abi.O_WRITE;
    @r = a;
    @w = b;
    ret 1;
}

pub fun dup(h: *Handle) *Handle {
    h.refs = h.refs + 1;
    ret h;
}

pub fun close(h: *Handle) {
    h.refs = h.refs - 1;
    if (h.refs > 0) { ret; }
    if (h.kind == NODE) { vfs.release(h.node); }
    or (h.kind == PIPE_R) { pipe.close_reader(h.pipe); }
    or (h.kind == PIPE_W) { pipe.close_writer(h.pipe); }
    heap.free(h::u64);
}

fun console_read(buf: u64, n: u64) u64 {
    for (tty.readable() == 0) {
        if (proc.current().killed != 0) { ret 0; }
        proc.sleep_on(proc.CHAN_TTY);
    }
    ret tty.read(buf::*u8, n);
}

# `buf` must already be checked to be writable user memory
pub fun read(h: *Handle, buf: u64, n: u64) u64 {
    if ((h.flags & abi.O_READ) == 0) { ret abi.err(abi.E_BADF); }
    if (h.kind == PIPE_R) { ret pipe.read(h.pipe, buf, n); }
    if (h.kind != NODE) { ret abi.err(abi.E_BADF); }
    val nd: *vfs.Node = h.node;
    if (nd.kind == abi.KIND_DIR) { ret abi.err(abi.E_ISDIR); }
    if (nd.kind == abi.KIND_DEV) {
        if (nd.dev == vfs.DEV_CONSOLE) { ret console_read(buf, n); }
        if (nd.dev == vfs.DEV_ZERO) {
            mem.fill(buf, 0, n);
            ret n;
        }
        ret 0;
    }
    val k: u64 = vfs.read(nd, h.offset, buf, n);
    h.offset = h.offset + k;
    ret k;
}

pub fun write(h: *Handle, buf: u64, n: u64) u64 {
    if ((h.flags & abi.O_WRITE) == 0) { ret abi.err(abi.E_BADF); }
    if (h.kind == PIPE_W) { ret pipe.write(h.pipe, buf, n); }
    if (h.kind != NODE) { ret abi.err(abi.E_BADF); }
    val nd: *vfs.Node = h.node;
    if (nd.kind == abi.KIND_DIR) { ret abi.err(abi.E_ISDIR); }
    if (nd.kind == abi.KIND_DEV) {
        if (nd.dev == vfs.DEV_CONSOLE) {
            val b: *u8 = buf::*u8;
            var i: u64 = 0;
            for (i < n) {
                kprint.putc(b[i]);
                i = i + 1;
            }
        }
        ret n;
    }
    if ((h.flags & abi.O_APPEND) != 0) { h.offset = nd.size; }
    val k: u64 = vfs.write(nd, h.offset, buf, n);
    if (abi.is_err(k) == 0) { h.offset = h.offset + k; }
    ret k;
}
