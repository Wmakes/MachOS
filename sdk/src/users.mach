# user accounts, the Unix way:
#   /etc/passwd  name:x:uid:gid:full name:home:shell   (readable by all)
#   /etc/group   name:x:gid:members
#   /etc/shadow  name:hash:                            (root only, 0600)
# a hash is $sha256$ROUNDS$SALT$DIGEST (hex): SHA-256 of salt + password,
# then ROUNDS - 1 more times of digest + salt + password. an empty hash
# means no password; "!" or "*" means the account is locked

use abi:    sdk.abi;
use sys:    sdk.sys;
use io:     sdk.io;
use sha256: sdk.sha256;

pub val ROUNDS: u64 = 5000;

pub rec User {
    name:      [32]u8;
    name_len:  u64;
    uid:       u64;
    gid:       u64;
    home:      [128]u8;
    home_len:  u64;
    shell:     [64]u8;
    shell_len: u64;
}

val CAP: u64 = 16384;
var file: [16384]u8;
var flen: u64 = 0;

fun load(p: *u8) u8 {
    flen = 0;
    val h: u64 = sys.open(p, io.len(p), abi.O_READ);
    if (abi.is_err(h) != 0) { ret 0; }
    var good: u8 = 1;
    for (flen < CAP) {
        val r: u64 = sys.read(h, ?file[flen], CAP - flen);
        if (abi.is_err(r) != 0) { good = 0; brk; }
        if (r == 0) { brk; }
        flen = flen + r;
    }
    if (flen == CAP) {
        var extra: u8 = 0;
        if (sys.read(h, ?extra, 1) != 0) { good = 0; }
    }
    sys.close(h);
    if (good == 0) { flen = 0; }
    ret good;
}

# field `k` (0-based, ':'-separated) of the line at file[s..e]
fun field(s: u64, e: u64, k: u64, fs: *u64, fl: *u64) u8 {
    var i: u64 = s;
    var n: u64 = 0;
    var start: u64 = s;
    for (i <= e) {
        if (i == e || file[i] == 58) {
            if (n == k) {
                @fs = start;
                @fl = i - start;
                ret 1;
            }
            n = n + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    ret 0;
}

fun num(s: u64, n: u64) u64 {
    var okk: u8 = 0;
    ret io.parse_dec(?file[s], n, ?okk);
}

# find the line whose field `k` is `want`; its bounds
fun find_line(k: u64, want: *u8, wn: u64, ls: *u64, le: *u64) u8 {
    var s: u64 = 0;
    for (s < flen) {
        var e: u64 = s;
        for (e < flen && file[e] != 10) { e = e + 1; }
        var fs: u64 = 0;
        var fl: u64 = 0;
        if (field(s, e, k, ?fs, ?fl) != 0 && io.eq(?file[fs], fl, want, wn) != 0) {
            @ls = s;
            @le = e;
            ret 1;
        }
        s = e + 1;
    }
    ret 0;
}

fun fill(u: *User, s: u64, e: u64) {
    var fs: u64 = 0;
    var fl: u64 = 0;
    field(s, e, 0, ?fs, ?fl);
    if (fl > 31) { fl = 31; }
    io.copy(?u.name[0], ?file[fs], fl);
    u.name[fl] = 0;
    u.name_len = fl;
    field(s, e, 2, ?fs, ?fl);
    u.uid = num(fs, fl);
    field(s, e, 3, ?fs, ?fl);
    u.gid = num(fs, fl);
    u.home_len = 0;
    if (field(s, e, 5, ?fs, ?fl) != 0 && fl < 127) {
        io.copy(?u.home[0], ?file[fs], fl);
        u.home_len = fl;
    }
    u.home[u.home_len] = 0;
    u.shell_len = 0;
    if (field(s, e, 6, ?fs, ?fl) != 0 && fl < 63) {
        io.copy(?u.shell[0], ?file[fs], fl);
        u.shell_len = fl;
    }
    u.shell[u.shell_len] = 0;
}

pub fun by_name(name: *u8, n: u64, out: *User) u8 { ret by_name_in("/etc/passwd\0", name, n, out); }

pub fun by_name_in(path: *u8, name: *u8, n: u64, out: *User) u8 {
    if (load(path) == 0) { ret 0; }
    var s: u64 = 0;
    var e: u64 = 0;
    if (find_line(0, name, n, ?s, ?e) == 0) { ret 0; }
    fill(out, s, e);
    ret 1;
}

pub fun by_uid(uid: u64, out: *User) u8 {
    var d: [20]u8;
    val dn: u64 = io.fmt_dec(uid, ?d[0]);
    if (load("/etc/passwd\0") == 0) { ret 0; }
    var s: u64 = 0;
    var e: u64 = 0;
    if (find_line(2, ?d[0], dn, ?s, ?e) == 0) { ret 0; }
    fill(out, s, e);
    ret 1;
}

# the name of user `uid` (or the number) into out (32 bytes); its length
pub fun user_name(uid: u64, out: *u8) u64 {
    var u: User;
    if (by_uid(uid, ?u) != 0) {
        io.copy(out, ?u.name[0], u.name_len + 1);
        ret u.name_len;
    }
    val n: u64 = io.fmt_dec(uid, out);
    out[n] = 0;
    ret n;
}

# the name of group `gid` (or the number) into out (32 bytes); its length
pub fun group_name(gid: u64, out: *u8) u64 {
    var d: [20]u8;
    val dn: u64 = io.fmt_dec(gid, ?d[0]);
    if (load("/etc/group\0") != 0) {
        var s: u64 = 0;
        var e: u64 = 0;
        if (find_line(2, ?d[0], dn, ?s, ?e) != 0) {
            var fs: u64 = 0;
            var fl: u64 = 0;
            field(s, e, 0, ?fs, ?fl);
            if (fl > 31) { fl = 31; }
            io.copy(out, ?file[fs], fl);
            out[fl] = 0;
            ret fl;
        }
    }
    io.copy(out, ?d[0], dn);
    out[dn] = 0;
    ret dn;
}

# the gid of group `name`, or NO_ID
pub fun group_id(name: *u8, n: u64) u64 {
    if (load("/etc/group\0") == 0) { ret abi.NO_ID; }
    var s: u64 = 0;
    var e: u64 = 0;
    if (find_line(0, name, n, ?s, ?e) == 0) { ret abi.NO_ID; }
    var fs: u64 = 0;
    var fl: u64 = 0;
    field(s, e, 2, ?fs, ?fl);
    ret num(fs, fl);
}

val HEX: *u8 = "0123456789abcdef\0";

fun hex(src: *u8, n: u64, out: *u8) {
    var i: u64 = 0;
    for (i < n) {
        out[i * 2] = HEX[src[i] >> 4];
        out[i * 2 + 1] = HEX[src[i] & 15];
        i = i + 1;
    }
}

fun unhex_digit(c: u8) u8 {
    if (c >= 48 && c <= 57) { ret c - 48; }
    if (c >= 97 && c <= 102) { ret c - 87; }
    ret 0;
}

fun digest(salt: *u8, pw: *u8, pn: u64, rounds: u64, out: *u8) {
    var c: sha256.Ctx;
    sha256.init(?c);
    sha256.update(?c, salt, 16);
    sha256.update(?c, pw, pn);
    sha256.finish(?c, out);
    var r: u64 = 1;
    for (r < rounds) {
        sha256.init(?c);
        sha256.update(?c, out, 32);
        sha256.update(?c, salt, 16);
        sha256.update(?c, pw, pn);
        sha256.finish(?c, out);
        r = r + 1;
    }
}

# hash a new password with a fresh salt into out (128 bytes); its length
pub fun hash(pw: *u8, pn: u64, out: *u8) u64 {
    var salt: [16]u8;
    if (sys.raw(abi.GETRANDOM, (?salt[0])::u64, 16, 0, 0, 0) != 16) { ret 0; }
    var d: [32]u8;
    digest(?salt[0], pw, pn, ROUNDS, ?d[0]);
    var n: u64 = 0;
    io.copy(out, "$sha256$\0", 8);
    n = 8;
    n = n + io.fmt_dec(ROUNDS, ?out[n]);
    out[n] = 36;
    n = n + 1;
    hex(?salt[0], 16, ?out[n]);
    n = n + 32;
    out[n] = 36;
    n = n + 1;
    hex(?d[0], 32, ?out[n]);
    n = n + 64;
    out[n] = 0;
    ret n;
}

# the stored hash of `name` into out (128 bytes); its length, or NO_ID
# when there is no such user (or shadow cannot be read)
pub fun stored(name: *u8, n: u64, out: *u8) u64 {
    if (load("/etc/shadow\0") == 0) { ret abi.NO_ID; }
    var s: u64 = 0;
    var e: u64 = 0;
    if (find_line(0, name, n, ?s, ?e) == 0) { ret abi.NO_ID; }
    var fs: u64 = 0;
    var fl: u64 = 0;
    if (field(s, e, 1, ?fs, ?fl) == 0 || fl > 127) { ret abi.NO_ID; }
    io.copy(out, ?file[fs], fl);
    out[fl] = 0;
    ret fl;
}

# whether `pw` is the password of a stored hash (an empty hash takes any)
pub fun matches(h: *u8, hn: u64, pw: *u8, pn: u64) u8 {
    if (hn == 0) { ret 1; }
    if (hn < 10 || io.eq(h, 8, "$sha256$\0", 8) == 0) { ret 0; }
    var i: u64 = 8;
    for (i < hn && h[i] != 36) { i = i + 1; }
    var okk: u8 = 0;
    val rounds: u64 = io.parse_dec(?h[8], i - 8, ?okk);
    if (okk == 0 || rounds == 0 || rounds > 1000000 || i + 1 + 32 + 1 + 64 != hn) { ret 0; }
    var salt: [16]u8;
    var k: u64 = 0;
    for (k < 16) {
        salt[k] = (unhex_digit(h[i + 1 + k * 2]) << 4) | unhex_digit(h[i + 2 + k * 2]);
        k = k + 1;
    }
    var d: [32]u8;
    digest(?salt[0], pw, pn, rounds, ?d[0]);
    var x: [64]u8;
    hex(?d[0], 32, ?x[0]);
    ret io.eq(?x[0], 64, ?h[i + 34], 64);
}

pub fun locked(h: *u8, hn: u64) u8 {
    if (hn > 0 && (h[0] == 33 || h[0] == 42)) { ret 1; }
    ret 0;
}

# replace (or add) the line of `name` in `path` with `line` (no newline)
fun put_line(path: *u8, key_field: u64, name: *u8, n: u64, line: *u8, ln: u64, mode: u64) u8 {
    var lock: [512]u8;
    val length: u64 = io.len(path);
    if (length + 6 >= 512) { ret 0; }
    io.copy(?lock[0], path, length);
    io.copy(?lock[length], ".lock\0", 6);
    val held: u64 = sys.open_mode(?lock[0], length + 5, abi.O_WRITE | abi.O_CREATE | abi.O_EXCL, 0x180);
    if (abi.is_err(held) != 0) { ret 0; }
    val result: u8 = put_line_locked(path, key_field, name, n, line, ln, mode);
    sys.close(held);
    sys.remove(?lock[0], length + 5);
    ret result;
}

fun put_line_locked(path: *u8, key_field: u64, name: *u8, n: u64, line: *u8, ln: u64, mode: u64) u8 {
    if (load(path) == 0) { ret 0; }
    var out: [16384]u8;
    var o: u64 = 0;
    var s: u64 = 0;
    var done: u8 = 0;
    for (s < flen) {
        var e: u64 = s;
        for (e < flen && file[e] != 10) { e = e + 1; }
        var fs: u64 = 0;
        var fl: u64 = 0;
        var src: *u8 = ?file[s];
        var sl: u64 = e - s;
        if (field(s, e, key_field, ?fs, ?fl) != 0 && io.eq(?file[fs], fl, name, n) != 0) {
            src = line;
            sl = ln;
            done = 1;
        }
        if (o + sl + 1 > 16384) { ret 0; }
        io.copy(?out[o], src, sl);
        out[o + sl] = 10;
        o = o + sl + 1;
        s = e + 1;
    }
    if (done == 0) {
        if (o + ln + 1 > 16384) { ret 0; }
        io.copy(?out[o], line, ln);
        out[o + ln] = 10;
        o = o + ln + 1;
    }
    # Keep the old database intact until a complete replacement is ready.
    var temporary: [512]u8;
    val length: u64 = io.len(path);
    if (length + 32 >= 512) { ret 0; }
    io.copy(?temporary[0], path, length);
    io.copy(?temporary[length], ".tmp.\0", 5);
    val end: u64 = length + 5 + io.fmt_dec(sys.getpid(), ?temporary[length + 5]);
    temporary[end] = 0;
    val h: u64 = sys.open_mode(?temporary[0], end,
        abi.O_WRITE | abi.O_CREATE | abi.O_EXCL, 0x180);
    if (abi.is_err(h) != 0) { ret 0; }
    var good: u8 = io.write_all(h, ?out[0], o);
    if (good != 0 && abi.is_err(sys.raw(abi.FCHMOD, h, mode, 0, 0, 0)) != 0) { good = 0; }
    sys.close(h);
    if (good != 0 && abi.is_err(sys.rename(?temporary[0], end, path, length)) == 0) { ret 1; }
    sys.remove(?temporary[0], end);
    ret 0;
}

# store a new password for `name` (needs root: /etc/shadow is root's)
pub fun set_password(name: *u8, n: u64, pw: *u8, pn: u64) u8 { ret set_password_in("/etc/shadow\0", name, n, pw, pn); }

# the same in another system's shadow file (`install` sets up a new disk)
pub fun set_password_in(shadow: *u8, name: *u8, n: u64, pw: *u8, pn: u64) u8 {
    var line: [256]u8;
    if (n > 31 || pn == 0 || pn > 127) { ret 0; }
    io.copy(?line[0], name, n);
    line[n] = 58;
    var l: u64 = n + 1;
    if (pn > 0) {
        val hashed: u64 = hash(pw, pn, ?line[l]);
        if (hashed == 0) { ret 0; }
        l = l + hashed;
    }
    line[l] = 58;
    l = l + 1;
    ret put_line(shadow, 0, name, n, ?line[0], l, 0x180);
}

# add a user (and its own group of the same name and number)
pub fun add(name: *u8, n: u64, uid: u64, home: *u8, shell: *u8) u8 {
    ret add_in("/etc/passwd\0", "/etc/group\0", "/etc/shadow\0", name, n, uid, home, shell);
}

pub fun add_in(passwd: *u8, group: *u8, shadow: *u8, name: *u8, n: u64, uid: u64, home: *u8, shell: *u8) u8 {
    var line: [256]u8;
    var l: u64 = 0;
    var d: [20]u8;
    val dn: u64 = io.fmt_dec(uid, ?d[0]);
    io.copy(?line[0], name, n);
    l = n;
    io.copy(?line[l], ":x:\0", 3);
    l = l + 3;
    io.copy(?line[l], ?d[0], dn);
    l = l + dn;
    line[l] = 58;
    l = l + 1;
    io.copy(?line[l], ?d[0], dn);
    l = l + dn;
    line[l] = 58;
    line[l + 1] = 58;
    l = l + 2;
    io.copy(?line[l], home, io.len(home));
    l = l + io.len(home);
    line[l] = 58;
    l = l + 1;
    io.copy(?line[l], shell, io.len(shell));
    l = l + io.len(shell);
    if (put_line(passwd, 0, name, n, ?line[0], l, 0x1A4) == 0) { ret 0; }
    # name:x:gid:
    l = n;
    io.copy(?line[l], ":x:\0", 3);
    l = l + 3;
    io.copy(?line[l], ?d[0], dn);
    l = l + dn;
    line[l] = 58;
    l = l + 1;
    if (put_line(group, 0, name, n, ?line[0], l, 0x1A4) == 0) { ret 0; }
    io.copy(?line[0], name, n);
    line[n] = 58; line[n + 1] = 33; line[n + 2] = 58;
    ret put_line(shadow, 0, name, n, ?line[0], n + 3, 0x180);
}

# a free uid from 1000 up
pub fun next_uid() u64 { ret next_uid_in("/etc/passwd\0"); }

pub fun next_uid_in(path: *u8) u64 {
    if (load(path) == 0) { ret abi.NO_ID; }
    var uid: u64 = 1000;
    for (uid < 0xffffffff) {
        var digits: [24]u8; var start: u64 = 0; var end: u64 = 0;
        val n: u64 = io.fmt_dec(uid, ?digits[0]);
        if (find_line(2, ?digits[0], n, ?start, ?end) == 0) { ret uid; }
        uid = uid + 1;
    }
    ret abi.NO_ID;
}

# print `prompt` and read a line without echoing it (a password) into out;
# its length (without the newline), or NO_ID at end of input
pub fun read_secret(prompt: *u8, out: *u8, cap: u64) u64 {
    io.out(prompt);
    var original: abi.Termios;
    val tty: u8 = (abi.is_err(sys.tcgetattr(abi.STDIN, ?original)) == 0)::u8;
    if (tty != 0) {
        var hidden: abi.Termios = original; hidden.lflag = hidden.lflag & ~abi.ECHO;
        if (abi.is_err(sys.tcsetattr(abi.STDIN, ?hidden)) != 0) { ret abi.NO_ID; }
    }
    val n: u64 = read_line(out, cap);
    if (tty != 0) { sys.tcsetattr(abi.STDIN, ?original); io.putc(10); }
    ret n;
}

# drain an overlong line rather than leaving its tail for a later prompt
pub fun read_line(out: *u8, cap: u64) u64 {
    var n: u64 = 0; var any: u8 = 0; var overflow: u8 = 0;
    for {
        var c: u8 = 0;
        val r: u64 = sys.read(abi.STDIN, ?c, 1);
        if (abi.is_err(r) != 0 || r == 0) { brk; }
        any = 1;
        if (c == 10) { brk; }
        if (n < cap) { out[n] = c; n = n + 1; } or { overflow = 1; }
    }
    if (any == 0 || overflow != 0) { ret abi.NO_ID; }
    ret n;
}

# switch this process to user `u`: groups first, while still allowed
pub fun become(u: *User) u8 {
    if (abi.is_err(sys.setgid(u.gid)) != 0) { ret 0; }
    if (abi.is_err(sys.setuid(u.uid)) != 0) { ret 0; }
    ret 1;
}

# require a matching, nonempty password before changing account files
pub fun new_password(out: *u8) u64 {
    for {
        val n: u64 = read_secret("New password: \0", out, 127);
        if (n == abi.NO_ID) { ret abi.NO_ID; }
        if (n == 0) { io.emsg("Password cannot be empty.\n\0"); cnt; }
        var again: [128]u8;
        val m: u64 = read_secret("Again: \0", ?again[0], 127);
        val same: u8 = io.eq(out, n, ?again[0], m);
        var i: u64 = 0;
        for (i < 128) { again[i] = 0; i = i + 1; }
        if (m == abi.NO_ID) { ret abi.NO_ID; }
        if (same != 0) { ret n; }
        io.emsg("Passwords do not match.\n\0");
    }
    ret abi.NO_ID;
}

# membership is read afresh for each privileged operation
pub fun in_group(user: *User, group: *u8) u8 {
    if (load("/etc/group\0") == 0) { ret 0; }
    var s: u64 = 0; var e: u64 = 0;
    if (find_line(0, group, io.len(group), ?s, ?e) == 0) { ret 0; }
    var at: u64 = 0; var n: u64 = 0;
    if (field(s, e, 2, ?at, ?n) == 0) { ret 0; }
    if (num(at, n) == user.gid) { ret 1; }
    if (field(s, e, 3, ?at, ?n) == 0) { ret 0; }
    val end: u64 = at + n;
    for (at < end) {
        var stop: u64 = at;
        for (stop < end && file[stop] != 44) { stop = stop + 1; }
        if (io.eq(?file[at], stop - at, ?user.name[0], user.name_len) != 0) { ret 1; }
        at = stop + 1;
    }
    ret 0;
}

# add an administrator to the named system; preserve existing members
pub fun add_admin(group_path: *u8, name: *u8, n: u64) u8 { ret set_admin(group_path, name, n, 1); }

pub fun set_admin(group_path: *u8, name: *u8, n: u64, enabled: u8) u8 {
    if (load(group_path) == 0 || n == 0 || n > 31) { ret 0; }
    var s: u64 = 0; var e: u64 = 0;
    var line: [16384]u8; var len: u64 = 0;
    if (find_line(0, "admin\0", 5, ?s, ?e) != 0) {
        var at: u64 = 0; var count: u64 = 0;
        if (field(s, e, 3, ?at, ?count) == 0) { ret 0; }
        len = at - s; io.copy(?line[0], ?file[s], len);
        val prefix: u64 = len; val end: u64 = at + count;
        for (at < end) {
            var stop: u64 = at; for (stop < end && file[stop] != 44) { stop = stop + 1; }
            if (stop > at && io.eq(?file[at], stop - at, name, n) == 0) {
                if (len + stop - at + 1 >= 16384) { ret 0; }
                if (len > prefix) { line[len] = 44; len = len + 1; }
                io.copy(?line[len], ?file[at], stop - at); len = len + stop - at;
            }
            at = stop + 1;
        }
    } or { io.copy(?line[0], "admin:x:101:\0", 12); len = 12; }
    if (enabled != 0) {
        if (len + n + 1 >= 16384) { ret 0; }
        if (line[len - 1] != 58) { line[len] = 44; len = len + 1; }
        io.copy(?line[len], name, n); len = len + n;
    }
    ret put_line(group_path, 0, "admin\0", 5, ?line[0], len, 0x1A4);
}
