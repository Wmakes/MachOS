# helpers the text tools share: whole inputs, lines, dates, wildcards

use os:  std.system.os;
use io:  userland.lib.cli;

# all of `h` into buf (at most cap bytes); the length
pub fun read_all(h: i64, buf: *u8, cap: u64) u64 {
    var n: u64 = 0;
    for (n < cap) {
        val r: i64 = io.read(h, ?buf[n], cap - n);
        if (r <= 0) { brk; }
        n = n + r::u64;
    }
    ret n;
}

# FILE opened for reading, or stdin for nil / "-"; an error is reported
pub fun open_in(prog: *u8, path: *u8) i64 {
    if (path == nil || io.streq(path, "-\0") != 0) { ret io.STDIN; }
    val h: i64 = io.open_mode(path, os.O_RDONLY, 0o666);
    if (h < 0) { io.fail(prog, path, h); }
    ret h;
}

# split buf[0..n] into lines: starts[i] and lens[i] (no newline); the count
pub fun split_lines(buf: *u8, n: u64, starts: *u64, lens: *u64, max: u64) u64 {
    var count: u64 = 0;
    var s: u64 = 0;
    var i: u64 = 0;
    for (i <= n && count < max) {
        if (i == n || buf[i] == 10) {
            if (i == n && s == n) { brk; } # no empty last line after a final newline
            starts[count] = s;
            lens[count] = i - s;
            count = count + 1;
            s = i + 1;
        }
        i = i + 1;
    }
    ret count;
}

fun leap(y: u64) u8 {
    if ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) { ret 1; }
    ret 0;
}

val MONTH_DAYS: [12]u64 = [12]u64{31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

fun two(out: *u8, v: u64) {
    out[0] = 48 + (v / 10)::u8;
    out[1] = 48 + (v % 10)::u8;
}

# "YYYY-MM-DD HH:MM" (UTC) of Unix time t into out (16 bytes)
pub fun fmt_time(t: u64, out: *u8) u64 {
    var days: u64 = t / 86400;
    val secs: u64 = t % 86400;
    var year: u64 = 1970;
    for {
        var len: u64 = 365;
        if (leap(year) != 0) { len = 366; }
        if (days < len) { brk; }
        days = days - len;
        year = year + 1;
    }
    var month: u64 = 0;
    for (month < 12) {
        var len: u64 = MONTH_DAYS[month];
        if (month == 1 && leap(year) != 0) { len = 29; }
        if (days < len) { brk; }
        days = days - len;
        month = month + 1;
    }
    io.fmt_dec(year, out);
    out[4] = 45;
    two(?out[5], month + 1);
    out[7] = 45;
    two(?out[8], days + 1);
    out[10] = 32;
    two(?out[11], secs / 3600);
    out[13] = 58;
    two(?out[14], (secs / 60) % 60);
    ret 16;
}

# shell-style wildcard match: * any run, ? any one character
pub fun glob(p: *u8, pn: u64, s: *u8, sn: u64) u8 {
    var pi: u64 = 0;
    var si: u64 = 0;
    var star: u64 = 0xFFFFFFFFFFFFFFFF;
    var mark: u64 = 0;
    for (si < sn) {
        if (pi < pn && (p[pi] == 63 || p[pi] == s[si])) {
            pi = pi + 1;
            si = si + 1;
        } or (pi < pn && p[pi] == 42) {
            star = pi;
            pi = pi + 1;
            mark = si;
        } or (star != 0xFFFFFFFFFFFFFFFF) {
            pi = star + 1;
            mark = mark + 1;
            si = mark;
        } or {
            ret 0;
        }
    }
    for (pi < pn && p[pi] == 42) { pi = pi + 1; }
    if (pi == pn) { ret 1; }
    ret 0;
}

pub fun human(bytes: u64) {
    if (bytes >= 1073741824) {
        io.dec(bytes / 1073741824);
        io.out("G\0");
    } or (bytes >= 1048576) {
        io.dec(bytes / 1048576);
        io.out("M\0");
    } or (bytes >= 1024) {
        io.dec(bytes / 1024);
        io.out("K\0");
    } or {
        io.dec(bytes);
    }
}
